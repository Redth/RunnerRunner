# RunnerRunner Agent Configuration
# Copy this to /opt/runnerrunner/appsettings.Production.json and edit values
#
# This file is used as a template. The deploy script copies it to the host
# and the agent reads appsettings.Production.json at runtime.
#
# Usage: cp agent.env.example agent.env && edit agent.env
#        Then run deploy-agent.sh which converts it to appsettings.Production.json

# Required: URL of the RunnerRunner server
RUNNERRUNNER_SERVER_URL=http://192.168.2.4:4779

# Required: Display name for this agent
RUNNERRUNNER_AGENT_NAME=mac-mini-01

# Optional: Enrollment token from the server UI
RUNNERRUNNER_AGENT_TOKEN=

# Optional: Unique agent ID (auto-generated if empty)
RUNNERRUNNER_AGENT_ID=
