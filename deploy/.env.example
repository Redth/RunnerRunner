# RunnerRunner development/debug deploy configuration
# Copy this to deploy/.env only when using the SSH helper scripts in deploy/.
# Public installs should use GitHub Release artifacts, runnerrunner-server update,
# and HostWorker updates from the Hosts page.
# This file is gitignored - your passwords stay local.

# --- Linux Host (Docker Compose stack) ---
# Replace these examples with the actual Linux machine you deploy to.
LINUX_HOST=192.168.2.4
LINUX_SSH_PORT=22
# Optional: bind Docker-published ports to a specific interface on the Linux host.
# Leave unset to bind on all interfaces, or set to the host IP you want to expose.
LINUX_BIND_IP=

# Optional: override the IP address Orleans should advertise to other silos.
# Usually this should just be your real Linux host IP.
ORLEANS_ADVERTISED_IP=
LINUX_USER=root
LINUX_PASSWORD=
LINUX_SSH_KEY=~/.ssh/id_ed25519

# --- HostWorker enrollment ---
# HOSTWORKER_ENROLLMENT_TOKEN is a bootstrap fallback shared by the server
# and bundled Linux HostWorker. Prefer per-host tokens from the Hosts page for
# standalone macOS/Windows workers when deploying them after the server exists.
HOSTWORKER_ENROLLMENT_TOKEN=change-me

# --- macOS Host (native HostWorker) ---
# Replace this example with the actual macOS machine you deploy to.
MACOS_HOST=192.168.2.134
MACOS_SSH_PORT=22
MACOS_USER=root
MACOS_PASSWORD=
MACOS_SSH_KEY=~/.ssh/id_ed25519
MACOS_HOSTWORKER_ENROLLMENT_TOKEN=

# --- Windows Host (native HostWorker or HostWorker-in-Docker) ---
# Use OpenSSH on the Windows host. Keep the deploy dir in forward-slash form for scp.
WINDOWS_HOST=
WINDOWS_SSH_PORT=22
WINDOWS_USER=Administrator
WINDOWS_PASSWORD=
WINDOWS_SSH_KEY=
WINDOWS_DEPLOY_DIR=C:/RunnerRunner
WINDOWS_MODE=native
WINDOWS_HOSTWORKER_ENROLLMENT_TOKEN=

# --- Container Registry ---
REGISTRY_URL=ghcr.io
REGISTRY_NAMESPACE=redth

# --- Server Port (web UI) ---
SERVER_PORT=4779

# --- OpenTelemetry (optional) ---
# Set to export traces/metrics/logs to an OTLP-compatible endpoint.
# For the Linux compose observability profile, use http://otel-collector:4317.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
