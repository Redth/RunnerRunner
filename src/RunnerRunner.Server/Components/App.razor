<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        // Theme: restore saved preference or follow system, runs before first paint
        (function() {
            var storageKey = 'rr-theme';
            var mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
            var enhancedNavigationRegistered = false;

            function getThemePreference() {
                var saved = localStorage.getItem(storageKey);
                return saved === 'light' || saved === 'dark' || saved === 'auto' ? saved : 'auto';
            }

            function resolveTheme(preference) {
                return preference === 'light' || preference === 'dark'
                    ? preference
                    : mediaQuery.matches ? 'dark' : 'light';
            }

            function updateThemeToggle(preference) {
                var toggle = document.querySelector('[data-theme-toggle]');
                if (!toggle) return;

                var label = 'Theme: ' + preference.charAt(0).toUpperCase() + preference.slice(1);
                toggle.setAttribute('title', label);
                toggle.setAttribute('aria-label', label);
            }

            function applyThemePreference(preference) {
                var normalizedPreference = preference === 'light' || preference === 'dark' || preference === 'auto'
                    ? preference
                    : getThemePreference();
                var theme = resolveTheme(normalizedPreference);

                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-theme-preference', normalizedPreference);
                updateThemeToggle(normalizedPreference);
            }

            function setThemePreference(preference) {
                if (preference === 'auto') {
                    localStorage.removeItem(storageKey);
                } else {
                    localStorage.setItem(storageKey, preference);
                }

                applyThemePreference(preference);
            }

            function toggleTheme() {
                var current = document.documentElement.getAttribute('data-theme-preference') || getThemePreference();
                var next = current === 'auto' ? 'light' : current === 'light' ? 'dark' : 'auto';
                setThemePreference(next);
            }

            function registerEnhancedNavigationHandler() {
                if (enhancedNavigationRegistered) return;

                var blazor = window.Blazor || window.blazor;
                if (blazor && typeof blazor.addEventListener === 'function') {
                    blazor.addEventListener('enhancedload', window.rrTheme.apply);
                    enhancedNavigationRegistered = true;
                }
            }

            window.rrTheme = {
                apply: function() {
                    applyThemePreference(getThemePreference());
                },
                toggle: toggleTheme,
                registerEnhancedNavigationHandler: registerEnhancedNavigationHandler
            };
            window.toggleTheme = toggleTheme;

            applyThemePreference(getThemePreference());

            mediaQuery.addEventListener('change', function() {
                if (getThemePreference() === 'auto') {
                    applyThemePreference('auto');
                }
            });
            document.addEventListener('DOMContentLoaded', function() {
                registerEnhancedNavigationHandler();
                window.rrTheme.apply();
            });
        })();
        // Sidebar: persist collapsed state before first paint to prevent flash
        (function() {
            if (localStorage.getItem('rr-sidebar-collapsed') === 'true') {
                document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
            }
        })();
    </script>
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/bootstrap-icons.min.css"]" />
    <RadzenTheme Theme="standard" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RunnerRunner.Server.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="icon" type="image/svg+xml" href="icon.svg" />
    <link rel="apple-touch-icon" href="icon-192.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.min.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xterm-addon-search@0.13.0/lib/xterm-addon-search.js"></script>
    <script src="@Assets["js/terminal.js"]"></script>
    <script src="@Assets["js/table-grid.js"]"></script>
    <script src="@Assets["js/downloads.js"]"></script>
    <script src="@Assets["_content/Radzen.Blazor/Radzen.Blazor.js"]"></script>
    <script src="@Assets["js/autocomplete.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.toggleMobileSidebar = function() {
            document.getElementById('page-root').classList.toggle('mobile-sidebar-open');
        };
        window.closeMobileSidebar = function() {
            document.getElementById('page-root').classList.remove('mobile-sidebar-open');
        };
        window.toggleSidebar = function() {
            var page = document.querySelector('.page');
            if (!page) return;
            var collapsed = page.classList.toggle('sidebar-collapsed');
            if (collapsed) {
                document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
            } else {
                document.documentElement.removeAttribute('data-sidebar-collapsed');
            }
            localStorage.setItem('rr-sidebar-collapsed', collapsed);
        };
        if (window.rrTheme) window.rrTheme.registerEnhancedNavigationHandler();
        // Apply sidebar collapsed class after DOM is ready
        document.addEventListener('DOMContentLoaded', function() {
            if (localStorage.getItem('rr-sidebar-collapsed') === 'true') {
                var page = document.getElementById('page-root');
                if (page) page.classList.add('sidebar-collapsed');
            }
        });
        // Auto-init resizable table columns on DOM changes (Blazor navigations)
        var _resizeInitPending = false;
        function scheduleResizableColumnsInit() {
            if (_resizeInitPending) return;
            _resizeInitPending = true;
            requestAnimationFrame(function() {
                _resizeInitPending = false;
                if (window.rrResizableColumns) window.rrResizableColumns.init();
            });
        }
        var _resizeObserver = new MutationObserver(function() {
            scheduleResizableColumnsInit();
        });
        _resizeObserver.observe(document.body, { childList: true, subtree: true });
        scheduleResizableColumnsInit();
    </script>
</body>

</html>
