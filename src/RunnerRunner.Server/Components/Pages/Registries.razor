@page "/registries"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Hub
@using RunnerRunner.Core.Models
@using RunnerRunner.Server.Services
@using RunnerHost = RunnerRunner.Core.Models.Host
@inject IDocumentStore Store
@inject IRegistryCatalogService RegistryCatalog
@inject IHostCommandDispatcher HostCommandDispatcher
@inject IJSRuntime JS

<PageTitle>Registries - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-boxes"></i> Registries</h1>
        <span class="page-desc">Store container registries, browse images and tags, and launch pulls to hosts.</span>
    </div>
</SectionContent>

<div class="registries-workspace images-workspace logs-workspace">
    <aside id="registries-sidebar" class="logs-source-panel registries-source-panel" aria-label="Registries">
        <div class="logs-source-panel-header">
            <span><i class="bi bi-boxes"></i> Registries</span>
            <span class="badge bg-secondary">@registries.Count</span>
        </div>

        <div class="registries-sidebar-cta">
            <button class="btn btn-primary btn-sm w-100" @onclick="ShowCreateRegistry">
                <i class="bi bi-plus-lg me-1"></i> Add Registry
            </button>
        </div>

        <div class="logs-source-search">
            <i class="bi bi-search"></i>
            <input type="search"
                   class="form-control"
                   placeholder="Filter registries..."
                   aria-label="Filter registries"
                   @bind="registryFilter"
                   @bind:event="oninput" />
        </div>

        <div class="logs-source-list">
            @if (!FilteredRegistries.Any())
            {
                <div class="p-3 text-muted small">
                    No registries match the current filter.
                </div>
            }
            else
            {
                @foreach (var group in FilteredRegistries.GroupBy(r => r.RegistryType).OrderBy(g => RegistryTypeOrder(g.Key)))
                {
                    <div class="sidebar-section-header">
                        <span><i class="bi @GetRegistryTypeIcon(group.Key)"></i> @GetRegistryTypeTitle(group.Key)</span>
                        <span class="badge bg-secondary">@group.Count()</span>
                    </div>
                    @foreach (var registry in group.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                    {
                        <button type="button"
                                class="log-source-card registry-source-card @(selectedRegistryId == registry.Id ? "active" : "")"
                                @onclick="() => SelectRegistry(registry.Id)">
                            <span class="log-source-title">
                                <i class="bi @GetRegistryTypeIcon(registry.RegistryType)"></i>
                                <span class="text-truncate">@registry.Name</span>
                                @if (registry.IsDefault)
                                {
                                    <span class="log-source-count">Default</span>
                                }
                            </span>
                            <small class="text-truncate">@registry.RegistryUrl</small>
                            <span class="registry-source-badges">
                                <span class="badge bg-secondary">@registry.RegistryType</span>
                                <span class="badge @(string.IsNullOrWhiteSpace(registry.Username) ? "bg-secondary" : "bg-success")">
                                    @(string.IsNullOrWhiteSpace(registry.Username) ? "No auth" : "Auth")
                                </span>
                            </span>
                        </button>
                    }
                }
            }
        </div>
    </aside>

    <div id="registries-resize-handle" class="split-resize-handle"></div>

    <section class="images-main-panel registries-main-panel" aria-label="Registry browser">
        @if (GetSelectedRegistry() is not RegistryCredential selectedRegistry)
        {
            <div class="images-empty-state">
                <span class="empty-state-icon"><i class="bi bi-boxes" aria-hidden="true"></i></span>
                <h3>Select a registry</h3>
                <p>Choose a registry from the sidebar or add a new one to start browsing images.</p>
            </div>
        }
        else
        {
            <div class="images-toolbar registries-toolbar">
                <div class="images-toolbar-title">
                    <div class="images-toolbar-heading">
                        <i class="bi @GetRegistryTypeIcon(selectedRegistry.RegistryType)"></i>
                        <strong>@selectedRegistry.Name</strong>
                        @if (selectedRegistry.IsDefault)
                        {
                            <span class="logs-console-meta">Default</span>
                        }
                        <span class="logs-console-meta">@selectedRegistry.RegistryType</span>
                    </div>
                    <p>
                        <code>@selectedRegistry.RegistryUrl</code>
                        @if (!string.IsNullOrWhiteSpace(selectedRegistry.DefaultNamespace))
                        {
                            <span> · Namespace <code>@selectedRegistry.DefaultNamespace</code></span>
                        }
                        <span> · @(string.IsNullOrWhiteSpace(selectedRegistry.Username) ? "No authentication" : "Authenticated")</span>
                    </p>
                </div>
                <div class="images-toolbar-actions">
                    <button class="btn btn-outline-primary btn-sm" @onclick="() => EditRegistry(selectedRegistry)">
                        <i class="bi bi-pencil-square"></i> Edit
                    </button>
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmAndDeleteRegistry(selectedRegistry)">
                        <i class="bi bi-trash3"></i> Delete
                    </button>
                </div>
            </div>

            <div class="images-content-card registries-content-card registries-search-card">
                <div class="images-filter-row registries-search-row">
                    <div>
                        <label class="form-label">@GetSearchLabel()</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input class="form-control" @bind="searchText" @bind:event="oninput"
                                   placeholder="@GetSearchPlaceholder()" />
                            <button class="btn btn-primary" @onclick="SearchAsync" disabled="@searchInProgress">
                                @if (searchInProgress)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                }
                                Search
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(searchStatus))
                    {
                        <span class="small @(searchIsError ? "text-danger" : "text-muted")">@searchStatus</span>
                    }
                </div>
                <div class="registries-help-text">@GetSearchHelpText()</div>
            </div>

            <div class="images-content-card registries-content-card">
                <div class="registries-card-header">
                    <div>
                        <h2>Repositories</h2>
                        <p>Search results from @selectedRegistry.RegistryUrl.</p>
                    </div>
                    @if (searchResults.FromCache)
                    {
                        <span class="badge bg-secondary">Cached</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(searchResults.Warning))
                {
                    <div class="alert alert-warning mx-3 mt-3">@searchResults.Warning</div>
                }

                @if (!string.IsNullOrWhiteSpace(searchResults.InfoMessage))
                {
                    <div class="alert alert-secondary mx-3 mt-3">@searchResults.InfoMessage</div>
                }

                @if (!searchResults.Results.Any())
                {
                    <div class="images-empty-state images-empty-state-compact">
                        <span class="empty-state-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <h3>Search a registry</h3>
                        <p>Search to see matching repositories.</p>
                    </div>
                }
                else
                {
                    <div class="images-table-wrap registries-table-wrap">
                        <div class="table-responsive">
                            <table class="table table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th data-col-kind="name" data-col-min="180" data-col-preferred="280" data-col-weight="3.5">Repository</th>
                                        <th data-col-kind="description" data-col-min="180" data-col-preferred="300" data-col-priority="4" data-col-weight="2">Description</th>
                                        <th data-col-kind="compact" data-col-min="70" data-col-preferred="88" data-col-priority="4">Stars</th>
                                        <th class="actions-col" data-col-min="92" data-col-preferred="112"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var result in searchResults.Results)
                                    {
                                        <tr class="@(selectedRepository == result.Name ? "table-primary" : "")">
                                            <td class="name-cell"><code class="primary-label">@result.Name</code></td>
                                            <td>@(string.IsNullOrWhiteSpace(result.Description) ? "—" : result.Description)</td>
                                            <td>@(result.StarCount?.ToString() ?? "—")</td>
                                            <td class="actions-cell">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectRepositoryAsync(result.Name)">
                                                    View tags
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedRepository))
            {
                <div class="images-content-card registries-content-card">
                    <div class="registries-card-header">
                        <div>
                            <h2>Tags for <code>@selectedRepository</code></h2>
                            <p>Choose a version to inspect host cache status or pull it now.</p>
                        </div>
                        @if (tagResults.FromCache)
                        {
                            <span class="badge bg-secondary">Cached</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(tagResults.Warning))
                    {
                        <div class="alert alert-warning mx-3 mt-3">@tagResults.Warning</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(tagResults.InfoMessage))
                    {
                        <div class="alert alert-secondary mx-3 mt-3">@tagResults.InfoMessage</div>
                    }

                    @if (!tagResults.Tags.Any())
                    {
                        <div class="images-empty-state images-empty-state-compact">
                            <span class="empty-state-icon"><i class="bi bi-tags" aria-hidden="true"></i></span>
                            <h3>No tags loaded</h3>
                            <p>No tags are available for this repository yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="images-table-wrap registries-table-wrap">
                            <div class="table-responsive">
                                <table class="table table-striped align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th data-col-kind="name" data-col-min="140" data-col-preferred="220" data-col-weight="3">Tag</th>
                                            <th data-col-kind="compact" data-col-min="82" data-col-preferred="100" data-col-priority="2">Size</th>
                                            <th data-col-kind="time" data-col-min="108" data-col-preferred="132" data-col-priority="4">Updated</th>
                                            <th data-col-kind="optional" data-col-min="92" data-col-preferred="116" data-col-priority="4">Cached on</th>
                                            <th class="actions-col" data-col-min="144" data-col-preferred="172"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var tag in tagResults.Tags)
                                        {
                                            var cachedCount = CountCachedHosts(tag.Name);
                                            <tr class="@(selectedTag == tag.Name ? "table-primary" : "")">
                                                <td class="name-cell"><span class="badge bg-secondary primary-label">@tag.Name</span></td>
                                                <td>@FormatSize(tag.SizeBytes)</td>
                                                <td>@FormatDateTime(tag.UpdatedAt)</td>
                                                <td>@cachedCount host(s)</td>
                                                <td class="actions-cell">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectTagAsync(tag.Name)">
                                                        Cache status
                                                    </button>
                                                    <button class="btn btn-sm btn-primary" @onclick="() => OpenPullDialog(tag.Name)">
                                                        Pull
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(selectedTag))
            {
                <div class="images-content-card registries-content-card">
                    <div class="registries-card-header">
                        <div>
                            <h2>Cached on hosts</h2>
                            <p>Best-effort inventory from each host's last reported image list.</p>
                        </div>
                    </div>

                    @if (!hostPresence.Any())
                    {
                        <div class="images-empty-state images-empty-state-compact">
                            <span class="empty-state-icon"><i class="bi bi-hdd-network" aria-hidden="true"></i></span>
                            <h3>No cache data</h3>
                            <p>No cached presence information is available yet for <code>@selectedRepository:@selectedTag</code>.</p>
                        </div>
                    }
                    else
                    {
                        <div class="images-table-wrap registries-table-wrap">
                            <div class="table-responsive">
                                <table class="table table-striped align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th data-col-kind="name" data-col-min="170" data-col-preferred="260" data-col-weight="3.5">Host</th>
                                            <th data-col-kind="related" data-col-min="110" data-col-preferred="150" data-col-priority="4">Group</th>
                                            <th data-col-kind="compact" data-col-min="92" data-col-preferred="112" data-col-priority="2">Status</th>
                                            <th data-col-kind="compact" data-col-min="82" data-col-preferred="100" data-col-priority="3">Cached?</th>
                                            <th data-col-kind="time" data-col-min="108" data-col-preferred="132" data-col-priority="4">Last reported</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var presence in hostPresence.OrderByDescending(x => x.HasImage).ThenBy(x => x.HostLabel, StringComparer.OrdinalIgnoreCase))
                                        {
                                            <tr>
                                                <td class="name-cell">
                                                    <span class="primary-label">@presence.HostLabel</span>
                                                    <small class="secondary-label">@presence.HostName</small>
                                                </td>
                                                <td>@(string.IsNullOrWhiteSpace(presence.GroupId) ? "—" : presence.GroupId)</td>
                                                <td><span class="badge @GetStatusBadge(presence.AgentStatus)">@presence.AgentStatus</span></td>
                                                <td>
                                                    <span class="badge @(presence.HasImage ? "bg-success" : "bg-secondary")">
                                                        @(presence.HasImage ? "Yes" : "No")
                                                    </span>
                                                </td>
                                                <td>@FormatDateTime(presence.LastReportedAt)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(actionStatus))
            {
                <div class="alert @(actionIsError ? "alert-danger" : "alert-success")">
                    @actionStatus
                </div>
            }
        }
    </section>
</div>

@if (showRegistryForm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block rr-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="registry-form-title" @onclick="CloseRegistryForm">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 id="registry-form-title" class="modal-title">
                            <i class="bi bi-boxes me-2"></i>@(isEditingRegistry ? "Edit" : "Add") Registry
                        </h5>
                        <div class="modal-kicker">Store registry connection details and optional authentication in a focused dialog.</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseRegistryForm" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (actionIsError && !string.IsNullOrWhiteSpace(actionStatus))
                    {
                        <div class="alert alert-danger py-2">@actionStatus</div>
                    }

                    <div class="rr-form-section">
                        <div class="rr-form-section-title"><i class="bi bi-info-circle"></i> Registry details</div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Name</label>
                                <input class="form-control" @bind="editRegistry.Name" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Registry URL</label>
                                <input class="form-control" @bind="editRegistry.RegistryUrl" placeholder="ghcr.io" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" @bind="editRegistry.RegistryType">
                                    @foreach (var t in Enum.GetValues<RegistryType>())
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Default namespace / owner</label>
                                <input class="form-control" @bind="editRegistry.DefaultNamespace" placeholder="e.g., redth or my-org" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="editRegistry.IsDefault" id="registryDefaultCheck" />
                                    <label class="form-check-label" for="registryDefaultCheck">Use as default registry</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rr-form-section">
                        <div class="rr-form-section-title"><i class="bi bi-shield-lock"></i> Authentication</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Username</label>
                                <input class="form-control" @bind="editRegistry.Username" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Password / Token</label>
                                <input type="password" class="form-control" @bind="editRegistry.Password" autocomplete="off" />
                                <div class="form-text">Leave blank for public registries or hosts that already have credentials configured.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseRegistryForm">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveRegistry">
                        <i class="bi bi-check2 me-1"></i>Save registry
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showPullDialog && GetSelectedRegistry() is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.45);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pull <code>@selectedRepository:@selectedTag</code></h5>
                    <button type="button" class="btn-close" @onclick="ClosePullDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Targeting mode</label>
                        <select class="form-select" @bind="pullTargetMode">
                            <option value="group">Host group</option>
                            <option value="host">Specific host</option>
                        </select>
                    </div>

                    @if (pullTargetMode == "group")
                    {
                        <div class="mb-3">
                            <label class="form-label">Host group</label>
                            <select class="form-select" @bind="selectedGroupId">
                                <option value="">Select a host group</option>
                                @foreach (var group in GetAvailableGroups())
                                {
                                    <option value="@group">@group (@GetGroupMatchCount(group) online)</option>
                                }
                            </select>
                            @if (!GetAvailableGroups().Any())
                            {
                                <div class="form-text text-warning">No host groups are defined yet. You can set Group ID values on the Hosts page.</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Filter hosts</label>
                            <input class="form-control" @bind="hostFilterText" @bind:event="oninput" placeholder="Search by name, display name, group, or capability" />
                        </div>

                        <div class="list-group host-pick-list">
                            @foreach (var host in GetFilteredHosts())
                            {
                                <label class="list-group-item list-group-item-action">
                                    <input class="form-check-input me-2" type="radio" name="pullHost"
                                           checked="@(selectedPullHostId == host.Id)"
                                           @onchange='() => selectedPullHostId = host.Id' />
                                    <span class="fw-semibold">@host.Label</span>
                                    <small class="text-muted ms-1">@host.Name</small>
                                    <span class="badge @GetStatusBadge(host.AgentStatus) ms-2">@host.AgentStatus</span>
                                    @if (!string.IsNullOrWhiteSpace(host.GroupId))
                                    {
                                        <span class="badge bg-secondary ms-2">@host.GroupId</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePullDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="ExecutePullAsync" disabled="@pullRequestInProgress">
                        @if (pullRequestInProgress)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Request Pull
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RegistryCredential> registries = [];
    private List<RunnerHost> hosts = [];
    private string selectedRegistryId = "";
    private string registryFilter = "";

    private RegistryCredential editRegistry = new() { Name = "", RegistryUrl = "" };
    private bool showRegistryForm;
    private bool isEditingRegistry;

    private string searchText = "";
    private bool searchInProgress;
    private bool searchIsError;
    private string searchStatus = "";
    private RegistrySearchResponse searchResults = new();

    private string selectedRepository = "";
    private string selectedTag = "";
    private RegistryTagResponse tagResults = new();
    private List<HostPresenceRow> hostPresence = [];
    private Dictionary<string, int> cachedHostCounts = new(StringComparer.OrdinalIgnoreCase);

    private bool showPullDialog;
    private string pullTargetMode = "group";
    private string selectedGroupId = "";
    private string selectedPullHostId = "";
    private string hostFilterText = "";
    private bool pullRequestInProgress;

    private string actionStatus = "";
    private bool actionIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync("rrSplitPane.init", "registries-resize-handle", "registries-sidebar", "rr-registries-sidebar-width-v2", 220, 420);
    }

    private async Task LoadPageDataAsync()
    {
        registries = (await Store.Query<RegistryCredential>().ToList()).OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase).ToList();
        hosts = (await Store.Query<RunnerHost>().ToList()).OrderBy(h => h.Label, StringComparer.OrdinalIgnoreCase).ToList();

        if (string.IsNullOrWhiteSpace(selectedRegistryId) && registries.Any())
            selectedRegistryId = registries[0].Id;
        else if (!registries.Any())
            selectedRegistryId = "";
    }

    private RegistryCredential? GetSelectedRegistry() =>
        registries.FirstOrDefault(r => r.Id == selectedRegistryId);

    private IEnumerable<RegistryCredential> FilteredRegistries
    {
        get
        {
            if (string.IsNullOrWhiteSpace(registryFilter))
                return registries;

            var query = registryFilter.Trim();
            return registries.Where(r =>
                r.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                || r.RegistryUrl.Contains(query, StringComparison.OrdinalIgnoreCase)
                || r.RegistryType.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(r.DefaultNamespace) && r.DefaultNamespace.Contains(query, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(r.Username) && r.Username.Contains(query, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private void SelectRegistry(string id)
    {
        selectedRegistryId = id;
        showRegistryForm = false;
        searchText = "";
        searchStatus = "";
        searchIsError = false;
        searchResults = new();
        selectedRepository = "";
        selectedTag = "";
        tagResults = new();
        hostPresence = [];
        cachedHostCounts = new(StringComparer.OrdinalIgnoreCase);
        actionStatus = "";
    }

    private void ShowCreateRegistry()
    {
        editRegistry = new RegistryCredential { Name = "", RegistryUrl = "" };
        isEditingRegistry = false;
        actionIsError = false;
        actionStatus = "";
        showRegistryForm = true;
    }

    private void EditRegistry(RegistryCredential reg)
    {
        editRegistry = new RegistryCredential
        {
            Id = reg.Id,
            Name = reg.Name,
            RegistryUrl = reg.RegistryUrl,
            RegistryType = reg.RegistryType,
            DefaultNamespace = reg.DefaultNamespace,
            Username = reg.Username,
            Password = reg.Password,
            IsDefault = reg.IsDefault,
            CreatedAt = reg.CreatedAt,
            UpdatedAt = reg.UpdatedAt
        };
        isEditingRegistry = true;
        actionIsError = false;
        actionStatus = "";
        showRegistryForm = true;
    }

    private void CloseRegistryForm()
    {
        showRegistryForm = false;
        if (actionIsError)
        {
            actionIsError = false;
            actionStatus = "";
        }
    }

    private async Task SaveRegistry()
    {
        if (string.IsNullOrWhiteSpace(editRegistry.Name) || string.IsNullOrWhiteSpace(editRegistry.RegistryUrl))
        {
            actionIsError = true;
            actionStatus = "Registry name and URL are required.";
            return;
        }

        editRegistry.UpdatedAt = DateTime.UtcNow;
        if (isEditingRegistry)
            await Store.Update(editRegistry);
        else
            await Store.Insert(editRegistry);

        await LoadPageDataAsync();
        selectedRegistryId = editRegistry.Id;
        showRegistryForm = false;
        actionIsError = false;
        actionStatus = $"Saved registry '{editRegistry.Name}'.";
    }

    private async Task ConfirmAndDeleteRegistry(RegistryCredential reg)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete registry credential '{reg.Name}'?");
        if (!confirmed)
            return;

        await Store.Remove<RegistryCredential>(reg.Id);
        await LoadPageDataAsync();
        searchResults = new();
        tagResults = new();
        selectedRepository = "";
        selectedTag = "";
        hostPresence = [];
        cachedHostCounts = new(StringComparer.OrdinalIgnoreCase);
        actionIsError = false;
        actionStatus = $"Deleted registry '{reg.Name}'.";
    }

    private async Task SearchAsync()
    {
        var registry = GetSelectedRegistry();
        if (registry == null)
            return;

        searchInProgress = true;
        searchIsError = false;
        searchStatus = "Searching registry...";
        searchResults = await RegistryCatalog.SearchRepositoriesAsync(registry, searchText);
        searchInProgress = false;
        searchIsError = !string.IsNullOrWhiteSpace(searchResults.Warning);
        searchStatus = searchResults.FromCache ? "Showing cached search results." : "";
    }

    private async Task SelectRepositoryAsync(string repository)
    {
        var registry = GetSelectedRegistry();
        if (registry == null)
            return;

        selectedRepository = repository;
        selectedTag = "";
        hostPresence = [];
        await LoadCachedHostCountsAsync();
        tagResults = await RegistryCatalog.GetTagsAsync(registry, repository);
        if (tagResults.Tags.Any())
            await SelectTagAsync(tagResults.Tags[0].Name);
    }

    private async Task LoadCachedHostCountsAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedRepository))
        {
            cachedHostCounts = new(StringComparer.OrdinalIgnoreCase);
            return;
        }

        var images = (await Store.Query<AgentImage>().ToList()).ToList();
        cachedHostCounts = images
            .Where(i => RepositoriesMatch(i.Repository, selectedRepository) && !string.IsNullOrWhiteSpace(i.Tag))
            .GroupBy(i => i.Tag!, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.Select(i => i.HostId).Distinct(StringComparer.OrdinalIgnoreCase).Count(), StringComparer.OrdinalIgnoreCase);
    }

    private async Task SelectTagAsync(string tag)
    {
        selectedTag = tag;
        await LoadHostPresenceAsync();
    }

    private async Task LoadHostPresenceAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedRepository) || string.IsNullOrWhiteSpace(selectedTag))
        {
            hostPresence = [];
            return;
        }

        hosts = (await Store.Query<RunnerHost>().ToList()).OrderBy(h => h.Label, StringComparer.OrdinalIgnoreCase).ToList();
        var images = (await Store.Query<AgentImage>().ToList()).ToList();

        hostPresence = hosts.Select(host =>
        {
            var matchingImages = images
                .Where(i => i.HostId == host.Id &&
                            string.Equals(i.Tag, selectedTag, StringComparison.OrdinalIgnoreCase) &&
                            RepositoriesMatch(i.Repository, selectedRepository))
                .OrderByDescending(i => i.LastReportedAt)
                .ToList();

            return new HostPresenceRow
            {
                HostId = host.Id,
                HostName = host.Name,
                HostLabel = host.Label,
                GroupId = host.GroupId,
                AgentStatus = host.AgentStatus,
                HasImage = matchingImages.Any(),
                LastReportedAt = matchingImages.FirstOrDefault()?.LastReportedAt
            };
        }).ToList();
    }

    private int CountCachedHosts(string tag) =>
        cachedHostCounts.TryGetValue(tag, out var count) ? count : 0;

    private void OpenPullDialog(string tag)
    {
        selectedTag = tag;
        showPullDialog = true;
        pullTargetMode = GetAvailableGroups().Any() ? "group" : "host";
        selectedGroupId = GetAvailableGroups().FirstOrDefault() ?? "";
        selectedPullHostId = GetFilteredHosts().FirstOrDefault()?.Id ?? "";
        hostFilterText = "";
    }

    private void ClosePullDialog()
    {
        showPullDialog = false;
        pullRequestInProgress = false;
    }

    private async Task ExecutePullAsync()
    {
        var registry = GetSelectedRegistry();
        if (registry == null || string.IsNullOrWhiteSpace(selectedRepository) || string.IsNullOrWhiteSpace(selectedTag))
            return;

        var targetHosts = pullTargetMode == "group"
            ? hosts.Where(h =>
                    h.AgentStatus == AgentStatus.Online &&
                    SupportsRegistryType(h, registry.RegistryType) &&
                    !string.IsNullOrWhiteSpace(selectedGroupId) &&
                    string.Equals(h.GroupId, selectedGroupId, StringComparison.OrdinalIgnoreCase))
                .ToList()
            : hosts.Where(h => h.AgentStatus == AgentStatus.Online && h.Id == selectedPullHostId).ToList();

        if (!targetHosts.Any())
        {
            actionIsError = true;
            actionStatus = pullTargetMode == "group"
                ? "No online hosts matched the selected group."
                : "Select an online host before requesting the pull.";
            return;
        }

        var requested = 0;
        var failures = new List<string>();
        pullRequestInProgress = true;

        try
        {
            foreach (var host in targetHosts)
            {
                try
                {
                    await HostCommandDispatcher.DispatchPullImageAsync(host.Id, new PullImageCommand
                    {
                        ImageType = registry.RegistryType == RegistryType.Tart ? ImageType.Tart : ImageType.Docker,
                        ImageName = selectedRepository,
                        Tag = selectedTag,
                        RegistryUrl = registry.RegistryUrl,
                        Username = registry.Username,
                        Password = registry.Password
                    });

                    requested++;
                }
                catch (Exception ex)
                {
                    failures.Add($"{host.Label}: {ex.Message}");
                }
            }
        }
        finally
        {
            pullRequestInProgress = false;
        }

        if (requested > 0)
            showPullDialog = false;

        actionIsError = requested == 0 || failures.Count > 0;
        actionStatus = failures.Count > 0
            ? requested == 0
                ? $"Unable to request pull: {string.Join("; ", failures)}"
                : $"Requested pull of {selectedRepository}:{selectedTag} on {requested} host(s), but {failures.Count} host(s) failed: {string.Join("; ", failures)}"
            : requested == 0
            ? "No online hosts were available for that pull request."
            : $"Requested pull of {selectedRepository}:{selectedTag} on {requested} host(s).";
    }

    private IEnumerable<string> GetAvailableGroups() =>
        hosts
            .Where(h => h.AgentStatus == AgentStatus.Online &&
                        SupportsRegistryType(h, GetSelectedRegistry()?.RegistryType) &&
                        !string.IsNullOrWhiteSpace(h.GroupId))
            .Select(h => h.GroupId!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase);

    private int GetGroupMatchCount(string groupId) =>
        hosts.Count(h => h.AgentStatus == AgentStatus.Online &&
                         SupportsRegistryType(h, GetSelectedRegistry()?.RegistryType) &&
                         string.Equals(h.GroupId, groupId, StringComparison.OrdinalIgnoreCase));

    private List<RunnerHost> GetFilteredHosts()
    {
        IEnumerable<RunnerHost> result = hosts.Where(h => h.AgentStatus == AgentStatus.Online &&
                                                          SupportsRegistryType(h, GetSelectedRegistry()?.RegistryType));

        if (!string.IsNullOrWhiteSpace(hostFilterText))
        {
            var q = hostFilterText.Trim();
            result = result.Where(h =>
                h.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                h.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(h.GroupId) && h.GroupId.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                h.Capabilities.Any(c => c.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        return result.OrderByDescending(h => h.AgentStatus == AgentStatus.Online)
            .ThenBy(h => h.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static bool SupportsRegistryType(RunnerHost host, RegistryType? type) => type switch
    {
        RegistryType.Tart => host.Platform == HostPlatform.MacOS ||
                             host.Capabilities.Any(c => c.Contains("tart", StringComparison.OrdinalIgnoreCase)),
        _ => true
    };

    private string GetSearchLabel() =>
        IsGhcrSelected() ? "Search GHCR images" : "Search repositories";

    private string GetSearchPlaceholder() =>
        IsGhcrSelected()
            ? string.IsNullOrWhiteSpace(GetSelectedRegistry()?.DefaultNamespace)
                ? "owner/image or owner/partial-name"
                : $"image name or {GetSelectedRegistry()!.DefaultNamespace}/image"
            : "ubuntu, org/image, repo/path, ...";

    private string GetSearchHelpText()
    {
        if (IsGhcrSelected())
        {
            return string.IsNullOrWhiteSpace(GetSelectedRegistry()?.DefaultNamespace)
                ? "GHCR search is owner-scoped through GitHub Packages. Search as 'owner/image', or set a default namespace / owner above."
                : $"GHCR search uses GitHub Packages under '{GetSelectedRegistry()!.DefaultNamespace}'. You can search by just the image name or by full owner/image path.";
        }

        return "Search support is best-effort and depends on what the registry exposes. Cached results may be shown when available.";
    }

    private bool IsGhcrSelected() =>
        IsGhcrRegistry(GetSelectedRegistry()?.RegistryUrl);

    private static int RegistryTypeOrder(RegistryType type) => type switch
    {
        RegistryType.Docker => 0,
        RegistryType.Tart => 1,
        _ => 2
    };

    private static string GetRegistryTypeIcon(RegistryType type) => type switch
    {
        RegistryType.Tart => "bi-apple",
        _ => "bi-box"
    };

    private static string GetRegistryTypeTitle(RegistryType type) => type switch
    {
        RegistryType.Tart => "Tart OCI",
        RegistryType.Docker => "Docker",
        _ => type.ToString()
    };

    private static bool IsGhcrRegistry(string? registryUrl)
    {
        var value = (registryUrl ?? "").ToLowerInvariant();
        return value.Contains("ghcr.io");
    }

    private static bool RepositoriesMatch(string? cachedRepository, string selectedRepository)
    {
        if (string.IsNullOrWhiteSpace(cachedRepository))
            return false;

        var left = NormalizeRepo(cachedRepository);
        var right = NormalizeRepo(selectedRepository);

        return string.Equals(left, right, StringComparison.OrdinalIgnoreCase) ||
               string.Equals(left, $"library/{right}", StringComparison.OrdinalIgnoreCase) ||
               string.Equals($"library/{left}", right, StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeRepo(string repository)
    {
        var value = repository.Trim().Trim('/').ToLowerInvariant();
        foreach (var prefix in new[] { "docker.io/", "registry-1.docker.io/", "index.docker.io/" })
        {
            if (value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                return value[prefix.Length..];
        }
        return value;
    }

    private static string GetStatusBadge(AgentStatus status) => status switch
    {
        AgentStatus.Online => "bg-success",
        AgentStatus.Connecting => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private static string FormatSize(long? bytes)
    {
        if (!bytes.HasValue || bytes.Value <= 0) return "—";
        if (bytes.Value < 1024) return $"{bytes.Value} B";
        if (bytes.Value < 1024 * 1024) return $"{bytes.Value / 1024.0:F1} KB";
        if (bytes.Value < 1024 * 1024 * 1024) return $"{bytes.Value / (1024.0 * 1024):F1} MB";
        return $"{bytes.Value / (1024.0 * 1024 * 1024):F1} GB";
    }

    private static string FormatDateTime(DateTimeOffset? value) =>
        value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm") : "—";

    private static string FormatDateTime(DateTime? value) =>
        value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm") : "—";

    private sealed class HostPresenceRow
    {
        public string HostId { get; set; } = "";
        public string HostName { get; set; } = "";
        public string HostLabel { get; set; } = "";
        public string? GroupId { get; set; }
        public AgentStatus AgentStatus { get; set; }
        public bool HasImage { get; set; }
        public DateTime? LastReportedAt { get; set; }
    }
}
