@page "/runners"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using Microsoft.AspNetCore.SignalR
@using RunnerRunner.Server.Hubs
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Grains.Events
@using RunnerRunner.Server.Services
@inject IDocumentStore Store
@inject IHubContext<AgentHub, IAgentHubClient> HubContext
@inject IJSRuntime JS
@inject IGrainFactory GrainFactory
@implements IDisposable

<PageTitle>Runner Instances - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-lightning-charge-fill"></i> Runner Instances</h1>
        <span class="page-desc">View and manage runners across connected hosts.</span>
    </div>
</SectionContent>

<div class="mb-3 d-flex flex-wrap align-items-end gap-2">
    <div>
        <label class="form-label mb-0 small text-muted">Search</label>
        <input type="text" class="form-control form-control-sm" placeholder="Filter runners…" @bind="searchText" @bind:event="oninput" style="min-width:180px;" />
    </div>
    <div>
        <label class="form-label mb-0 small text-muted">Status</label>
        <select class="form-select form-select-sm" @bind="filterStatus" style="min-width:120px;">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<RunnerInstanceStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label mb-0 small text-muted">Host</label>
        <select class="form-select form-select-sm" @bind="filterHostId" style="min-width:140px;">
            <option value="">All</option>
            @foreach (var kv in hostNames.OrderBy(h => h.Value))
            {
                <option value="@kv.Key">@kv.Value</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label mb-0 small text-muted">Profile</label>
        <select class="form-select form-select-sm" @bind="filterProfileId" style="min-width:140px;">
            <option value="">All</option>
            @foreach (var kv in profileNames.OrderBy(p => p.Value))
            {
                <option value="@kv.Key">@kv.Value</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label mb-0 small text-muted">Mode</label>
        <select class="form-select form-select-sm" @bind="filterMode" style="min-width:120px;">
            <option value="">All</option>
            <option value="static">Static</option>
            <option value="dynamic">Dynamic</option>
        </select>
    </div>
    <div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </div>
</div>

@{
    var filtered = GetFilteredInstances();
    var groups = filtered.GroupBy(i => i.HostId)
        .OrderBy(g => validHostIds.Contains(g.Key) ? 1 : 0)  // orphans first
        .ThenBy(g => hostNames.GetValueOrDefault(g.Key, g.Key))
        .ToList();
}

@if (!groups.Any())
{
    <div class="text-center text-muted py-4">No runner instances match the current filters.</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped resizable-table">
        <thead>
            <tr>
                <th role="button" @onclick='() => SetSort("RunnerName")' style="cursor:pointer; user-select:none;">Runner Name @SortIndicator("RunnerName")</th>
                <th role="button" @onclick='() => SetSort("Profile")' style="cursor:pointer; user-select:none;">Profile @SortIndicator("Profile")</th>
                <th role="button" @onclick='() => SetSort("Status")' style="cursor:pointer; user-select:none;">Status @SortIndicator("Status")</th>
                <th role="button" @onclick='() => SetSort("Mode")' style="cursor:pointer; user-select:none;">Mode @SortIndicator("Mode")</th>
                <th role="button" @onclick='() => SetSort("Started")' style="cursor:pointer; user-select:none;">Started @SortIndicator("Started")</th>
                <th role="button" @onclick='() => SetSort("LastHealthCheck")' style="cursor:pointer; user-select:none;">Last Health Check @SortIndicator("LastHealthCheck")</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in groups)
            {
                var hostId = group.Key;
                var isOrphan = !validHostIds.Contains(hostId);
                var hostLabel = isOrphan ? "⚠ Orphaned Runners" : hostNames.GetValueOrDefault(hostId, hostId);
                var isExpanded = expandedHosts.Contains(hostId);
                var sorted = ApplySort(group).ToList();

                <tr class="group-header @(isOrphan ? "group-orphaned" : "")" role="button" @onclick="() => ToggleHost(hostId)" style="cursor:pointer; user-select:none;">
                    <td colspan="7">
                        <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") me-2"></i>
                        <strong>@hostLabel</strong>
                        <span class="badge @(isOrphan ? "bg-danger" : "bg-primary") ms-2">@sorted.Count</span>
                        @if (isOrphan)
                        {
                            <button class="btn btn-sm btn-outline-danger ms-2" @onclick:stopPropagation="true" @onclick="() => ConfirmAndRemoveOrphans(sorted)">
                                <i class="bi bi-trash3 me-1"></i>Remove All
                            </button>
                        }
                    </td>
                </tr>
                @if (isExpanded)
                {
                    @foreach (var inst in sorted)
                    {
                        <tr>
                            <td>@inst.RunnerName</td>
                            <td>@(profileNames.GetValueOrDefault(inst.ProfileId, inst.ProfileId))</td>
                            <td>
                                <span class="badge @GetStatusBadge(inst.Status)">@inst.Status</span>
                                @if (!string.IsNullOrEmpty(inst.StatusMessage))
                                {
                                    <br/><small class="text-muted" style="font-size: 0.7rem;">@inst.StatusMessage</small>
                                }
                            </td>
                            <td><span class="badge @(inst.ProvisioningMode == "dynamic" ? "bg-warning text-dark" : "bg-secondary")">@(inst.ProvisioningMode == "dynamic" ? "Dynamic" : "Static")</span></td>
                            <td>@(inst.StartedAt?.ToString("g") ?? "—")</td>
                            <td>@(inst.LastHealthCheck?.ToString("HH:mm:ss") ?? "—")</td>
                            <td>
                                <a href="/logs?source=runner:@inst.Id" class="btn btn-sm btn-outline-secondary me-1" title="View logs"><i class="bi bi-file-text"></i></a>
                                @if (!isOrphan && inst.Status is RunnerInstanceStatus.Running or RunnerInstanceStatus.Starting)
                                {
                                    <button class="btn btn-sm btn-warning" @onclick="() => StopInstance(inst)"><i class="bi bi-stop-circle"></i> Stop</button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmAndRemoveInstance(inst)">Remove</button>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
    </div>
}

<style>
    tr.group-header td {
        background: var(--bg-secondary, #f8f9fc);
        border-bottom: 2px solid var(--border-color, #e5e7eb);
        padding: 0.5rem 0.75rem;
        font-size: 0.95rem;
    }
    tr.group-header:hover td {
        background: var(--bg-tertiary, #f0f2f5);
    }
    tr.group-orphaned td {
        background: #fff3cd;
        border-bottom-color: #ffc107;
    }
    tr.group-orphaned:hover td {
        background: #ffecb5;
    }
</style>

@code {
    private List<RunnerInstance> instances = [];
    private Dictionary<string, string> hostNames = new();
    // LEGACY: Maps host IDs to agent names for AgentHub lookups. Will be removed when using HostGrain.
    private Dictionary<string, string> hostAgentNames = new();
    private HashSet<string> validHostIds = new();
    private Dictionary<string, string> profileNames = new();

    private string searchText = "";
    private string filterStatus = "";
    private string filterHostId = "";
    private string filterProfileId = "";
    private string filterMode = "";

    private string sortColumn = "Started";
    private bool sortAscending = false;

    private HashSet<string> expandedHosts = new();

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        StreamSubscriptionService.OnRunnerStatusChanged += OnStreamRunnerStatusChanged;
    }

    private void OnStreamRunnerStatusChanged(RunnerStatusChangedEvent evt)
    {
        InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
    }

    public void Dispose()
    {
        StreamSubscriptionService.OnRunnerStatusChanged -= OnStreamRunnerStatusChanged;
    }

    private async Task Refresh()
    {
        instances = (await Store.Query<RunnerInstance>().ToList()).ToList();
        var hosts = (await Store.Query<Host>().ToList()).ToList();
        var profiles = (await Store.Query<RunnerProfile>().ToList()).ToList();
        validHostIds = hosts.Select(h => h.Id).ToHashSet();
        hostNames = hosts.ToDictionary(h => h.Id, h => h.Label);
        hostAgentNames = hosts.ToDictionary(h => h.Id, h => h.Name);
        profileNames = profiles.ToDictionary(p => p.Id, p => p.Name);

        // Auto-expand all hosts that have instances
        foreach (var hostId in instances.Select(i => i.HostId).Distinct())
            expandedHosts.Add(hostId);
    }

    private IEnumerable<RunnerInstance> GetFilteredInstances()
    {
        var q = instances.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filterHostId))
            q = q.Where(i => i.HostId == filterHostId);

        if (!string.IsNullOrWhiteSpace(filterProfileId))
            q = q.Where(i => i.ProfileId == filterProfileId);

        if (!string.IsNullOrWhiteSpace(filterMode))
            q = q.Where(i => i.ProvisioningMode == filterMode);

        if (!string.IsNullOrWhiteSpace(filterStatus) && Enum.TryParse<RunnerInstanceStatus>(filterStatus, out var status))
            q = q.Where(i => i.Status == status);

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim();
            q = q.Where(i =>
                i.RunnerName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || hostNames.GetValueOrDefault(i.HostId, i.HostId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || profileNames.GetValueOrDefault(i.ProfileId, i.ProfileId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || i.Status.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return q;
    }

    private IEnumerable<RunnerInstance> ApplySort(IEnumerable<RunnerInstance> items)
    {
        return sortColumn switch
        {
            "RunnerName" => sortAscending ? items.OrderBy(i => i.RunnerName) : items.OrderByDescending(i => i.RunnerName),
            "Profile" => sortAscending
                ? items.OrderBy(i => profileNames.GetValueOrDefault(i.ProfileId, i.ProfileId))
                : items.OrderByDescending(i => profileNames.GetValueOrDefault(i.ProfileId, i.ProfileId)),
            "Status" => sortAscending ? items.OrderBy(i => i.Status) : items.OrderByDescending(i => i.Status),
            "Mode" => sortAscending ? items.OrderBy(i => i.ProvisioningMode) : items.OrderByDescending(i => i.ProvisioningMode),
            "Started" => sortAscending ? items.OrderBy(i => i.StartedAt ?? i.CreatedAt) : items.OrderByDescending(i => i.StartedAt ?? i.CreatedAt),
            "LastHealthCheck" => sortAscending ? items.OrderBy(i => i.LastHealthCheck) : items.OrderByDescending(i => i.LastHealthCheck),
            _ => items.OrderByDescending(i => i.StartedAt ?? i.CreatedAt)
        };
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIndicator(string column)
    {
        if (sortColumn != column) return (MarkupString)"";
        return (MarkupString)(sortAscending ? "▲" : "▼");
    }

    private void ToggleHost(string hostId)
    {
        if (!expandedHosts.Remove(hostId))
            expandedHosts.Add(hostId);
    }

    // LEGACY: Uses AgentHub to send stop commands. Will be replaced by RunnerInstanceGrain.MarkStopping()
    private async Task StopInstance(RunnerInstance inst)
    {
        var agents = AgentHub.GetConnectedAgents();
        var agentName = hostAgentNames.GetValueOrDefault(inst.HostId);
        var agent = agents.Values.FirstOrDefault(a => a.AgentInfo.Name == agentName);

        if (agent != null)
        {
            await HubContext.Clients.Client(agent.ConnectionId).StopRunner(new StopRunnerCommand
            {
                InstanceId = inst.Id,
                InstanceHandle = inst.ContainerId ?? inst.VmName ?? inst.ProcessId?.ToString()
            });

            inst.Status = RunnerInstanceStatus.Stopping;
            await Store.Update(inst);
        }

        await Refresh();
    }

    private async Task ConfirmAndRemoveInstance(RunnerInstance inst)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Remove runner instance '{inst.RunnerName}'?");
        if (confirmed) await RemoveInstance(inst.Id);
    }

    private async Task ConfirmAndRemoveOrphans(List<RunnerInstance> orphans)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Remove {orphans.Count} orphaned runner record(s)? These runners have no associated host.");
        if (!confirmed) return;
        foreach (var inst in orphans)
            await Store.Remove<RunnerInstance>(inst.Id);
        await Refresh();
    }

    private async Task RemoveInstance(string id)
    {
        await Store.Remove<RunnerInstance>(id);
        await Refresh();
    }

    private string GetStatusBadge(RunnerInstanceStatus status) => status switch
    {
        RunnerInstanceStatus.Running => "bg-success",
        RunnerInstanceStatus.Starting => "bg-info",
        RunnerInstanceStatus.Pending => "bg-secondary",
        RunnerInstanceStatus.Stopping => "bg-warning",
        RunnerInstanceStatus.Stopped => "bg-dark",
        RunnerInstanceStatus.Failed => "bg-danger",
        RunnerInstanceStatus.Crashed => "bg-danger",
        _ => "bg-secondary"
    };

    private async Task<RunnerInstanceGrainState?> GetRunnerGrainState(string instanceId)
    {
        try
        {
            var grain = GrainFactory.GetGrain<IRunnerInstanceGrain>(instanceId);
            return await grain.GetState();
        }
        catch { return null; }
    }
}
