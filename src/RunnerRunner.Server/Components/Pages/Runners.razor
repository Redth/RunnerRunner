@page "/runners"
@attribute [Authorize(Policy = RunnerRunnerPolicies.ManageJobs)]
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Grains.Events
@using RunnerRunner.Server.Services
@inject IDocumentStore Store
@inject IJSRuntime JS
@inject IGrainFactory GrainFactory
@inject CapacityPlanningService CapacityService
@inject IHostCommandDispatcher HostCommandDispatcher
@implements IDisposable

<PageTitle>Runner Instances - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-lightning-charge-fill"></i> Runner Instances</h1>
        <span class="page-desc">View Orleans-managed runners across connected hosts.</span>
    </div>
</SectionContent>

@if (capacitySnapshot.Hosts.Any())
{
    <div class="runner-capacity-overview mb-3" aria-label="Host backend capacity">
        @foreach (var hostCapacity in capacitySnapshot.Hosts.Values.OrderBy(h => h.HostLabel))
        {
            <div class="runner-host-capacity-card">
                <div class="runner-host-capacity-title">
                    <i class="bi bi-hdd-network"></i>
                    <strong>@hostCapacity.HostLabel</strong>
                </div>
                <div class="backend-capacity-row">
                    @foreach (var backendUsage in GetEnabledBackendUsage(hostCapacity))
                    {
                        var backend = backendUsage.Key;
                        var counter = backendUsage.Value;
                        <span class="backend-capacity-chip @GetBackendUsageClass(counter)"
                              title="@GetBackendUsageTitle(backend, counter)">
                            <span class="backend-capacity-meter" style="@GetBackendUsageStyle(counter)" aria-hidden="true">
                                <span></span>
                            </span>
                            <i class="bi @GetBackendIcon(backend)"></i>
                            <span class="backend-capacity-label">@GetBackendShortLabel(backend)</span>
                            <span class="backend-capacity-count">@counter.Summary</span>
                        </span>
                    }
                </div>
            </div>
        }
    </div>
}

<div class="rr-filter-panel mb-3" aria-label="Runner filters">
    <div class="rr-filter-header">
        <div class="rr-filter-panel-title">
            <i class="bi bi-funnel"></i>
            <span>Filters</span>
        </div>
        <div class="rr-filter-buttons">
            <button class="btn btn-sm rr-filter-btn rr-filter-btn-clear" @onclick="ClearFilters" disabled="@(!HasActiveFilters())">
                <i class="bi bi-eraser"></i> Clear
            </button>
            <button class="btn btn-sm rr-filter-btn rr-filter-btn-refresh" @onclick="Refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>
    <div class="rr-filter-grid">
        <div class="rr-filter-field rr-filter-field-wide">
            <label class="form-label">Search</label>
            <input type="text" class="form-control form-control-sm" placeholder="Filter runners…" @bind="searchText" @bind:event="oninput" />
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Status</label>
            <select class="form-select form-select-sm" @bind="filterStatus">
                <option value="active">Active</option>
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<RunnerInstanceStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Host</label>
            <select class="form-select form-select-sm" @bind="filterHostId">
                <option value="">All</option>
                @foreach (var kv in hostNames.OrderBy(h => h.Value))
                {
                    <option value="@kv.Key">@kv.Value</option>
                }
            </select>
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Profile</label>
            <select class="form-select form-select-sm" @bind="filterProfileId">
                <option value="">All</option>
                @foreach (var kv in profileNames.OrderBy(p => p.Value))
                {
                    <option value="@kv.Key">@kv.Value</option>
                }
            </select>
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Mode</label>
            <select class="form-select form-select-sm" @bind="filterMode">
                <option value="">All</option>
                <option value="static">Static</option>
                <option value="dynamic">Dynamic</option>
            </select>
        </div>
    </div>
</div>

@if (unmanagedHiddenCount > 0)
{
    <div class="alert alert-warning py-2 mb-3 small">
        <i class="bi bi-eye-slash me-1"></i>
        <strong>@unmanagedHiddenCount external/legacy runner @(unmanagedHiddenCount == 1 ? "entry is" : "entries are") hidden</strong>
        because RunnerRunner did not create or does not actively manage @(unmanagedHiddenCount == 1 ? "it" : "them").
    </div>
}

@{
    var filtered = GetFilteredInstances();
    var groups = filtered.GroupBy(i => i.HostId)
        .OrderBy(g => validHostIds.Contains(g.Key) ? 1 : 0)  // orphans first
        .ThenBy(g => hostNames.GetValueOrDefault(g.Key, g.Key))
        .ToList();
}

@if (!groups.Any())
{
    <div class="text-center text-muted py-4">
        @(HasActiveFilters()
            ? "No managed runner instances match the current filters."
            : "No managed runner instances are active. Use provisioning rules to launch runners.")
    </div>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped resizable-table">
        <thead>
            <tr>
                <th role="button" data-col-kind="name" data-col-min="170" data-col-preferred="250" data-col-weight="3.5" @onclick='() => SetSort("RunnerName")' style="cursor:pointer; user-select:none;">Runner Name @SortIndicator("RunnerName")</th>
                <th role="button" data-col-kind="related" data-col-min="210" data-col-preferred="280" data-col-priority="3" data-col-weight="1.4" @onclick='() => SetSort("Profile")' style="cursor:pointer; user-select:none;">Profile @SortIndicator("Profile")</th>
                <th role="button" data-col-kind="description" data-col-min="220" data-col-preferred="320" data-col-priority="2" data-col-weight="1.7" @onclick='() => SetSort("Status")' style="cursor:pointer; user-select:none;">Status @SortIndicator("Status")</th>
                <th role="button" data-col-kind="compact" data-col-min="76" data-col-preferred="96" data-col-priority="4" @onclick='() => SetSort("Mode")' style="cursor:pointer; user-select:none;">Mode @SortIndicator("Mode")</th>
                <th role="button" data-col-kind="time" data-col-min="108" data-col-preferred="130" data-col-priority="3" @onclick='() => SetSort("Started")' style="cursor:pointer; user-select:none;">Started @SortIndicator("Started")</th>
                <th role="button" data-col-kind="time" data-col-min="104" data-col-preferred="126" data-col-priority="4" @onclick='() => SetSort("LastHealthCheck")' style="cursor:pointer; user-select:none;">Last Health Check @SortIndicator("LastHealthCheck")</th>
                <th class="actions-col" data-col-min="154" data-col-preferred="184">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in groups)
            {
                var hostId = group.Key;
                var isOrphan = !validHostIds.Contains(hostId);
                var hostLabel = isOrphan ? "Orphaned Runners" : hostNames.GetValueOrDefault(hostId, hostId);
                var isExpanded = expandedHosts.Contains(hostId);
                var sorted = ApplySort(group).ToList();

                <tr class="group-header @(isOrphan ? "group-orphaned" : "")" role="button" @onclick="() => ToggleHost(hostId)" style="cursor:pointer; user-select:none;">
                    <td colspan="7">
                        <div class="runner-group-header-content">
                            <span class="runner-group-title">
                                <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                <i class="bi @(isOrphan ? "bi-exclamation-triangle-fill text-danger" : "bi-hdd-network")"></i>
                                <strong>@hostLabel</strong>
                                <span class="runner-group-count">@sorted.Count</span>
                            </span>
                            @if (!isOrphan && capacitySnapshot.Hosts.TryGetValue(hostId, out var hostCapacity))
                            {
                                <span class="runner-group-capacity">
                                    @foreach (var backendUsage in GetEnabledBackendUsage(hostCapacity))
                                    {
                                        var backend = backendUsage.Key;
                                        var counter = backendUsage.Value;
                                        <span class="backend-capacity-chip @GetBackendUsageClass(counter)"
                                              title="@GetBackendUsageTitle(backend, counter)">
                                            <span class="backend-capacity-meter" style="@GetBackendUsageStyle(counter)" aria-hidden="true">
                                                <span></span>
                                            </span>
                                            <i class="bi @GetBackendIcon(backend)"></i>
                                            <span class="backend-capacity-label">@GetBackendShortLabel(backend)</span>
                                            <span class="backend-capacity-count">@counter.Summary</span>
                                        </span>
                                    }
                                </span>
                            }
                            @if (isOrphan)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmAndRemoveOrphans(sorted)">
                                    <i class="bi bi-trash3 me-1"></i>Remove All
                                </button>
                            }
                        </div>
                    </td>
                </tr>
                @if (isExpanded)
                {
                    @foreach (var inst in sorted)
                    {
                        <tr>
                            <td class="name-cell"><span class="primary-label">@inst.RunnerName</span></td>
                            <td>
                                <span class="primary-label">@GetProfileName(inst)</span>
                            </td>
                            <td>
                                <div class="event-status-card @GetRunnerStatusToneClass(inst)">
                                    <div class="event-status-heading">
                                        <span class="badge @GetStatusBadge(inst.Status)">@inst.Status</span>
                                    </div>
                                    @{
                                        var statusSummary = GetRunnerStatusSummary(inst);
                                        var statusMeta = GetRunnerStatusMeta(inst).ToList();
                                    }
                                    @if (!string.IsNullOrWhiteSpace(statusSummary))
                                    {
                                        <span class="event-status-summary" title="@statusSummary">@statusSummary</span>
                                    }
                                    @if (statusMeta.Any())
                                    {
                                        <div class="event-status-meta">
                                            @foreach (var item in statusMeta)
                                            {
                                                <span title="@item.Title">
                                                    <i class="bi @item.Icon"></i>@item.Text
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                            <td><span class="badge @(inst.ProvisioningMode == "dynamic" ? "bg-warning text-dark" : "bg-secondary")">@(inst.ProvisioningMode == "dynamic" ? "Dynamic" : "Static")</span></td>
                            <td>@(inst.StartedAt?.ToString("g") ?? "—")</td>
                            <td>@(inst.LastHealthCheck?.ToString("HH:mm:ss") ?? "—")</td>
                            <td class="actions-cell">
                                <a href="/logs?source=runner:@inst.Id" class="btn btn-sm btn-outline-secondary" title="View logs"><i class="bi bi-file-text"></i></a>
                                @if (!isOrphan && inst.Status is RunnerInstanceStatus.Running or RunnerInstanceStatus.Starting)
                                {
                                    <button class="btn btn-sm btn-warning" @onclick="() => StopInstance(inst)"><i class="bi bi-stop-circle"></i> Stop</button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmAndRemoveInstance(inst)">Remove</button>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
    </div>
}

<style>
    tr.group-header td {
        background:
            linear-gradient(90deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 42%),
            color-mix(in srgb, var(--bg-tertiary) 82%, var(--bg-card));
        border-top: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border-color));
        border-bottom: 2px solid color-mix(in srgb, var(--accent) 22%, var(--border-color));
        box-shadow: inset 4px 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
        padding: 0.68rem 0.85rem;
        font-size: 0.95rem;
    }
    tr.group-header:hover td {
        background:
            linear-gradient(90deg, color-mix(in srgb, var(--accent) 14%, transparent), transparent 42%),
            color-mix(in srgb, var(--bg-tertiary) 92%, var(--bg-card));
    }
    tr.group-orphaned td {
        background:
            linear-gradient(90deg, color-mix(in srgb, var(--danger) 12%, transparent), transparent 42%),
            var(--warning-soft);
        border-bottom-color: color-mix(in srgb, var(--danger) 24%, var(--border-color));
        box-shadow: inset 4px 0 0 var(--danger);
    }
    tr.group-orphaned:hover td {
        background:
            linear-gradient(90deg, color-mix(in srgb, var(--danger) 16%, transparent), transparent 42%),
            var(--warning-soft);
    }
</style>

@code {
    private List<RunnerInstance> instances = [];
    private Dictionary<string, string> hostNames = new();
    private Dictionary<string, Host> hostsById = new();
    private HashSet<string> validHostIds = new();
    private Dictionary<string, string> profileNames = new();
    private CapacitySnapshot capacitySnapshot = CapacitySnapshot.Empty;
    private int unmanagedHiddenCount;
    private static readonly ExecutionBackend[] BackendCapacityOrder =
    [
        ExecutionBackend.Docker,
        ExecutionBackend.Tart,
        ExecutionBackend.Native,
        ExecutionBackend.HyperV
    ];

    private string searchText = "";
    private string filterStatus = "active";
    private string filterHostId = "";
    private string filterProfileId = "";
    private string filterMode = "";

    private string sortColumn = "Started";
    private bool sortAscending = false;

    private HashSet<string> expandedHosts = new();
    private sealed record RunnerStatusMeta(string Icon, string Text, string Title);

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        StreamSubscriptionService.OnRunnerStatusChanged += OnStreamRunnerStatusChanged;
    }

    private void OnStreamRunnerStatusChanged(RunnerStatusChangedEvent evt)
    {
        InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
    }

    public void Dispose()
    {
        StreamSubscriptionService.OnRunnerStatusChanged -= OnStreamRunnerStatusChanged;
    }

    private async Task Refresh()
    {
        var allInstances = (await Store.Query<RunnerInstance>().ToList()).ToList();
        var staleEntries = allInstances.Where(IsLegacyDiscoveryEntry).ToList();

        foreach (var stale in staleEntries)
            await Store.Remove<RunnerInstance>(stale.Id);

        if (staleEntries.Count > 0)
            allInstances = (await Store.Query<RunnerInstance>().ToList()).ToList();

        unmanagedHiddenCount = allInstances.Count(i =>
            !IsManagedInstance(i)
            && (i.Status is RunnerInstanceStatus.Pending
                or RunnerInstanceStatus.Starting
                or RunnerInstanceStatus.Running
                or RunnerInstanceStatus.Stopping));
        instances = allInstances.Where(IsManagedInstance).ToList();
        var hosts = (await Store.Query<Host>().ToList()).ToList();
        var profiles = (await Store.Query<RunnerProfile>().ToList()).ToList();
        validHostIds = hosts.Select(h => h.Id).ToHashSet();
        hostsById = hosts.ToDictionary(h => h.Id);
        hostNames = hosts.ToDictionary(h => h.Id, h => h.Label);
        profileNames = profiles.ToDictionary(p => p.Id, p => p.Name);
        capacitySnapshot = await CapacityService.GetSnapshotAsync();

        // Auto-expand all hosts that have instances
        foreach (var hostId in instances.Select(i => i.HostId).Distinct())
            expandedHosts.Add(hostId);
    }

    private static bool IsManagedInstance(RunnerInstance instance) =>
        CapacityPlanningService.IsRunnerRunnerManaged(instance);

    private static bool IsLegacyDiscoveryEntry(RunnerInstance instance) =>
        string.IsNullOrWhiteSpace(instance.RunnerName);

    private bool HasActiveFilters() =>
        !string.IsNullOrWhiteSpace(searchText) ||
        (!string.IsNullOrWhiteSpace(filterStatus) && !string.Equals(filterStatus, "active", StringComparison.OrdinalIgnoreCase)) ||
        !string.IsNullOrWhiteSpace(filterHostId) ||
        !string.IsNullOrWhiteSpace(filterProfileId) ||
        !string.IsNullOrWhiteSpace(filterMode);

    private void ClearFilters()
    {
        searchText = "";
        filterStatus = "active";
        filterHostId = "";
        filterProfileId = "";
        filterMode = "";
    }

    private IEnumerable<RunnerInstance> GetFilteredInstances()
    {
        var q = instances.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filterHostId))
            q = q.Where(i => i.HostId == filterHostId);

        if (!string.IsNullOrWhiteSpace(filterProfileId))
            q = q.Where(i => i.ProfileId == filterProfileId);

        if (!string.IsNullOrWhiteSpace(filterMode))
            q = q.Where(i => i.ProvisioningMode == filterMode);

        if (string.Equals(filterStatus, "active", StringComparison.OrdinalIgnoreCase))
        {
            q = q.Where(i => i.Status is RunnerInstanceStatus.Pending
                or RunnerInstanceStatus.Starting
                or RunnerInstanceStatus.Running
                or RunnerInstanceStatus.Stopping);
        }
        else if (!string.IsNullOrWhiteSpace(filterStatus) && Enum.TryParse<RunnerInstanceStatus>(filterStatus, out var status))
        {
            q = q.Where(i => i.Status == status);
        }

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim();
            q = q.Where(i =>
                i.RunnerName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || hostNames.GetValueOrDefault(i.HostId, i.HostId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || profileNames.GetValueOrDefault(i.ProfileId, i.ProfileId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || i.Status.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return q;
    }

    private IEnumerable<RunnerInstance> ApplySort(IEnumerable<RunnerInstance> items)
    {
        return sortColumn switch
        {
            "RunnerName" => sortAscending ? items.OrderBy(i => i.RunnerName) : items.OrderByDescending(i => i.RunnerName),
            "Profile" => sortAscending
                ? items.OrderBy(i => profileNames.GetValueOrDefault(i.ProfileId, i.ProfileId))
                : items.OrderByDescending(i => profileNames.GetValueOrDefault(i.ProfileId, i.ProfileId)),
            "Status" => sortAscending ? items.OrderBy(i => i.Status) : items.OrderByDescending(i => i.Status),
            "Mode" => sortAscending ? items.OrderBy(i => i.ProvisioningMode) : items.OrderByDescending(i => i.ProvisioningMode),
            "Started" => sortAscending ? items.OrderBy(i => i.StartedAt ?? i.CreatedAt) : items.OrderByDescending(i => i.StartedAt ?? i.CreatedAt),
            "LastHealthCheck" => sortAscending ? items.OrderBy(i => i.LastHealthCheck) : items.OrderByDescending(i => i.LastHealthCheck),
            _ => items.OrderByDescending(i => i.StartedAt ?? i.CreatedAt)
        };
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIndicator(string column)
    {
        if (sortColumn != column) return (MarkupString)"";
        return (MarkupString)(sortAscending ? "▲" : "▼");
    }

    private static string FormatBackendUsage(HostCapacityView capacity, ExecutionBackend backend)
    {
        if (!capacity.BackendUsage.TryGetValue(backend, out var counter))
            return "0/0";

        return counter.IsDisabled ? "off" : $"{counter.Used}/{counter.Limit}";
    }

    private IEnumerable<KeyValuePair<ExecutionBackend, CapacityCounter>> GetEnabledBackendUsage(HostCapacityView capacity)
    {
        foreach (var backend in BackendCapacityOrder)
        {
            if (capacity.BackendUsage.TryGetValue(backend, out var counter) && IsBackendVisible(capacity.HostId, backend, counter))
                yield return new KeyValuePair<ExecutionBackend, CapacityCounter>(backend, counter);
        }
    }

    private bool IsBackendVisible(string hostId, ExecutionBackend backend, CapacityCounter counter)
    {
        if (counter.IsDisabled)
            return false;

        return backend != ExecutionBackend.Tart
            || (hostsById.TryGetValue(hostId, out var host) && host.Platform == HostPlatform.MacOS);
    }

    private static string GetBackendIcon(ExecutionBackend backend) => backend switch
    {
        ExecutionBackend.Docker => "bi-box-seam",
        ExecutionBackend.Tart => "bi-apple",
        ExecutionBackend.Native => "bi-terminal",
        ExecutionBackend.HyperV => "bi-windows",
        _ => "bi-hdd-rack"
    };

    private static string GetBackendShortLabel(ExecutionBackend backend) => backend switch
    {
        ExecutionBackend.Docker => "Docker",
        ExecutionBackend.Tart => "Tart",
        ExecutionBackend.Native => "Native",
        ExecutionBackend.HyperV => "Hyper-V",
        _ => backend.ToString()
    };

    private static string GetBackendUsageClass(CapacityCounter counter)
    {
        if (counter.IsDisabled)
            return "capacity-disabled";

        var ratio = counter.Limit == 0 ? 0 : (double)counter.Used / counter.Limit;
        return ratio switch
        {
            >= 1 => "capacity-full",
            >= 0.75 => "capacity-warn",
            _ => "capacity-good"
        };
    }

    private static string GetBackendUsageStyle(CapacityCounter counter)
    {
        var percent = counter.IsDisabled || counter.Limit == 0
            ? 0
            : Math.Clamp((int)Math.Round((double)counter.Used / counter.Limit * 100), 0, 100);

        return $"--usage-percent: {percent}%;";
    }

    private static string GetBackendUsageTitle(ExecutionBackend backend, CapacityCounter counter)
    {
        var label = GetBackendShortLabel(backend);
        return counter.IsDisabled
            ? $"{label}: disabled"
            : $"{label}: {counter.Used} of {counter.Limit} used, {counter.Remaining} available";
    }

    private string GetProfileName(RunnerInstance instance) =>
        profileNames.GetValueOrDefault(instance.ProfileId, instance.ProfileId);

    private void ToggleHost(string hostId)
    {
        if (!expandedHosts.Remove(hostId))
            expandedHosts.Add(hostId);
    }

    private async Task StopInstance(RunnerInstance inst)
    {
        var runnerGrain = GrainFactory.GetGrain<IRunnerInstanceGrain>(inst.Id);
        await runnerGrain.MarkStopping();

        await HostCommandDispatcher.DispatchStopRunnerAsync(inst.HostId, new StopRunnerCommand
        {
            InstanceId = inst.Id,
            InstanceHandle = inst.ContainerId ?? inst.VmName ?? inst.ProcessId?.ToString()
        });

        inst.Status = RunnerInstanceStatus.Stopping;
        await Store.Update(inst);

        await Refresh();
    }

    private async Task ConfirmAndRemoveInstance(RunnerInstance inst)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Remove runner instance '{inst.RunnerName}'?");
        if (confirmed) await RemoveInstance(inst.Id);
    }

    private async Task ConfirmAndRemoveOrphans(List<RunnerInstance> orphans)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Remove {orphans.Count} orphaned runner record(s)? These runners have no associated host.");
        if (!confirmed) return;
        foreach (var inst in orphans)
            await Store.Remove<RunnerInstance>(inst.Id);
        await Refresh();
    }

    private async Task RemoveInstance(string id)
    {
        await Store.Remove<RunnerInstance>(id);
        await Refresh();
    }

    private string GetStatusBadge(RunnerInstanceStatus status) => status switch
    {
        RunnerInstanceStatus.Running => "bg-success",
        RunnerInstanceStatus.Starting => "bg-info",
        RunnerInstanceStatus.Pending => "bg-secondary",
        RunnerInstanceStatus.Stopping => "bg-warning",
        RunnerInstanceStatus.Stopped => "bg-dark",
        RunnerInstanceStatus.Failed => "bg-danger",
        RunnerInstanceStatus.Crashed => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetRunnerStatusToneClass(RunnerInstance instance) => instance.Status switch
    {
        RunnerInstanceStatus.Running or RunnerInstanceStatus.Stopped => "event-status-good",
        RunnerInstanceStatus.Pending or RunnerInstanceStatus.Starting or RunnerInstanceStatus.Stopping => "event-status-info",
        RunnerInstanceStatus.Failed or RunnerInstanceStatus.Crashed => "event-status-danger",
        _ => ""
    };

    private string? GetRunnerStatusSummary(RunnerInstance instance)
    {
        if (!string.IsNullOrWhiteSpace(instance.ErrorMessage))
            return instance.ErrorMessage;
        if (!string.IsNullOrWhiteSpace(instance.StatusMessage))
            return instance.StatusMessage;

        var hostName = hostNames.GetValueOrDefault(instance.HostId, instance.HostId);
        return instance.Status switch
        {
            RunnerInstanceStatus.Pending => "Waiting for provisioning.",
            RunnerInstanceStatus.Starting => $"Starting on {hostName}.",
            RunnerInstanceStatus.Running => $"Active on {hostName}.",
            RunnerInstanceStatus.Stopping => "Stop requested; waiting for shutdown.",
            RunnerInstanceStatus.Stopped => "Runner stopped.",
            RunnerInstanceStatus.Failed => "Runner failed.",
            RunnerInstanceStatus.Crashed => "Runner crashed.",
            _ => null
        };
    }

    private IEnumerable<RunnerStatusMeta> GetRunnerStatusMeta(RunnerInstance instance)
    {
        if (instance.StartedAt.HasValue)
            yield return new("bi-play-circle", instance.StartedAt.Value.ToLocalTime().ToString("t"), $"Started at {instance.StartedAt.Value.ToLocalTime():f}");
        else if (instance.DeployedAt.HasValue)
            yield return new("bi-box-arrow-in-down", instance.DeployedAt.Value.ToLocalTime().ToString("t"), $"Deployed at {instance.DeployedAt.Value.ToLocalTime():f}");
        else
            yield return new("bi-clock", instance.CreatedAt.ToLocalTime().ToString("t"), $"Created at {instance.CreatedAt.ToLocalTime():f}");

        if (instance.Status is RunnerInstanceStatus.Running or RunnerInstanceStatus.Starting or RunnerInstanceStatus.Stopping)
        {
            var since = instance.StartedAt ?? instance.DeployedAt ?? instance.CreatedAt;
            yield return new("bi-stopwatch", FormatDuration(DateTime.UtcNow - since), $"Active for {FormatDuration(DateTime.UtcNow - since)}");
        }

        if (instance.LastHealthCheck.HasValue)
            yield return new("bi-heart-pulse", instance.LastHealthCheck.Value.ToLocalTime().ToString("T"), $"Last health check at {instance.LastHealthCheck.Value.ToLocalTime():f}");
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
            return $"{(int)duration.TotalDays}d {duration.Hours}h";
        if (duration.TotalHours >= 1)
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        if (duration.TotalMinutes >= 1)
            return $"{(int)duration.TotalMinutes}m";
        return $"{Math.Max(0, (int)duration.TotalSeconds)}s";
    }

    private async Task<RunnerInstanceGrainState?> GetRunnerGrainState(string instanceId)
    {
        try
        {
            var grain = GrainFactory.GetGrain<IRunnerInstanceGrain>(instanceId);
            return await grain.GetState();
        }
        catch { return null; }
    }
}
