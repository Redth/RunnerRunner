@page "/images"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Hubs
@using Microsoft.AspNetCore.SignalR
@inject IDocumentStore Store
@inject IHubContext<AgentHub, IAgentHubClient> HubContext
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Images - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-box-seam-fill"></i> Images</h1>
        <span class="page-desc">Manage Docker and Tart images across hosts.</span>
    </div>
</SectionContent>

<div class="split-pane-container d-flex" style="height: calc(100vh - 120px);">
    @* Left sidebar *@
    <div id="images-sidebar" class="split-pane-sidebar d-flex flex-column" style="width: 260px; min-width: 180px; max-width: 500px; overflow-y: auto;">
        <div class="sidebar-section-header">
            <i class="bi bi-pc-display me-1"></i> Hosts
            <span class="badge bg-secondary ms-auto">@hosts.Count</span>
        </div>
        @foreach (var h in hosts)
        {
            <div class="image-host-card @(selectedHostId == h.Id ? "active" : "")"
                 @onclick="() => SelectHost(h.Id)">
                <div class="d-flex align-items-center">
                    <i class="bi @GetPlatformIcon(h.Platform) me-2"></i>
                    <span class="text-truncate">@h.Label</span>
                    <span class="badge ms-auto @GetStatusBadge(h.AgentStatus)" style="font-size: 0.65rem;">@h.AgentStatus</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(h.DisplayName))
                {
                    <small class="text-muted text-truncate d-block" style="font-size: 0.7rem;">@h.Name</small>
                }
            </div>
        }
    </div>

    @* Resize handle *@
    <div id="images-resize-handle" class="split-resize-handle"></div>

    @* Right pane *@
    <div class="split-pane-main flex-grow-1 d-flex flex-column" style="min-width: 0; overflow-y: auto;">
        @if (string.IsNullOrEmpty(selectedHostId))
        {
            <div class="border rounded d-flex flex-column align-items-center justify-content-center flex-grow-1 text-muted" style="background: var(--bg-card, #fff);">
                <i class="bi bi-arrow-left-circle" style="font-size: 3rem; opacity: 0.4;"></i>
                <h5 class="mt-3">Select a host</h5>
                <p>Choose a host from the sidebar to manage its images.</p>
            </div>
        }
        else
        {
            @* Toolbar *@
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshImages">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
                <button class="btn btn-primary btn-sm" @onclick="() => showPullForm = true">
                    <i class="bi bi-cloud-arrow-down"></i> Pull Image
                </button>
            </div>

            @* Pull progress indicator *@
            @if (pullInProgress)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h6><i class="bi bi-cloud-arrow-down me-1"></i> Pulling @pullImageName</h6>
                        <div class="progress" style="height: 24px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar" style="width: @pullProgress%"
                                 aria-valuenow="@pullProgress" aria-valuemin="0" aria-valuemax="100">
                                @pullProgress.ToString("F0")%
                            </div>
                        </div>
                        <small class="text-muted mt-1 d-block">@pullStatus</small>
                    </div>
                </div>
            }

            @* Pull form *@
            @if (showPullForm)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>Pull Image</h5>
                        <div class="row">
                            <div class="col-md-2 mb-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" @bind="pullType">
                                    <option value="@ImageType.Docker">Docker</option>
                                    <option value="@ImageType.Tart">Tart</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Registry</label>
                                <select class="form-select" @bind="pullRegistryId">
                                    <option value="">(default / no auth)</option>
                                    @foreach (var r in registries)
                                    {
                                        <option value="@r.Id">@r.Name (@r.RegistryUrl)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Image</label>
                                <input class="form-control" @bind="pullImage" placeholder="org/image-name" />
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label">Tag</label>
                                <input class="form-control" @bind="pullTag" placeholder="latest" />
                            </div>
                            <div class="col-md-1 d-flex align-items-end mb-3">
                                <button class="btn btn-success" @onclick="StartPull"><i class="bi bi-download"></i></button>
                            </div>
                        </div>
                        <button class="btn btn-secondary btn-sm" @onclick="() => showPullForm = false">Cancel</button>
                    </div>
                </div>
            }

            @* Tabs *@
            <ul class="nav nav-tabs mb-0">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "docker" ? "active" : "")" @onclick="SwitchToDocker">
                        <i class="bi bi-box-fill me-1"></i> Docker (@dockerImages.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "tart" ? "active" : "")" @onclick="SwitchToTart">
                        <i class="bi bi-display me-1"></i> Tart (@tartImages.Count)
                    </button>
                </li>
            </ul>

            <div class="border border-top-0 rounded-bottom p-3 mb-3">
                <div class="row mb-2">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Search images…" @bind="searchText" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(searchText))
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => searchText = string.Empty">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @{ var displayImages = GetFilteredSortedImages(); }

                @if (!displayImages.Any())
                {
                    <div class="alert alert-secondary mb-0">
                        @if (!string.IsNullOrEmpty(searchText))
                        {
                            <text>No @activeTab images matching "<strong>@searchText</strong>".</text>
                        }
                        else
                        {
                            <text>No @activeTab images on this host. Use Pull Image to download one.</text>
                        }
                    </div>
                }
                else
                {
                    @if (activeTab == "docker")
                    {
                        <div class="table-responsive">
                        <table class="table table-striped resizable-table mb-0">
                            <thead>
                                <tr>
                                    <th role="button" @onclick='() => ToggleSort("Repository")'>Repository @SortIndicator("Repository")</th>
                                    <th role="button" @onclick='() => ToggleSort("Tag")'>Tag @SortIndicator("Tag")</th>
                                    <th>Image ID</th>
                                    <th role="button" @onclick='() => ToggleSort("Size")' style="min-width: 100px;">Size @SortIndicator("Size")</th>
                                    <th role="button" @onclick='() => ToggleSort("Created")' style="min-width: 150px;">Created @SortIndicator("Created")</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var img in displayImages)
                                {
                                    <tr>
                                        <td>@img.Repository</td>
                                        <td><span class="badge bg-secondary">@img.Tag</span></td>
                                        <td><code>@(img.ImageId?[..Math.Min(12, img.ImageId?.Length ?? 0)])</code></td>
                                        <td>@FormatSize(img.SizeBytes)</td>
                                        <td>@FormatDate(img.ImageCreatedAt)</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmAndDeleteImage(img)">
                                                <i class="bi bi-trash3"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                        <table class="table table-striped resizable-table mb-0">
                            <thead>
                                <tr>
                                    <th role="button" @onclick='() => ToggleSort("Repository")'>Name @SortIndicator("Repository")</th>
                                    <th role="button" @onclick='() => ToggleSort("Tag")'>Tag @SortIndicator("Tag")</th>
                                    <th role="button" @onclick='() => ToggleSort("Size")' style="min-width: 100px;">Size @SortIndicator("Size")</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var img in displayImages)
                                {
                                    <tr>
                                        <td>@img.Repository</td>
                                        <td><span class="badge bg-secondary">@img.Tag</span></td>
                                        <td>@FormatSize(img.SizeBytes)</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmAndDeleteImage(img)">
                                                <i class="bi bi-trash3"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

<style>
    .image-host-card {
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
        border: 1px solid transparent;
        margin-bottom: 2px;
    }
    .image-host-card:hover {
        background: var(--bg-secondary, #f0f0f0);
    }
    .image-host-card.active {
        background: var(--bg-tertiary, #e8e8e8);
        border-color: var(--bs-primary);
        box-shadow: inset 3px 0 0 var(--bs-primary);
    }
    .sidebar-section-header {
        display: flex;
        align-items: center;
        padding: 0.35rem 0.75rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted, #6c757d);
    }
    .split-resize-handle {
        width: 6px;
        cursor: col-resize;
        background: transparent;
        transition: background 0.15s;
        flex-shrink: 0;
        border-radius: 3px;
        margin: 0 2px;
    }
    .split-resize-handle:hover, .split-resize-handle:active {
        background: var(--bs-primary);
        opacity: 0.4;
    }
</style>

@code {
    private List<Host> hosts = [];
    private List<RegistryCredential> registries = [];
    private string selectedHostId = "";
    private string activeTab = "docker";
    private List<AgentImage> dockerImages = [];
    private List<AgentImage> tartImages = [];

    // Search & sort
    private string searchText = "";
    private string sortColumn = "";
    private bool sortAscending = true;

    // Pull form
    private bool showPullForm;
    private ImageType pullType = ImageType.Docker;
    private string pullRegistryId = "";
    private string pullImage = "";
    private string pullTag = "latest";

    // Pull progress
    private bool pullInProgress;
    private string pullImageName = "";
    private double pullProgress;
    private string pullStatus = "";

    protected override async Task OnInitializedAsync()
    {
        hosts = (await Store.Query<Host>().ToList()).ToList();
        registries = (await Store.Query<RegistryCredential>().ToList()).ToList();

        // TODO: Replace AgentHub static events with Orleans stream subscriptions
        AgentHub.OnImagePullProgressReceived += HandlePullProgress;
        AgentHub.OnImagePullCompleteReceived += HandlePullComplete;
        AgentHub.OnImageDeletedReceived += HandleImageDeleted;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("rrSplitPane.init", "images-resize-handle", "images-sidebar", "rr-images-sidebar-width", 180, 500);
    }

    private async Task SelectHost(string hostId)
    {
        selectedHostId = hostId;
        if (string.IsNullOrEmpty(selectedHostId)) return;
        await LoadImages();
        await RequestImageRefresh();
    }

    private async Task LoadImages()
    {
        var all = (await Store.Query<AgentImage>().ToList())
            .Where(i => i.HostId == selectedHostId).ToList();
        dockerImages = all.Where(i => i.ImageType == ImageType.Docker).ToList();
        tartImages = all.Where(i => i.ImageType == ImageType.Tart).ToList();
    }

    private async Task RefreshImages()
    {
        await RequestImageRefresh();
        await Task.Delay(2000); // Give agent time to respond
        await LoadImages();
    }

    private async Task RequestImageRefresh()
    {
        var host = hosts.FirstOrDefault(h => h.Id == selectedHostId);
        if (host == null) return;

        var agent = AgentHub.GetConnectedAgents().Values
            .FirstOrDefault(a => a.AgentInfo.Name == host.Name);
        if (agent == null) return;

        await HubContext.Clients.Client(agent.ConnectionId)
            .ListImages(new ListImagesCommand());
    }

    private async Task StartPull()
    {
        var host = hosts.FirstOrDefault(h => h.Id == selectedHostId);
        if (host == null) return;
        var agent = AgentHub.GetConnectedAgents().Values
            .FirstOrDefault(a => a.AgentInfo.Name == host.Name);
        if (agent == null) return;

        var registry = registries.FirstOrDefault(r => r.Id == pullRegistryId);

        pullInProgress = true;
        pullImageName = $"{pullImage}:{pullTag}";
        pullProgress = 0;
        pullStatus = "Starting...";
        showPullForm = false;

        var command = new PullImageCommand
        {
            ImageType = pullType,
            ImageName = pullImage,
            Tag = pullTag,
            RegistryUrl = registry?.RegistryUrl,
            Username = registry?.Username,
            Password = registry?.Password
        };

        await HubContext.Clients.Client(agent.ConnectionId).PullImage(command);
    }

    private async Task ConfirmAndDeleteImage(AgentImage img)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete image '{img.Repository}'?");
        if (confirmed) await DeleteImage(img);
    }

    private async Task DeleteImage(AgentImage img)
    {
        var host = hosts.FirstOrDefault(h => h.Id == selectedHostId);
        if (host == null) return;
        var agent = AgentHub.GetConnectedAgents().Values
            .FirstOrDefault(a => a.AgentInfo.Name == host.Name);
        if (agent == null) return;

        await HubContext.Clients.Client(agent.ConnectionId).DeleteImage(new DeleteImageCommand
        {
            ImageType = img.ImageType,
            ImageId = img.ImageId ?? img.Repository,
            ImageName = img.Repository
        });

        // Remove from local cache immediately for responsiveness
        await Store.Remove<AgentImage>(img.Id);
        await LoadImages();
    }

    private void HandlePullProgress(ImagePullProgressEvent evt)
    {
        pullProgress = evt.ProgressPercent;
        pullStatus = evt.Status ?? $"{FormatSize(evt.BytesDownloaded)} / {FormatSize(evt.BytesTotal)}";
        InvokeAsync(StateHasChanged);
    }

    private void HandlePullComplete(ImagePullCompleteEvent evt)
    {
        pullInProgress = false;
        pullStatus = evt.Success ? "Complete!" : $"Failed: {evt.Error}";
        InvokeAsync(async () =>
        {
            await Task.Delay(1000);
            await LoadImages();
            StateHasChanged();
        });
    }

    private void HandleImageDeleted(ImageDeletedEvent evt)
    {
        InvokeAsync(async () =>
        {
            await LoadImages();
            StateHasChanged();
        });
    }

    private static string FormatSize(long bytes)
    {
        if (bytes <= 0) return "—";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

    private static string FormatDate(DateTime? dt) =>
        dt.HasValue ? dt.Value.ToString("yyyy-MM-dd HH:mm") : "—";

    private void SwitchToDocker() => SwitchTab("docker");
    private void SwitchToTart() => SwitchTab("tart");

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        searchText = "";
        sortColumn = "";
        sortAscending = true;
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIndicator(string column) =>
        sortColumn != column
            ? new MarkupString("<span class=\"text-muted\" style=\"opacity:0.3\">▲</span>")
            : new MarkupString(sortAscending ? "<span>▲</span>" : "<span>▼</span>");

    private List<AgentImage> GetFilteredSortedImages()
    {
        var source = activeTab == "docker" ? dockerImages : tartImages;
        IEnumerable<AgentImage> result = source;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var q = searchText.Trim();
            result = result.Where(i =>
                (i.Repository?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.Tag?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.ImageId?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (!string.IsNullOrEmpty(sortColumn))
        {
            result = (sortColumn, sortAscending) switch
            {
                ("Repository", true) => result.OrderBy(i => i.Repository, StringComparer.OrdinalIgnoreCase),
                ("Repository", false) => result.OrderByDescending(i => i.Repository, StringComparer.OrdinalIgnoreCase),
                ("Tag", true) => result.OrderBy(i => i.Tag, StringComparer.OrdinalIgnoreCase),
                ("Tag", false) => result.OrderByDescending(i => i.Tag, StringComparer.OrdinalIgnoreCase),
                ("Size", true) => result.OrderBy(i => i.SizeBytes),
                ("Size", false) => result.OrderByDescending(i => i.SizeBytes),
                ("Created", true) => result.OrderBy(i => i.ImageCreatedAt ?? DateTime.MinValue),
                ("Created", false) => result.OrderByDescending(i => i.ImageCreatedAt ?? DateTime.MinValue),
                _ => result
            };
        }

        return result.ToList();
    }

    private string GetPlatformIcon(HostPlatform platform) => platform switch
    {
        HostPlatform.Linux => "bi-ubuntu",
        HostPlatform.MacOS => "bi-apple",
        HostPlatform.Windows => "bi-windows",
        _ => "bi-pc-display"
    };

    private string GetStatusBadge(AgentStatus status) => status switch
    {
        AgentStatus.Online => "bg-success",
        AgentStatus.Connecting => "bg-warning",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        AgentHub.OnImagePullProgressReceived -= HandlePullProgress;
        AgentHub.OnImagePullCompleteReceived -= HandlePullComplete;
        AgentHub.OnImageDeletedReceived -= HandleImageDeleted;
    }
}
