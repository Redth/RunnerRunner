@page "/images"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Services
@inject IDocumentStore Store
@inject IHostCommandDispatcher HostCommandDispatcher
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Images - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-box-seam-fill"></i> Images</h1>
        <span class="page-desc">Manage Docker and Tart images across hosts.</span>
    </div>
</SectionContent>

<div class="images-workspace logs-workspace @(hostPanelCollapsed ? "sources-collapsed" : "sources-expanded")">
    <aside id="images-sidebar" class="logs-source-panel images-host-panel" aria-label="Image hosts">
        <div class="logs-source-panel-header">
            <span><i class="bi bi-pc-display"></i> Hosts</span>
            <button type="button" class="icon-btn" @onclick="ToggleHostPanel" aria-label="Collapse image hosts" title="Collapse hosts" aria-controls="images-sidebar" aria-expanded="@(!hostPanelCollapsed)">
                <i class="bi bi-layout-sidebar-inset"></i>
            </button>
        </div>

        <div class="logs-source-search">
            <i class="bi bi-search"></i>
            <input type="search"
                   class="form-control"
                   placeholder="Filter hosts..."
                   aria-label="Filter image hosts"
                   @bind="hostFilter"
                   @bind:event="oninput" />
        </div>

        <div class="logs-source-actions">
            <button type="button" @onclick="SelectFirstHost">Select first</button>
            <span aria-hidden="true"></span>
            <button type="button" @onclick="ClearHostFilter">Clear</button>
        </div>

        <div class="logs-source-list">
            @foreach (var group in FilteredHosts.GroupBy(h => h.AgentStatus).OrderBy(g => HostStatusOrder(g.Key)))
            {
                <div class="sidebar-section-header">
                    <span><i class="bi @HostStatusGroupIcon(group.Key)"></i> @HostStatusGroupTitle(group.Key)</span>
                    <span class="badge bg-secondary">@group.Count()</span>
                </div>
                @foreach (var h in group.OrderByDescending(h => h.AgentStatus == AgentStatus.Online).ThenBy(h => h.Label))
                {
                    <button type="button"
                            class="log-source-card image-host-card @(selectedHostId == h.Id ? "active" : "")"
                            @onclick="() => SelectHost(h.Id)">
                        <span class="log-source-title">
                            <i class="bi @GetPlatformIcon(h.Platform)"></i>
                            <span class="text-truncate">@h.Label</span>
                            <span class="source-dot @h.AgentStatus.ToString().ToLowerInvariant() ms-auto"></span>
                        </span>
                        <small class="text-truncate">@GetHostDescription(h)</small>
                        <span class="image-host-meta">
                            <span><i class="bi bi-box-seam"></i>@GetHostImageCount(h.Id, ImageType.Docker)</span>
                            @if (h.Platform == HostPlatform.MacOS)
                            {
                                <span><i class="bi bi-apple"></i>@GetHostImageCount(h.Id, ImageType.Tart)</span>
                            }
                        </span>
                    </button>
                }
            }
        </div>
    </aside>

    <div id="images-resize-handle" class="split-resize-handle"></div>

    @if (hostPanelCollapsed)
    {
        <button type="button" class="source-panel-reveal source-panel-reveal-icon-only" @onclick="ToggleHostPanel" aria-label="Show image hosts" title="Show hosts" aria-controls="images-sidebar" aria-expanded="false">
            <span class="source-panel-reveal-icon"><i class="bi bi-layout-sidebar-inset"></i></span>
        </button>
    }

    <section class="images-main-panel" aria-label="Host images">
        @if (string.IsNullOrEmpty(selectedHostId))
        {
            <div class="images-empty-state">
                <span class="empty-state-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                <h3>Select a host</h3>
                <p>Choose a host from the sidebar to manage its images.</p>
            </div>
        }
        else
        {
            var selectedHost = SelectedHost;
            <div class="images-toolbar">
                <div class="images-toolbar-title">
                    <div class="images-toolbar-heading">
                        <span class="source-dot @(selectedHost?.AgentStatus.ToString().ToLowerInvariant() ?? "")" aria-hidden="true"></span>
                        <strong>@(selectedHost?.Label ?? selectedHostId)</strong>
                        <span class="logs-console-meta">@dockerImages.Count Docker</span>
                        <span class="logs-console-meta">@tartImages.Count Tart</span>
                    </div>
                    @if (selectedHost is not null)
                    {
                        <p>@GetHostDescription(selectedHost)</p>
                    }
                </div>
                <div class="images-toolbar-actions">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshImages" disabled="@refreshInProgress">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                    <button class="btn btn-primary btn-sm" @onclick="OpenPullForm" disabled="@pullInProgress">
                        <i class="bi bi-cloud-arrow-down"></i> Pull Image
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(refreshStatus))
            {
                <div class="images-refresh-status @(refreshStatusIsError ? "text-danger" : refreshInProgress ? "text-muted" : "text-success")">
                    @if (refreshInProgress)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    @refreshStatus
                </div>
            }

            @if (showPullStatus)
            {
                <div class="card mb-3 @PullStatusCardClass">
                    <div class="card-body">
                        <h6 class="@PullStatusTextClass"><i class="bi @PullStatusIcon me-1"></i> @PullStatusTitle</h6>
                        @if (pullInProgress || pullProgress > 0)
                        {
                            <div class="progress" style="height: 24px;">
                                <div class="progress-bar @PullProgressBarClass"
                                     role="progressbar" style="width: @pullProgress%"
                                     aria-valuenow="@pullProgress" aria-valuemin="0" aria-valuemax="100">
                                    @pullProgress.ToString("F0")%
                                </div>
                            </div>
                        }
                        <small class="@PullStatusTextClass mt-1 d-block">@pullStatus</small>
                    </div>
                </div>
            }

            <div class="images-content-card">
                <div class="images-tabs" role="tablist" aria-label="Image type">
                    <button type="button" class="@(activeTab == "docker" ? "active" : "")" @onclick="SwitchToDocker" aria-pressed="@(activeTab == "docker")">
                        <i class="bi bi-box-fill"></i> Docker <span>@dockerImages.Count</span>
                    </button>
                    <button type="button" class="@(activeTab == "tart" ? "active" : "")" @onclick="SwitchToTart" aria-pressed="@(activeTab == "tart")">
                        <i class="bi bi-apple"></i> Tart <span>@tartImages.Count</span>
                    </button>
                </div>

                <div class="images-filter-row">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Search images..." @bind="searchText" @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(searchText))
                        {
                            <button class="btn btn-outline-secondary" @onclick="() => searchText = string.Empty">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                </div>

                @{ var displayImages = GetFilteredSortedImages(); }

                @if (!displayImages.Any())
                {
                    <div class="images-empty-state images-empty-state-compact">
                        <span class="empty-state-icon"><i class="bi bi-box" aria-hidden="true"></i></span>
                        <h3>No @activeTab images</h3>
                        <p>
                        @if (!string.IsNullOrEmpty(searchText))
                        {
                            <text>No images match "<strong>@searchText</strong>" on this host.</text>
                        }
                        else
                        {
                            <text>Use Pull Image to download one to this host.</text>
                        }
                        </p>
                    </div>
                }
                else
                {
                    <div class="images-table-wrap">
                    @if (activeTab == "docker")
                    {
                        <div class="table-responsive">
                        <table class="table table-striped resizable-table mb-0">
                            <thead>
                                <tr>
                                    <th role="button" data-col-kind="name" data-col-min="170" data-col-preferred="260" data-col-weight="3.5" @onclick='() => ToggleSort("Repository")'>Repository @SortIndicator("Repository")</th>
                                    <th role="button" data-col-kind="compact" data-col-min="82" data-col-preferred="110" data-col-priority="2" @onclick='() => ToggleSort("Tag")'>Tag @SortIndicator("Tag")</th>
                                    <th data-col-kind="optional" data-col-min="108" data-col-preferred="132" data-col-priority="5">Image ID</th>
                                    <th role="button" data-col-kind="compact" data-col-min="82" data-col-preferred="100" data-col-priority="3" @onclick='() => ToggleSort("Size")'>Size @SortIndicator("Size")</th>
                                    <th role="button" data-col-kind="time" data-col-min="108" data-col-preferred="132" data-col-priority="4" @onclick='() => ToggleSort("Created")'>Created @SortIndicator("Created")</th>
                                    <th class="actions-col" data-col-min="92" data-col-preferred="112">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var img in displayImages)
                                {
                                    <tr>
                                        <td class="name-cell"><span class="primary-label">@img.Repository</span></td>
                                        <td><span class="badge bg-secondary">@img.Tag</span></td>
                                        <td><code>@(img.ImageId?[..Math.Min(12, img.ImageId?.Length ?? 0)])</code></td>
                                        <td>@FormatSize(img.SizeBytes)</td>
                                        <td>@FormatDate(img.ImageCreatedAt)</td>
                                        <td class="actions-cell">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmAndDeleteImage(img)">
                                                <i class="bi bi-trash3"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                        <table class="table table-striped resizable-table mb-0">
                            <thead>
                                <tr>
                                    <th role="button" data-col-kind="name" data-col-min="170" data-col-preferred="260" data-col-weight="3.5" @onclick='() => ToggleSort("Repository")'>Name @SortIndicator("Repository")</th>
                                    <th role="button" data-col-kind="compact" data-col-min="82" data-col-preferred="110" data-col-priority="2" @onclick='() => ToggleSort("Tag")'>Tag @SortIndicator("Tag")</th>
                                    <th role="button" data-col-kind="compact" data-col-min="82" data-col-preferred="100" data-col-priority="3" @onclick='() => ToggleSort("Size")'>Size @SortIndicator("Size")</th>
                                    <th class="actions-col" data-col-min="92" data-col-preferred="112">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var img in displayImages)
                                {
                                    <tr>
                                        <td class="name-cell"><span class="primary-label">@img.Repository</span></td>
                                        <td><span class="badge bg-secondary">@img.Tag</span></td>
                                        <td>@FormatSize(img.SizeBytes)</td>
                                        <td class="actions-cell">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmAndDeleteImage(img)">
                                                <i class="bi bi-trash3"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    </div>
                }
            </div>
        }
    </section>
</div>

@if (showPullForm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block rr-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="pull-image-title" @onclick="ClosePullForm">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 id="pull-image-title" class="modal-title">
                            <i class="bi bi-cloud-arrow-down me-2"></i>Pull Image
                        </h5>
                        <div class="modal-kicker">Download a Docker image or Tart VM image onto the selected host.</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="ClosePullForm" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (showPullStatus && pullStatusIsError && !string.IsNullOrWhiteSpace(pullStatus))
                    {
                        <div class="alert alert-danger py-2">@pullStatus</div>
                    }

                    <div class="rr-form-section">
                        <div class="rr-form-section-title"><i class="bi bi-box-seam"></i> Image reference</div>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" @bind="pullType">
                                    <option value="@ImageType.Docker">Docker</option>
                                    <option value="@ImageType.Tart">Tart</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Registry</label>
                                <select class="form-select" @bind="pullRegistryId">
                                    <option value="">(default / no auth)</option>
                                    @foreach (var r in registries)
                                    {
                                        <option value="@r.Id">@r.Name (@r.RegistryUrl)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Image</label>
                                <input class="form-control" @bind="pullImage" placeholder="org/image-name" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tag</label>
                                <input class="form-control" @bind="pullTag" placeholder="latest" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="ClosePullForm">Cancel</button>
                    <button class="btn btn-primary" @onclick="StartPull">
                        <i class="bi bi-download me-1"></i>Request pull
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Host> hosts = [];
    private List<AgentImage> allImages = [];
    private List<RegistryCredential> registries = [];
    private string selectedHostId = "";
    private string hostFilter = "";
    private bool hostPanelCollapsed;
    private string activeTab = "docker";
    private List<AgentImage> dockerImages = [];
    private List<AgentImage> tartImages = [];
    private const string HostPanelPreferenceKey = "rr-images-hosts-collapsed-v2";

    // Search & sort
    private string searchText = "";
    private string sortColumn = "";
    private bool sortAscending = true;

    // Pull form
    private bool showPullForm;
    private ImageType pullType = ImageType.Docker;
    private string pullRegistryId = "";
    private string pullImage = "";
    private string pullTag = "latest";

    // Pull progress
    private bool pullInProgress;
    private bool showPullStatus;
    private bool pullStatusIsError;
    private bool pullStatusIsSuccess;
    private string pullImageName = "";
    private double pullProgress;
    private string pullStatus = "";
    private string? activePullTaskId;

    // Refresh progress
    private bool refreshInProgress;
    private bool refreshStatusIsError;
    private string refreshStatus = "";

    protected override async Task OnInitializedAsync()
    {
        hosts = (await Store.Query<Host>().ToList()).ToList();
        allImages = (await Store.Query<AgentImage>().ToList()).ToList();
        registries = (await Store.Query<RegistryCredential>().ToList()).ToList();

        StreamSubscriptionService.OnImageRefreshStatusReceived += HandleRefreshStatus;
        StreamSubscriptionService.OnImagePullProgressReceived += HandlePullProgress;
        StreamSubscriptionService.OnImagePullCompleteReceived += HandlePullComplete;
        StreamSubscriptionService.OnImageDeletedReceived += HandleImageDeleted;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await JS.InvokeVoidAsync("rrSplitPane.init", "images-resize-handle", "images-sidebar", "rr-images-sidebar-width-v2", 220, 420);
        await InitializeResponsiveHostPanel();
    }

    private IEnumerable<Host> FilteredHosts =>
        string.IsNullOrWhiteSpace(hostFilter)
            ? hosts
            : hosts.Where(h =>
                h.Label.Contains(hostFilter.Trim(), StringComparison.OrdinalIgnoreCase)
                || h.Name.Contains(hostFilter.Trim(), StringComparison.OrdinalIgnoreCase)
                || h.Platform.ToString().Contains(hostFilter.Trim(), StringComparison.OrdinalIgnoreCase)
                || h.AgentStatus.ToString().Contains(hostFilter.Trim(), StringComparison.OrdinalIgnoreCase));

    private Host? SelectedHost => hosts.FirstOrDefault(h => h.Id == selectedHostId);

    private async Task ToggleHostPanel()
    {
        hostPanelCollapsed = !hostPanelCollapsed;
        await JS.InvokeVoidAsync("rrViewport.setBooleanPreference", HostPanelPreferenceKey, hostPanelCollapsed);
        StateHasChanged();
    }

    private async Task InitializeResponsiveHostPanel()
    {
        var savedCollapsed = await JS.InvokeAsync<string?>("rrViewport.getPreference", HostPanelPreferenceKey);
        hostPanelCollapsed = bool.TryParse(savedCollapsed, out var collapsed)
            ? collapsed
            : await JS.InvokeAsync<bool>("rrViewport.isBelow", 720);
        StateHasChanged();
    }

    private async Task SelectFirstHost()
    {
        var first = FilteredHosts
            .OrderByDescending(h => h.AgentStatus == AgentStatus.Online)
            .ThenBy(h => h.Label)
            .FirstOrDefault();

        if (first != null)
            await SelectHost(first.Id);
    }

    private void ClearHostFilter()
    {
        hostFilter = "";
    }

    private async Task SelectHost(string hostId)
    {
        selectedHostId = hostId;
        refreshInProgress = false;
        refreshStatusIsError = false;
        refreshStatus = "";
        ClearPullStatus();
        if (string.IsNullOrEmpty(selectedHostId)) return;
        await LoadImages();
        await RefreshImages();
    }

    private async Task LoadImages()
    {
        allImages = (await Store.Query<AgentImage>().ToList()).ToList();
        var selectedImages = allImages.Where(i => i.HostId == selectedHostId).ToList();
        dockerImages = selectedImages.Where(i => i.ImageType == ImageType.Docker).ToList();
        tartImages = selectedImages.Where(i => i.ImageType == ImageType.Tart).ToList();
    }

    private async Task RefreshImages()
    {
        if (string.IsNullOrEmpty(selectedHostId))
            return;

        refreshInProgress = true;
        refreshStatusIsError = false;
        var host = hosts.FirstOrDefault(h => h.Id == selectedHostId);
        refreshStatus = host == null
            ? "Requesting image refresh..."
            : $"Requesting image refresh from {host.Label}...";

        await RequestImageRefresh();
    }

    private async Task RequestImageRefresh()
    {
        var host = hosts.FirstOrDefault(h => h.Id == selectedHostId);
        if (host == null)
        {
            refreshInProgress = false;
            refreshStatusIsError = true;
            refreshStatus = "Select a host to refresh images.";
            return;
        }

        if (host.AgentStatus != AgentStatus.Online)
        {
            refreshInProgress = false;
            refreshStatusIsError = true;
            refreshStatus = $"{host.Label} is not currently online.";
            return;
        }

        try
        {
            await HostCommandDispatcher.DispatchListImagesAsync(host.Id, new ListImagesCommand());
        }
        catch (InvalidOperationException ex)
        {
            refreshInProgress = false;
            refreshStatusIsError = true;
            refreshStatus = $"Unable to request image refresh from {host.Label}: {ex.Message}";
        }
    }

    private async Task StartPull()
    {
        var host = hosts.FirstOrDefault(h => h.Id == selectedHostId);
        if (host == null)
        {
            ShowPullError("Select a host before pulling an image.");
            return;
        }

        if (host.AgentStatus != AgentStatus.Online)
        {
            ShowPullError($"{host.Label} is not currently online.");
            return;
        }

        var imageName = pullImage.Trim();
        if (string.IsNullOrWhiteSpace(imageName))
        {
            showPullForm = true;
            ShowPullError("Enter an image name to pull.");
            return;
        }

        var registry = registries.FirstOrDefault(r => r.Id == pullRegistryId);
        var tag = string.IsNullOrWhiteSpace(pullTag) ? "latest" : pullTag.Trim();
        var taskId = Guid.NewGuid().ToString("N");
        var imageReference = ImageReference.Build(registry?.RegistryUrl, imageName, tag);

        BeginPullStatus(imageReference, taskId);
        showPullForm = false;

        var command = new PullImageCommand
        {
            ImageType = pullType,
            ImageName = imageName,
            Tag = tag,
            RegistryUrl = registry?.RegistryUrl,
            Username = registry?.Username,
            Password = registry?.Password,
            TaskId = taskId
        };

        try
        {
            await HostCommandDispatcher.DispatchPullImageAsync(host.Id, command);
        }
        catch (Exception ex)
        {
            pullInProgress = false;
            pullStatusIsError = true;
            pullStatusIsSuccess = false;
            pullStatus = $"Failed to queue pull: {ex.Message}";
            activePullTaskId = null;
        }
    }

    private async Task ConfirmAndDeleteImage(AgentImage img)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete image '{img.Repository}'?");
        if (confirmed) await DeleteImage(img);
    }

    private async Task DeleteImage(AgentImage img)
    {
        var host = hosts.FirstOrDefault(h => h.Id == selectedHostId);
        if (host == null) return;

        await HostCommandDispatcher.DispatchDeleteImageAsync(host.Id, new DeleteImageCommand
        {
            ImageType = img.ImageType,
            ImageId = img.ImageId ?? img.Repository,
            ImageName = img.Repository
        });

        // Remove from local cache immediately for responsiveness
        await Store.Remove<AgentImage>(img.Id);
        await LoadImages();
    }

    private void HandlePullProgress(ImagePullProgressEvent evt)
    {
        if (!IsCurrentPullEvent(evt.HostId, evt.TaskId, evt.ImageName)) return;

        if (!string.IsNullOrWhiteSpace(evt.TaskId))
            activePullTaskId = evt.TaskId;
        if (!string.IsNullOrWhiteSpace(evt.ImageName))
            pullImageName = evt.ImageName;

        showPullStatus = true;
        pullInProgress = true;
        pullStatusIsError = false;
        pullStatusIsSuccess = false;
        pullProgress = Math.Clamp(evt.ProgressPercent, 0, 100);
        pullStatus = FormatPullProgressStatus(evt);
        InvokeAsync(StateHasChanged);
    }

    private void HandlePullComplete(ImagePullCompleteEvent evt)
    {
        if (!IsCurrentPullEvent(evt.HostId, evt.TaskId, evt.ImageName)) return;

        if (!string.IsNullOrWhiteSpace(evt.TaskId))
            activePullTaskId = evt.TaskId;
        if (!string.IsNullOrWhiteSpace(evt.ImageName))
            pullImageName = evt.ImageName;

        showPullStatus = true;
        pullInProgress = false;
        pullStatusIsError = !evt.Success;
        pullStatusIsSuccess = evt.Success;
        pullProgress = evt.Success ? 100 : pullProgress;
        pullStatus = evt.Success
            ? "Pull complete."
            : $"Pull failed: {evt.Error ?? "HostWorker did not provide an error."}";

        if (evt.Success)
        {
            InvokeAsync(async () =>
            {
                await RefreshImages();
                StateHasChanged();
            });
        }
        else
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void HandleImageDeleted(ImageDeletedEvent evt)
    {
        if (!IsSelectedHostEvent(evt.HostId)) return;
        InvokeAsync(async () =>
        {
            await RefreshImages();
            StateHasChanged();
        });
    }

    private void HandleRefreshStatus(ImageRefreshStatusEvent evt)
    {
        if (!IsSelectedHostEvent(evt.HostId)) return;

        refreshInProgress = !evt.IsComplete;
        refreshStatusIsError = !evt.Success;
        refreshStatus = evt.Message;

        InvokeAsync(async () =>
        {
            if (evt.IsComplete)
                await LoadImages();

            StateHasChanged();
        });
    }

    private bool IsSelectedHostEvent(string? hostId) =>
        !string.IsNullOrWhiteSpace(selectedHostId) &&
        !string.IsNullOrWhiteSpace(hostId) &&
        string.Equals(selectedHostId, hostId, StringComparison.OrdinalIgnoreCase);

    private bool IsCurrentPullEvent(string? hostId, string? taskId, string? imageName)
    {
        if (!IsSelectedHostEvent(hostId))
            return false;

        if (string.IsNullOrWhiteSpace(activePullTaskId))
            return true;

        if (!string.IsNullOrWhiteSpace(taskId))
            return string.Equals(activePullTaskId, taskId, StringComparison.OrdinalIgnoreCase);

        return !string.IsNullOrWhiteSpace(imageName) &&
            string.Equals(pullImageName, imageName, StringComparison.OrdinalIgnoreCase);
    }

    private void OpenPullForm()
    {
        if (!pullInProgress)
            ClearPullStatus();

        showPullForm = true;
    }

    private void ClosePullForm()
    {
        showPullForm = false;
    }

    private void BeginPullStatus(string imageReference, string taskId)
    {
        activePullTaskId = taskId;
        pullInProgress = true;
        showPullStatus = true;
        pullStatusIsError = false;
        pullStatusIsSuccess = false;
        pullImageName = imageReference;
        pullProgress = 0;
        pullStatus = "Queued pull request.";
    }

    private void ShowPullError(string message)
    {
        activePullTaskId = null;
        pullInProgress = false;
        showPullStatus = true;
        pullStatusIsError = true;
        pullStatusIsSuccess = false;
        pullProgress = 0;
        pullStatus = message;
    }

    private void ClearPullStatus()
    {
        activePullTaskId = null;
        pullInProgress = false;
        showPullStatus = false;
        pullStatusIsError = false;
        pullStatusIsSuccess = false;
        pullImageName = "";
        pullProgress = 0;
        pullStatus = "";
    }

    private static string FormatPullProgressStatus(ImagePullProgressEvent evt)
    {
        if (!string.IsNullOrWhiteSpace(evt.Status))
            return evt.Status;

        return evt.BytesDownloaded > 0 && evt.BytesTotal > 0
            ? $"{FormatSize(evt.BytesDownloaded)} / {FormatSize(evt.BytesTotal)}"
            : "Pulling...";
    }

    private static string FormatSize(long bytes)
    {
        if (bytes <= 0) return "—";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

    private static string FormatDate(DateTime? dt) =>
        dt.HasValue ? dt.Value.ToString("yyyy-MM-dd HH:mm") : "—";

    private string PullStatusTitle => string.IsNullOrWhiteSpace(pullImageName)
        ? "Pull image"
        : pullInProgress
            ? $"Pulling {pullImageName}"
            : pullStatusIsError
                ? $"Pull failed for {pullImageName}"
                : $"Pulled {pullImageName}";

    private string PullStatusIcon => pullInProgress
        ? "bi-cloud-arrow-down"
        : pullStatusIsError
            ? "bi-exclamation-triangle"
            : "bi-check-circle";

    private string PullStatusCardClass => pullStatusIsError
        ? "border-danger"
        : pullStatusIsSuccess
            ? "border-success"
            : "";

    private string PullStatusTextClass => pullStatusIsError
        ? "text-danger"
        : pullStatusIsSuccess
            ? "text-success"
            : "text-muted";

    private string PullProgressBarClass => pullStatusIsError
        ? "bg-danger"
        : pullStatusIsSuccess
            ? "bg-success"
            : "progress-bar-striped progress-bar-animated";

    private void SwitchToDocker() => SwitchTab("docker");
    private void SwitchToTart() => SwitchTab("tart");

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        searchText = "";
        sortColumn = "";
        sortAscending = true;
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIndicator(string column) =>
        sortColumn != column
            ? new MarkupString("<span class=\"text-muted\" style=\"opacity:0.3\">▲</span>")
            : new MarkupString(sortAscending ? "<span>▲</span>" : "<span>▼</span>");

    private List<AgentImage> GetFilteredSortedImages()
    {
        var source = activeTab == "docker" ? dockerImages : tartImages;
        IEnumerable<AgentImage> result = source;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var q = searchText.Trim();
            result = result.Where(i =>
                (i.Repository?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.Tag?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (i.ImageId?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (!string.IsNullOrEmpty(sortColumn))
        {
            result = (sortColumn, sortAscending) switch
            {
                ("Repository", true) => result.OrderBy(i => i.Repository, StringComparer.OrdinalIgnoreCase),
                ("Repository", false) => result.OrderByDescending(i => i.Repository, StringComparer.OrdinalIgnoreCase),
                ("Tag", true) => result.OrderBy(i => i.Tag, StringComparer.OrdinalIgnoreCase),
                ("Tag", false) => result.OrderByDescending(i => i.Tag, StringComparer.OrdinalIgnoreCase),
                ("Size", true) => result.OrderBy(i => i.SizeBytes),
                ("Size", false) => result.OrderByDescending(i => i.SizeBytes),
                ("Created", true) => result.OrderBy(i => i.ImageCreatedAt ?? DateTime.MinValue),
                ("Created", false) => result.OrderByDescending(i => i.ImageCreatedAt ?? DateTime.MinValue),
                _ => result
            };
        }

        return result.ToList();
    }

    private string GetPlatformIcon(HostPlatform platform) => platform switch
    {
        HostPlatform.Linux => "bi-ubuntu",
        HostPlatform.MacOS => "bi-apple",
        HostPlatform.Windows => "bi-windows",
        _ => "bi-pc-display"
    };

    private string GetStatusBadge(AgentStatus status) => status switch
    {
        AgentStatus.Online => "bg-success",
        AgentStatus.Connecting => "bg-warning",
        _ => "bg-secondary"
    };

    private static int HostStatusOrder(AgentStatus status) => status switch
    {
        AgentStatus.Online => 0,
        AgentStatus.Connecting => 1,
        _ => 2
    };

    private static string HostStatusGroupIcon(AgentStatus status) => status switch
    {
        AgentStatus.Online => "bi-broadcast-pin",
        AgentStatus.Connecting => "bi-arrow-repeat",
        _ => "bi-power"
    };

    private static string HostStatusGroupTitle(AgentStatus status) => status switch
    {
        AgentStatus.Online => "Online",
        AgentStatus.Connecting => "Connecting",
        _ => "Offline"
    };

    private string GetHostDescription(Host host)
    {
        if (!string.IsNullOrWhiteSpace(host.DisplayName))
            return host.Name;

        return $"{host.Platform} · {host.Architecture}";
    }

    private int GetHostImageCount(string hostId, ImageType imageType) =>
        allImages.Count(image => image.HostId == hostId && image.ImageType == imageType);

    public void Dispose()
    {
        StreamSubscriptionService.OnImageRefreshStatusReceived -= HandleRefreshStatus;
        StreamSubscriptionService.OnImagePullProgressReceived -= HandlePullProgress;
        StreamSubscriptionService.OnImagePullCompleteReceived -= HandlePullComplete;
        StreamSubscriptionService.OnImageDeletedReceived -= HandleImageDeleted;
    }
}
