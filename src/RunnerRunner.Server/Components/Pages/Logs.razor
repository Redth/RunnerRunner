@page "/logs"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Services
@using RunnerRunner.Server.Services.Logs
@using Microsoft.AspNetCore.Components
@inject IDocumentStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IHostCommandDispatcher HostCommandDispatcher
@inject ObservedLogQueryService LogQuery
@implements IDisposable

<PageTitle>Logs - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-terminal-fill"></i> Logs</h1>
    </div>
</SectionContent>

<div class="logs-console d-flex">
    <div id="logs-sidebar" class="logs-sidebar d-flex flex-column">
        <button type="button" class="log-source-card @(selectedSourceId == "all" ? "active" : "")" @onclick='() => SelectSource("all")'>
            <span><i class="bi bi-collection me-2 text-primary"></i><strong>All logs</strong></span>
            <small>Server, hosts, runners, tasks</small>
        </button>

        @foreach (var group in GroupedSources)
        {
            <div class="sidebar-section-header mt-2">
                <i class="bi @GroupIcon(group.Key) me-1"></i> @GroupTitle(group.Key)
                <span class="badge bg-secondary ms-auto">@group.Count()</span>
            </div>
            @foreach (var source in group)
            {
                <button type="button" class="log-source-card @(selectedSourceId == source.SourceId ? "active" : "")" @onclick="() => SelectSource(source.SourceId)">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi @SourceIcon(source)"></i>
                        <span class="text-truncate">@source.Name</span>
                        @if (source.IsOnline)
                        {
                            <span class="source-dot online ms-auto"></span>
                        }
                        else
                        {
                            <span class="source-dot ms-auto"></span>
                        }
                    </span>
                    @if (!string.IsNullOrWhiteSpace(source.Description))
                    {
                        <small class="text-truncate">@source.Description</small>
                    }
                </button>
            }
        }
    </div>

    <div id="logs-resize-handle" class="split-resize-handle"></div>

    <div class="logs-main flex-grow-1 d-flex flex-column">
        <div class="logs-toolbar">
            <div class="input-group input-group-sm logs-search">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Search logs..." @bind="searchQuery" @bind:event="oninput" @bind:after="FetchLogs" />
            </div>

            <select class="form-select form-select-sm" @bind="minimumLevel" @bind:after="FetchLogs">
                <option value="">All levels</option>
                @foreach (var level in LogLevels)
                {
                    <option value="@level">@level</option>
                }
            </select>

            <select class="form-select form-select-sm" @bind="streamKind" @bind:after="FetchLogs">
                <option value="">All streams</option>
                @foreach (var kind in StreamKinds)
                {
                    <option value="@kind">@kind</option>
                }
            </select>

            <input class="form-control form-control-sm logs-category" placeholder="Category" @bind="categoryFilter" @bind:event="oninput" @bind:after="FetchLogs" />

            <select class="form-select form-select-sm" @bind="tailLines" @bind:after="FetchLogs">
                <option value="100">100 lines</option>
                <option value="250">250 lines</option>
                <option value="500">500 lines</option>
                <option value="1000">1000 lines</option>
                <option value="2000">2000 lines</option>
            </select>

            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ToggleFollow" title="Auto-refresh">
                <i class="bi @(followLogs ? "bi-pause-fill" : "bi-play-fill")"></i>
                @(followLogs ? "Pause" : "Follow")
            </button>
            <button type="button" class="btn btn-sm btn-primary" @onclick="FetchLogs" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm text-primary"></span>
            }
        </div>

        <div class="logs-summary">
            <span><i class="bi bi-funnel me-1"></i>@SelectedSourceName</span>
            <span>@lastResultCount matched</span>
            @if (lastResultWasTruncated)
            {
                <span class="text-warning">tail truncated</span>
            }
            @if (!string.IsNullOrEmpty(lastFetchTime))
            {
                <span class="ms-auto"><i class="bi bi-clock me-1"></i>@lastFetchTime</span>
            }
        </div>

        <div class="logs-terminal flex-grow-1">
            <div id="rr-terminal"></div>
        </div>
    </div>
</div>

<style>
    .logs-console {
        height: calc(100vh - 120px);
        min-height: 520px;
    }
    .logs-sidebar {
        width: 320px;
        min-width: 220px;
        max-width: 560px;
        overflow-y: auto;
        padding-right: 0.25rem;
    }
    .logs-main {
        min-width: 0;
    }
    .logs-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }
    .logs-toolbar .form-select {
        width: auto;
    }
    .logs-search {
        max-width: 300px;
    }
    .logs-category {
        width: 180px;
    }
    .logs-summary {
        display: flex;
        gap: 1rem;
        align-items: center;
        color: var(--text-secondary);
        font-size: 0.75rem;
        margin-bottom: 0.5rem;
    }
    .logs-terminal {
        min-height: 320px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: #1a1b26;
        box-shadow: var(--shadow-sm);
    }
    #rr-terminal {
        width: 100%;
        height: 100%;
    }
    #rr-terminal .xterm-screen {
        padding: 0.75rem;
    }
    .log-source-card {
        display: block;
        width: 100%;
        text-align: left;
        background: transparent;
        color: var(--text-primary);
        padding: 0.55rem 0.75rem;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
        border: 1px solid transparent;
        margin-bottom: 2px;
    }
    .log-source-card:hover {
        background: var(--bg-hover);
    }
    .log-source-card.active {
        background: var(--accent-soft);
        border-color: var(--accent);
        box-shadow: inset 3px 0 0 var(--accent);
    }
    .log-source-card small {
        display: block;
        color: var(--text-secondary);
        font-size: 0.72rem;
        margin-top: 0.1rem;
    }
    .sidebar-section-header {
        display: flex;
        align-items: center;
        padding: 0.35rem 0.75rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
    }
    .source-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: var(--text-tertiary);
        flex: 0 0 auto;
    }
    .source-dot.online {
        background: var(--success);
        box-shadow: 0 0 0 3px var(--success-soft);
    }
    .split-resize-handle {
        width: 6px;
        cursor: col-resize;
        background: transparent;
        transition: background 0.15s;
        flex-shrink: 0;
        border-radius: 3px;
        margin: 0 4px;
    }
    .split-resize-handle:hover, .split-resize-handle:active {
        background: var(--accent);
        opacity: 0.5;
    }
</style>

@code {
    private List<Host> hosts = [];
    private List<RunnerInstance> runnerInstances = [];
    private IReadOnlyList<ObservedLogSource> sources = [];
    private string selectedSourceId = "all";
    private int tailLines = 250;
    private bool isLoading;
    private bool termInitialized;
    private bool followLogs;
    private string searchQuery = "";
    private string categoryFilter = "";
    private string? minimumLevel;
    private string? streamKind;
    private string lastFetchTime = "";
    private int lastResultCount;
    private bool lastResultWasTruncated;
    private PeriodicTimer? followTimer;
    private CancellationTokenSource? followCts;
    private TaskCompletionSource<string>? hostLogsTcs;
    private TaskCompletionSource<string>? runnerLogsTcs;

    private static readonly ObservedLogLevel[] LogLevels =
    [
        ObservedLogLevel.Trace,
        ObservedLogLevel.Debug,
        ObservedLogLevel.Information,
        ObservedLogLevel.Warning,
        ObservedLogLevel.Error,
        ObservedLogLevel.Critical
    ];

    private static readonly ObservedLogStreamKind[] StreamKinds = Enum.GetValues<ObservedLogStreamKind>();

    private IEnumerable<IGrouping<ObservedLogSourceType, ObservedLogSource>> GroupedSources =>
        sources
            .Where(s => s.SourceId != "all")
            .GroupBy(s => s.SourceType)
            .OrderBy(g => GroupOrder(g.Key));

    private string SelectedSourceName =>
        selectedSourceId == "all"
            ? "All logs"
            : sources.FirstOrDefault(s => s.SourceId == selectedSourceId)?.Name ?? selectedSourceId;

    protected override async Task OnInitializedAsync()
    {
        StreamSubscriptionService.OnHostLogsReceived += OnHostLogsReceived;
        StreamSubscriptionService.OnRunnerLogsReceived += OnRunnerLogsReceived;
        await LoadSources();

        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        selectedSourceId = NormalizeSource(query["source"]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        termInitialized = await JS.InvokeAsync<bool>("rrTerminal.init", "rr-terminal", new { darkMode = true });
        await JS.InvokeVoidAsync("rrSplitPane.init", "logs-resize-handle", "logs-sidebar", "rr-logs-sidebar-width", 220, 560);
        await FetchLogs();
    }

    private async Task LoadSources()
    {
        hosts = (await Store.Query<Host>().ToList())
            .OrderByDescending(h => h.AgentStatus == AgentStatus.Online)
            .ThenBy(h => h.Label)
            .ToList();
        runnerInstances = (await Store.Query<RunnerInstance>().ToList())
            .Where(CapacityPlanningService.IsRunnerRunnerManaged)
            .OrderBy(r => r.RunnerName)
            .ToList();
        sources = await LogQuery.GetSourcesAsync();
    }

    private async Task SelectSource(string sourceId)
    {
        selectedSourceId = sourceId;
        await FetchLogs();
    }

    private async Task FetchLogs()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            await LoadSources();
            var directTail = await RequestLiveTailIfNeeded();

            var result = await LogQuery.QueryAsync(BuildQuery());
            lastResultCount = result.TotalMatched;
            lastResultWasTruncated = result.IsTruncated;
            lastFetchTime = DateTime.Now.ToString("HH:mm:ss");

            var text = result.Entries.Count == 0
                ? string.IsNullOrWhiteSpace(directTail) ? BuildEmptyMessage() : directTail
                : string.Join('\n', result.Entries.Select(FormatEntry));
            await WriteToTerminal(text);
        }
        catch (Exception ex)
        {
            await WriteToTerminal($"\x1b[31mError loading logs: {ex.Message}\x1b[0m");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private ObservedLogQuery BuildQuery()
    {
        var query = new ObservedLogQuery
        {
            Tail = tailLines,
            SearchText = string.IsNullOrWhiteSpace(searchQuery) ? null : searchQuery,
            Category = string.IsNullOrWhiteSpace(categoryFilter) ? null : categoryFilter,
            MinimumLevel = Enum.TryParse<ObservedLogLevel>(minimumLevel, out var level) ? level : null,
            StreamKind = Enum.TryParse<ObservedLogStreamKind>(streamKind, out var kind) ? kind : null
        };

        var source = sources.FirstOrDefault(s => s.SourceId == selectedSourceId);
        if (source == null || selectedSourceId == "all")
            return query;

        query.SourceId = source.SourceId;
        query.SourceType = source.SourceType;
        query.HostId = source.HostId;
        query.RunnerInstanceId = source.RunnerInstanceId;
        query.TaskId = source.TaskId;
        return query;
    }

    private async Task<string?> RequestLiveTailIfNeeded()
    {
        var source = sources.FirstOrDefault(s => s.SourceId == selectedSourceId);
        if (source?.SourceType == ObservedLogSourceType.Host && source.HostId != null)
        {
            var host = hosts.FirstOrDefault(h => h.Id == source.HostId);
            if (host?.AgentStatus == AgentStatus.Online)
            {
                hostLogsTcs = new TaskCompletionSource<string>();
                await HostCommandDispatcher.DispatchGetHostLogsAsync(host.Id, new GetHostLogsCommand { TailLines = tailLines });
                var completed = await Task.WhenAny(hostLogsTcs.Task, Task.Delay(TimeSpan.FromSeconds(4)));
                if (completed == hostLogsTcs.Task)
                    return await hostLogsTcs.Task;
            }
        }
        else if (source?.SourceType == ObservedLogSourceType.Runner && source.RunnerInstanceId != null)
        {
            var runner = runnerInstances.FirstOrDefault(r => r.Id == source.RunnerInstanceId);
            var host = runner == null ? null : hosts.FirstOrDefault(h => h.Id == runner.HostId);
            if (runner != null && host?.AgentStatus == AgentStatus.Online)
            {
                var handle = runner.ContainerId ?? runner.VmName ?? runner.ProcessId?.ToString() ?? runner.RunnerName;
                runnerLogsTcs = new TaskCompletionSource<string>();
                await HostCommandDispatcher.DispatchGetRunnerLogsAsync(host.Id, new GetRunnerLogsCommand { InstanceHandle = handle, TailLines = tailLines });
                var completed = await Task.WhenAny(runnerLogsTcs.Task, Task.Delay(TimeSpan.FromSeconds(4)));
                if (completed == runnerLogsTcs.Task)
                    return await runnerLogsTcs.Task;
            }
        }

        return null;
    }

    private async Task WriteToTerminal(string text)
    {
        if (!termInitialized)
            return;

        await JS.InvokeVoidAsync("rrTerminal.clear", "rr-terminal");
        foreach (var line in text.Split('\n'))
            await JS.InvokeVoidAsync("rrTerminal.writeln", "rr-terminal", line.TrimEnd('\r'));
    }

    private string BuildEmptyMessage()
    {
        var source = sources.FirstOrDefault(s => s.SourceId == selectedSourceId);
        if (source?.SourceType == ObservedLogSourceType.Server)
            return "\x1b[33mNo server logs captured yet.\x1b[0m\n\x1b[90mNew application logs will appear here as the server writes through ILogger.\x1b[0m";
        if (source?.SourceType == ObservedLogSourceType.Host && !source.IsOnline)
            return "\x1b[33mHost is offline.\x1b[0m\n\x1b[90mCached HostWorker frames will appear here when available.\x1b[0m";
        if (source?.SourceType == ObservedLogSourceType.Runner)
            return "\x1b[33mNo runner logs are cached yet.\x1b[0m\n\x1b[90mRefresh while the host is online to request a live tail from the HostWorker.\x1b[0m";
        return "\x1b[90mNo logs matched the current filters.\x1b[0m";
    }

    private static string FormatEntry(ObservedLogEntry entry)
    {
        var color = entry.Level switch
        {
            ObservedLogLevel.Trace or ObservedLogLevel.Debug => "\x1b[90m",
            ObservedLogLevel.Warning => "\x1b[33m",
            ObservedLogLevel.Error or ObservedLogLevel.Critical => "\x1b[31m",
            _ => "\x1b[0m"
        };
        var source = entry.SourceName;
        var category = string.IsNullOrWhiteSpace(entry.Category) ? "" : $" \x1b[90m{entry.Category}\x1b[0m";
        var message = string.IsNullOrWhiteSpace(entry.RenderedMessage) ? entry.Message : entry.RenderedMessage;
        return $"{color}{entry.Timestamp.LocalDateTime:HH:mm:ss.fff} {entry.Level,-11}\x1b[0m \x1b[36m{source}\x1b[0m{category} {message}";
    }

    private string NormalizeSource(string? source)
    {
        if (string.IsNullOrWhiteSpace(source))
            return "all";
        if (source.Equals("server", StringComparison.OrdinalIgnoreCase))
            return "server";
        if (source.StartsWith("agent:", StringComparison.OrdinalIgnoreCase))
            source = "host:" + source["agent:".Length..];
        if (source.StartsWith("host:", StringComparison.OrdinalIgnoreCase))
        {
            var value = source["host:".Length..];
            var host = hosts.FirstOrDefault(h =>
                string.Equals(h.Id, value, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(h.Name, value, StringComparison.OrdinalIgnoreCase));
            return host == null ? "all" : $"host:{host.Id}";
        }
        if (source.StartsWith("runner:", StringComparison.OrdinalIgnoreCase))
        {
            var value = source["runner:".Length..];
            return runnerInstances.Any(r => string.Equals(r.Id, value, StringComparison.OrdinalIgnoreCase))
                ? $"runner:{value}"
                : "all";
        }
        if (source.StartsWith("task:", StringComparison.OrdinalIgnoreCase))
            return source;
        return source;
    }

    private async Task ToggleFollow()
    {
        followLogs = !followLogs;
        if (followLogs)
        {
            followCts = new CancellationTokenSource();
            followTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            _ = RunFollowLoopAsync(followCts.Token);
        }
        else
        {
            followCts?.Cancel();
            followTimer?.Dispose();
        }
        await Task.CompletedTask;
    }

    private async Task RunFollowLoopAsync(CancellationToken ct)
    {
        try
        {
            while (followTimer != null && await followTimer.WaitForNextTickAsync(ct))
                await InvokeAsync(FetchLogs);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnHostLogsReceived(HostLogsEvent evt)
    {
        hostLogsTcs?.TrySetResult(evt.Logs ?? "");
    }

    private void OnRunnerLogsReceived(RunnerLogsEvent evt)
    {
        runnerLogsTcs?.TrySetResult(evt.Logs ?? "");
    }

    private static int GroupOrder(ObservedLogSourceType sourceType) => sourceType switch
    {
        ObservedLogSourceType.Server => 0,
        ObservedLogSourceType.Grain => 1,
        ObservedLogSourceType.Host => 2,
        ObservedLogSourceType.Runner => 3,
        ObservedLogSourceType.Task => 4,
        _ => 9
    };

    private static string GroupTitle(ObservedLogSourceType sourceType) => sourceType switch
    {
        ObservedLogSourceType.Server => "Server",
        ObservedLogSourceType.Grain => "Grains",
        ObservedLogSourceType.Host => "Hosts",
        ObservedLogSourceType.Runner => "Runners",
        ObservedLogSourceType.Task => "Tasks",
        ObservedLogSourceType.Provider => "Providers",
        ObservedLogSourceType.Command => "Commands",
        _ => sourceType.ToString()
    };

    private static string GroupIcon(ObservedLogSourceType sourceType) => sourceType switch
    {
        ObservedLogSourceType.Server => "bi-hdd-rack-fill",
        ObservedLogSourceType.Grain => "bi-diagram-3-fill",
        ObservedLogSourceType.Host => "bi-pc-display",
        ObservedLogSourceType.Runner => "bi-lightning-charge",
        ObservedLogSourceType.Task => "bi-list-task",
        _ => "bi-terminal"
    };

    private static string SourceIcon(ObservedLogSource source) => source.SourceType switch
    {
        ObservedLogSourceType.Server => "bi-hdd-rack-fill text-primary",
        ObservedLogSourceType.Grain => "bi-diagram-3-fill text-info",
        ObservedLogSourceType.Host => "bi-pc-display text-success",
        ObservedLogSourceType.Runner => "bi-lightning-charge text-warning",
        ObservedLogSourceType.Task => "bi-list-task text-primary",
        _ => "bi-terminal"
    };

    public void Dispose()
    {
        StreamSubscriptionService.OnHostLogsReceived -= OnHostLogsReceived;
        StreamSubscriptionService.OnRunnerLogsReceived -= OnRunnerLogsReceived;
        followCts?.Cancel();
        followTimer?.Dispose();
        try { _ = JS.InvokeVoidAsync("rrTerminal.dispose", "rr-terminal"); }
        catch { }
    }
}
