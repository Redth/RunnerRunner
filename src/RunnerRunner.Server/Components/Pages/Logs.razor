@page "/logs"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Services
@using RunnerRunner.Server.Services.HostWorkers
@using Microsoft.AspNetCore.Components
@inject IDocumentStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IGrainFactory GrainFactory
@inject IHostCommandDispatcher HostCommandDispatcher
@inject HostWorkerLogCache HostWorkerLogCache
@implements IDisposable

<PageTitle>Logs - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-terminal-fill"></i> Logs</h1>
    </div>
</SectionContent>

<div class="split-pane-container d-flex" style="height: calc(100vh - 120px);">
    @* Left sidebar *@
    <div id="logs-sidebar" class="split-pane-sidebar d-flex flex-column" style="width: 260px; min-width: 180px; max-width: 500px; overflow-y: auto;">
        @* Server card *@
        <div class="log-source-card @(selectedSource == "server" ? "active" : "")"
             @onclick='() => SelectSource("server")'>
            <div class="d-flex align-items-center">
                <i class="bi bi-hdd-rack-fill me-2 text-primary"></i>
                <strong>Server</strong>
            </div>
            <small class="text-muted">Overview &amp; status</small>
        </div>

        @* Agents section *@
        <div class="sidebar-section-header mt-2">
            <i class="bi bi-pc-display me-1"></i> Hosts
            <span class="badge bg-secondary ms-auto">@hosts.Count</span>
        </div>
        @foreach (var h in hosts)
        {
            var src = $"host:{h.Name}";
            <div class="log-source-card @(selectedSource == src ? "active" : "")"
                 @onclick="() => SelectSource(src)">
                <div class="d-flex align-items-center">
                    <i class="bi @GetPlatformIcon(h.Platform) me-2"></i>
                    <span class="text-truncate">@h.Label</span>
                    <span class="badge ms-auto @GetStatusBadge(h.AgentStatus)" style="font-size: 0.65rem;">@h.AgentStatus</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(h.DisplayName))
                {
                    <small class="text-muted text-truncate d-block" style="font-size: 0.7rem;">@h.Name</small>
                }
            </div>
        }

        @* Runners section *@
        @if (runnerInstances.Any())
        {
            <div class="sidebar-section-header mt-2">
                <i class="bi bi-lightning-charge me-1"></i> Runners
                <span class="badge bg-secondary ms-auto">@runnerInstances.Count</span>
            </div>
            @foreach (var inst in runnerInstances)
            {
                var src = $"runner:{inst.Id}";
                <div class="log-source-card @(selectedSource == src ? "active" : "")"
                     @onclick="() => SelectSource(src)">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-lightning-charge me-2"></i>
                        <span class="text-truncate">@inst.RunnerName</span>
                        <span class="badge ms-auto @GetRunnerStatusBadge(inst.Status)" style="font-size: 0.65rem;">@inst.Status</span>
                    </div>
                    <small class="text-muted text-truncate d-block" style="font-size: 0.7rem;">@(hostNames.GetValueOrDefault(inst.HostId, "?"))</small>
                </div>
            }
        }
    </div>

    @* Resize handle *@
    <div id="logs-resize-handle" class="split-resize-handle"></div>

    @* Main content *@
    <div class="split-pane-main flex-grow-1 d-flex flex-column" style="min-width: 0;">
        @* Toolbar *@
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <div class="input-group" style="max-width: 250px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control form-control-sm" placeholder="Search in logs..."
                       @bind="searchQuery" @bind:event="oninput" @bind:after="DoSearch" />
            </div>
            <div class="d-flex align-items-center gap-1">
                <button class="btn btn-sm btn-outline-secondary" @onclick="SearchPrevious" title="Previous match" disabled="@string.IsNullOrEmpty(searchQuery)">
                    <i class="bi bi-chevron-up"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SearchNext" title="Next match" disabled="@string.IsNullOrEmpty(searchQuery)">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
            <select class="form-select form-select-sm" style="width: auto;" @bind="tailLines">
                <option value="50">50 lines</option>
                <option value="100">100 lines</option>
                <option value="200">200 lines</option>
                <option value="500">500 lines</option>
                <option value="1000">1000 lines</option>
            </select>
            <button class="btn btn-sm btn-primary" @onclick="FetchLogs" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm text-primary"></span>
            }
            <span class="ms-auto text-muted" style="font-size: 0.75rem;">
                @if (!string.IsNullOrEmpty(lastFetchTime))
                {
                    <i class="bi bi-clock me-1"></i>@lastFetchTime
                }
            </span>
        </div>

        @* Terminal container *@
        <div class="flex-grow-1 rounded overflow-hidden border" style="min-height: 300px;">
            <div id="rr-terminal" style="width: 100%; height: 100%;"></div>
        </div>
        <div class="text-muted mt-2" style="font-size: 0.75rem;">
            Host and runner logs are loaded on demand from HostWorker when available.
        </div>
    </div>
</div>

<style>
    .log-source-card {
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
        border: 1px solid transparent;
        margin-bottom: 2px;
    }
    .log-source-card:hover {
        background: var(--bg-secondary, #f0f0f0);
    }
    .log-source-card.active {
        background: var(--bg-tertiary, #e8e8e8);
        border-color: var(--bs-primary);
        box-shadow: inset 3px 0 0 var(--bs-primary);
    }
    .sidebar-section-header {
        display: flex;
        align-items: center;
        padding: 0.35rem 0.75rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted, #6c757d);
    }
    .split-resize-handle {
        width: 6px;
        cursor: col-resize;
        background: transparent;
        transition: background 0.15s;
        flex-shrink: 0;
        border-radius: 3px;
        margin: 0 2px;
    }
    .split-resize-handle:hover, .split-resize-handle:active {
        background: var(--bs-primary);
        opacity: 0.4;
    }
    /* Terminal internal padding */
    #rr-terminal .xterm-screen {
        padding: 0.75rem;
    }
    #rr-terminal {
        background: #1a1b26;
    }
</style>

@code {
    private List<Host> hosts = [];
    private List<RunnerInstance> runnerInstances = [];
    private Dictionary<string, string> hostNames = [];
    private string selectedSource = "server";
    private int tailLines = 100;
    private string logContent = "";
    private bool isLoading;
    private bool termInitialized;
    private string searchQuery = "";
    private string lastFetchTime = "";
    private TaskCompletionSource<string>? _hostLogsTcs;
    private TaskCompletionSource<string>? _runnerLogsTcs;

    protected override async Task OnInitializedAsync()
    {
        await LoadSources();
        StreamSubscriptionService.OnHostLogsReceived += OnHostLogsReceived;
        StreamSubscriptionService.OnRunnerLogsReceived += OnRunnerLogsReceived;

        // Check for query string parameter
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var source = query["source"];
        if (!string.IsNullOrEmpty(source))
            selectedSource = source;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitTerminal();
            await JS.InvokeVoidAsync("rrSplitPane.init", "logs-resize-handle", "logs-sidebar", "rr-logs-sidebar-width", 180, 500);
            await FetchLogs();
        }
    }

    private async Task InitTerminal()
    {
        try
        {
            var isDark = true; // default to dark for terminal
            termInitialized = await JS.InvokeAsync<bool>("rrTerminal.init", "rr-terminal", new { darkMode = isDark });
        }
        catch { termInitialized = false; }
    }

    private async Task WriteToTerminal(string text)
    {
        if (!termInitialized) return;
        try
        {
            await JS.InvokeVoidAsync("rrTerminal.clear", "rr-terminal");
            // Write line by line for proper rendering
            foreach (var line in text.Split('\n'))
            {
                await JS.InvokeVoidAsync("rrTerminal.writeln", "rr-terminal", line);
            }
        }
        catch { /* JS interop may fail during disposal */ }
    }

    private async Task SelectSource(string source)
    {
        selectedSource = source;
        await FetchLogs();
    }

    private async Task FetchLogs()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            await LoadSources();

            if (selectedSource == "server")
            {
                logContent = await GetServerLogsAsync();
            }
            else if (selectedSource.StartsWith("host:"))
            {
                var hostName = selectedSource["host:".Length..];
                logContent = await GetAgentLogsAsync(hostName);
            }
            else if (selectedSource.StartsWith("runner:"))
            {
                var instanceId = selectedSource["runner:".Length..];
                logContent = await GetRunnerLogsAsync(instanceId);
            }

            lastFetchTime = DateTime.Now.ToString("HH:mm:ss");
            await WriteToTerminal(logContent);
        }
        catch (Exception ex)
        {
            logContent = $"Error fetching logs: {ex.Message}";
            await WriteToTerminal(logContent);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DoSearch()
    {
        if (!termInitialized || string.IsNullOrEmpty(searchQuery)) return;
        try { await JS.InvokeAsync<bool>("rrTerminal.search", "rr-terminal", searchQuery); }
        catch { }
    }

    private async Task SearchNext()
    {
        if (!termInitialized || string.IsNullOrEmpty(searchQuery)) return;
        try { await JS.InvokeAsync<bool>("rrTerminal.search", "rr-terminal", searchQuery); }
        catch { }
    }

    private async Task SearchPrevious()
    {
        if (!termInitialized || string.IsNullOrEmpty(searchQuery)) return;
        try { await JS.InvokeAsync<bool>("rrTerminal.searchPrevious", "rr-terminal", searchQuery); }
        catch { }
    }

    private async Task<string> GetRunnerLogsAsync(string instanceId)
    {
        var instance = runnerInstances.FirstOrDefault(i => i.Id == instanceId);
        if (instance == null) return "\x1b[31mRunner instance not found.\x1b[0m";

        var host = hosts.FirstOrDefault(h => h.Id == instance.HostId);
        if (host == null) return "\x1b[31mHost not found.\x1b[0m";

        if (host.AgentStatus != AgentStatus.Online)
        {
            var cached = GetCachedRunnerLogs(host.Id, instance);
            if (!string.IsNullOrWhiteSpace(cached))
                return cached;

            var lines = new List<string>
            {
                $"\x1b[1;36m=== Runner: {instance.RunnerName} ===\x1b[0m",
                $"\x1b[90mHost: {host.Label}\x1b[0m",
                $"Status: \x1b[1m{instance.Status}\x1b[0m",
                $"Mode: {GetModeLabel(instance)}",
            };

            if (!string.IsNullOrWhiteSpace(instance.StatusMessage))
                lines.Add($"Detail: {instance.StatusMessage}");

            lines.Add("");
            lines.Add("\x1b[33mDirect live log streaming is unavailable because this HostWorker is offline.\x1b[0m");
            lines.Add("\x1b[90mThe runner is tracked by the Orleans lifecycle model, but live log streaming requires an online HostWorker.\x1b[0m");
            lines.Add("");
            lines.AddRange(GetManualLogHints(host, instance));
            return string.Join("\n", lines);
        }

        var handle = instance.ContainerId ?? instance.RunnerName;
        _runnerLogsTcs = new TaskCompletionSource<string>();
        var command = new GetRunnerLogsCommand { InstanceHandle = handle, TailLines = tailLines };

        await HostCommandDispatcher.DispatchGetRunnerLogsAsync(host.Id, command);

        var completedTask = await Task.WhenAny(_runnerLogsTcs.Task, Task.Delay(TimeSpan.FromSeconds(10)));
        if (completedTask == _runnerLogsTcs.Task)
            return await _runnerLogsTcs.Task;

        var cachedTail = GetCachedRunnerLogs(host.Id, instance);
        return !string.IsNullOrWhiteSpace(cachedTail)
            ? cachedTail
            : $"\x1b[33mTimeout waiting for logs from host.\x1b[0m";
    }

    private void OnRunnerLogsReceived(RunnerLogsEvent evt)
    {
        _runnerLogsTcs?.TrySetResult(evt.Logs ?? "(empty)");
        InvokeAsync(StateHasChanged);
    }

    private Task<string> GetServerLogsAsync()
    {
        var lines = new List<string>();
        lines.Add("\x1b[1;36m=== RunnerRunner Server Status ===\x1b[0m");
        lines.Add($"\x1b[90mTimestamp: {DateTime.UtcNow:u}\x1b[0m");
        lines.Add("");

        var onlineHosts = hosts.Count(h => h.AgentStatus == AgentStatus.Online);

        lines.Add($"\x1b[1mHosts online in cluster:\x1b[0m {onlineHosts}/{hosts.Count}");
        lines.Add($"\x1b[1mLive HostWorker log sources:\x1b[0m {onlineHosts}");
        lines.Add("");

        foreach (var host in hosts.OrderBy(h => h.Label))
        {
            var lastHb = host.LastHeartbeat?.ToString("HH:mm:ss") ?? "never";
            var runners = runnerInstances.Count(i => i.HostId == host.Id);
            var statusColor = host.AgentStatus == AgentStatus.Online ? "\x1b[32m" : "\x1b[90m";
            var bridge = host.AgentStatus == AgentStatus.Online ? "live logs available" : "summary only";
            lines.Add($"  {statusColor}●\x1b[0m {host.Label} \x1b[90m({host.Platform} {host.Architecture})\x1b[0m — heartbeat: {lastHb}, runners: \x1b[1m{runners}\x1b[0m, log access: {bridge}");
        }

        if (!hosts.Any())
            lines.Add("  \x1b[33mNo hosts registered\x1b[0m");

        lines.Add("");
        lines.Add("\x1b[90mFor full server container logs:\x1b[0m");
        lines.Add("\x1b[90m  ssh root@<linux-host> 'cd /opt/stacks/runnerrunner && docker compose logs server --tail 100'\x1b[0m");

        return Task.FromResult(string.Join("\n", lines));
    }

    private async Task<string> GetAgentLogsAsync(string hostName)
    {
        var host = hosts.FirstOrDefault(h => h.Name == hostName);
        if (host == null) return "\x1b[31mHost not found.\x1b[0m";

        var lines = new List<string>();
        lines.Add($"\x1b[1;36m=== Host: {host.Label} ===\x1b[0m");
        lines.Add($"\x1b[90mPlatform: {host.Platform} {host.Architecture}\x1b[0m");
        lines.Add($"Status: {(host.AgentStatus == AgentStatus.Online ? "\x1b[32m" : "\x1b[33m")}{host.AgentStatus}\x1b[0m");
        lines.Add($"Last heartbeat: {host.LastHeartbeat?.ToString("u") ?? "never"}");
        if (host.Capabilities.Any())
            lines.Add($"Capabilities: \x1b[90m{string.Join(", ", host.Capabilities)}\x1b[0m");
        lines.Add("");

        if (host.AgentStatus == AgentStatus.Online)
        {
            lines.Add($"\x1b[1mLive host log tail:\x1b[0m last {tailLines} lines");
            lines.Add("\x1b[90mLoaded on demand from HostWorker.\x1b[0m");
            lines.Add("");

            var liveLogs = await RequestHostLogsAsync(host);
            if (!string.IsNullOrWhiteSpace(liveLogs))
                lines.Add(liveLogs);

            lines.Add("");
        }
        else
        {
            lines.Add("\x1b[33mDirect live host log streaming is unavailable because this HostWorker is offline.\x1b[0m");
            lines.Add("\x1b[90mThis host is registered with the cluster, but live log streaming requires an online HostWorker.\x1b[0m");
            var cachedTail = HostWorkerLogCache.GetTextTail(host.Id, "worker.process", tailLines);
            if (!string.IsNullOrWhiteSpace(cachedTail))
            {
                lines.Add("");
                lines.Add($"\x1b[1mCached host log tail:\x1b[0m last {tailLines} frames retained by the server");
                lines.Add(cachedTail);
            }
            lines.Add("");
        }

        var instances = (await Store.Query<RunnerInstance>().ToList())
            .Where(i => IsManagedInstance(i) && i.HostId == host.Id)
            .ToList();

        if (instances.Count > 0)
        {
            lines.Add($"\x1b[1mRunner instances:\x1b[0m {instances.Count}");
            foreach (var inst in instances.OrderByDescending(i => i.StartedAt ?? i.CreatedAt))
            {
                var statusIcon = inst.Status == RunnerInstanceStatus.Running ? "\x1b[32m●\x1b[0m" :
                                 inst.Status == RunnerInstanceStatus.Failed ? "\x1b[31m●\x1b[0m" : "\x1b[90m●\x1b[0m";
                var cid = inst.ContainerId?[..Math.Min(12, inst.ContainerId?.Length ?? 0)] ?? "—";
                lines.Add($"  {statusIcon} {inst.RunnerName} — \x1b[1m{inst.Status}\x1b[0m (started: {inst.StartedAt?.ToString("HH:mm:ss") ?? "—"}, container: \x1b[90m{cid}\x1b[0m)");
                if (inst.ErrorMessage != null)
                    lines.Add($"    \x1b[31mError: {inst.ErrorMessage}\x1b[0m");
            }
        }
        else
        {
            lines.Add("\x1b[90mNo runner instances on this host.\x1b[0m");
        }

        lines.Add("");
        if (host.AgentStatus != AgentStatus.Online)
            lines.AddRange(GetManualLogHints(host));

        return string.Join("\n", lines);
    }

    private async Task LoadSources()
    {
        hosts = (await Store.Query<Host>().ToList())
            .OrderByDescending(h => h.AgentStatus == AgentStatus.Online)
            .ThenBy(h => h.Label)
            .ToList();

        hostNames = hosts.ToDictionary(h => h.Id, h => h.Label);

        runnerInstances = (await Store.Query<RunnerInstance>().ToList())
            .Where(i => IsManagedInstance(i) &&
                        i.Status is RunnerInstanceStatus.Running or RunnerInstanceStatus.Starting)
            .OrderBy(i => hostNames.GetValueOrDefault(i.HostId, i.HostId))
            .ThenBy(i => i.RunnerName)
            .ToList();

        if (selectedSource.StartsWith("runner:") &&
            !runnerInstances.Any(i => $"runner:{i.Id}" == selectedSource))
        {
            selectedSource = "server";
        }
    }

    private static bool IsManagedInstance(RunnerInstance instance) =>
        CapacityPlanningService.IsRunnerRunnerManaged(instance);

    private async Task<string> RequestHostLogsAsync(Host host)
    {
        _hostLogsTcs = new TaskCompletionSource<string>();
        await HostCommandDispatcher.DispatchGetHostLogsAsync(host.Id, new GetHostLogsCommand
        {
            TailLines = tailLines
        });

        var completedTask = await Task.WhenAny(_hostLogsTcs.Task, Task.Delay(TimeSpan.FromSeconds(10)));
        if (completedTask == _hostLogsTcs.Task)
            return await _hostLogsTcs.Task;

        var cachedTail = HostWorkerLogCache.GetTextTail(host.Id, "worker.process", tailLines);
        return !string.IsNullOrWhiteSpace(cachedTail)
            ? cachedTail
            : "\x1b[33mTimeout waiting for host logs.\x1b[0m";
    }

    private string GetCachedRunnerLogs(string hostId, RunnerInstance instance)
    {
        var streamId = GetRunnerLogStreamId(instance);
        return HostWorkerLogCache.GetTextTail(hostId, streamId, tailLines);
    }

    private static string GetRunnerLogStreamId(RunnerInstance instance)
        => $"runner.{instance.ContainerId ?? instance.RunnerName}";

    private void OnHostLogsReceived(HostLogsEvent evt)
    {
        _hostLogsTcs?.TrySetResult(evt.Logs ?? "(empty)");
        InvokeAsync(StateHasChanged);
    }

    private string GetModeLabel(RunnerInstance instance) =>
        string.Equals(instance.ProvisioningMode, "dynamic", StringComparison.OrdinalIgnoreCase)
            ? "Dynamic"
            : "Static";

    private IEnumerable<string> GetManualLogHints(Host host, RunnerInstance? instance = null)
    {
        var lines = new List<string> { "\x1b[90mManual log access:\x1b[0m" };

        if (host.Platform == HostPlatform.Linux)
        {
            lines.Add($"\x1b[90m  ssh root@<linux-host> 'cd /opt/stacks/runnerrunner && docker compose logs server --tail {tailLines}'\x1b[0m");
        }
        else if (host.Platform == HostPlatform.MacOS)
        {
            lines.Add($"\x1b[90m  ssh <user>@{host.Name} 'tail -{tailLines} /tmp/runnerrunner-hostworker.log'\x1b[0m");
        }
        else
        {
            lines.Add("\x1b[90m  Check the local HostWorker service logs on the target machine.\x1b[0m");
        }

        if (instance != null)
        {
            lines.Add($"\x1b[90m  Runner: {instance.RunnerName} ({instance.Id})\x1b[0m");
        }

        return lines;
    }

    private string GetPlatformIcon(HostPlatform platform) => platform switch
    {
        HostPlatform.Linux => "bi-ubuntu",
        HostPlatform.MacOS => "bi-apple",
        HostPlatform.Windows => "bi-windows",
        _ => "bi-pc-display"
    };

    private string GetStatusBadge(AgentStatus status) => status switch
    {
        AgentStatus.Online => "bg-success",
        AgentStatus.Connecting => "bg-warning",
        _ => "bg-secondary"
    };

    private string GetRunnerStatusBadge(RunnerInstanceStatus status) => status switch
    {
        RunnerInstanceStatus.Running => "bg-success",
        RunnerInstanceStatus.Starting => "bg-info",
        RunnerInstanceStatus.Failed or RunnerInstanceStatus.Crashed => "bg-danger",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        StreamSubscriptionService.OnHostLogsReceived -= OnHostLogsReceived;
        StreamSubscriptionService.OnRunnerLogsReceived -= OnRunnerLogsReceived;
        try { _ = JS.InvokeVoidAsync("rrTerminal.dispose", "rr-terminal"); }
        catch { }
    }
}
