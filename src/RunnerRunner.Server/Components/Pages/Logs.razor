@page "/logs"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Hubs
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.Components
@inject IDocumentStore Store
@inject IHubContext<AgentHub, IAgentHubClient> HubContext
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Logs - RunnerRunner</PageTitle>

<h1 class="mb-3"><i class="bi bi-terminal-fill me-2"></i>Logs</h1>

<div class="d-flex" style="height: calc(100vh - 160px); gap: 1rem;">
    @* Left sidebar *@
    <div class="d-flex flex-column" style="width: 260px; min-width: 220px; overflow-y: auto;">
        @* Server card *@
        <div class="log-source-card @(selectedSource == "server" ? "active" : "")"
             @onclick='() => SelectSource("server")'>
            <div class="d-flex align-items-center">
                <i class="bi bi-hdd-rack-fill me-2 text-primary"></i>
                <strong>Server</strong>
            </div>
            <small class="text-muted">Overview &amp; status</small>
        </div>

        @* Agents section *@
        <div class="sidebar-section-header mt-2">
            <i class="bi bi-pc-display me-1"></i> Agents
            <span class="badge bg-secondary ms-auto">@hosts.Count</span>
        </div>
        @foreach (var h in hosts)
        {
            var src = $"agent:{h.Name}";
            <div class="log-source-card @(selectedSource == src ? "active" : "")"
                 @onclick="() => SelectSource(src)">
                <div class="d-flex align-items-center">
                    <i class="bi @GetPlatformIcon(h.Platform) me-2"></i>
                    <span class="text-truncate">@h.Label</span>
                    <span class="badge ms-auto @GetAgentStatusBadge(h.AgentStatus)" style="font-size: 0.65rem;">@h.AgentStatus</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(h.DisplayName))
                {
                    <small class="text-muted text-truncate d-block" style="font-size: 0.7rem;">@h.Name</small>
                }
            </div>
        }

        @* Runners section *@
        @if (runnerInstances.Any())
        {
            <div class="sidebar-section-header mt-2">
                <i class="bi bi-lightning-charge me-1"></i> Runners
                <span class="badge bg-secondary ms-auto">@runnerInstances.Count</span>
            </div>
            @foreach (var inst in runnerInstances)
            {
                var src = $"runner:{inst.Id}";
                <div class="log-source-card @(selectedSource == src ? "active" : "")"
                     @onclick="() => SelectSource(src)">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-lightning-charge me-2"></i>
                        <span class="text-truncate">@inst.RunnerName</span>
                        <span class="badge ms-auto @GetRunnerStatusBadge(inst.Status)" style="font-size: 0.65rem;">@inst.Status</span>
                    </div>
                    <small class="text-muted text-truncate d-block" style="font-size: 0.7rem;">@(hostNames.GetValueOrDefault(inst.HostId, "?"))</small>
                </div>
            }
        }
    </div>

    @* Main content *@
    <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
        @* Toolbar *@
        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <div class="input-group" style="max-width: 250px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control form-control-sm" placeholder="Search in logs..."
                       @bind="searchQuery" @bind:event="oninput" @bind:after="DoSearch" />
            </div>
            <div class="d-flex align-items-center gap-1">
                <button class="btn btn-sm btn-outline-secondary" @onclick="SearchPrevious" title="Previous match" disabled="@string.IsNullOrEmpty(searchQuery)">
                    <i class="bi bi-chevron-up"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SearchNext" title="Next match" disabled="@string.IsNullOrEmpty(searchQuery)">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>
            <select class="form-select form-select-sm" style="width: auto;" @bind="tailLines">
                <option value="50">50 lines</option>
                <option value="100">100 lines</option>
                <option value="200">200 lines</option>
                <option value="500">500 lines</option>
            </select>
            <button class="btn btn-sm btn-primary" @onclick="FetchLogs" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm text-primary"></span>
            }
            <span class="ms-auto text-muted" style="font-size: 0.75rem;">
                @if (!string.IsNullOrEmpty(lastFetchTime))
                {
                    <i class="bi bi-clock me-1"></i>@lastFetchTime
                }
            </span>
        </div>

        @* Terminal container *@
        <div class="flex-grow-1 rounded overflow-hidden border" style="min-height: 300px;">
            <div id="rr-terminal" style="width: 100%; height: 100%;"></div>
        </div>
    </div>
</div>

<style>
    .log-source-card {
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
        border: 1px solid transparent;
        margin-bottom: 2px;
    }
    .log-source-card:hover {
        background: var(--bg-secondary, #f0f0f0);
    }
    .log-source-card.active {
        background: var(--bg-tertiary, #e8e8e8);
        border-color: var(--bs-primary);
        box-shadow: inset 3px 0 0 var(--bs-primary);
    }
    .sidebar-section-header {
        display: flex;
        align-items: center;
        padding: 0.35rem 0.75rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted, #6c757d);
    }
</style>

@code {
    private List<Host> hosts = [];
    private List<RunnerInstance> runnerInstances = [];
    private Dictionary<string, string> hostNames = [];
    private string selectedSource = "server";
    private int tailLines = 100;
    private string logContent = "";
    private bool isLoading;
    private bool termInitialized;
    private string searchQuery = "";
    private string lastFetchTime = "";
    private TaskCompletionSource<string>? _runnerLogsTcs;

    protected override async Task OnInitializedAsync()
    {
        hosts = (await Store.Query<Host>().ToList()).ToList();
        runnerInstances = (await Store.Query<RunnerInstance>().ToList())
            .Where(i => i.Status == RunnerInstanceStatus.Running || i.Status == RunnerInstanceStatus.Starting)
            .ToList();
        hostNames = hosts.ToDictionary(h => h.Id, h => h.Label);
        AgentHub.OnRunnerLogsReceived += OnRunnerLogsReceived;

        // Check for query string parameter
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var source = query["source"];
        if (!string.IsNullOrEmpty(source))
            selectedSource = source;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitTerminal();
            await FetchLogs();
        }
    }

    private async Task InitTerminal()
    {
        try
        {
            var isDark = true; // default to dark for terminal
            termInitialized = await JS.InvokeAsync<bool>("rrTerminal.init", "rr-terminal", new { darkMode = isDark });
        }
        catch { termInitialized = false; }
    }

    private async Task WriteToTerminal(string text)
    {
        if (!termInitialized) return;
        try
        {
            await JS.InvokeVoidAsync("rrTerminal.clear", "rr-terminal");
            // Write line by line for proper rendering
            foreach (var line in text.Split('\n'))
            {
                await JS.InvokeVoidAsync("rrTerminal.writeln", "rr-terminal", line);
            }
        }
        catch { /* JS interop may fail during disposal */ }
    }

    private async Task SelectSource(string source)
    {
        selectedSource = source;
        await FetchLogs();
    }

    private async Task FetchLogs()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            if (selectedSource == "server")
            {
                logContent = await GetServerLogsAsync();
            }
            else if (selectedSource.StartsWith("agent:"))
            {
                var hostName = selectedSource["agent:".Length..];
                logContent = await GetAgentLogsAsync(hostName);
            }
            else if (selectedSource.StartsWith("runner:"))
            {
                var instanceId = selectedSource["runner:".Length..];
                logContent = await GetRunnerLogsAsync(instanceId);
            }

            lastFetchTime = DateTime.Now.ToString("HH:mm:ss");
            await WriteToTerminal(logContent);
        }
        catch (Exception ex)
        {
            logContent = $"Error fetching logs: {ex.Message}";
            await WriteToTerminal(logContent);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DoSearch()
    {
        if (!termInitialized || string.IsNullOrEmpty(searchQuery)) return;
        try { await JS.InvokeAsync<bool>("rrTerminal.search", "rr-terminal", searchQuery); }
        catch { }
    }

    private async Task SearchNext()
    {
        if (!termInitialized || string.IsNullOrEmpty(searchQuery)) return;
        try { await JS.InvokeAsync<bool>("rrTerminal.search", "rr-terminal", searchQuery); }
        catch { }
    }

    private async Task SearchPrevious()
    {
        if (!termInitialized || string.IsNullOrEmpty(searchQuery)) return;
        try { await JS.InvokeAsync<bool>("rrTerminal.searchPrevious", "rr-terminal", searchQuery); }
        catch { }
    }

    private async Task<string> GetRunnerLogsAsync(string instanceId)
    {
        var instance = runnerInstances.FirstOrDefault(i => i.Id == instanceId);
        if (instance == null) return "\x1b[31mRunner instance not found.\x1b[0m";

        var host = hosts.FirstOrDefault(h => h.Id == instance.HostId);
        if (host == null) return "\x1b[31mHost not found.\x1b[0m";

        var agent = AgentHub.GetConnectedAgents().Values
            .FirstOrDefault(a => a.AgentInfo.Name == host.Name);

        if (agent == null)
            return $"\x1b[33mAgent for host '{host.Label}' is not connected.\x1b[0m";

        var handle = instance.ContainerId ?? instance.RunnerName;
        _runnerLogsTcs = new TaskCompletionSource<string>();
        var command = new GetRunnerLogsCommand { InstanceHandle = handle, TailLines = tailLines };

        await HubContext.Clients.Client(agent.ConnectionId).GetRunnerLogs(command);

        var completedTask = await Task.WhenAny(_runnerLogsTcs.Task, Task.Delay(TimeSpan.FromSeconds(10)));
        if (completedTask == _runnerLogsTcs.Task)
            return await _runnerLogsTcs.Task;

        return $"\x1b[33mTimeout waiting for logs from agent.\x1b[0m";
    }

    private void OnRunnerLogsReceived(RunnerLogsEvent evt)
    {
        _runnerLogsTcs?.TrySetResult(evt.Logs ?? "(empty)");
        InvokeAsync(StateHasChanged);
    }

    private Task<string> GetServerLogsAsync()
    {
        var lines = new List<string>();
        lines.Add("\x1b[1;36m=== RunnerRunner Server Status ===\x1b[0m");
        lines.Add($"\x1b[90mTimestamp: {DateTime.UtcNow:u}\x1b[0m");
        lines.Add("");

        var connectedAgents = AgentHub.GetConnectedAgents();
        lines.Add($"\x1b[1mConnected agents:\x1b[0m {connectedAgents.Count}");
        foreach (var agent in connectedAgents.Values)
        {
            var lastHb = agent.LastHeartbeat?.ToString("HH:mm:ss") ?? "never";
            var runners = agent.LastMetrics?.RunningInstanceCount ?? 0;
            var statusColor = runners > 0 ? "\x1b[32m" : "\x1b[90m";
            lines.Add($"  {statusColor}●\x1b[0m {agent.AgentInfo.Name} \x1b[90m({agent.AgentInfo.Platform} {agent.AgentInfo.Architecture})\x1b[0m — heartbeat: {lastHb}, runners: \x1b[1m{runners}\x1b[0m");
        }

        if (!connectedAgents.Any())
            lines.Add("  \x1b[33mNo agents connected\x1b[0m");

        lines.Add("");
        lines.Add("\x1b[90mFor full server container logs:\x1b[0m");
        lines.Add("\x1b[90m  ssh root@<linux-host> 'cd /opt/stacks/runnerrunner && docker compose logs server --tail 100'\x1b[0m");

        return Task.FromResult(string.Join("\n", lines));
    }

    private async Task<string> GetAgentLogsAsync(string hostName)
    {
        var host = hosts.FirstOrDefault(h => h.Name == hostName);
        if (host == null) return "\x1b[31mHost not found.\x1b[0m";

        var agent = AgentHub.GetConnectedAgents().Values
            .FirstOrDefault(a => a.AgentInfo.Name == hostName);

        if (agent == null)
            return $"\x1b[33mAgent '{host.Label}' is not connected.\x1b[0m\n\n\x1b[90mCheck logs manually:\n  ssh <user>@<host> 'tail -{tailLines} /tmp/runnerrunner-agent.log'\x1b[0m";

        var lines = new List<string>();
        lines.Add($"\x1b[1;36m=== Agent: {host.Label} ===\x1b[0m");
        lines.Add($"\x1b[90mPlatform: {host.Platform} {host.Architecture}\x1b[0m");
        lines.Add($"Status: \x1b[32m{host.AgentStatus}\x1b[0m");
        lines.Add($"Last heartbeat: {host.LastHeartbeat?.ToString("u") ?? "never"}");
        if (host.Capabilities.Any())
            lines.Add($"Capabilities: \x1b[90m{string.Join(", ", host.Capabilities)}\x1b[0m");
        lines.Add("");

        var instances = (await Store.Query<RunnerInstance>().ToList())
            .Where(i => i.HostId == host.Id).ToList();

        if (instances.Count > 0)
        {
            lines.Add($"\x1b[1mRunner instances:\x1b[0m {instances.Count}");
            foreach (var inst in instances.OrderByDescending(i => i.StartedAt ?? i.CreatedAt))
            {
                var statusIcon = inst.Status == RunnerInstanceStatus.Running ? "\x1b[32m●\x1b[0m" :
                                 inst.Status == RunnerInstanceStatus.Failed ? "\x1b[31m●\x1b[0m" : "\x1b[90m●\x1b[0m";
                var cid = inst.ContainerId?[..Math.Min(12, inst.ContainerId?.Length ?? 0)] ?? "—";
                lines.Add($"  {statusIcon} {inst.RunnerName} — \x1b[1m{inst.Status}\x1b[0m (started: {inst.StartedAt?.ToString("HH:mm:ss") ?? "—"}, container: \x1b[90m{cid}\x1b[0m)");
                if (inst.ErrorMessage != null)
                    lines.Add($"    \x1b[31mError: {inst.ErrorMessage}\x1b[0m");
            }
        }
        else
        {
            lines.Add("\x1b[90mNo runner instances on this host.\x1b[0m");
        }

        lines.Add("");
        lines.Add("\x1b[90mFor full agent logs:\x1b[0m");
        if (host.Platform == HostPlatform.Linux)
            lines.Add("\x1b[90m  ssh root@<linux-host> 'cd /opt/stacks/runnerrunner && docker compose logs agent --tail 100'\x1b[0m");
        else
            lines.Add($"\x1b[90m  ssh <user>@{hostName} 'tail -{tailLines} /tmp/runnerrunner-agent.log'\x1b[0m");

        return string.Join("\n", lines);
    }

    private string GetPlatformIcon(HostPlatform platform) => platform switch
    {
        HostPlatform.Linux => "bi-ubuntu",
        HostPlatform.MacOS => "bi-apple",
        HostPlatform.Windows => "bi-windows",
        _ => "bi-pc-display"
    };

    private string GetAgentStatusBadge(AgentStatus status) => status switch
    {
        AgentStatus.Online => "bg-success",
        AgentStatus.Connecting => "bg-warning",
        _ => "bg-secondary"
    };

    private string GetRunnerStatusBadge(RunnerInstanceStatus status) => status switch
    {
        RunnerInstanceStatus.Running => "bg-success",
        RunnerInstanceStatus.Starting => "bg-info",
        RunnerInstanceStatus.Failed or RunnerInstanceStatus.Crashed => "bg-danger",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        AgentHub.OnRunnerLogsReceived -= OnRunnerLogsReceived;
        try { _ = JS.InvokeVoidAsync("rrTerminal.dispose", "rr-terminal"); }
        catch { }
    }
}
