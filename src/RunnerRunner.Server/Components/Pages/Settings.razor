@page "/settings"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@inject IDocumentStore Store

<PageTitle>Settings - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-gear-fill"></i> Settings</h1>
    </div>
</SectionContent>

<h3 class="mt-4">Provider Credentials</h3>
<p>Configure CI/CD provider credentials for runner registration.</p>

<button class="btn btn-primary mb-3" @onclick="ShowCreateForm"><i class="bi bi-plus-lg me-1"></i> Add Credential</button>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(isEditing ? "Edit" : "Add") Provider Credential</h5>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="editCred.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Provider</label>
                    <select class="form-select" @bind="editCred.Provider">
                        @foreach (var p in Enum.GetValues<RunnerProvider>())
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
            </div>

            @if (editCred.Provider == RunnerProvider.GitHubActions)
            {
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">GitHub Org</label>
                        <input class="form-control" @bind="editCred.GitHubOrg" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">GitHub Repo (optional)</label>
                        <input class="form-control" @bind="editCred.GitHubRepo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">GitHub Token (PAT)</label>
                        <input type="password" class="form-control" @bind="editCred.GitHubToken" />
                    </div>
                </div>
            }
            else if (editCred.Provider == RunnerProvider.GiteaActions)
            {
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Gitea Instance URL</label>
                        <input class="form-control" @bind="editCred.GiteaInstanceUrl" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gitea Runner Token</label>
                        <input type="password" class="form-control" @bind="editCred.GiteaRunnerToken" />
                    </div>
                </div>
            }
            else if (editCred.Provider == RunnerProvider.AzureDevOps)
            {
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">AzDO Org URL</label>
                        <input class="form-control" @bind="editCred.AzDoOrgUrl" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Project Name</label>
                        <input class="form-control" @bind="editCred.AzDoProjectName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Pool Name</label>
                        <input class="form-control" @bind="editCred.AzDoPoolName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">PAT</label>
                        <input type="password" class="form-control" @bind="editCred.AzDoPat" />
                    </div>
                </div>
            }

            <button class="btn btn-success me-2" @onclick="SaveCredential">Save</button>
            <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
        </div>
    </div>
}

<div class="table-responsive">
<table class="table table-striped resizable-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Provider</th>
            <th>Details</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cred in credentials)
        {
            <tr>
                <td>@cred.Name</td>
                <td>@cred.Provider</td>
                <td>@GetCredentialSummary(cred)</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditCredential(cred)">Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteCredential(cred.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<hr class="my-4" />

<h3 class="mt-4"><i class="bi bi-box-seam me-2"></i>Container / OCI Registries</h3>
<p>Manage Docker and OCI registry credentials for pulling images on agents.</p>

<button class="btn btn-primary mb-3" @onclick="ShowCreateRegistry"><i class="bi bi-plus-lg me-1"></i> Add Registry</button>

@if (showRegistryForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(isEditingRegistry ? "Edit" : "Add") Registry</h5>
            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="editRegistry.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Registry URL</label>
                    <input class="form-control" @bind="editRegistry.RegistryUrl" placeholder="ghcr.io" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="editRegistry.RegistryType">
                        @foreach (var t in Enum.GetValues<RegistryType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="editRegistry.IsDefault" id="regDefaultCheck" />
                        <label class="form-check-label" for="regDefaultCheck">Default</label>
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Username</label>
                    <input class="form-control" @bind="editRegistry.Username" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Password / Token</label>
                    <input type="password" class="form-control" @bind="editRegistry.Password" />
                </div>
            </div>
            <button class="btn btn-success me-2" @onclick="SaveRegistry">Save</button>
            <button class="btn btn-secondary" @onclick="() => showRegistryForm = false">Cancel</button>
        </div>
    </div>
}

<div class="table-responsive">
<table class="table table-striped resizable-table">
    <thead><tr><th>Name</th><th>URL</th><th>Type</th><th>Username</th><th>Default</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var reg in registryCreds)
        {
            <tr>
                <td>@reg.Name</td>
                <td><code>@reg.RegistryUrl</code></td>
                <td>@reg.RegistryType</td>
                <td>@(reg.Username ?? "—")</td>
                <td>@(reg.IsDefault ? "✓" : "")</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditRegistry(reg)"><i class="bi bi-pencil-square"></i> Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteRegistry(reg.Id)"><i class="bi bi-trash3"></i> Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<ProviderCredential> credentials = [];
    private ProviderCredential editCred = new() { Name = "" };
    private bool showForm;
    private bool isEditing;

    private List<RegistryCredential> registryCreds = [];
    private RegistryCredential editRegistry = new() { Name = "", RegistryUrl = "" };
    private bool showRegistryForm;
    private bool isEditingRegistry;

    protected override async Task OnInitializedAsync()
    {
        credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();
        registryCreds = (await Store.Query<RegistryCredential>().ToList()).ToList();
    }

    private void ShowCreateForm()
    {
        editCred = new ProviderCredential { Name = "" };
        isEditing = false;
        showForm = true;
    }

    private void EditCredential(ProviderCredential cred)
    {
        editCred = cred;
        isEditing = true;
        showForm = true;
    }

    private async Task SaveCredential()
    {
        editCred.UpdatedAt = DateTime.UtcNow;

        if (isEditing)
            await Store.Update(editCred);
        else
            await Store.Insert(editCred);

        credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();
        showForm = false;
    }

    private async Task DeleteCredential(string id)
    {
        await Store.Remove<ProviderCredential>(id);
        credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();
    }

    private string GetCredentialSummary(ProviderCredential cred) => cred.Provider switch
    {
        RunnerProvider.GitHubActions => $"{cred.GitHubOrg}/{cred.GitHubRepo ?? "*"}",
        RunnerProvider.GiteaActions => cred.GiteaInstanceUrl ?? "",
        RunnerProvider.AzureDevOps => $"{cred.AzDoOrgUrl} / {cred.AzDoProjectName}",
        _ => ""
    };

    // --- Registry CRUD ---

    private void ShowCreateRegistry()
    {
        editRegistry = new RegistryCredential { Name = "", RegistryUrl = "" };
        isEditingRegistry = false;
        showRegistryForm = true;
    }

    private void EditRegistry(RegistryCredential reg)
    {
        editRegistry = reg;
        isEditingRegistry = true;
        showRegistryForm = true;
    }

    private async Task SaveRegistry()
    {
        editRegistry.UpdatedAt = DateTime.UtcNow;
        if (isEditingRegistry)
            await Store.Update(editRegistry);
        else
            await Store.Insert(editRegistry);
        registryCreds = (await Store.Query<RegistryCredential>().ToList()).ToList();
        showRegistryForm = false;
    }

    private async Task DeleteRegistry(string id)
    {
        await Store.Remove<RegistryCredential>(id);
        registryCreds = (await Store.Query<RegistryCredential>().ToList()).ToList();
    }
}
