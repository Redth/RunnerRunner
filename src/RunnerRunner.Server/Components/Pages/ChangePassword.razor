@page "/account/change-password"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using RunnerRunner.Server.Data.Auth
@inject UserManager<RunnerRunnerUser> UserManager
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Change Password - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-shield-lock-fill"></i> Change Password</h1>
        <span class="page-desc">Update your account password.</span>
    </div>
</SectionContent>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="alert @(Success ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                @Message
                <button type="button" class="btn-close" @onclick="DismissMessage"></button>
            </div>
        }

        @if (!Success)
        {
            <div class="card">
                <div class="card-body p-4">
                    <EditForm Model="this" OnValidSubmit="ChangePasswordAsync" FormName="change-password">
                        <AntiforgeryToken />
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label" for="currentPassword">Current password</label>
                            <InputText id="currentPassword" @bind-Value="CurrentPassword"
                                       type="password" class="form-control"
                                       autocomplete="current-password" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="newPassword">New password</label>
                            <InputText id="newPassword" @bind-Value="NewPassword"
                                       type="password" class="form-control"
                                       autocomplete="new-password" />
                            <div class="form-text">At least 12 characters. Non-alphanumeric characters are not required.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="confirmPassword">Confirm new password</label>
                            <InputText id="confirmPassword" @bind-Value="ConfirmPassword"
                                       type="password" class="form-control"
                                       autocomplete="new-password" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@Changing">
                            @if (Changing)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Changing...</span>
                            }
                            else
                            {
                                <i class="bi bi-shield-check me-1"></i>
                                <span>Change Password</span>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string CurrentPassword { get; set; } = "";
    private string NewPassword { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private string Message { get; set; } = "";
    private bool Success { get; set; }
    private bool Changing { get; set; }

    private async Task ChangePasswordAsync()
    {
        Message = "";
        Success = false;

        if (NewPassword != ConfirmPassword)
        {
            Message = "New password and confirmation do not match.";
            return;
        }

        if (NewPassword.Length < 12)
        {
            Message = "New password must be at least 12 characters.";
            return;
        }

        if (NewPassword == CurrentPassword)
        {
            Message = "New password must be different from your current password.";
            return;
        }

        Changing = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user is null)
            {
                Message = "Unable to identify your account. Please sign in again.";
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, CurrentPassword, NewPassword);
            if (result.Succeeded)
            {
                Success = true;
                Message = "Password changed successfully.";
            }
            else
            {
                var errors = result.Errors.Select(e => e.Description);
                Message = string.Join(" ", errors);
            }
        }
        catch (Exception ex)
        {
            Message = $"An error occurred: {ex.Message}";
        }
        finally
        {
            Changing = false;
        }
    }

    private void DismissMessage()
    {
        Message = "";
    }
}
