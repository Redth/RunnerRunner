    private static string GetBackendUsageClass(CapacityCounter counter)
    {
        if (counter.IsDisabled)
            return "capacity-disabled";

        var ratio = counter.Limit == 0 ? 0 : (double)counter.Used / counter.Limit;
        return ratio switch
        {
            >= 1 => "capacity-full",
            >= 0.75 => "capacity-warn",
            _ => "capacity-good"
        };
    }

    private static string GetBackendUsageStyle(CapacityCounter counter)
    {
        var percent = counter.IsDisabled || counter.Limit == 0
            ? 0
            : Math.Clamp((int)Math.Round((double)counter.Used / counter.Limit * 100), 0, 100);

        return $"--usage-percent: {percent}%;";
    }

    private static string GetBackendUsageTitle(ExecutionBackend backend, CapacityCounter counter)
    {
        var label = GetBackendShortLabel(backend);
        return counter.IsDisabled
            ? $"{label}: disabled"
            : $"{label}: {counter.Used} of {counter.Limit} used, {counter.Remaining} available";
    }

    private static string FormatSaturatedProfiles(HostCapacityView capacity)
        => "Saturated profiles: " + string.Join(
            ", ",
            capacity.ProfileUsage
                .Where(p => p.IsSaturated)
                .Select(p => $"{p.ProfileName} {p.Summary}"));

    private static string FormatHeartbeat(DateTime? heartbeat)
    {
        if (!heartbeat.HasValue)
            return "Never";

        var utc = NormalizeUtc(heartbeat.Value);
        var elapsed = DateTime.UtcNow - utc;
        if (elapsed < TimeSpan.Zero || elapsed < TimeSpan.FromMinutes(1))
            return "just now";
        if (elapsed < TimeSpan.FromHours(1))
            return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed < TimeSpan.FromDays(1))
            return $"{(int)elapsed.TotalHours}h ago";
        if (elapsed < TimeSpan.FromDays(7))
            return $"{(int)elapsed.TotalDays}d ago";

        return utc.ToLocalTime().ToString("MMM d, h:mm tt");
    }

    private static string FormatHeartbeatTitle(DateTime? heartbeat)
    {
        if (!heartbeat.HasValue)
            return "No heartbeat received";

        return $"Last heartbeat: {NormalizeUtc(heartbeat.Value).ToLocalTime():MMM d, yyyy h:mm tt}";
    }

    private static string GetHeartbeatClass(DateTime? heartbeat)
    {
        if (!heartbeat.HasValue)
            return "heartbeat-muted";

        var elapsed = DateTime.UtcNow - NormalizeUtc(heartbeat.Value);
        if (elapsed < TimeSpan.FromMinutes(5))
            return "heartbeat-fresh";
        if (elapsed < TimeSpan.FromHours(1))
            return "heartbeat-warm";

        return "heartbeat-muted";
    }

    private static DateTime NormalizeUtc(DateTime value)
        => value.Kind == DateTimeKind.Utc ? value : DateTime.SpecifyKind(value, DateTimeKind.Utc);
}

