    private static IEnumerable<KeyValuePair<ExecutionBackend, CapacityCounter>> GetEnabledBackendUsage(
        Host host,
        HostCapacityView capacity)
    {
        foreach (var backend in BackendCapacityOrder)
        {
            if (capacity.BackendUsage.TryGetValue(backend, out var counter) && IsBackendVisible(host, backend, counter))
                yield return new KeyValuePair<ExecutionBackend, CapacityCounter>(backend, counter);
        }
    }

    private static bool IsBackendVisible(Host host, ExecutionBackend backend, CapacityCounter counter)
    {
        if (counter.IsDisabled)
            return false;

        return backend != ExecutionBackend.Tart || host.Platform == HostPlatform.MacOS;
    }

    private static string GetBackendUsageClass(CapacityCounter counter)
    {
        if (counter.IsDisabled)
            return "capacity-disabled";

        var ratio = counter.Limit == 0 ? 0 : (double)counter.Used / counter.Limit;
        return ratio switch
        {
            >= 1 => "capacity-full",
            >= 0.75 => "capacity-warn",
            _ => "capacity-good"
        };
    }

    private static string GetBackendUsageStyle(CapacityCounter counter)
    {
        var percent = counter.IsDisabled || counter.Limit == 0
            ? 0
            : Math.Clamp((int)Math.Round((double)counter.Used / counter.Limit * 100), 0, 100);

        return $"--usage-percent: {percent}%;";
    }

    private static string GetBackendUsageTitle(ExecutionBackend backend, CapacityCounter counter)
    {
        var label = GetBackendShortLabel(backend);
        return counter.IsDisabled
            ? $"{label}: disabled"
            : $"{label}: {counter.Used} of {counter.Limit} used, {counter.Remaining} available";
    }

