@page "/hosts"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Components.Hosts
@using RunnerRunner.Server.Services
@using RunnerRunner.Server.Services.HostWorkers
@inject IDocumentStore Store
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IGrainFactory GrainFactory
@inject CapacityPlanningService CapacityService
@inject IHostCommandDispatcher HostCommandDispatcher
@inject HostWorkerUpdateService HostWorkerUpdateService
@inject HostWorkerLocalUpdateStore HostWorkerUpdateStore

<PageTitle>Hosts - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-hdd-rack-fill"></i> Hosts</h1>
        <span class="page-desc">Manage host machines and their capabilities.</span>
    </div>
</SectionContent>

<div class="mb-3 d-flex flex-wrap gap-2">
    <button class="btn btn-primary" @onclick="OpenEnrollmentWizard">
        <i class="bi bi-hdd-network me-1"></i> Add HostWorker
    </button>
    <button class="btn btn-outline-secondary" @onclick="ToggleUpdateOptions">
        <i class="bi bi-arrow-up-circle me-1"></i> HostWorker updates
        <span class="badge bg-secondary ms-1" title="@SelectedUpdateTargetTitle">@SelectedUpdateTargetLabel</span>
    </button>
    @if (!string.IsNullOrWhiteSpace(updateError))
    {
        <div class="alert alert-warning mt-2 mb-0">
            @updateError
        </div>
    }
</div>

<HostEnrollmentWizard IsOpen="@showEnrollmentWizard"
                      UpdateHost="@manualUpdateHost"
                      UpdateSource="@selectedUpdateSource"
                      UpdateVersion="@selectedUpdateVersion"
                      OnClose="CloseEnrollmentWizard"
                      OnChanged="ReloadData" />

@if (renameHost is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block rr-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="rename-host-title" @onclick="CancelRename">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 id="rename-host-title" class="modal-title">
                            <i class="bi bi-pencil-square me-2"></i>Rename host
                        </h5>
                        <div class="modal-kicker">Give this HostWorker a friendly display name.</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CancelRename" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="host-rename-input">Display name</label>
                    <input id="host-rename-input"
                           class="form-control"
                           placeholder="@renameHost.Name"
                           @bind="renameValue"
                           @onkeydown="OnRenameKeyDown"
                           autofocus />
                    <div class="form-text">
                        Leave blank to use the canonical host name <code>@renameHost.Name</code>.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelRename" disabled="@isSavingRename">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveRename" disabled="@isSavingRename">
                        <i class="bi bi-check2 me-1"></i>@(isSavingRename ? "Saving..." : "Save name")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (configureHost is not null)
{
    var autoLabels = GetAutoLabels(configureHost);
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block rr-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="configure-host-title" @onclick="CloseConfigureHost">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 id="configure-host-title" class="modal-title">
                            <i class="bi bi-sliders me-2"></i>Configure @configureHost.Label
                        </h5>
                        <div class="modal-kicker">Tune host matching labels, resource limits, and fleet grouping.</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseConfigureHost" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-lg-7">
                            <section class="rr-form-section h-100">
                                <div class="rr-form-section-title"><i class="bi bi-tags"></i>Host labels</div>
                                <p class="form-text mb-3">Labels are used by provisioning rules and profiles when selecting eligible hosts.</p>
                                @if (autoLabels.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-3">
                                        @foreach (var label in autoLabels)
                                        {
                                            <span class="host-chip arch-chip" title="Auto-detected capability (read-only)">
                                                <i class="bi bi-lock-fill me-1"></i>@label.Key=@label.Value
                                            </span>
                                        }
                                    </div>
                                }
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @foreach (var label in configureHost.Labels)
                                    {
                                        <span class="host-chip cap-chip">
                                            @label.Key=@label.Value
                                            <button type="button" class="btn-close btn-close-sm ms-1" style="font-size: 0.5rem;"
                                                    @onclick="() => RemoveLabel(configureHost, label.Key)" aria-label="Remove @label.Key label"></button>
                                        </span>
                                    }
                                </div>
                                <div class="input-group input-group-sm">
                                    <input class="form-control" @bind="newLabelKey" placeholder="capability" />
                                    <input class="form-control" @bind="newLabelValue" placeholder="value" />
                                    <button class="btn btn-outline-primary" @onclick="() => AddLabel(configureHost)">
                                        <i class="bi bi-plus-lg"></i> Add
                                    </button>
                                </div>
                            </section>
                        </div>
                        <div class="col-lg-5">
                            <section class="rr-form-section h-100">
                                <div class="rr-form-section-title"><i class="bi bi-speedometer2"></i>Resource limits</div>
                                <p class="form-text mb-3">Set a backend limit to <code>0</code> to hide and disable that backend on this host.</p>
                                <div class="mb-2">
                                    <label class="form-label form-label-sm mb-1">Max Docker containers</label>
                                    <input type="number" class="form-control form-control-sm" @bind="configureHost.MaxDockerContainers" min="0" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label form-label-sm mb-1">Max Tart VMs</label>
                                    <input type="number" class="form-control form-control-sm" @bind="configureHost.MaxTartVMs" min="0" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label form-label-sm mb-1">Max Native processes</label>
                                    <input type="number" class="form-control form-control-sm" @bind="configureHost.MaxNativeProcesses" min="0" />
                                </div>
                                <div>
                                    <label class="form-label form-label-sm mb-1">Group ID</label>
                                    <input type="text" class="form-control form-control-sm" @bind="configureHost.GroupId" placeholder="e.g., build-farm-1" />
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseConfigureHost">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveConfiguration">
                        <i class="bi bi-check2 me-1"></i>Save configuration
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showUpdateOptions)
{
    <div class="card host-update-options mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-end gap-2">
                <div>
                    <label class="form-label form-label-sm mb-1">Update source</label>
                    <select class="form-select form-select-sm" value="@selectedUpdateSource.ToSourceId()" @onchange="OnUpdateSourceChanged">
                        <option value="release">GitHub ref</option>
                        <option value="local-folder">SSH/local folder</option>
                    </select>
                </div>
                <div style="min-width: 260px;">
                    <label class="form-label form-label-sm mb-1">@(selectedUpdateSource == HostWorkerUpdateSourceKind.Release ? "Ref" : "Version")</label>
                    @if (selectedUpdateSource == HostWorkerUpdateSourceKind.Release)
                    {
                        <input class="form-control form-control-sm" @bind="selectedUpdateVersion" placeholder="latest, tag, branch, or commit" />
                    }
                    else
                    {
                        <select class="form-select form-select-sm" @bind="selectedUpdateVersion">
                            @if (availableUpdateVersions.Count == 0)
                            {
                                <option value="">No builds found</option>
                            }
                            @foreach (var version in availableUpdateVersions)
                            {
                                <option value="@version.Version">@version.Version (@version.Assets.Count assets)</option>
                            }
                        </select>
                    }
                </div>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CheckHostWorkerUpdates" disabled="@checkingUpdates">
                    <i class="bi bi-cloud-download me-1"></i> @(checkingUpdates ? "Checking..." : "Check hosts")
                </button>
                @if (selectedUpdateSource != HostWorkerUpdateSourceKind.Release)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadUpdateVersions">
                        <i class="bi bi-arrow-clockwise me-1"></i> Refresh builds
                    </button>
                }
            </div>
            <div class="small text-muted mt-2">
                GitHub refs resolve to a release tag first, then matching workflow artifacts for a branch or commit. SSH/local builds are read from
                <code>@HostWorkerUpdateStore.LocalFolderRoot</code>.
            </div>
        </div>
    </div>
}

<div class="row g-2 mb-3 align-items-end">
    <div class="col-auto flex-grow-1">
        <input type="text" class="form-control form-control-sm" placeholder="Search by name, platform, architecture, capabilities…"
               @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-auto">
        <select class="form-select form-select-sm" @bind="filterPlatform">
            <option value="">All Platforms</option>
            @foreach (var p in Enum.GetValues<HostPlatform>())
            {
                <option value="@p">@p</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select form-select-sm" @bind="filterStatus">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<AgentStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select form-select-sm" @bind="filterArch">
            <option value="">All Architectures</option>
            @foreach (var a in hosts.Select(h => h.Architecture).Where(a => !string.IsNullOrEmpty(a)).Distinct().OrderBy(a => a))
            {
                <option value="@a">@a</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
<table class="table table-striped resizable-table">
    <thead>
        <tr>
            <th role="button" data-col-kind="name" data-col-min="170" data-col-preferred="240" data-col-weight="3.5" @onclick='() => ToggleSort("Name")'>Name @SortIndicator("Name")</th>
            <th role="button" data-col-kind="compact" data-col-min="92" data-col-preferred="120" data-col-priority="2" @onclick='() => ToggleSort("Status")'>Status @SortIndicator("Status")</th>
            <th data-col-kind="related" data-col-min="112" data-col-preferred="150" data-col-priority="4">Worker</th>
            <th role="button" data-col-kind="related" data-col-min="130" data-col-preferred="175" data-col-priority="3" @onclick='() => ToggleSort("Platform")'>Platform @SortIndicator("Platform")</th>
            <th data-col-kind="related" data-col-min="172" data-col-preferred="220" data-col-priority="2" data-col-weight="1.4">Provisioning</th>
            <th class="actions-col" data-col-min="116" data-col-preferred="132">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var host in FilteredHosts)
        {
            var hostRules = GetHostRules(host);
            <tr>
                <td class="name-cell">
                    <span class="name-primary-line">
                        <span class="primary-label">@host.Label</span>
                        <button class="btn btn-sm btn-link p-0 inline-name-edit" @onclick="() => StartRename(host)" title="Rename" aria-label="Rename host @host.Label"><i class="bi bi-pencil"></i></button>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(host.DisplayName))
                    {
                        <small class="secondary-label">@host.Name</small>
                    }
                </td>
                <td>
                    <div class="host-status-stack">
                        <span class="badge @GetStatusBadge(host.AgentStatus)">@host.AgentStatus</span>
                        <span class="host-heartbeat @GetHeartbeatClass(host.LastHeartbeat)" title="@FormatHeartbeatTitle(host.LastHeartbeat)">
                            <i class="bi bi-heart-pulse-fill"></i>
                            <span>@FormatHeartbeat(host.LastHeartbeat)</span>
                        </span>
                    </div>
                </td>
                <td>
                    <div class="host-worker-version">
                        <span class="worker-version-label">Version</span>
                        @if (!string.IsNullOrWhiteSpace(host.AgentVersion))
                        {
                            <code title="@host.AgentVersion">@FormatDisplayVersion(host.AgentVersion)</code>
                        }
                        else
                        {
                            <span class="text-muted">unknown</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(host.AgentVersion))
                    {
                        @if (!string.IsNullOrWhiteSpace(host.UpdateStatus))
                        {
                            <div class="host-update-summary mt-2">
                                @if (IsCurrentUpdateStatus(host.UpdateStatus))
                                {
                                    <span class="host-update-chip update-current" title="@GetWorkerUpdateSummary(host)">
                                        <i class="bi bi-check-lg"></i>
                                        <span class="visually-hidden">Up to date</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge @GetUpdateBadge(host.UpdateStatus)">
                                        <i class="bi @GetUpdateIcon(host.UpdateStatus) me-1"></i>@FormatUpdateStatus(host.UpdateStatus)
                                    </span>
                                }
                                @if (ShouldShowLatestAvailableVersion(host))
                                {
                                    <code title="@host.LatestAvailableVersion">@FormatDisplayVersion(host.LatestAvailableVersion, host.LatestAvailableCommitSha)</code>
                                }
                                @if (!IsCurrentUpdateStatus(host.UpdateStatus))
                                {
                                    <div class="small text-muted">@GetWorkerUpdateSummary(host)</div>
                                }
                            </div>
                        }
                    }
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="host-chip platform-chip"><i class="bi @GetPlatformIcon(host.Platform) me-1"></i>@host.Platform</span>
                        @if (!string.IsNullOrEmpty(host.Architecture))
                        {
                            <span class="host-chip arch-chip"><i class="bi bi-cpu me-1"></i>@host.Architecture</span>
                        }
                        @if (host.IsContainerized)
                        {
                            <span class="host-chip cap-chip"><i class="bi bi-box me-1"></i>container</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(host.ContainerImage))
                    {
                        <div class="small text-muted mt-1">@host.ContainerImage</div>
                    }
                    @if (host.Capabilities.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var cap in host.Capabilities)
                            {
                                <span class="host-chip cap-chip">@cap</span>
                            }
                        </div>
                    }
                    @{
                        var autoLabels = GetAutoLabels(host);
                    }
                    @if (autoLabels.TryGetValue("docker_os", out var dockerOs))
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <span class="host-chip cap-chip" title="Docker container mode">
                                <i class="bi bi-boxes me-1"></i>@dockerOs containers
                            </span>
                        </div>
                    }
                </td>
                <td>
                    @if (hostRules.Any())
                    {
                        <div class="provisioning-chips">
                            @foreach (var rule in hostRules)
                            {
                                <span class="provisioning-chip @GetProvisioningChipClass(rule)"
                                      title="@GetProvisioningRuleTitle(rule)">
                                    <i class="bi @GetProvisioningIcon(rule.Type)"></i>
                                    <span>@rule.Name</span>
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <a class="provisioning-chip provisioning-chip-empty" href="/provisioning-rules"
                           title="No provisioning rules target this host. Open provisioning rules.">
                            <i class="bi bi-diagram-3"></i>
                            <span>Rules</span>
                        </a>
                    }
                    @if (capacitySnapshot.Hosts.TryGetValue(host.Id, out var capacity))
                    {
                        var enabledBackends = GetEnabledBackendUsage(host, capacity).ToList();
                        @if (enabledBackends.Any())
                        {
                            <div class="backend-capacity-stack mt-2" aria-label="Backend capacity">
                                @foreach (var backendUsage in enabledBackends)
                                {
                                    var backend = backendUsage.Key;
                                    var counter = backendUsage.Value;
                                    <span class="backend-capacity-chip @GetBackendUsageClass(counter)"
                                          title="@GetBackendUsageTitle(backend, counter)">
                                        <span class="backend-capacity-meter" style="@GetBackendUsageStyle(counter)" aria-hidden="true">
                                            <span></span>
                                        </span>
                                        <i class="bi @GetBackendIcon(backend)"></i>
                                        <span class="backend-capacity-label">@GetBackendShortLabel(backend)</span>
                                        <span class="backend-capacity-count">@counter.Summary</span>
                                    </span>
                                }
                            </div>
                        }
                        @if (capacity.ProfileUsage.Any(p => p.IsSaturated))
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                <span class="host-chip saturated-chip" title="@FormatSaturatedProfiles(capacity)">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Saturated
                                </span>
                            </div>
                        }
                    }
                </td>
                <td class="actions-cell host-actions-cell">
                    <div class="host-actions">
                        <a href="/logs?source=host:@host.Id" class="btn btn-sm btn-outline-secondary" title="View logs">
                            <i class="bi bi-file-text"></i><span class="host-action-label">Logs</span>
                        </a>
                        @if (CanUpdate(host))
                        {
                            <button class="btn btn-sm btn-outline-success" title="@GetUpdateActionLabel(host)"
                                    @onclick="() => QueueHostWorkerUpdate(host)" disabled="@updatingHosts.Contains(host.Id)">
                                <i class="bi bi-arrow-up-circle"></i>
                                <span class="host-action-label host-update-action-label">@GetUpdateActionLabel(host)</span>
                            </button>
                        }
                        <div class="host-action-menu">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActionsMenu(host.Id)" title="More actions">
                                <i class="bi bi-three-dots"></i><span class="visually-hidden">More actions</span>
                            </button>
                            @if (openActionsMenuHostId == host.Id)
                            {
                                <div class="host-action-dropdown">
                                    <button type="button" class="host-action-dropdown-item" @onclick="() => ConfigureHostFromMenu(host)">
                                        <i class="bi bi-gear"></i> Configure
                                    </button>
                                    <button type="button" class="host-action-dropdown-item" @onclick="() => OpenManualUpdateWizardFromMenu(host)">
                                        <i class="bi bi-tools"></i> Manual update
                                    </button>
                                    <button type="button" class="host-action-dropdown-item text-danger" @onclick="() => ConfirmAndRemoveHostFromMenu(host)">
                                        <i class="bi bi-trash3"></i> Remove
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<Host> hosts = [];
    private List<ProvisioningRule> rules = [];
    private CapacitySnapshot capacitySnapshot = CapacitySnapshot.Empty;
    private bool showEnrollmentWizard;
    private Host? manualUpdateHost;
    private bool checkingUpdates;
    private string? updateError;
    private readonly HashSet<string> updatingHosts = [];
    private HostWorkerUpdateSourceKind selectedUpdateSource = HostWorkerUpdateSourceKind.Release;
    private string? selectedUpdateVersion;
    private IReadOnlyList<HostWorkerUpdateVersion> availableUpdateVersions = [];
    private bool showUpdateOptions;
    private string? openActionsMenuHostId;
    private static readonly ExecutionBackend[] BackendCapacityOrder =
        new[] { ExecutionBackend.Docker, ExecutionBackend.Tart, ExecutionBackend.Native };

    private string SelectedUpdateTargetLabel =>
        selectedUpdateSource == HostWorkerUpdateSourceKind.Release
            ? $"GitHub: {SelectedUpdateVersionLabel}"
            : $"Local: {SelectedUpdateVersionLabel}";

    private string SelectedUpdateTargetTitle =>
        string.IsNullOrWhiteSpace(selectedUpdateVersion)
            ? SelectedUpdateTargetLabel
            : selectedUpdateVersion.Trim();

    private string SelectedUpdateVersionLabel =>
        string.IsNullOrWhiteSpace(selectedUpdateVersion)
            ? selectedUpdateSource == HostWorkerUpdateSourceKind.Release ? "latest" : "no build"
            : FormatDisplayVersion(selectedUpdateVersion);

    // Filter & sort state
    private string searchText = "";
    private string filterPlatform = "";
    private string filterStatus = "";
    private string filterArch = "";
    private string sortColumn = "Name";
    private bool sortAscending = true;

    private IEnumerable<Host> FilteredHosts
    {
        get
        {
            var q = hosts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();
                q = q.Where(h =>
                    (h.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (h.DisplayName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    h.Platform.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (h.Architecture?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    h.Capabilities.Any(c => c.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrEmpty(filterPlatform) && Enum.TryParse<HostPlatform>(filterPlatform, out var plat))
                q = q.Where(h => h.Platform == plat);

            if (!string.IsNullOrEmpty(filterStatus) && Enum.TryParse<AgentStatus>(filterStatus, out var stat))
                q = q.Where(h => h.AgentStatus == stat);

            if (!string.IsNullOrEmpty(filterArch))
                q = q.Where(h => string.Equals(h.Architecture, filterArch, StringComparison.OrdinalIgnoreCase));

            q = sortColumn switch
            {
                "Name" => sortAscending ? q.OrderBy(h => h.Label) : q.OrderByDescending(h => h.Label),
                "Platform" => sortAscending ? q.OrderBy(h => h.Platform) : q.OrderByDescending(h => h.Platform),
                "Status" => sortAscending ? q.OrderBy(h => h.AgentStatus) : q.OrderByDescending(h => h.AgentStatus),
                "Architecture" => sortAscending ? q.OrderBy(h => h.Architecture) : q.OrderByDescending(h => h.Architecture),
                "LastHeartbeat" => sortAscending ? q.OrderBy(h => h.LastHeartbeat) : q.OrderByDescending(h => h.LastHeartbeat),
                _ => q
            };

            return q;
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIndicator(string column)
    {
        if (sortColumn != column) return new MarkupString("");
        return new MarkupString(sortAscending ? " ▲" : " ▼");
    }

    // Rename modal
    private Host? renameHost;
    private string renameValue = "";
    private bool isSavingRename;

    // Configure modal
    private Host? configureHost;
    private string newLabelKey = "";
    private string newLabelValue = "";

    private void ToggleConfigure(Host host)
    {
        openActionsMenuHostId = null;
        if (configureHost?.Id == host.Id)
        {
            CloseConfigureHost();
            return;
        }

        configureHost = CloneHost(host);
        newLabelKey = "";
        newLabelValue = "";
    }

    private void CloseConfigureHost()
    {
        configureHost = null;
        newLabelKey = "";
        newLabelValue = "";
    }

    private void ToggleUpdateOptions()
        => showUpdateOptions = !showUpdateOptions;

    private void ToggleActionsMenu(string hostId)
        => openActionsMenuHostId = openActionsMenuHostId == hostId ? null : hostId;

    private void ConfigureHostFromMenu(Host host)
        => ToggleConfigure(host);

    private void OpenManualUpdateWizardFromMenu(Host host)
    {
        openActionsMenuHostId = null;
        OpenManualUpdateWizard(host);
    }

    private async Task ConfirmAndRemoveHostFromMenu(Host host)
    {
        openActionsMenuHostId = null;
        await ConfirmAndRemoveHost(host);
    }

    private Dictionary<string, string> GetAutoLabels(Host host)
    {
        var labels = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(host.Architecture))
            labels["arch"] = host.Architecture;
        if (host.Platform != default)
            labels["os"] = host.Platform.ToString().ToLowerInvariant();
        if (host.Labels.TryGetValue("docker_os", out var dockerOs) && !string.IsNullOrWhiteSpace(dockerOs))
            labels["docker_os"] = dockerOs;
        if (host.Labels.TryGetValue("windows_containers", out var windowsContainers) && !string.IsNullOrWhiteSpace(windowsContainers))
            labels["windows_containers"] = windowsContainers;
        foreach (var cap in host.Capabilities)
            labels[cap] = "true";
        return labels;
    }

    private void AddLabel(Host host)
    {
        var key = newLabelKey?.Trim();
        var value = newLabelValue?.Trim();
        if (string.IsNullOrEmpty(key) || string.IsNullOrEmpty(value)) return;
        host.Labels[key] = value;
        newLabelKey = "";
        newLabelValue = "";
    }

    private void RemoveLabel(Host host, string key)
    {
        host.Labels.Remove(key);
    }

