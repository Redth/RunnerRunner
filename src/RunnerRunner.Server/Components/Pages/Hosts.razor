@page "/hosts"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Services
@using RunnerRunner.Server.Services.HostWorkers
@inject IDocumentStore Store
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IGrainFactory GrainFactory
@inject CapacityPlanningService CapacityService
@inject IHostCommandDispatcher HostCommandDispatcher
@inject HostWorkerUpdateService HostWorkerUpdateService
@inject HostWorkerLocalUpdateStore HostWorkerUpdateStore

<PageTitle>Hosts - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-hdd-rack-fill"></i> Hosts</h1>
        <span class="page-desc">Manage host machines and their capabilities. Provisioning is defined through rules.</span>
    </div>
</SectionContent>

<div class="mb-3 d-flex flex-wrap gap-2">
    <button class="btn btn-primary" @onclick="GenerateEnrollmentToken">
        <i class="bi bi-key-fill me-1"></i> Generate Enrollment Token
    </button>
    <a class="btn btn-outline-primary" href="/provisioning-rules">
        <i class="bi bi-diagram-3 me-1"></i> Manage Provisioning Rules
    </a>
    @if (!string.IsNullOrWhiteSpace(updateError))
    {
        <div class="alert alert-warning mt-2 mb-0">
            @updateError
        </div>
    }
    @if (!string.IsNullOrEmpty(newToken))
    {
        <div class="alert alert-success mt-2">
            <strong>Enrollment Token:</strong> <code>@newToken</code>
            <br /><small>Use this token when starting one new HostWorker. It is stored hashed and will not be shown again.</small>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-end gap-2">
            <div>
                <label class="form-label form-label-sm mb-1">HostWorker update source</label>
                <select class="form-select form-select-sm" value="@selectedUpdateSource.ToSourceId()" @onchange="OnUpdateSourceChanged">
                    <option value="release">GitHub Releases</option>
                    <option value="upload">Uploaded builds</option>
                    <option value="local-folder">SSH/local folder</option>
                </select>
            </div>
            <div style="min-width: 220px;">
                <label class="form-label form-label-sm mb-1">Version</label>
                @if (selectedUpdateSource == HostWorkerUpdateSourceKind.Release)
                {
                    <input class="form-control form-control-sm" @bind="selectedUpdateVersion" placeholder="latest or v1.2.3" />
                }
                else
                {
                    <select class="form-select form-select-sm" @bind="selectedUpdateVersion">
                        @if (availableUpdateVersions.Count == 0)
                        {
                            <option value="">No builds found</option>
                        }
                        @foreach (var version in availableUpdateVersions)
                        {
                            <option value="@version.Version">@version.Version (@version.Assets.Count assets)</option>
                        }
                    </select>
                }
            </div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CheckHostWorkerUpdates" disabled="@checkingUpdates">
                <i class="bi bi-cloud-download me-1"></i> @(checkingUpdates ? "Checking..." : "Check")
            </button>
            @if (selectedUpdateSource != HostWorkerUpdateSourceKind.Release)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadUpdateVersions">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh builds
                </button>
            }
        </div>
        <div class="small text-muted mt-2">
            Releases use GitHub assets. Uploaded builds are stored by the server. SSH/local folder builds are read from
            <code>@HostWorkerUpdateStore.LocalFolderRoot</code> with artifacts under version folders.
        </div>
        <div class="row g-2 align-items-end mt-2">
            <div class="col-md-3">
                <label class="form-label form-label-sm mb-1">Upload version</label>
                <input class="form-control form-control-sm" @bind="uploadVersion" placeholder="dev-main-abc123" />
            </div>
            <div class="col-md-5">
                <label class="form-label form-label-sm mb-1">Upload artifact</label>
                <InputFile class="form-control form-control-sm" OnChange="OnUpdateArtifactSelected" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary btn-sm" @onclick="UploadHostWorkerBuild" disabled="@(!CanUploadBuild)">
                    <i class="bi bi-upload me-1"></i> @(uploadingUpdate ? "Uploading..." : "Upload build")
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(uploadMessage))
            {
                <div class="col-12 small text-muted">@uploadMessage</div>
            }
        </div>
    </div>
</div>

<div class="row g-2 mb-3 align-items-end">
    <div class="col-auto flex-grow-1">
        <input type="text" class="form-control form-control-sm" placeholder="Search by name, platform, architecture, capabilities…"
               @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-auto">
        <select class="form-select form-select-sm" @bind="filterPlatform">
            <option value="">All Platforms</option>
            @foreach (var p in Enum.GetValues<HostPlatform>())
            {
                <option value="@p">@p</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select form-select-sm" @bind="filterStatus">
            <option value="">All Statuses</option>
            @foreach (var s in Enum.GetValues<AgentStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select form-select-sm" @bind="filterArch">
            <option value="">All Architectures</option>
            @foreach (var a in hosts.Select(h => h.Architecture).Where(a => !string.IsNullOrEmpty(a)).Distinct().OrderBy(a => a))
            {
                <option value="@a">@a</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
<table class="table table-striped resizable-table">
    <thead>
        <tr>
            <th role="button" @onclick='() => ToggleSort("Name")'>Name @SortIndicator("Name")</th>
            <th role="button" @onclick='() => ToggleSort("Status")'>Status @SortIndicator("Status")</th>
            <th role="button" @onclick='() => ToggleSort("Platform")'>Platform @SortIndicator("Platform")</th>
            <th>Provisioning</th>
            <th role="button" @onclick='() => ToggleSort("LastHeartbeat")'>Last Heartbeat @SortIndicator("LastHeartbeat")</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var host in FilteredHosts)
        {
            var hostRules = GetHostRules(host);
            <tr>
                <td>
                    @if (renamingHostId == host.Id)
                    {
                        <div class="d-flex gap-1">
                            <input class="form-control form-control-sm" style="width: 140px" @bind="renameValue" @onkeydown="e => OnRenameKeyDown(e, host)" />
                            <button class="btn btn-sm btn-success" @onclick="() => SaveRename(host)" title="Save"><i class="bi bi-check-lg"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelRename" title="Cancel"><i class="bi bi-x-lg"></i></button>
                        </div>
                    }
                    else
                    {
                        <span>@host.Label</span>
                        @if (!string.IsNullOrWhiteSpace(host.DisplayName))
                        {
                            <br/><small class="text-muted">@host.Name</small>
                        }
                        <button class="btn btn-sm btn-link p-0 ms-1" @onclick="() => StartRename(host)" title="Rename"><i class="bi bi-pencil"></i></button>
                    }
                </td>
                <td>
                    <span class="badge @GetStatusBadge(host.AgentStatus)">@host.AgentStatus</span>
                    @if (!string.IsNullOrWhiteSpace(host.AgentVersion))
                    {
                        <div class="small text-muted mt-1">Worker @host.AgentVersion</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(host.UpdateStatus))
                    {
                        <div class="small mt-1">
                            <span class="badge @GetUpdateBadge(host.UpdateStatus)">@FormatUpdateStatus(host.UpdateStatus)</span>
                            @if (!string.IsNullOrWhiteSpace(host.LatestAvailableVersion))
                            {
                                <span class="text-muted ms-1">@host.LatestAvailableVersion</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(host.UpdateMessage))
                        {
                            <div class="small text-muted">@host.UpdateMessage</div>
                        }
                    }
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="host-chip platform-chip"><i class="bi @GetPlatformIcon(host.Platform) me-1"></i>@host.Platform</span>
                        @if (!string.IsNullOrEmpty(host.Architecture))
                        {
                            <span class="host-chip arch-chip"><i class="bi bi-cpu me-1"></i>@host.Architecture</span>
                        }
                    </div>
                    @if (host.Capabilities.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var cap in host.Capabilities)
                            {
                                <span class="host-chip cap-chip">@cap</span>
                            }
                        </div>
                    }
                    @if (capacitySnapshot.Hosts.TryGetValue(host.Id, out var capacity))
                    {
                        <div class="small text-muted mt-2">
                            <span class="me-2">Docker @FormatBackendUsage(capacity, ExecutionBackend.Docker)</span>
                            <span class="me-2">Tart @FormatBackendUsage(capacity, ExecutionBackend.Tart)</span>
                            <span>Native @FormatBackendUsage(capacity, ExecutionBackend.Native)</span>
                        </div>
                        @if (GetAutoLabels(host).TryGetValue("docker_os", out var dockerOs))
                        {
                            <div class="small text-muted mt-1">
                                Docker mode: <strong>@dockerOs</strong> containers
                            </div>
                        }
                        @if (capacity.ProfileUsage.Any(p => p.IsSaturated))
                        {
                            <div class="small text-warning mt-1">
                                Saturated profiles:
                                @string.Join(", ", capacity.ProfileUsage.Where(p => p.IsSaturated).Take(2).Select(p => $"{p.ProfileName} {p.Summary}"))
                            </div>
                        }
                    }
                </td>
                <td>
                    @if (hostRules.Any())
                    {
                        @foreach (var rule in hostRules)
                        {
                            <span class="badge @GetRuleBadge(rule.Type) me-1">@rule.Name</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Use provisioning rules</span>
                    }
                </td>
                <td>@(host.LastHeartbeat?.ToString("g") ?? "Never")</td>
                <td>
                    <a href="/logs?source=agent:@host.Name" class="btn btn-sm btn-outline-secondary me-1" title="View logs"><i class="bi bi-file-text"></i></a>
                    <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ToggleConfigure(host)" title="Configure capabilities & resources">
                        <i class="bi bi-gear"></i> Configure
                    </button>
                    @if (CanUpdate(host))
                    {
                        <button class="btn btn-sm btn-outline-success me-1" @onclick="() => QueueHostWorkerUpdate(host)" disabled="@updatingHosts.Contains(host.Id)">
                            <i class="bi bi-arrow-up-circle"></i> @(updatingHosts.Contains(host.Id) ? "Queuing..." : selectedUpdateSource == HostWorkerUpdateSourceKind.Release ? "Update" : "Apply build")
                        </button>
                    }
                    <a class="btn btn-sm btn-outline-primary me-1" href="/provisioning-rules"><i class="bi bi-diagram-3"></i> Rules</a>
                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmAndRemoveHost(host)">  <i class="bi bi-trash3"></i> Remove</button>
                </td>
            </tr>
            @if (configureHostId == host.Id)
            {
                <tr>
                    <td colspan="6" class="p-0">
                        <div class="card m-2">
                            <div class="card-body">
                                <div class="row">
                                    @* Capabilities Section *@
                                    <div class="col-md-7">
                                        <h6><i class="bi bi-tags me-1"></i>Capabilities</h6>
                                        @{
                                            var autoLabels = GetAutoLabels(host);
                                        }
                                        @if (autoLabels.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1 mb-2">
                                                @foreach (var label in autoLabels)
                                                {
                                                    <span class="host-chip arch-chip" title="Auto-detected capability (read-only)">
                                                        <i class="bi bi-lock-fill me-1"></i>@label.Key=@label.Value
                                                    </span>
                                                }
                                            </div>
                                        }
                                        <div class="d-flex flex-wrap gap-1 mb-2">
                                            @foreach (var label in host.Labels)
                                            {
                                                <span class="host-chip cap-chip">
                                                    @label.Key=@label.Value
                                                    <button type="button" class="btn-close btn-close-sm ms-1" style="font-size: 0.5rem;"
                                                            @onclick="() => RemoveLabel(host, label.Key)"></button>
                                                </span>
                                            }
                                        </div>
                                        <div class="input-group input-group-sm" style="max-width: 400px;">
                                            <input class="form-control" @bind="newLabelKey" placeholder="capability" />
                                            <input class="form-control" @bind="newLabelValue" placeholder="value" />
                                            <button class="btn btn-outline-primary" @onclick="() => AddLabel(host)">
                                                <i class="bi bi-plus-lg"></i> Add
                                            </button>
                                        </div>
                                    </div>

                                    @* Resource Limits Section *@
                                     <div class="col-md-5">
                                         <h6><i class="bi bi-speedometer2 me-1"></i>Resource Limits</h6>
                                         <div class="form-text mb-2">These are the host-level backend caps. Set a value to <code>0</code> to disable that backend on this host.</div>
                                         <div class="mb-2">
                                             <label class="form-label form-label-sm mb-0">Max Docker Containers</label>
                                             <input type="number" class="form-control form-control-sm" style="max-width: 120px;"
                                                    @bind="host.MaxDockerContainers" min="0" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label form-label-sm mb-0">Max Tart VMs</label>
                                            <input type="number" class="form-control form-control-sm" style="max-width: 120px;"
                                                   @bind="host.MaxTartVMs" min="0" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label form-label-sm mb-0">Max Native Processes</label>
                                            <input type="number" class="form-control form-control-sm" style="max-width: 120px;"
                                                   @bind="host.MaxNativeProcesses" min="0" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label form-label-sm mb-0">Group ID</label>
                                            <input type="text" class="form-control form-control-sm" style="max-width: 200px;"
                                                   @bind="host.GroupId" placeholder="e.g., build-farm-1" />
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-success btn-sm" @onclick="() => SaveConfiguration(host)">
                                        <i class="bi bi-check-lg me-1"></i>Save
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="() => configureHostId = null">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@code {
    private List<Host> hosts = [];
    private List<ProvisioningRule> rules = [];
    private CapacitySnapshot capacitySnapshot = CapacitySnapshot.Empty;
    private string? newToken;
    private bool checkingUpdates;
    private string? updateError;
    private readonly HashSet<string> updatingHosts = [];
    private HostWorkerUpdateSourceKind selectedUpdateSource = HostWorkerUpdateSourceKind.Release;
    private string? selectedUpdateVersion;
    private IReadOnlyList<HostWorkerUpdateVersion> availableUpdateVersions = [];
    private string uploadVersion = $"dev-{DateTime.UtcNow:yyyyMMddHHmmss}";
    private IBrowserFile? selectedUpdateFile;
    private bool uploadingUpdate;
    private string? uploadMessage;

    private bool CanUploadBuild
        => !uploadingUpdate
           && selectedUpdateFile != null
           && !string.IsNullOrWhiteSpace(uploadVersion);

    // Filter & sort state
    private string searchText = "";
    private string filterPlatform = "";
    private string filterStatus = "";
    private string filterArch = "";
    private string sortColumn = "Name";
    private bool sortAscending = true;

    private IEnumerable<Host> FilteredHosts
    {
        get
        {
            var q = hosts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();
                q = q.Where(h =>
                    (h.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (h.DisplayName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    h.Platform.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (h.Architecture?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    h.Capabilities.Any(c => c.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrEmpty(filterPlatform) && Enum.TryParse<HostPlatform>(filterPlatform, out var plat))
                q = q.Where(h => h.Platform == plat);

            if (!string.IsNullOrEmpty(filterStatus) && Enum.TryParse<AgentStatus>(filterStatus, out var stat))
                q = q.Where(h => h.AgentStatus == stat);

            if (!string.IsNullOrEmpty(filterArch))
                q = q.Where(h => string.Equals(h.Architecture, filterArch, StringComparison.OrdinalIgnoreCase));

            q = sortColumn switch
            {
                "Name" => sortAscending ? q.OrderBy(h => h.Label) : q.OrderByDescending(h => h.Label),
                "Platform" => sortAscending ? q.OrderBy(h => h.Platform) : q.OrderByDescending(h => h.Platform),
                "Status" => sortAscending ? q.OrderBy(h => h.AgentStatus) : q.OrderByDescending(h => h.AgentStatus),
                "Architecture" => sortAscending ? q.OrderBy(h => h.Architecture) : q.OrderByDescending(h => h.Architecture),
                "LastHeartbeat" => sortAscending ? q.OrderBy(h => h.LastHeartbeat) : q.OrderByDescending(h => h.LastHeartbeat),
                _ => q
            };

            return q;
        }
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIndicator(string column)
    {
        if (sortColumn != column) return new MarkupString("");
        return new MarkupString(sortAscending ? " ▲" : " ▼");
    }

    // Rename
    private string? renamingHostId;
    private string renameValue = "";

    // Configure panel
    private string? configureHostId;
    private string newLabelKey = "";
    private string newLabelValue = "";

    private void ToggleConfigure(Host host)
    {
        configureHostId = configureHostId == host.Id ? null : host.Id;
        newLabelKey = "";
        newLabelValue = "";
    }

    private Dictionary<string, string> GetAutoLabels(Host host)
    {
        var labels = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(host.Architecture))
            labels["arch"] = host.Architecture;
        if (host.Platform != default)
            labels["os"] = host.Platform.ToString().ToLowerInvariant();
        if (host.Labels.TryGetValue("docker_os", out var dockerOs) && !string.IsNullOrWhiteSpace(dockerOs))
            labels["docker_os"] = dockerOs;
        if (host.Labels.TryGetValue("windows_containers", out var windowsContainers) && !string.IsNullOrWhiteSpace(windowsContainers))
            labels["windows_containers"] = windowsContainers;
        foreach (var cap in host.Capabilities)
            labels[cap] = "true";
        return labels;
    }

    private void AddLabel(Host host)
    {
        var key = newLabelKey?.Trim();
        var value = newLabelValue?.Trim();
        if (string.IsNullOrEmpty(key) || string.IsNullOrEmpty(value)) return;
        host.Labels[key] = value;
        newLabelKey = "";
        newLabelValue = "";
    }

    private void RemoveLabel(Host host, string key)
    {
        host.Labels.Remove(key);
    }

    private async Task SaveConfiguration(Host host)
    {
        host.UpdatedAt = DateTime.UtcNow;
        await Store.Update(host);
        configureHostId = null;
        await ReloadData();
    }

    private void StartRename(Host host)
    {
        renamingHostId = host.Id;
        renameValue = host.DisplayName ?? "";
    }

    private void CancelRename() => renamingHostId = null;

    private async Task SaveRename(Host host)
    {
        host.DisplayName = string.IsNullOrWhiteSpace(renameValue) ? null : renameValue.Trim();
        host.UpdatedAt = DateTime.UtcNow;
        await Store.Update(host);
        renamingHostId = null;
        await ReloadData();
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs e, Host host)
    {
        if (e.Key == "Enter") await SaveRename(host);
        if (e.Key == "Escape") CancelRename();
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadData();
        await LoadUpdateVersions();
    }

    private async Task ReloadData()
    {
        hosts = (await Store.Query<Host>().ToList()).ToList();
        rules = (await Store.Query<ProvisioningRule>().ToList()).ToList();
        capacitySnapshot = await CapacityService.GetSnapshotAsync();
    }

    private async Task CheckHostWorkerUpdates()
    {
        if (!CanCheckSelectedUpdateSource())
            return;

        checkingUpdates = true;
        updateError = null;
        try
        {
            var selection = CreateUpdateSelection();
            var first = true;
            foreach (var host in hosts.Where(h => h.IsApproved && !string.IsNullOrWhiteSpace(h.AgentVersion)))
            {
                await HostWorkerUpdateService.RefreshHostUpdateStateAsync(host, selection, forceRefresh: first);
                first = false;
            }
            await ReloadData();
        }
        catch (Exception ex)
        {
            updateError = $"Unable to check GitHub releases: {ex.Message}";
        }
        finally
        {
            checkingUpdates = false;
        }
    }

    private async Task QueueHostWorkerUpdate(Host host)
    {
        if (!CanCheckSelectedUpdateSource())
            return;

        updatingHosts.Add(host.Id);
        updateError = null;
        try
        {
            await HostWorkerUpdateService.QueueUpdateAsync(
                host.Id,
                CreateUpdateSelection(allowNonUpgrade: selectedUpdateSource != HostWorkerUpdateSourceKind.Release));
            await ReloadData();
        }
        catch (Exception ex)
        {
            updateError = $"Unable to queue update for {host.Label}: {ex.Message}";
        }
        finally
        {
            updatingHosts.Remove(host.Id);
        }
    }

    private bool CanUpdate(Host host)
        => host.AgentStatus == AgentStatus.Online
           && (selectedUpdateSource == HostWorkerUpdateSourceKind.Release
               ? string.Equals(host.UpdateStatus, "UpdateAvailable", StringComparison.OrdinalIgnoreCase)
               : !string.IsNullOrWhiteSpace(selectedUpdateVersion));

    private async Task OnUpdateSourceChanged(ChangeEventArgs e)
    {
        if (!HostWorkerUpdateSourceKinds.TryParse(e.Value?.ToString(), out var source))
        {
            updateError = $"Unsupported HostWorker update source '{e.Value}'.";
            return;
        }

        selectedUpdateSource = source;
        updateError = null;
        await LoadUpdateVersions();
    }

    private async Task LoadUpdateVersions()
    {
        if (selectedUpdateSource == HostWorkerUpdateSourceKind.Release)
        {
            availableUpdateVersions = [];
            return;
        }

        availableUpdateVersions = await HostWorkerUpdateService.GetAvailableVersionsAsync(selectedUpdateSource);
        if (availableUpdateVersions.Count == 0)
        {
            selectedUpdateVersion = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedUpdateVersion) ||
            !availableUpdateVersions.Any(x => string.Equals(x.Version, selectedUpdateVersion, StringComparison.OrdinalIgnoreCase)))
        {
            selectedUpdateVersion = availableUpdateVersions[0].Version;
        }
    }

    private void OnUpdateArtifactSelected(InputFileChangeEventArgs e)
    {
        selectedUpdateFile = e.File;
        uploadMessage = selectedUpdateFile == null ? null : $"Selected {selectedUpdateFile.Name} ({selectedUpdateFile.Size:n0} bytes).";
    }

    private async Task UploadHostWorkerBuild()
    {
        if (selectedUpdateFile == null)
            return;

        uploadingUpdate = true;
        updateError = null;
        uploadMessage = null;
        try
        {
            await using var stream = selectedUpdateFile.OpenReadStream(HostWorkerUpdateStore.MaxUploadBytes);
            var artifact = await HostWorkerUpdateStore.SaveUploadAsync(
                uploadVersion,
                selectedUpdateFile.Name,
                stream,
                selectedUpdateFile.Size);

            selectedUpdateSource = HostWorkerUpdateSourceKind.Upload;
            selectedUpdateVersion = artifact.Version;
            uploadMessage = $"Uploaded {artifact.AssetName} for {artifact.Version}.";
            await LoadUpdateVersions();
        }
        catch (Exception ex)
        {
            updateError = $"Unable to upload HostWorker build: {ex.Message}";
        }
        finally
        {
            uploadingUpdate = false;
        }
    }

    private HostWorkerUpdateSelection CreateUpdateSelection(bool allowNonUpgrade = false)
        => new(
            selectedUpdateSource,
            string.IsNullOrWhiteSpace(selectedUpdateVersion) ? null : selectedUpdateVersion.Trim(),
            Force: false,
            AllowNonUpgrade: allowNonUpgrade,
            PublicBaseUrl: Navigation.BaseUri);

    private bool CanCheckSelectedUpdateSource()
    {
        if (selectedUpdateSource == HostWorkerUpdateSourceKind.Release ||
            !string.IsNullOrWhiteSpace(selectedUpdateVersion))
        {
            updateError = null;
            return true;
        }

        updateError = $"No {selectedUpdateSource.ToDisplayName()} HostWorker build version is selected.";
        return false;
    }

    private static string FormatUpdateStatus(string status)
        => status switch
        {
            "UpdateAvailable" => "Update available",
            _ => status
        };

    private static string GetUpdateBadge(string status)
        => status switch
        {
            "Current" => "bg-success",
            "UpdateAvailable" => "bg-warning text-dark",
            "Queued" or "Downloading" or "Verifying" or "Staged" or "Restarting" => "bg-info text-dark",
            "Failed" or "Unavailable" => "bg-danger",
            _ => "bg-secondary"
        };

    private async Task GenerateEnrollmentToken()
    {
        newToken = HostEnrollmentToken.Create();
        var host = new Host
        {
            Name = $"pending-{newToken[..8]}",
            EnrollmentTokenHash = HostEnrollmentToken.Hash(newToken),
            EnrollmentTokenCreatedAt = DateTime.UtcNow,
            IsApproved = false
        };
        await Store.Insert(host);
        await ReloadData();
    }

    private async Task ConfirmAndRemoveHost(Host host)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Remove host '{host.Label}'? This will stop all runners on this host.");
        if (confirmed) await RemoveHost(host.Id);
    }

    private async Task RemoveHost(string id)
    {
        // Stop all running instances on this host
        await StopRunnersForHost(id);

        // Remove all instances for this host
        var hostInstances = (await Store.Query<RunnerInstance>().ToList())
            .Where(i => i.HostId == id).ToList();
        foreach (var inst in hostInstances)
            await Store.Remove<RunnerInstance>(inst.Id);

        // Remove all assignments for this host
        var hostAssignments = (await Store.Query<RunnerAssignment>().ToList())
            .Where(a => a.HostId == id)
            .ToList();
        foreach (var a in hostAssignments)
            await Store.Remove<RunnerAssignment>(a.Id);

        var targetedRules = rules.Where(r => r.TargetHostId == id).ToList();
        foreach (var rule in targetedRules)
        {
            rule.TargetHostId = null;
            rule.UpdatedAt = DateTime.UtcNow;
            await Store.Update(rule);
        }

        await Store.Remove<Host>(id);
        await ReloadData();
    }

    private async Task StopRunnersForHost(string hostId)
    {
        var host = hosts.FirstOrDefault(h => h.Id == hostId);
        if (host == null) return;

        var running = (await Store.Query<RunnerInstance>().ToList())
            .Where(i => i.HostId == hostId &&
                        i.Status is RunnerInstanceStatus.Running or RunnerInstanceStatus.Starting).ToList();
        foreach (var inst in running)
        {
            var runnerGrain = GrainFactory.GetGrain<IRunnerInstanceGrain>(inst.Id);
            await runnerGrain.MarkStopping();

            await HostCommandDispatcher.DispatchStopRunnerAsync(hostId, new StopRunnerCommand
            {
                InstanceId = inst.Id,
                InstanceHandle = inst.ContainerId ?? inst.VmName ?? inst.ProcessId?.ToString()
            });
        }
    }

    private string GetStatusBadge(AgentStatus status) => status switch
    {
        AgentStatus.Online => "bg-success",
        AgentStatus.Connecting => "bg-warning",
        AgentStatus.Offline => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetPlatformIcon(HostPlatform platform) => platform switch
    {
        HostPlatform.Linux => "bi-ubuntu",
        HostPlatform.MacOS => "bi-apple",
        HostPlatform.Windows => "bi-windows",
        _ => "bi-pc-display"
    };

    private List<ProvisioningRule> GetHostRules(Host host) =>
        rules.Where(r =>
                r.TargetHostId == host.Id ||
                (!string.IsNullOrWhiteSpace(host.GroupId) && r.TargetGroupId == host.GroupId))
            .OrderBy(r => r.Name)
            .ToList();

    private string GetRuleBadge(ProvisioningType type) => type switch
    {
        ProvisioningType.Static => "bg-secondary",
        ProvisioningType.ScaleSet => "bg-primary",
        ProvisioningType.Webhook => "bg-warning text-dark",
        ProvisioningType.Scheduled => "bg-info",
        _ => "bg-secondary"
    };

    private async Task<HostGrainState?> GetHostGrainState(string hostId)
    {
        try
        {
            var grain = GrainFactory.GetGrain<IHostGrain>(hostId);
            return await grain.GetState();
        }
        catch { return null; }
    }

    private static string FormatBackendUsage(HostCapacityView capacity, ExecutionBackend backend)
    {
        if (!capacity.BackendUsage.TryGetValue(backend, out var counter))
            return "0/0";

        return counter.IsDisabled ? "off" : $"{counter.Used}/{counter.Limit}";
    }
}

