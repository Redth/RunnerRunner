@page "/credentials"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@inject IDocumentStore Store
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Credentials - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-key-fill"></i> Credentials</h1>
        <span class="page-desc">Connect RunnerRunner to GitHub Actions, Gitea Actions, and Azure DevOps.</span>
    </div>
</SectionContent>

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <button class="btn btn-primary" @onclick="StartCreateFlow">
        <i class="bi bi-plus-lg me-1"></i> Add Credential
    </button>
    <span class="text-muted small">Start by choosing a credential type, then follow the provider-specific setup guide.</span>
</div>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-start mb-3">
                <div>
                    <h5 class="card-title mb-1">@(isEditing ? "Edit Credential" : "Add Credential")</h5>
                    <div class="text-muted small">@GetCredentialKindLabel(selectedKind)</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="CloseForm">Cancel</button>
            </div>

            @if (!isEditing)
            {
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge rounded-pill @(GetStepBadgeClass(CredentialWizardStep.ChooseType))">1. Choose type</span>
                    <span class="badge rounded-pill @(GetStepBadgeClass(CredentialWizardStep.SetupGuide))">2. Setup guide</span>
                    <span class="badge rounded-pill @(GetStepBadgeClass(CredentialWizardStep.Details))">3. Enter details</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="alert alert-danger py-2">@formError</div>
            }

            @if (!isEditing && wizardStep == CredentialWizardStep.ChooseType)
            {
                <div class="row g-3">
                    @foreach (var kind in CredentialKinds)
                    {
                        <div class="col-md-6 col-xl-3">
                            <div class="card h-100 @(selectedKind == kind ? "border-primary shadow-sm" : "")">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex align-items-start gap-2 mb-2">
                                        <i class="bi @GetCredentialKindIcon(kind) fs-3 text-primary"></i>
                                        <div>
                                            <h6 class="mb-1">@GetCredentialKindLabel(kind)</h6>
                                            @if (kind == CredentialKind.GitHubApp)
                                            {
                                                <span class="badge bg-success">Recommended</span>
                                            }
                                        </div>
                                    </div>
                                    <p class="small text-muted flex-grow-1">@GetCredentialKindDescription(kind)</p>
                                    <button type="button" class="btn btn-outline-primary btn-sm mt-auto" @onclick="() => SelectCredentialKind(kind)">
                                        Choose @GetCredentialKindShortLabel(kind)
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (!isEditing && wizardStep == CredentialWizardStep.SetupGuide)
            {
                <div class="row g-3">
                    <div class="col-lg-8">
                        <div class="border rounded p-3 h-100">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi @GetCredentialKindIcon(selectedKind) fs-4 text-primary"></i>
                                <h5 class="mb-0">@GetCredentialKindLabel(selectedKind) setup</h5>
                            </div>

                            @if (selectedKind == CredentialKind.GitHubApp)
                            {
                                <ol class="mb-0">
                                    <li class="mb-2">Create a GitHub App from <a href="@GitHubAppCreationUrl" target="_blank" rel="noopener">GitHub developer settings</a>. Use your RunnerRunner URL as the homepage.</li>
                                    <li class="mb-2">Enable webhooks and set the webhook URL to <code>@GitHubWebhookUrl</code>. Generate a strong webhook secret and keep it for the form.</li>
                                    <li class="mb-2">Subscribe to the <code>workflow_job</code> event so RunnerRunner can react when jobs are queued or completed.</li>
                                    <li class="mb-2">Grant runner-management permissions: organization <strong>Self-hosted runners: Read and write</strong> for org runners, and repository <strong>Actions: Read and write</strong> for repo-scoped runners.</li>
                                    <li class="mb-2">Generate a private key, install the app on the organizations or repositories RunnerRunner should manage, then copy the App ID and installation ID.</li>
                                </ol>
                            }
                            else if (selectedKind == CredentialKind.GitHubPat)
                            {
                                <ol class="mb-0">
                                    <li class="mb-2">Create a GitHub personal access token from <a href="@GitHubTokenSettingsUrl" target="_blank" rel="noopener">GitHub token settings</a>.</li>
                                    <li class="mb-2">For organization-level runners, use a token owned by an org admin with <code>admin:org</code> and <code>read:org</code>.</li>
                                    <li class="mb-2">For repository-level runners, grant repository access plus the scopes needed to manage Actions self-hosted runners for that repo.</li>
                                    <li class="mb-2">Decide whether this credential should target a whole organization or a single repository.</li>
                                </ol>
                            }
                            else if (selectedKind == CredentialKind.GiteaActions)
                            {
                                <ol class="mb-0">
                                    <li class="mb-2">In Gitea, enable Actions for the instance and the organization or repository RunnerRunner will manage.</li>
                                    <li class="mb-2">Open the runner settings for the target scope and copy a runner registration token. For dynamic/JIT runners, use a token that can request registration tokens for that scope.</li>
                                    <li class="mb-2">If you use webhook provisioning, configure a Gitea <code>workflow_job</code> webhook to <code>@GiteaWebhookUrl</code> and set the same secret on the provisioning rule.</li>
                                    <li class="mb-2">Record the Gitea instance URL, such as <code>https://gitea.example.com</code>.</li>
                                </ol>
                            }
                            else if (selectedKind == CredentialKind.AzureDevOps)
                            {
                                <ol class="mb-0">
                                    <li class="mb-2">In Azure DevOps, create or choose the agent pool RunnerRunner should register agents into.</li>
                                    <li class="mb-2">Grant the pool access to the project if jobs from that project should use these agents.</li>
                                    <li class="mb-2">Create a PAT with <strong>Agent Pools: Read and manage</strong> for the organization.</li>
                                    <li class="mb-2">Record the organization URL, project name, pool name, and PAT.</li>
                                </ol>
                            }
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="alert alert-info h-100 mb-0">
                            <i class="bi bi-lightbulb me-1"></i>
                            <strong>Tip:</strong> You can save one credential per scope, such as one GitHub App installation for an organization and separate PATs for exceptional repositories.
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-outline-secondary" @onclick="() => wizardStep = CredentialWizardStep.ChooseType">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                    <button class="btn btn-primary" @onclick="GoToDetailsStep">
                        Enter details <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            }
            else
            {
                <div class="alert alert-secondary py-2 d-flex flex-wrap gap-2 align-items-center">
                    <i class="bi @GetCredentialKindIcon(selectedKind)"></i>
                    <span><strong>@GetCredentialKindLabel(selectedKind)</strong> - @GetCredentialKindDescription(selectedKind)</span>
                    @if (!isEditing)
                    {
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => wizardStep = CredentialWizardStep.ChooseType">Change type</button>
                    }
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Credential name</label>
                        <input class="form-control" @bind="editCred.Name" placeholder="@GetDefaultNamePlaceholder(selectedKind)" />
                        <div class="form-text">Use a human-friendly name that describes the provider and scope.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Provider</label>
                        <input class="form-control" value="@GetProviderLabel(editCred.Provider)" disabled />
                    </div>
                    @if (editCred.Provider == RunnerProvider.GitHubActions)
                    {
                        <div class="col-md-4">
                            <label class="form-label">GitHub auth type</label>
                            <input class="form-control" value="@GetGitHubAuthTypeLabel(editCred.GitHubAuthType)" disabled />
                        </div>
                    }
                </div>

                @if (editCred.Provider == RunnerProvider.GitHubActions)
                {
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">GitHub organization</label>
                            <input class="form-control" @bind="editCred.GitHubOrg" placeholder="my-org" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">GitHub repository (optional)</label>
                            <input class="form-control" @bind="editCred.GitHubRepo" placeholder="my-org/my-repo or my-repo" />
                            <div class="form-text">Leave blank for organization-level runners.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">GitHub server URL</label>
                            <input class="form-control" @bind="editCred.GitHubServerUrl" placeholder="https://github.com" />
                        </div>
                    </div>

                    @if (editCred.GitHubAuthType == GitHubAuthType.PersonalAccessToken)
                    {
                        <div class="alert alert-info py-2">
                            <i class="bi bi-shield-lock me-1"></i>
                            Use a token with enough access to create self-hosted runner registration tokens for the selected organization or repository.
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">GitHub token (PAT)</label>
                                <input type="password" class="form-control" @bind="editCred.GitHubToken" autocomplete="off" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">GitHub API URL</label>
                                <input class="form-control" @bind="editCred.GitHubApiUrl" placeholder="https://api.github.com" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2">
                            <i class="bi bi-github me-1"></i>
                            Configure the GitHub App webhook URL as <code>@GitHubWebhookUrl</code>, subscribe to <code>workflow_job</code>, then paste the App ID, installation ID, private key, and webhook secret below.
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label">App ID</label>
                                <input class="form-control" @bind="editCred.GitHubAppId" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Default installation ID</label>
                                <input class="form-control" @bind="editCred.GitHubAppInstallationId" />
                                <div class="form-text">Used for static runners and polling. Webhook events can supply their own installation ID.</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Webhook secret</label>
                                <input type="password" class="form-control" @bind="editCred.GitHubAppWebhookSecret" autocomplete="off" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">GitHub API URL</label>
                                <input class="form-control" @bind="editCred.GitHubApiUrl" placeholder="https://api.github.com" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Private key PEM</label>
                            <textarea class="form-control font-monospace" rows="7" @bind="editCred.GitHubAppPrivateKey" placeholder="-----BEGIN RSA PRIVATE KEY-----"></textarea>
                        </div>
                    }
                }
                else if (editCred.Provider == RunnerProvider.GiteaActions)
                {
                    <div class="alert alert-info py-2">
                        <i class="bi bi-diagram-2 me-1"></i>
                        Gitea runners register against an instance URL with a runner token. Add an org or repository scope when you want RunnerRunner to request scoped registration tokens.
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Gitea instance URL</label>
                            <input class="form-control" @bind="editCred.GiteaInstanceUrl" placeholder="https://gitea.example.com" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Gitea organization (optional)</label>
                            <input class="form-control" @bind="editCred.GitHubOrg" placeholder="my-org" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Gitea repository (optional)</label>
                            <input class="form-control" @bind="editCred.GitHubRepo" placeholder="my-org/my-repo" />
                            <div class="form-text">Use owner/repo for repository-scoped dynamic runners.</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Gitea runner token</label>
                            <input type="password" class="form-control" @bind="editCred.GiteaRunnerToken" autocomplete="off" />
                        </div>
                    </div>
                }
                else if (editCred.Provider == RunnerProvider.AzureDevOps)
                {
                    <div class="alert alert-info py-2">
                        <i class="bi bi-cloud me-1"></i>
                        Azure DevOps agents use the organization URL, pool name, and a PAT during unattended registration.
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Organization URL</label>
                            <input class="form-control" @bind="editCred.AzDoOrgUrl" placeholder="https://dev.azure.com/my-org" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Project name</label>
                            <input class="form-control" @bind="editCred.AzDoProjectName" placeholder="My Project" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Pool name</label>
                            <input class="form-control" @bind="editCred.AzDoPoolName" placeholder="Default" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">PAT</label>
                            <input type="password" class="form-control" @bind="editCred.AzDoPat" autocomplete="off" />
                        </div>
                    </div>
                }

                <div class="d-flex gap-2">
                    @if (!isEditing)
                    {
                        <button class="btn btn-outline-secondary" @onclick="() => wizardStep = CredentialWizardStep.SetupGuide">
                            <i class="bi bi-arrow-left me-1"></i> Setup guide
                        </button>
                    }
                    <button class="btn btn-success" @onclick="SaveCredential">
                        <i class="bi bi-check-lg me-1"></i> Save credential
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseForm">Cancel</button>
                </div>
            }
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped resizable-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Details</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!credentials.Any())
            {
                <tr>
                    <td colspan="4" class="text-muted">No provider credentials yet. Add one to connect a CI provider.</td>
                </tr>
            }
            @foreach (var cred in credentials)
            {
                <tr>
                    <td>@cred.Name</td>
                    <td>@GetCredentialKindLabel(GetCredentialKind(cred))</td>
                    <td>@GetCredentialSummary(cred)</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditCredential(cred)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmAndDeleteCredential(cred)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private static readonly CredentialKind[] CredentialKinds =
    [
        CredentialKind.GitHubApp,
        CredentialKind.GitHubPat,
        CredentialKind.GiteaActions,
        CredentialKind.AzureDevOps
    ];

    private List<ProviderCredential> credentials = [];
    private ProviderCredential editCred = new() { Name = "" };
    private bool showForm;
    private bool isEditing;
    private string? formError;
    private CredentialWizardStep wizardStep = CredentialWizardStep.ChooseType;
    private CredentialKind selectedKind = CredentialKind.GitHubApp;

    protected override async Task OnInitializedAsync()
    {
        await ReloadCredentials();
    }

    private void StartCreateFlow()
    {
        editCred = new ProviderCredential { Name = "" };
        isEditing = false;
        formError = null;
        selectedKind = CredentialKind.GitHubApp;
        wizardStep = CredentialWizardStep.ChooseType;
        ApplyKindToCredential(selectedKind);
        showForm = true;
    }

    private void SelectCredentialKind(CredentialKind kind)
    {
        selectedKind = kind;
        formError = null;
        ApplyKindToCredential(kind);
        wizardStep = CredentialWizardStep.SetupGuide;
    }

    private void GoToDetailsStep()
    {
        formError = null;
        wizardStep = CredentialWizardStep.Details;
    }

    private void EditCredential(ProviderCredential cred)
    {
        editCred = CloneCredential(cred);
        selectedKind = GetCredentialKind(editCred);
        isEditing = true;
        formError = null;
        wizardStep = CredentialWizardStep.Details;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        formError = null;
    }

    private async Task SaveCredential()
    {
        if (!ValidateCredential())
            return;

        editCred.UpdatedAt = DateTime.UtcNow;

        if (isEditing)
            await Store.Update(editCred);
        else
            await Store.Insert(editCred);

        await ReloadCredentials();
        CloseForm();
    }

    private async Task ConfirmAndDeleteCredential(ProviderCredential cred)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete provider credential '{cred.Name}'?");
        if (confirmed) await DeleteCredential(cred.Id);
    }

    private async Task DeleteCredential(string id)
    {
        await Store.Remove<ProviderCredential>(id);
        await ReloadCredentials();
    }

    private async Task ReloadCredentials()
    {
        credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();
    }

    private void ApplyKindToCredential(CredentialKind kind)
    {
        editCred.Provider = kind switch
        {
            CredentialKind.GiteaActions => RunnerProvider.GiteaActions,
            CredentialKind.AzureDevOps => RunnerProvider.AzureDevOps,
            _ => RunnerProvider.GitHubActions
        };

        editCred.GitHubAuthType = kind == CredentialKind.GitHubApp
            ? GitHubAuthType.GitHubApp
            : GitHubAuthType.PersonalAccessToken;

        if (editCred.Provider == RunnerProvider.GitHubActions)
        {
            editCred.GitHubServerUrl = string.IsNullOrWhiteSpace(editCred.GitHubServerUrl)
                ? "https://github.com"
                : editCred.GitHubServerUrl;
            editCred.GitHubApiUrl = string.IsNullOrWhiteSpace(editCred.GitHubApiUrl)
                ? "https://api.github.com"
                : editCred.GitHubApiUrl;
        }
        else if (editCred.Provider == RunnerProvider.AzureDevOps)
        {
            editCred.AzDoPoolName = string.IsNullOrWhiteSpace(editCred.AzDoPoolName)
                ? "Default"
                : editCred.AzDoPoolName;
        }
    }

    private bool ValidateCredential()
    {
        formError = null;

        if (string.IsNullOrWhiteSpace(editCred.Name))
        {
            formError = "Enter a credential name.";
            return false;
        }

        switch (editCred.Provider)
        {
            case RunnerProvider.GitHubActions:
                if (string.IsNullOrWhiteSpace(editCred.GitHubOrg) && string.IsNullOrWhiteSpace(editCred.GitHubRepo))
                {
                    formError = "Enter a GitHub organization or repository.";
                    return false;
                }

                if (string.IsNullOrWhiteSpace(editCred.GitHubOrg)
                    && !string.IsNullOrWhiteSpace(editCred.GitHubRepo)
                    && !editCred.GitHubRepo.Contains('/'))
                {
                    formError = "Enter the GitHub repository as owner/repo when no organization is set.";
                    return false;
                }

                if (editCred.GitHubAuthType == GitHubAuthType.PersonalAccessToken)
                {
                    if (string.IsNullOrWhiteSpace(editCred.GitHubToken))
                    {
                        formError = "Enter a GitHub personal access token.";
                        return false;
                    }
                }
                else
                {
                    if (string.IsNullOrWhiteSpace(editCred.GitHubAppId))
                    {
                        formError = "Enter the GitHub App ID.";
                        return false;
                    }

                    if (string.IsNullOrWhiteSpace(editCred.GitHubAppPrivateKey))
                    {
                        formError = "Paste the GitHub App private key PEM.";
                        return false;
                    }

                }
                break;

            case RunnerProvider.GiteaActions:
                if (string.IsNullOrWhiteSpace(editCred.GiteaInstanceUrl))
                {
                    formError = "Enter the Gitea instance URL.";
                    return false;
                }

                if (string.IsNullOrWhiteSpace(editCred.GitHubOrg)
                    && !string.IsNullOrWhiteSpace(editCred.GitHubRepo)
                    && !editCred.GitHubRepo.Contains('/'))
                {
                    formError = "Enter the Gitea repository as owner/repo when no organization is set.";
                    return false;
                }

                if (string.IsNullOrWhiteSpace(editCred.GiteaRunnerToken))
                {
                    formError = "Enter the Gitea runner token.";
                    return false;
                }
                break;

            case RunnerProvider.AzureDevOps:
                if (string.IsNullOrWhiteSpace(editCred.AzDoOrgUrl))
                {
                    formError = "Enter the Azure DevOps organization URL.";
                    return false;
                }

                if (string.IsNullOrWhiteSpace(editCred.AzDoPoolName))
                {
                    formError = "Enter the Azure DevOps pool name.";
                    return false;
                }

                if (string.IsNullOrWhiteSpace(editCred.AzDoPat))
                {
                    formError = "Enter the Azure DevOps PAT.";
                    return false;
                }
                break;
        }

        return true;
    }

    private string GetCredentialSummary(ProviderCredential cred) => cred.Provider switch
    {
        RunnerProvider.GitHubActions => cred.GitHubAuthType == GitHubAuthType.GitHubApp
            ? $"GitHub App {cred.GitHubAppId ?? "?"} - {FormatScope(cred.GitHubOrg, cred.GitHubRepo)}"
            : $"PAT - {FormatScope(cred.GitHubOrg, cred.GitHubRepo)}",
        RunnerProvider.GiteaActions => $"{cred.GiteaInstanceUrl} - {FormatScope(cred.GitHubOrg, cred.GitHubRepo)}",
        RunnerProvider.AzureDevOps => $"{cred.AzDoOrgUrl} / {cred.AzDoProjectName} / {cred.AzDoPoolName ?? "Default"}",
        _ => ""
    };

    private static string FormatScope(string? org, string? repo)
    {
        if (!string.IsNullOrWhiteSpace(repo))
        {
            var trimmedRepo = repo.Trim().Trim('/');
            return trimmedRepo.Contains('/')
                ? trimmedRepo
                : string.IsNullOrWhiteSpace(org) ? trimmedRepo : $"{org.Trim().Trim('/')}/{trimmedRepo}";
        }

        return string.IsNullOrWhiteSpace(org) ? "all configured scope" : $"{org.Trim().Trim('/')}/*";
    }

    private string GitHubWebhookUrl => $"{Navigation.BaseUri.TrimEnd('/')}/api/webhooks/github";
    private string GiteaWebhookUrl => $"{Navigation.BaseUri.TrimEnd('/')}/api/webhooks/gitea";
    private string GitHubAppCreationUrl => $"{GetGitHubServerUrl()}/settings/apps/new";
    private string GitHubTokenSettingsUrl => $"{GetGitHubServerUrl()}/settings/tokens";

    private string GetGitHubServerUrl()
    {
        var value = editCred.GitHubServerUrl;
        return string.IsNullOrWhiteSpace(value)
            ? "https://github.com"
            : value.TrimEnd('/');
    }

    private static ProviderCredential CloneCredential(ProviderCredential cred) => new()
    {
        Id = cred.Id,
        Name = cred.Name,
        Provider = cred.Provider,
        GitHubOrg = cred.GitHubOrg,
        GitHubRepo = cred.GitHubRepo,
        GitHubToken = cred.GitHubToken,
        GitHubApiUrl = cred.GitHubApiUrl,
        GitHubServerUrl = cred.GitHubServerUrl,
        GitHubAuthType = cred.GitHubAuthType,
        GitHubAppId = cred.GitHubAppId,
        GitHubAppPrivateKey = cred.GitHubAppPrivateKey,
        GitHubAppInstallationId = cred.GitHubAppInstallationId,
        GitHubAppWebhookSecret = cred.GitHubAppWebhookSecret,
        GiteaInstanceUrl = cred.GiteaInstanceUrl,
        GiteaRunnerToken = cred.GiteaRunnerToken,
        AzDoOrgUrl = cred.AzDoOrgUrl,
        AzDoProjectName = cred.AzDoProjectName,
        AzDoPat = cred.AzDoPat,
        AzDoPoolName = cred.AzDoPoolName,
        CreatedAt = cred.CreatedAt,
        UpdatedAt = cred.UpdatedAt
    };

    private static CredentialKind GetCredentialKind(ProviderCredential cred) => cred.Provider switch
    {
        RunnerProvider.GitHubActions => cred.GitHubAuthType == GitHubAuthType.GitHubApp
            ? CredentialKind.GitHubApp
            : CredentialKind.GitHubPat,
        RunnerProvider.GiteaActions => CredentialKind.GiteaActions,
        RunnerProvider.AzureDevOps => CredentialKind.AzureDevOps,
        _ => CredentialKind.GitHubPat
    };

    private static string GetCredentialKindLabel(CredentialKind kind) => kind switch
    {
        CredentialKind.GitHubApp => "GitHub Actions - GitHub App",
        CredentialKind.GitHubPat => "GitHub Actions - Personal Access Token",
        CredentialKind.GiteaActions => "Gitea Actions",
        CredentialKind.AzureDevOps => "Azure DevOps",
        _ => kind.ToString()
    };

    private static string GetCredentialKindShortLabel(CredentialKind kind) => kind switch
    {
        CredentialKind.GitHubApp => "GitHub App",
        CredentialKind.GitHubPat => "GitHub PAT",
        CredentialKind.GiteaActions => "Gitea",
        CredentialKind.AzureDevOps => "Azure DevOps",
        _ => kind.ToString()
    };

    private static string GetCredentialKindDescription(CredentialKind kind) => kind switch
    {
        CredentialKind.GitHubApp => "Best for organizations and webhook-driven scaling with installation-scoped access.",
        CredentialKind.GitHubPat => "Use an existing GitHub token for simple organization or repository runner registration.",
        CredentialKind.GiteaActions => "Connect to a Gitea instance with an act_runner registration token.",
        CredentialKind.AzureDevOps => "Register Azure Pipelines agents into an organization agent pool.",
        _ => ""
    };

    private static string GetCredentialKindIcon(CredentialKind kind) => kind switch
    {
        CredentialKind.GitHubApp or CredentialKind.GitHubPat => "bi-github",
        CredentialKind.GiteaActions => "bi-diagram-2-fill",
        CredentialKind.AzureDevOps => "bi-cloud-fill",
        _ => "bi-key-fill"
    };

    private static string GetDefaultNamePlaceholder(CredentialKind kind) => kind switch
    {
        CredentialKind.GitHubApp => "github-app-my-org",
        CredentialKind.GitHubPat => "github-pat-my-repo",
        CredentialKind.GiteaActions => "gitea-my-org",
        CredentialKind.AzureDevOps => "azdo-default-pool",
        _ => "provider-credential"
    };

    private string GetStepBadgeClass(CredentialWizardStep step)
    {
        if (wizardStep == step)
            return "bg-primary";

        return wizardStep > step ? "bg-success" : "bg-secondary";
    }

    private static string GetProviderLabel(RunnerProvider provider) => provider switch
    {
        RunnerProvider.GitHubActions => "GitHub Actions",
        RunnerProvider.GiteaActions => "Gitea Actions",
        RunnerProvider.AzureDevOps => "Azure DevOps",
        _ => provider.ToString()
    };

    private static string GetGitHubAuthTypeLabel(GitHubAuthType authType) => authType switch
    {
        GitHubAuthType.GitHubApp => "GitHub App",
        _ => "Personal Access Token"
    };

    private enum CredentialWizardStep
    {
        ChooseType,
        SetupGuide,
        Details
    }

    private enum CredentialKind
    {
        GitHubApp,
        GitHubPat,
        GiteaActions,
        AzureDevOps
    }
}
