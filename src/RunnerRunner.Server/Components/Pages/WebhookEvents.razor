@page "/webhook-events"
@rendermode InteractiveServer
@implements IDisposable
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Server.Services
@inject IDocumentStore Store
@inject CapacityPlanningService CapacityService

<PageTitle>Events - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-clock-history"></i> Events</h1>
        <span class="page-desc">Webhook and provisioning audit trail for the Orleans runner lifecycle.</span>
    </div>
</SectionContent>

<div class="mb-3 d-flex flex-wrap align-items-end gap-2">
    <div>
        <label class="form-label mb-0 small text-muted">Search</label>
        <input type="text" class="form-control form-control-sm" placeholder="Filter events…" @bind="searchText" @bind:event="oninput" style="min-width:220px;" />
    </div>
    <div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </div>
    <div class="small text-muted mb-1">Auto-refreshing every 5s</div>
</div>

<div class="alert alert-info py-2 d-flex align-items-center gap-2 mb-3" style="font-size: 0.9rem;">
    <i class="bi bi-info-circle"></i>
    <span>Queued work is evaluated in this order: <strong>FIFO</strong> → <strong>rule concurrency</strong> → <strong>profile per-host cap</strong> → <strong>host backend slots</strong>.</span>
</div>

@if (!filteredEvents.Any())
{
    <div class="text-center text-muted py-4">No webhook events match the current filters.</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped resizable-table">
        <thead>
            <tr>
                <th data-col-kind="time" data-col-min="108" data-col-preferred="130" data-col-priority="3">Time</th>
                <th data-col-kind="compact" data-col-min="78" data-col-preferred="96" data-col-priority="4">Action</th>
                <th data-col-kind="name" data-col-min="170" data-col-preferred="250" data-col-weight="3.5">Repository</th>
                <th data-col-kind="related" data-col-min="130" data-col-preferred="180" data-col-priority="3">Workflow</th>
                <th data-col-kind="related" data-col-min="112" data-col-preferred="150" data-col-priority="4">Rule</th>
                <th data-col-kind="optional" data-col-min="100" data-col-preferred="140" data-col-priority="5">Labels</th>
                <th data-col-kind="optional" data-col-min="88" data-col-preferred="112" data-col-priority="5">Image Tag</th>
                <th data-col-kind="related" data-col-min="118" data-col-preferred="150" data-col-priority="4">Matched Profile</th>
                <th data-col-kind="description" data-col-min="220" data-col-preferred="320" data-col-priority="2" data-col-weight="1.7">Status</th>
                <th data-col-kind="optional" data-col-min="98" data-col-preferred="126" data-col-priority="5">Instance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evt in filteredEvents)
            {
                <tr>
                    <td>@evt.ReceivedAt.ToString("g")</td>
                    <td><span class="badge @(evt.Action == "queued" ? "bg-primary" : "bg-secondary")">@evt.Action</span></td>
                    <td class="name-cell">
                        <span class="primary-label">@evt.Repository</span>
                        @if (!string.IsNullOrWhiteSpace(evt.GitHubInstallationId))
                        {
                            <small class="secondary-label">installation @evt.GitHubInstallationId</small>
                        }
                    </td>
                    <td>@evt.WorkflowName</td>
                    <td>@GetSourceName(evt)</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var label in evt.Labels)
                            {
                                <span class="badge bg-secondary">@label</span>
                            }
                        </div>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(evt.ImageTagOverride))
                        {
                            <span class="badge bg-info text-dark" title="Webhook-supplied image tag override (rr-image-tag label)">@evt.ImageTagOverride</span>
                            @if (!string.IsNullOrEmpty(evt.ImageTagOverrideRejectedReason))
                            {
                                <div><small class="text-danger" title="@evt.ImageTagOverrideRejectedReason">ignored</small></div>
                            }
                        }
                        else if (!string.IsNullOrEmpty(evt.ImageTagOverrideRejectedReason))
                        {
                            <small class="text-danger" title="@evt.ImageTagOverrideRejectedReason">rejected</small>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@(evt.MatchedProfileName ?? "—")</td>
                    <td>
                        @{
                            var insight = GetEventInsight(evt);
                            var primaryMessage = GetPrimaryStatusMessage(evt);
                            var metaItems = GetStatusMeta(evt).ToList();
                        }
                        <div class="event-status-card @GetStatusToneClass(evt.Status)">
                            <div class="event-status-heading">
                                <span class="badge @GetStatusBadge(evt.Status)">@GetStatusLabel(evt.Status)</span>
                                @if (insight is not null && insight.BlockedBy != CapacityBlockerKind.None)
                                {
                                    <span class="event-blocker-pill @GetLimitToneClass(insight.BlockedBy)" title="@GetInsightTitle(insight)">
                                        <i class="bi @GetLimitIcon(insight.BlockedBy)"></i>@GetLimitLabel(insight.BlockedBy)
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(primaryMessage))
                            {
                                <span class="event-status-summary" title="@primaryMessage">@primaryMessage</span>
                            }
                            @if (metaItems.Any())
                            {
                                <div class="event-status-meta">
                                    @foreach (var item in metaItems)
                                    {
                                        <span title="@item.Title">
                                            <i class="bi @item.Icon"></i>@item.Text
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(evt.InstanceId))
                        {
                            <a href="/runners">@evt.InstanceId[..Math.Min(8, evt.InstanceId.Length)]…</a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<WebhookEvent> allEvents = [];
    private List<WebhookEvent> filteredEvents = [];
    private Dictionary<string, string> sourceNames = [];
    private CapacitySnapshot capacitySnapshot = CapacitySnapshot.Empty;
    private string searchText = "";
    private CancellationTokenSource? _refreshCts;

    private string _lastSearch = "";

    private sealed record EventStatusMeta(string Icon, string Text, string Title);

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _refreshCts = new CancellationTokenSource();
        _ = RunAutoRefreshAsync(_refreshCts.Token);
    }

    protected override void OnParametersSet() => ApplyFilter();

    private void ApplyFilter(bool force = false)
    {
        if (!force && searchText == _lastSearch && filteredEvents.Any())
            return;
        _lastSearch = searchText;

        var q = allEvents.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim();
            q = q.Where(e =>
                e.Repository.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (e.GitHubInstallationId?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || e.WorkflowName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.Status.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        filteredEvents = q.ToList();
    }

    private async Task Refresh()
    {
        var rules = (await Store.Query<ProvisioningRule>().ToList()).ToList();
        var bindings = (await Store.Query<WebhookBinding>().ToList()).ToList();
        sourceNames = rules.ToDictionary(r => r.Id, r => r.Name);

        foreach (var binding in bindings)
            sourceNames.TryAdd(binding.Id, binding.Name);

        allEvents = (await Store.Query<WebhookEvent>().ToList())
            .OrderByDescending(e => e.ReceivedAt)
            .ThenByDescending(GetActivityTime)
            .ToList();
        capacitySnapshot = await CapacityService.GetSnapshotAsync();
        ApplyFilter(force: true);
        await InvokeAsync(StateHasChanged);
    }

    private static DateTime GetActivityTime(WebhookEvent evt) =>
        evt.UpdatedAt > evt.ReceivedAt ? evt.UpdatedAt : evt.ReceivedAt;

    private async Task RunAutoRefreshAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(Refresh);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string GetSourceName(WebhookEvent evt) =>
        string.IsNullOrWhiteSpace(evt.BindingId)
            ? "—"
            : sourceNames.GetValueOrDefault(evt.BindingId, evt.BindingId);

    private string GetStatusBadge(string status) => status switch
    {
        "provisioned" => "bg-success",
        "completed" => "bg-success",
        "matching" or "preparing" or "dispatching" => "bg-primary",
        "matched" or "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match" or "rate_limited" => "bg-warning text-dark",
        "error" or "rejected" or "timed_out" => "bg-danger",
        "in_progress" => "bg-info",
        "ignored" => "bg-light text-muted",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "pending_fifo" => "Queued (FIFO)",
        "pending_capacity" => "Waiting capacity",
        "pending_host_match" => "Waiting host",
        "pending_config" => "Waiting config",
        "matching" => "Matching",
        "preparing" => "Preparing",
        "dispatching" => "Dispatching",
        "provisioned" => "Provisioned",
        "in_progress" => "Job running",
        "no_match" => "No match",
        _ => status
    };

    private EventCapacityView? GetEventInsight(WebhookEvent evt) =>
        IsQueuedWait(evt) && capacitySnapshot.Events.TryGetValue(evt.Id, out var insight)
            ? insight
            : null;

    private string? GetPrimaryStatusMessage(WebhookEvent evt)
    {
        if (!string.IsNullOrWhiteSpace(evt.Error))
            return evt.Error;

        return evt.Status switch
        {
            "provisioned" when !string.IsNullOrWhiteSpace(evt.InstanceId) => $"Runner {evt.InstanceId[..Math.Min(8, evt.InstanceId.Length)]} created",
            "in_progress" => "Workflow job is running on a matched runner.",
            "completed" => "Workflow job completed.",
            "ignored" => "Event ignored by the provisioning pipeline.",
            _ => null
        };
    }

    private IEnumerable<EventStatusMeta> GetStatusMeta(WebhookEvent evt)
    {
        if (IsQueuedWait(evt))
        {
            var queuePosition = GetQueuePosition(evt);
            if (queuePosition.HasValue)
                yield return new("bi-list-ol", $"#{queuePosition.Value}", $"Queue position #{queuePosition.Value}");

            yield return new("bi-clock", evt.ReceivedAt.ToLocalTime().ToString("t"), $"Waiting since {evt.ReceivedAt.ToLocalTime():f}");
        }

        if (evt.RetryCount > 0)
            yield return new("bi-arrow-repeat", evt.RetryCount.ToString(), $"{evt.RetryCount} provisioning attempt(s)");

        if (evt.NextRetryAt.HasValue && evt.Status is "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match" or "provisioned")
            yield return new("bi-skip-forward", evt.NextRetryAt.Value.ToLocalTime().ToString("t"), $"Next check at {evt.NextRetryAt.Value.ToLocalTime():f}");

        if (evt.ExpiresAt.HasValue && evt.Status is not "completed" and not "timed_out")
            yield return new("bi-hourglass-split", evt.ExpiresAt.Value.ToLocalTime().ToString("t"), $"Expires at {evt.ExpiresAt.Value.ToLocalTime():f}");
    }

    private static string GetStatusToneClass(string status) => status switch
    {
        "provisioned" or "completed" => "event-status-good",
        "matching" or "preparing" or "dispatching" or "in_progress" => "event-status-info",
        "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match" or "rate_limited" => "event-status-warn",
        "error" or "rejected" or "timed_out" => "event-status-danger",
        "ignored" => "event-status-muted",
        _ => ""
    };

    private static bool IsQueuedWait(WebhookEvent evt) =>
        evt.Action == "queued"
        && evt.Status is "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match";

    private string GetLimitBadge(CapacityBlockerKind kind) => kind switch
    {
        CapacityBlockerKind.Fifo => "bg-secondary",
        CapacityBlockerKind.ProvisioningRule => "bg-warning text-dark",
        CapacityBlockerKind.Profile => "bg-info text-dark",
        CapacityBlockerKind.Host => "bg-danger",
        CapacityBlockerKind.Matching => "bg-dark",
        CapacityBlockerKind.Configuration => "bg-secondary",
        _ => "bg-light text-muted"
    };

    private static string GetLimitToneClass(CapacityBlockerKind kind) => kind switch
    {
        CapacityBlockerKind.Fifo => "event-blocker-neutral",
        CapacityBlockerKind.ProvisioningRule => "event-blocker-warn",
        CapacityBlockerKind.Profile => "event-blocker-info",
        CapacityBlockerKind.Host => "event-blocker-danger",
        CapacityBlockerKind.Matching => "event-blocker-dark",
        CapacityBlockerKind.Configuration => "event-blocker-neutral",
        _ => "event-blocker-neutral"
    };

    private static string GetLimitIcon(CapacityBlockerKind kind) => kind switch
    {
        CapacityBlockerKind.Fifo => "bi-signpost-split",
        CapacityBlockerKind.ProvisioningRule => "bi-diagram-3",
        CapacityBlockerKind.Profile => "bi-person-badge",
        CapacityBlockerKind.Host => "bi-hdd-network",
        CapacityBlockerKind.Matching => "bi-filter-circle",
        CapacityBlockerKind.Configuration => "bi-gear",
        _ => "bi-check-circle"
    };

    private string GetLimitLabel(CapacityBlockerKind kind) => kind switch
    {
        CapacityBlockerKind.Fifo => "FIFO",
        CapacityBlockerKind.ProvisioningRule => "Rule",
        CapacityBlockerKind.Profile => "Profile",
        CapacityBlockerKind.Host => "Host",
        CapacityBlockerKind.Matching => "Match",
        CapacityBlockerKind.Configuration => "Config",
        _ => "Ready"
    };

    private static string GetInsightTitle(EventCapacityView insight)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(insight.Summary))
            parts.Add(insight.Summary);
        parts.AddRange(insight.Details);
        return string.Join(" · ", parts);
    }

    private int? GetQueuePosition(WebhookEvent evt)
    {
        if (!IsQueuedWait(evt))
            return null;

        var orderedQueue = allEvents
            .Where(IsQueuedWait)
            .OrderBy(e => e.ReceivedAt)
            .ThenBy(e => e.Id)
            .Select((e, index) => new { e.Id, Position = index + 1 })
            .FirstOrDefault(e => e.Id == evt.Id);

        return orderedQueue?.Position;
    }

    public void Dispose()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
    }
}
