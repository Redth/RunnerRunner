@page "/webhook-events"
@attribute [Authorize(Policy = RunnerRunnerPolicies.CanView)]
@rendermode InteractiveServer
@implements IDisposable
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Server.Services
@inject IDocumentStore Store
@inject CapacityPlanningService CapacityService

<PageTitle>Events - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-clock-history"></i> Events</h1>
        <span class="page-desc">Webhook and provisioning audit trail for the Orleans runner lifecycle.</span>
    </div>
</SectionContent>

<div class="rr-filter-panel mb-3" aria-label="Event filters">
    <div class="rr-filter-header">
        <div class="rr-filter-panel-title">
            <i class="bi bi-funnel"></i>
            <span>Filters</span>
        </div>
        <div class="rr-filter-header-actions">
            <label class="rr-auto-refresh-control">
                <span>Auto-refresh</span>
                <select class="form-select form-select-sm rr-auto-refresh-select" value="@autoRefreshInterval" @onchange="AutoRefreshIntervalChanged">
                    <option value="3">3s</option>
                    <option value="5">5s</option>
                    <option value="30">30s</option>
                    <option value="60">60s</option>
                    <option value="@AutoRefreshNever">Never</option>
                </select>
            </label>
            <div class="rr-filter-buttons">
                <button class="btn btn-sm rr-filter-btn rr-filter-btn-clear" @onclick="ClearFilters" disabled="@(!HasActiveFilters)">
                    <i class="bi bi-eraser"></i> Clear
                </button>
                <button class="btn btn-sm rr-filter-btn rr-filter-btn-refresh" @onclick="Refresh">
                    <i class="bi bi-arrow-clockwise"></i> Refresh
                </button>
            </div>
        </div>
    </div>
    <div class="rr-filter-grid">
        <div class="rr-filter-field rr-filter-field-wide">
            <label class="form-label">Search</label>
            <input type="search" class="form-control form-control-sm" placeholder="Repo, workflow, labels, status…" @bind="searchText" @bind:event="oninput" @bind:after="ApplyFilterFromInput" />
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Repository</label>
            <input type="search" class="form-control form-control-sm" list="event-repository-options" placeholder="owner/repo" @bind="repositoryFilter" @bind:event="oninput" @bind:after="ApplyFilterFromInput" />
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Workflow</label>
            <input type="search" class="form-control form-control-sm" list="event-workflow-options" placeholder="workflow name" @bind="workflowFilter" @bind:event="oninput" @bind:after="ApplyFilterFromInput" />
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Rule</label>
            <input type="search" class="form-control form-control-sm" list="event-rule-options" placeholder="provisioning rule" @bind="ruleFilter" @bind:event="oninput" @bind:after="ApplyFilterFromInput" />
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Labels</label>
            <input type="search" class="form-control form-control-sm" list="event-label-options" placeholder="linux, docker" @bind="labelFilter" @bind:event="oninput" @bind:after="ApplyFilterFromInput" />
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Status</label>
            <select class="form-select form-select-sm" @bind="statusFilter" @bind:after="ApplyFilterFromInput">
                <option value="">Any status</option>
                @foreach (var status in StatusOptions)
                {
                    <option value="@status">@GetStatusLabel(status)</option>
                }
            </select>
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Visibility</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="showIgnoredEvents" @bind="showIgnoredEvents" @bind:after="ApplyFilterFromInput" />
                <label class="form-check-label" for="showIgnoredEvents">Show ignored org/repo/target</label>
            </div>
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Action</label>
            <select class="form-select form-select-sm" @bind="actionFilter" @bind:after="ApplyFilterFromInput">
                <option value="">Any action</option>
                @foreach (var action in ActionOptions)
                {
                    <option value="@action">@action</option>
                }
            </select>
        </div>
        <div class="rr-filter-field">
            <label class="form-label">Target</label>
            <input type="search" class="form-control form-control-sm" list="event-profile-options" placeholder="runner target or profile" @bind="profileFilter" @bind:event="oninput" @bind:after="ApplyFilterFromInput" />
        </div>
    </div>
    <div class="rr-filter-summary">
        Showing @filteredEvents.Count of @allEvents.Count events
        @if (HiddenIgnoredEventCount > 0 && !IncludeIgnoredEvents)
        {
            <span class="text-muted">(@HiddenIgnoredEventCount ignored hidden)</span>
        }
    </div>
</div>

<datalist id="event-repository-options">
    @foreach (var option in RepositoryOptions)
    {
        <option value="@option"></option>
    }
</datalist>
<datalist id="event-workflow-options">
    @foreach (var option in WorkflowOptions)
    {
        <option value="@option"></option>
    }
</datalist>
<datalist id="event-rule-options">
    @foreach (var option in RuleOptions)
    {
        <option value="@option"></option>
    }
</datalist>
<datalist id="event-label-options">
    @foreach (var option in LabelOptions)
    {
        <option value="@option"></option>
    }
</datalist>
<datalist id="event-profile-options">
    @foreach (var option in ProfileOptions)
    {
        <option value="@option"></option>
    }
</datalist>

@if (!filteredEvents.Any())
{
    <div class="text-center text-muted py-4">No webhook events match the current filters.</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped resizable-table">
        <thead>
            <tr>
                <th data-col-kind="time" data-col-min="108" data-col-preferred="130" data-col-priority="3">Time</th>
                <th data-col-kind="compact" data-col-min="78" data-col-preferred="96" data-col-priority="4">Action</th>
                <th data-col-kind="name" data-col-min="170" data-col-preferred="250" data-col-weight="3.5">Repository</th>
                <th data-col-kind="related" data-col-min="130" data-col-preferred="180" data-col-priority="3">Workflow</th>
                <th data-col-kind="related" data-col-min="112" data-col-preferred="150" data-col-priority="4">Rule</th>
                <th data-col-kind="optional" data-col-min="100" data-col-preferred="140" data-col-priority="5">Labels</th>
                <th data-col-kind="optional" data-col-min="88" data-col-preferred="112" data-col-priority="5">Image Tag</th>
                <th data-col-kind="related" data-col-min="118" data-col-preferred="160" data-col-priority="4">Matched Target</th>
                <th data-col-kind="description" data-col-min="220" data-col-preferred="320" data-col-priority="2" data-col-weight="1.7">Status</th>
                <th data-col-kind="optional" data-col-min="98" data-col-preferred="126" data-col-priority="5">Instance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evt in filteredEvents)
            {
                <tr>
                    <td>@evt.ReceivedAt.ToString("g")</td>
                    <td><span class="badge @(evt.Action == "queued" ? "bg-primary" : "bg-secondary")">@evt.Action</span></td>
                    <td class="name-cell">
                        <span class="primary-label">@evt.Repository</span>
                        @if (!string.IsNullOrWhiteSpace(evt.GitHubInstallationId))
                        {
                            <small class="secondary-label">installation @evt.GitHubInstallationId</small>
                        }
                    </td>
                    <td>@evt.WorkflowName</td>
                    <td>@GetSourceName(evt)</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var label in evt.Labels)
                            {
                                <span class="badge bg-secondary">@label</span>
                            }
                        </div>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(evt.ImageTagOverride))
                        {
                            <span class="badge bg-info text-dark" title="Webhook-supplied image tag override (rr-image-tag label)">@evt.ImageTagOverride</span>
                            @if (!string.IsNullOrEmpty(evt.ImageTagOverrideRejectedReason))
                            {
                                <div><small class="text-danger" title="@evt.ImageTagOverrideRejectedReason">ignored</small></div>
                            }
                        }
                        else if (!string.IsNullOrEmpty(evt.ImageTagOverrideRejectedReason))
                        {
                            <small class="text-danger" title="@evt.ImageTagOverrideRejectedReason">rejected</small>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(evt.MatchedRunnerDefinitionName) || !string.IsNullOrWhiteSpace(evt.MatchedProfileName))
                        {
                            <span class="primary-label">@(evt.MatchedRunnerDefinitionName ?? evt.MatchedProfileName)</span>
                            @if (!string.IsNullOrWhiteSpace(evt.RequestedRunnerTargetKey))
                            {
                                <small class="secondary-label">@evt.RequestedRunnerTargetKey</small>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(evt.RequestedRunnerTargetKey))
                        {
                            <span class="badge bg-warning text-dark" title="@evt.RunnerTargetSelectionReason">@evt.RequestedRunnerTargetKey</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @{
                            var insight = GetEventInsight(evt);
                            var primaryMessage = GetPrimaryStatusMessage(evt);
                            var metaItems = GetStatusMeta(evt).ToList();
                        }
                        <div class="event-status-card @GetStatusToneClass(evt.Status)">
                            <div class="event-status-heading">
                                <span class="badge @GetStatusBadge(evt.Status)">@GetStatusLabel(evt.Status)</span>
                                @if (insight is not null && insight.BlockedBy != CapacityBlockerKind.None)
                                {
                                    <span class="event-blocker-pill @GetLimitToneClass(insight.BlockedBy)" title="@GetInsightTitle(insight)">
                                        <i class="bi @GetLimitIcon(insight.BlockedBy)"></i>@GetLimitLabel(insight.BlockedBy)
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(primaryMessage))
                            {
                                <span class="event-status-summary" title="@primaryMessage">@primaryMessage</span>
                            }
                            @if (metaItems.Any())
                            {
                                <div class="event-status-meta">
                                    @foreach (var item in metaItems)
                                    {
                                        <span title="@item.Title">
                                            <i class="bi @item.Icon"></i>@item.Text
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(evt.InstanceId))
                        {
                            <a href="/runners">@evt.InstanceId[..Math.Min(8, evt.InstanceId.Length)]…</a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<WebhookEvent> allEvents = [];
    private List<WebhookEvent> filteredEvents = [];
    private Dictionary<string, string> sourceNames = [];
    private CapacitySnapshot capacitySnapshot = CapacitySnapshot.Empty;
    private string searchText = "";
    private string repositoryFilter = "";
    private string workflowFilter = "";
    private string ruleFilter = "";
    private string labelFilter = "";
    private string statusFilter = "";
    private string actionFilter = "";
    private string profileFilter = "";
    private bool showIgnoredEvents;
    private CancellationTokenSource? _refreshCts;
    private const string AutoRefreshNever = "never";
    private string autoRefreshInterval = "5";

    private string _lastFilterSignature = "";

    private sealed record EventStatusMeta(string Icon, string Text, string Title);

    private IEnumerable<string> RepositoryOptions => DistinctOptions(allEvents.Select(e => e.Repository));

    private IEnumerable<string> WorkflowOptions => DistinctOptions(allEvents.Select(e => e.WorkflowName));

    private IEnumerable<string> RuleOptions => DistinctOptions(allEvents.Select(GetSourceName).Where(name => name != "—"));

    private IEnumerable<string> LabelOptions => DistinctOptions(allEvents.SelectMany(e => e.Labels));

    private IEnumerable<string> StatusOptions => DistinctOptions(allEvents.Select(e => e.Status));

    private IEnumerable<string> ActionOptions => DistinctOptions(allEvents.Select(e => e.Action));

    private IEnumerable<string> ProfileOptions => DistinctOptions(allEvents
        .SelectMany(e => new[] { e.MatchedRunnerDefinitionName, e.RequestedRunnerTargetKey, e.MatchedProfileName }));

    private int HiddenIgnoredEventCount => allEvents.Count(IsHiddenIgnoredEvent);

    private bool IncludeIgnoredEvents => showIgnoredEvents || IsHiddenIgnoredStatus(statusFilter);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchText)
        || !string.IsNullOrWhiteSpace(repositoryFilter)
        || !string.IsNullOrWhiteSpace(workflowFilter)
        || !string.IsNullOrWhiteSpace(ruleFilter)
        || !string.IsNullOrWhiteSpace(labelFilter)
        || !string.IsNullOrWhiteSpace(statusFilter)
        || !string.IsNullOrWhiteSpace(actionFilter)
        || !string.IsNullOrWhiteSpace(profileFilter)
        || showIgnoredEvents;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        RestartAutoRefresh();
    }

    protected override void OnParametersSet() => ApplyFilter();

    private void ApplyFilterFromInput() => ApplyFilter(force: true);

    private void ApplyFilter(bool force = false)
    {
        var signature = string.Join('\u001f',
            searchText,
            repositoryFilter,
            workflowFilter,
            ruleFilter,
            labelFilter,
            statusFilter,
            actionFilter,
            profileFilter,
            showIgnoredEvents);

        if (!force && signature == _lastFilterSignature && filteredEvents.Any())
            return;
        _lastFilterSignature = signature;

        var q = allEvents.AsEnumerable();
        if (!IncludeIgnoredEvents)
            q = q.Where(e => !IsHiddenIgnoredEvent(e));

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim();
            q = q.Where(e =>
                e.Repository.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (e.GitHubInstallationId?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || e.WorkflowName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.Status.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.Action.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.Provider.Contains(term, StringComparison.OrdinalIgnoreCase)
                || GetSourceName(e).Contains(term, StringComparison.OrdinalIgnoreCase)
                || (e.MatchedRunnerDefinitionName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.RequestedRunnerTargetKey?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.RunnerTargetSelectionReason?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.MatchedProfileName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.InstanceId?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || e.JobId.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.RunId.Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.Labels.Any(label => label.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(repositoryFilter))
            q = q.Where(e => e.Repository.Contains(repositoryFilter.Trim(), StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(workflowFilter))
            q = q.Where(e => e.WorkflowName.Contains(workflowFilter.Trim(), StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(ruleFilter))
        {
            var term = ruleFilter.Trim();
            q = q.Where(e =>
                GetSourceName(e).Contains(term, StringComparison.OrdinalIgnoreCase)
                || e.BindingId.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        var labelTerms = SplitFilterTerms(labelFilter).ToList();
        if (labelTerms.Any())
        {
            q = q.Where(e => labelTerms.All(term =>
                e.Labels.Any(label => label.Contains(term, StringComparison.OrdinalIgnoreCase))));
        }

        if (!string.IsNullOrWhiteSpace(statusFilter))
            q = q.Where(e => string.Equals(e.Status, statusFilter, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(actionFilter))
            q = q.Where(e => string.Equals(e.Action, actionFilter, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(profileFilter))
        {
            var term = profileFilter.Trim();
            q = q.Where(e =>
                (e.MatchedRunnerDefinitionName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.MatchedRunnerDefinitionId?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.RequestedRunnerTargetKey?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || e.ValidRunnerTargetKeys.Any(target => target.Contains(term, StringComparison.OrdinalIgnoreCase))
                || (e.MatchedProfileName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (e.MatchedProfileId?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        filteredEvents = q.ToList();
    }

    private void ClearFilters()
    {
        searchText = "";
        repositoryFilter = "";
        workflowFilter = "";
        ruleFilter = "";
        labelFilter = "";
        statusFilter = "";
        actionFilter = "";
        profileFilter = "";
        showIgnoredEvents = false;
        ApplyFilter(force: true);
    }

    private static IEnumerable<string> DistinctOptions(IEnumerable<string?> values) =>
        values
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
            .Take(100);

    private static IEnumerable<string> SplitFilterTerms(string value) =>
        value
            .Split([','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(term => !string.IsNullOrWhiteSpace(term));

    private static bool IsHiddenIgnoredEvent(WebhookEvent evt) =>
        IsHiddenIgnoredStatus(evt.Status);

    private static bool IsHiddenIgnoredStatus(string? status) =>
        string.Equals(status, WebhookEvent.StatusIgnoredScope, StringComparison.OrdinalIgnoreCase)
        || string.Equals(status, WebhookEvent.StatusIgnoredTarget, StringComparison.OrdinalIgnoreCase);

    private async Task Refresh()
    {
        var rules = (await Store.Query<ProvisioningRule>().ToList()).ToList();
        var bindings = (await Store.Query<WebhookBinding>().ToList()).ToList();
        sourceNames = rules.ToDictionary(r => r.Id, r => r.Name);

        foreach (var binding in bindings)
            sourceNames.TryAdd(binding.Id, binding.Name);

        allEvents = (await Store.Query<WebhookEvent>().ToList())
            .OrderByDescending(e => e.ReceivedAt)
            .ThenByDescending(GetActivityTime)
            .ToList();
        capacitySnapshot = await CapacityService.GetSnapshotAsync();
        ApplyFilter(force: true);
        await InvokeAsync(StateHasChanged);
    }

    private static DateTime GetActivityTime(WebhookEvent evt) =>
        evt.UpdatedAt > evt.ReceivedAt ? evt.UpdatedAt : evt.ReceivedAt;

    private void AutoRefreshIntervalChanged(ChangeEventArgs args)
    {
        autoRefreshInterval = args.Value?.ToString() ?? AutoRefreshNever;
        RestartAutoRefresh();
    }

    private void RestartAutoRefresh()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshCts = null;

        if (!TryGetAutoRefreshInterval(out var interval))
            return;

        _refreshCts = new CancellationTokenSource();
        _ = RunAutoRefreshAsync(interval, _refreshCts.Token);
    }

    private bool TryGetAutoRefreshInterval(out TimeSpan interval)
    {
        if (int.TryParse(autoRefreshInterval, out var seconds) && seconds > 0)
        {
            interval = TimeSpan.FromSeconds(seconds);
            return true;
        }

        interval = TimeSpan.Zero;
        return false;
    }

    private async Task RunAutoRefreshAsync(TimeSpan interval, CancellationToken ct)
    {
        using var timer = new PeriodicTimer(interval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(Refresh);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string GetSourceName(WebhookEvent evt) =>
        string.IsNullOrWhiteSpace(evt.BindingId)
            ? "—"
            : sourceNames.GetValueOrDefault(evt.BindingId, evt.BindingId);

    private string GetStatusBadge(string status) => status switch
    {
        "provisioned" => "bg-success",
        "completed" => "bg-success",
        "matching" or "preparing" or "dispatching" => "bg-primary",
        "matched" or "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match" or "rate_limited" => "bg-warning text-dark",
        "error" or "rejected" or "timed_out" => "bg-danger",
        "in_progress" => "bg-info",
        "ignored" or WebhookEvent.StatusIgnoredScope or WebhookEvent.StatusIgnoredTarget => "bg-light text-muted",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "pending_fifo" => "Queued (FIFO)",
        "pending_capacity" => "Waiting capacity",
        "pending_host_match" => "Waiting host",
        "pending_config" => "Waiting config",
        "matching" => "Matching",
        "preparing" => "Preparing",
        "dispatching" => "Dispatching",
        "provisioned" => "Provisioned",
        "in_progress" => "Job running",
        "no_match" => "No match",
        WebhookEvent.StatusIgnoredScope => "Ignored org/repo",
        WebhookEvent.StatusIgnoredTarget => "Ignored target",
        _ => status
    };

    private EventCapacityView? GetEventInsight(WebhookEvent evt) =>
        IsQueuedWait(evt) && capacitySnapshot.Events.TryGetValue(evt.Id, out var insight)
            ? insight
            : null;

    private string? GetPrimaryStatusMessage(WebhookEvent evt)
    {
        if (!string.IsNullOrWhiteSpace(evt.Error))
            return evt.Error;

        return evt.Status switch
        {
            "provisioned" when !string.IsNullOrWhiteSpace(evt.InstanceId) => $"Runner {evt.InstanceId[..Math.Min(8, evt.InstanceId.Length)]} created",
            "in_progress" => "Workflow job is running on a matched runner.",
            "completed" => "Workflow job completed.",
            "ignored" => "Event ignored by the provisioning pipeline.",
            WebhookEvent.StatusIgnoredScope => "Repository/org is outside all configured webhook rule scopes.",
            WebhookEvent.StatusIgnoredTarget => "No RunnerRunner target was requested, so this job is informational only.",
            _ => null
        };
    }

    private IEnumerable<EventStatusMeta> GetStatusMeta(WebhookEvent evt)
    {
        if (IsQueuedWait(evt))
        {
            var queuePosition = GetQueuePosition(evt);
            if (queuePosition.HasValue)
                yield return new("bi-list-ol", $"#{queuePosition.Value}", $"Queue position #{queuePosition.Value}");

            yield return new("bi-clock", evt.ReceivedAt.ToLocalTime().ToString("t"), $"Waiting since {evt.ReceivedAt.ToLocalTime():f}");
        }

        if (evt.RetryCount > 0)
            yield return new("bi-arrow-repeat", evt.RetryCount.ToString(), $"{evt.RetryCount} provisioning attempt(s)");

        if (evt.NextRetryAt.HasValue && evt.Status is "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match" or "provisioned")
            yield return new("bi-skip-forward", evt.NextRetryAt.Value.ToLocalTime().ToString("t"), $"Next check at {evt.NextRetryAt.Value.ToLocalTime():f}");

        if (evt.ExpiresAt.HasValue && evt.Status is not "completed" and not "timed_out")
            yield return new("bi-hourglass-split", evt.ExpiresAt.Value.ToLocalTime().ToString("t"), $"Expires at {evt.ExpiresAt.Value.ToLocalTime():f}");
    }

    private static string GetStatusToneClass(string status) => status switch
    {
        "provisioned" or "completed" => "event-status-good",
        "matching" or "preparing" or "dispatching" or "in_progress" => "event-status-info",
        "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match" or "rate_limited" => "event-status-warn",
        "error" or "rejected" or "timed_out" => "event-status-danger",
        "ignored" or WebhookEvent.StatusIgnoredScope or WebhookEvent.StatusIgnoredTarget => "event-status-muted",
        _ => ""
    };

    private static bool IsQueuedWait(WebhookEvent evt) =>
        evt.Action == "queued"
        && evt.Status is "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match";

    private string GetLimitBadge(CapacityBlockerKind kind) => kind switch
    {
        CapacityBlockerKind.Fifo => "bg-secondary",
        CapacityBlockerKind.ProvisioningRule => "bg-warning text-dark",
        CapacityBlockerKind.Host => "bg-danger",
        CapacityBlockerKind.Matching => "bg-dark",
        CapacityBlockerKind.Configuration => "bg-secondary",
        _ => "bg-light text-muted"
    };

    private static string GetLimitToneClass(CapacityBlockerKind kind) => kind switch
    {
        CapacityBlockerKind.Fifo => "event-blocker-neutral",
        CapacityBlockerKind.ProvisioningRule => "event-blocker-warn",
        CapacityBlockerKind.Host => "event-blocker-danger",
        CapacityBlockerKind.Matching => "event-blocker-dark",
        CapacityBlockerKind.Configuration => "event-blocker-neutral",
        _ => "event-blocker-neutral"
    };

    private static string GetLimitIcon(CapacityBlockerKind kind) => kind switch
    {
        CapacityBlockerKind.Fifo => "bi-signpost-split",
        CapacityBlockerKind.ProvisioningRule => "bi-diagram-3",
        CapacityBlockerKind.Host => "bi-hdd-network",
        CapacityBlockerKind.Matching => "bi-filter-circle",
        CapacityBlockerKind.Configuration => "bi-gear",
        _ => "bi-check-circle"
    };

    private string GetLimitLabel(CapacityBlockerKind kind) => kind switch
    {
        CapacityBlockerKind.Fifo => "FIFO",
        CapacityBlockerKind.ProvisioningRule => "Rule",
        CapacityBlockerKind.Host => "Host",
        CapacityBlockerKind.Matching => "Match",
        CapacityBlockerKind.Configuration => "Config",
        _ => "Ready"
    };

    private static string GetInsightTitle(EventCapacityView insight)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(insight.Summary))
            parts.Add(insight.Summary);
        parts.AddRange(insight.Details);
        return string.Join(" · ", parts);
    }

    private int? GetQueuePosition(WebhookEvent evt)
    {
        if (!IsQueuedWait(evt))
            return null;

        var orderedQueue = allEvents
            .Where(IsQueuedWait)
            .OrderBy(e => e.ReceivedAt)
            .ThenBy(e => e.Id)
            .Select((e, index) => new { e.Id, Position = index + 1 })
            .FirstOrDefault(e => e.Id == evt.Id);

        return orderedQueue?.Position;
    }

    public void Dispose()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
    }
