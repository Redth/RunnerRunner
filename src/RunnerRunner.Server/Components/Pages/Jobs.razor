@page "/jobs"
@attribute [Authorize(Policy = RunnerRunnerPolicies.CanView)]
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Core.Hub
@using RunnerRunner.Server.Grains.Events
@using RunnerRunner.Server.Services
@using RunnerRunner.Server.Services.HostWorkers
@inject IDocumentStore Store
@inject IGrainFactory GrainFactory
@inject IHostCommandDispatcher HostCommandDispatcher
@inject HostWorkerLogCache HostWorkerLogCache
@implements IDisposable

<PageTitle>Jobs - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-briefcase-fill"></i> Jobs</h1>
        <span class="page-desc">View current and past runner jobs with lifecycle history.</span>
    </div>
</SectionContent>

<div class="rr-filter-panel mb-3" aria-label="Job filters">
    <div class="rr-filter-header">
        <div class="rr-filter-panel-title">
            <i class="bi bi-funnel"></i>
            <span>Filters</span>
        </div>
        <div class="rr-filter-buttons">
            <button class="btn btn-sm rr-filter-btn rr-filter-btn-clear" @onclick="ClearFilters" disabled="@(!HasActiveFilters())">
                <i class="bi bi-eraser"></i> Clear
            </button>
            <button class="btn btn-sm rr-filter-btn rr-filter-btn-refresh" @onclick="Refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>
    <div class="rr-filter-grid">
    <div class="rr-filter-field rr-filter-field-wide">
        <label class="form-label">Search</label>
        <input type="text" class="form-control form-control-sm" placeholder="Filter jobs…" @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="rr-filter-field">
        <label class="form-label">Status</label>
        <select class="form-select form-select-sm" @bind="filterStatus">
            <option value="active">Active</option>
            <option value="">All</option>
            <option value="Queued">Queued</option>
            @foreach (var s in Enum.GetValues<RunnerInstanceStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="rr-filter-field">
        <label class="form-label">Mode</label>
        <select class="form-select form-select-sm" @bind="filterMode">
            <option value="">All</option>
            <option value="static">Static</option>
            <option value="dynamic">Dynamic</option>
        </select>
    </div>
    <div class="rr-filter-field">
        <label class="form-label">Profile</label>
        <select class="form-select form-select-sm" @bind="filterProfileId">
            <option value="">All</option>
            @foreach (var kv in profileNames.OrderBy(p => p.Value))
            {
                <option value="@kv.Key">@kv.Value</option>
            }
        </select>
    </div>
    <div class="rr-filter-field">
        <label class="form-label">Host</label>
        <select class="form-select form-select-sm" @bind="filterHostId">
            <option value="">All</option>
            @foreach (var kv in hostNames.OrderBy(h => h.Value))
            {
                <option value="@kv.Key">@kv.Value</option>
            }
        </select>
    </div>
    </div>
</div>

@{
    var filtered = GetFilteredJobs().ToList();
    var sorted = ApplySortJobs(filtered).ToList();
}

@if (!sorted.Any())
{
    <div class="text-center text-muted py-4">
        @(HasActiveFilters()
            ? "No jobs match the current filters."
            : "No jobs found. Jobs appear when webhook events are received or runners are provisioned.")
    </div>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped resizable-table">
        <thead>
            <tr>
                <th data-col-kind="control" data-col-min="34" data-col-preferred="38"></th>
                <th role="button" data-col-kind="description" data-col-min="220" data-col-preferred="320" data-col-priority="2" data-col-weight="1.7" @onclick='() => SetSort("Status")' style="cursor:pointer; user-select:none;">Status @SortIndicator("Status")</th>
                <th role="button" data-col-kind="name" data-col-min="180" data-col-preferred="260" data-col-weight="3.5" @onclick='() => SetSort("RunnerName")' style="cursor:pointer; user-select:none;">Runner / Job @SortIndicator("RunnerName")</th>
                <th role="button" data-col-kind="compact" data-col-min="76" data-col-preferred="96" data-col-priority="2" @onclick='() => SetSort("Mode")' style="cursor:pointer; user-select:none;">Mode @SortIndicator("Mode")</th>
                <th role="button" data-col-kind="related" data-col-min="120" data-col-preferred="160" data-col-priority="4" @onclick='() => SetSort("Rule")' style="cursor:pointer; user-select:none;">Provisioning Rule @SortIndicator("Rule")</th>
                <th role="button" data-col-kind="related" data-col-min="112" data-col-preferred="150" data-col-priority="4" @onclick='() => SetSort("Profile")' style="cursor:pointer; user-select:none;">Profile @SortIndicator("Profile")</th>
                <th role="button" data-col-kind="related" data-col-min="110" data-col-preferred="142" data-col-priority="4" @onclick='() => SetSort("Host")' style="cursor:pointer; user-select:none;">Host @SortIndicator("Host")</th>
                <th role="button" data-col-kind="time" data-col-min="108" data-col-preferred="130" data-col-priority="3" @onclick='() => SetSort("Created")' style="cursor:pointer; user-select:none;">Created @SortIndicator("Created")</th>
                <th role="button" data-col-kind="compact" data-col-min="82" data-col-preferred="104" data-col-priority="3" @onclick='() => SetSort("Duration")' style="cursor:pointer; user-select:none;">Duration @SortIndicator("Duration")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in sorted)
            {
                var isExpanded = expandedRows.Contains(job.Id);
                <tr class="job-row" role="button" @onclick="() => ToggleRow(job.Id)" style="cursor:pointer;">
                    <td><i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i></td>
                    <td>
                        @{
                            var insight = GetJobEventInsight(job);
                            var statusSummary = GetJobStatusSummary(job);
                            var metaItems = GetJobStatusMeta(job).ToList();
                            var insightDetails = insight?.Details.Take(3).ToList() ?? [];
                            var hiddenInsightDetails = (insight?.Details.Count ?? 0) - insightDetails.Count;
                        }
                        <div class="event-status-card @GetJobStatusToneClass(job)">
                            <div class="event-status-heading">
                                <span class="badge @job.StatusBadge">@GetJobStatusLabel(job)</span>
                                @if (insight is not null && insight.BlockedBy != CapacityBlockerKind.None)
                                {
                                    <span class="event-blocker-pill @GetLimitToneClass(insight.BlockedBy)" title="@GetInsightTitle(insight)">
                                        <i class="bi @GetLimitIcon(insight.BlockedBy)"></i>@GetLimitLabel(insight.BlockedBy)
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(statusSummary))
                            {
                                <span class="event-status-summary" title="@statusSummary">@statusSummary</span>
                            }
                            @if (metaItems.Any())
                            {
                                <div class="event-status-meta">
                                    @foreach (var item in metaItems)
                                    {
                                        <span title="@item.Title">
                                            <i class="bi @item.Icon"></i>@item.Text
                                        </span>
                                    }
                                </div>
                            }
                            @if (insightDetails.Any())
                            {
                                <div class="event-status-details">
                                    @foreach (var detail in insightDetails)
                                    {
                                        <span title="@detail">@detail</span>
                                    }
                                    @if (hiddenInsightDetails > 0)
                                    {
                                        <span>+@hiddenInsightDetails more blocker detail(s)</span>
                                    }
                                </div>
                            }
                        </div>
                    </td>
                    <td class="name-cell">
                        @if (!string.IsNullOrEmpty(job.RunnerName))
                        {
                            <span class="primary-label">@job.RunnerName</span>
                        }
                        else if (!string.IsNullOrEmpty(job.JobId))
                        {
                            <span class="primary-label">Job @job.JobId</span>
                        }
                        else
                        {
                            <span class="primary-label">Pending runner</span>
                        }
                        @if (!string.IsNullOrEmpty(job.JobId))
                        {
                            @if (!string.IsNullOrEmpty(job.RunnerName))
                            {
                                <small class="secondary-label">Job: @job.JobId</small>
                            }
                        }
                        @if (!string.IsNullOrEmpty(job.Repository))
                        {
                            <small class="secondary-label">@job.Repository</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(job.ExternalJobUrl))
                        {
                            <a class="external-nav-link small"
                               href="@job.ExternalJobUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               title="Open @job.ProviderLabel job"
                               @onclick="() => { }"
                               @onclick:stopPropagation="true">
                                <i class="bi bi-box-arrow-up-right"></i> Open in @job.ProviderLabel
                            </a>
                        }
                    </td>
                    <td><span class="badge @(job.Mode == "dynamic" ? "bg-warning text-dark" : "bg-secondary")">@(job.Mode == "dynamic" ? "Dynamic" : "Static")</span></td>
                    <td>@job.RuleName</td>
                    <td>@job.ProfileName</td>
                    <td>@job.HostName</td>
                    <td>@job.CreatedAt.ToString("g")</td>
                    <td>@job.FormattedDuration</td>
                </tr>
                @if (isExpanded)
                {
                    <tr class="job-detail-row">
                        <td colspan="9">
                            <div class="job-detail p-3">
                                <div class="row">
                                    @* Left column: history timeline *@
                                    <div class="col-md-6">
                                        <h6><i class="bi bi-clock-history me-1"></i> Status History</h6>

                                        @* Webhook event lifecycle entries *@
                                        @if (job.WebhookEvent != null)
                                        {
                                            <div class="timeline">
                                                <div class="timeline-entry d-flex align-items-start gap-2 mb-2">
                                                    <div class="timeline-dot">
                                                        <span class="badge rounded-pill bg-info" style="font-size:0.65rem;">received</span>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="small">
                                                            <strong>@job.WebhookEvent.ReceivedAt.ToString("HH:mm:ss.fff")</strong>
                                                            <span class="text-muted ms-1">(webhook)</span>
                                                        </div>
                                                        <div class="small text-muted">Webhook <code>@job.WebhookEvent.Action</code> received for @job.WebhookEvent.Repository</div>
                                                    </div>
                                                </div>
                                                @if (job.WebhookEvent.RetryCount > 0 || !string.IsNullOrEmpty(job.WebhookEvent.Error))
                                                {
                                                    <div class="timeline-entry d-flex align-items-start gap-2 mb-2">
                                                        <div class="timeline-dot">
                                                            <span class="badge rounded-pill @GetWebhookStatusBadge(job.WebhookEvent.Status)" style="font-size:0.65rem;">@job.WebhookEvent.Status</span>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <div class="small">
                                                                <strong>@job.WebhookEvent.UpdatedAt.ToString("HH:mm:ss.fff")</strong>
                                                                <span class="text-muted ms-1">(provisioning)</span>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(job.WebhookEvent.Error))
                                                            {
                                                                <div class="small text-danger">@job.WebhookEvent.Error</div>
                                                            }
                                                            @if (job.WebhookEvent.RetryCount > 0)
                                                            {
                                                                <div class="small text-muted">Retry #@job.WebhookEvent.RetryCount</div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @* Runner instance status history *@
                                        @if (job.Instance != null && job.Instance.StatusHistory.Any())
                                        {
                                            <div class="timeline">
                                                @foreach (var entry in job.Instance.StatusHistory)
                                                {
                                                    <div class="timeline-entry d-flex align-items-start gap-2 mb-2">
                                                        <div class="timeline-dot">
                                                            <span class="badge rounded-pill @GetInstanceStatusBadge(entry.Status)" style="font-size:0.65rem;">@entry.Status</span>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <div class="small">
                                                                <strong>@entry.Timestamp.ToString("HH:mm:ss.fff")</strong>
                                                                <span class="text-muted ms-1">(@entry.Source)</span>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(entry.StatusMessage))
                                                            {
                                                                <div class="small text-muted">@entry.StatusMessage</div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (job.Instance != null)
                                        {
                                            <p class="text-muted small">No status history recorded yet.</p>
                                        }
                                    </div>

                                    @* Right column: details *@
                                    <div class="col-md-6">
                                        @if (job.Instance != null)
                                        {
                                            <div class="mb-2">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowLogs(job)" @onclick:stopPropagation="true">
                                                    <i class="bi bi-terminal me-1"></i> View Logs
                                                </button>
                                                @if (!string.IsNullOrWhiteSpace(job.ExternalJobUrl))
                                                {
                                                    <a class="btn btn-sm btn-outline-secondary ms-1"
                                                       href="@job.ExternalJobUrl"
                                                       target="_blank"
                                                       rel="noopener noreferrer">
                                                        <i class="bi bi-box-arrow-up-right me-1"></i>Open @job.ProviderLabel job
                                                    </a>
                                                }
                                            </div>
                                        }
                                        <h6><i class="bi bi-info-circle me-1"></i> Details</h6>
                                        <table class="table table-sm small mb-0">
                                            <tbody>
                                                @if (job.Instance != null)
                                                {
                                                    <tr><td class="text-muted" style="width:40%;">Instance ID</td><td><code class="small">@job.Instance.Id</code></td></tr>
                                                    var instProfile = profilesById.GetValueOrDefault(job.Instance.ProfileId);
                                                    if (instProfile != null)
                                                    {
                                                        <tr><td class="text-muted">Backend</td><td><span class="badge bg-secondary text-uppercase">@instProfile.ExecutionBackend</span></td></tr>
                                                        var imageRef = BuildImageReference(instProfile, job.Instance.ImageTagOverride);
                                                        if (!string.IsNullOrEmpty(imageRef))
                                                        {
                                                            <tr>
                                                                <td class="text-muted">Image</td>
                                                                <td>
                                                                    <code class="small">@imageRef</code>
                                                                    @if (!string.IsNullOrEmpty(job.Instance.ImageTagOverride))
                                                                    {
                                                                        <span class="badge bg-info text-dark ms-1" title="Webhook-supplied image tag override">override</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                        if (!string.IsNullOrEmpty(instProfile.RunnerAgentVersion))
                                                        {
                                                            <tr><td class="text-muted">Agent Version</td><td><code class="small">@instProfile.RunnerAgentVersion</code></td></tr>
                                                        }
                                                    }
                                                    @if (!string.IsNullOrEmpty(job.Instance.StatusMessage))
                                                    {
                                                        <tr><td class="text-muted">Status Message</td><td>@job.Instance.StatusMessage</td></tr>
                                                    }
                                                    @if (!string.IsNullOrEmpty(job.Instance.ErrorMessage))
                                                    {
                                                        <tr><td class="text-muted">Error</td><td class="text-danger">@job.Instance.ErrorMessage</td></tr>
                                                    }
                                                    <tr><td class="text-muted">Created</td><td>@job.Instance.CreatedAt.ToString("O")</td></tr>
                                                    @if (job.Instance.DeployedAt.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Deployed</td><td>@job.Instance.DeployedAt.Value.ToString("O")</td></tr>
                                                    }
                                                    @if (job.Instance.StartedAt.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Started</td><td>@job.Instance.StartedAt.Value.ToString("O")</td></tr>
                                                    }
                                                    @if (job.Instance.StoppedAt.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Stopped</td><td>@job.Instance.StoppedAt.Value.ToString("O")</td></tr>
                                                    }
                                                    @if (job.Instance.LastHealthCheck.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Last Health Check</td><td>@job.Instance.LastHealthCheck.Value.ToString("O")</td></tr>
                                                    }
                                                    @if (!string.IsNullOrEmpty(job.Instance.ContainerId))
                                                    {
                                                        <tr><td class="text-muted">Container ID</td><td><code class="small">@job.Instance.ContainerId</code></td></tr>
                                                    }
                                                    @if (!string.IsNullOrEmpty(job.Instance.VmName))
                                                    {
                                                        <tr><td class="text-muted">VM Name</td><td>@job.Instance.VmName</td></tr>
                                                    }
                                                    @if (job.Instance.ProcessId.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Process ID</td><td>@job.Instance.ProcessId</td></tr>
                                                    }
                                                }

                                                @if (job.WebhookEvent != null)
                                                {
                                                    @if (job.Instance == null)
                                                    {
                                                        <tr><td class="text-muted" style="width:40%;">Event ID</td><td><code class="small">@job.WebhookEvent.Id</code></td></tr>
                                                    }

                                                    @if (!string.IsNullOrEmpty(job.WebhookEvent.Error))
                                                    {
                                                        <tr><td class="text-muted">Last Error</td><td class="text-danger">@job.WebhookEvent.Error</td></tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>

                                        @if (job.WebhookEvent != null)
                                        {
                                            <h6 class="mt-3"><i class="bi bi-webhook me-1"></i> Webhook Event</h6>
                                            <table class="table table-sm small mb-0">
                                                <tbody>
                                                    <tr><td class="text-muted" style="width:40%;">Repository</td><td>@job.WebhookEvent.Repository</td></tr>
                                                    <tr><td class="text-muted">Workflow</td><td>@job.WebhookEvent.WorkflowName</td></tr>
                                                    <tr><td class="text-muted">Action</td><td>@job.WebhookEvent.Action</td></tr>
                                                    <tr><td class="text-muted">Job ID</td><td><code class="small">@job.WebhookEvent.JobId</code></td></tr>
                                                    <tr><td class="text-muted">Run ID</td><td><code class="small">@job.WebhookEvent.RunId</code></td></tr>
                                                    <tr><td class="text-muted">Labels</td><td>@string.Join(", ", job.WebhookEvent.Labels)</td></tr>
                                                    <tr><td class="text-muted">Webhook Status</td><td><span class="badge @GetWebhookStatusBadge(job.WebhookEvent.Status)">@job.WebhookEvent.Status</span></td></tr>
                                                    <tr><td class="text-muted">Received</td><td>@job.WebhookEvent.ReceivedAt.ToString("O")</td></tr>
                                                    @if (job.WebhookEvent.LastAttemptAt.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Last Attempt</td><td>@job.WebhookEvent.LastAttemptAt.Value.ToString("O")</td></tr>
                                                    }
                                                    @if (job.WebhookEvent.NextRetryAt.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Next Retry</td><td>@job.WebhookEvent.NextRetryAt.Value.ToString("O")</td></tr>
                                                    }
                                                    @if (job.WebhookEvent.ExpiresAt.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Expires</td><td>@job.WebhookEvent.ExpiresAt.Value.ToString("O")</td></tr>
                                                    }
                                                    @if (job.WebhookEvent.ResolvedAt.HasValue)
                                                    {
                                                        <tr><td class="text-muted">Resolved</td><td>@job.WebhookEvent.ResolvedAt.Value.ToString("O")</td></tr>
                                                    }
                                                    <tr><td class="text-muted">Retry Count</td><td>@job.WebhookEvent.RetryCount</td></tr>
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
}

@* Log viewer modal *@
@if (showLogModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" @onclick="CloseLogModal" @onclick:stopPropagation="false">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">
                        <i class="bi bi-terminal me-1"></i> Logs — @logModalTitle
                    </h6>
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <select class="form-select form-select-sm" style="width: auto;" @bind="logTailLines">
                            <option value="50">50 lines</option>
                            <option value="100">100 lines</option>
                            <option value="200">200 lines</option>
                            <option value="500">500 lines</option>
                            <option value="1000">1000 lines</option>
                        </select>
                        <button class="btn btn-sm btn-outline-primary" @onclick="RefreshLogs" disabled="@isLoadingLogs">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="btn-close" @onclick="CloseLogModal"></button>
                    </div>
                </div>
                <div class="modal-body p-0">
                    @if (isLoadingLogs)
                    {
                        <div class="text-center py-4">
                            <span class="spinner-border spinner-border-sm text-primary me-2"></span>
                            Fetching logs from agent…
                        </div>
                    }
                    <pre class="log-viewer-pre mb-0">@logContent</pre>
                </div>
            </div>
        </div>
    </div>
}

<style>
    tr.job-row:hover td {
        background: var(--bg-tertiary, #f0f2f5);
    }
    tr.job-detail-row td {
        background: var(--bg-secondary, #f8f9fc);
        border-top: none;
        padding: 0 !important;
    }
    .job-detail {
        border-left: 3px solid var(--bs-primary, #0d6efd);
    }
    .timeline-entry {
        border-left: 2px solid var(--border-color, #e5e7eb);
        padding-left: 0.75rem;
        margin-left: 0.25rem;
    }
    .timeline-entry:last-child {
        border-left-color: transparent;
    }
    .log-viewer-pre {
        background: #1a1b26;
        color: #c0caf5;
        font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
        font-size: 0.8rem;
        line-height: 1.4;
        padding: 1rem;
        white-space: pre-wrap;
        word-break: break-all;
        max-height: 70vh;
        overflow-y: auto;
        min-height: 200px;
    }
    .external-nav-link {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--bs-primary);
        text-decoration: none;
    }
    .external-nav-link:hover {
        text-decoration: underline;
    }
</style>

@code {
    private List<JobView> jobs = [];
    private List<Host> allHosts = [];
    private Dictionary<string, string> hostNames = new();
    private Dictionary<string, string> profileNames = new();
    private Dictionary<string, RunnerProfile> profilesById = new();
    private Dictionary<string, string> ruleNames = new();
    private Dictionary<string, ProvisioningRule> rulesById = new();
    private Dictionary<string, ProviderCredential> credentialsById = new();
    private List<WebhookEvent> allWebhookEvents = [];
    private CapacitySnapshot capacitySnapshot = CapacitySnapshot.Empty;

    private string searchText = "";
    private string filterStatus = "active";
    private string filterMode = "";
    private string filterProfileId = "";
    private string filterHostId = "";

    private string sortColumn = "Created";
    private bool sortAscending = false;

    private HashSet<string> expandedRows = new();

    // Log viewer modal state
    private bool showLogModal;
    private string logModalTitle = "";
    private string logContent = "";
    private bool isLoadingLogs;
    private int logTailLines = 200;
    private JobView? logModalJob;
    private TaskCompletionSource<string>? _runnerLogsTcs;
    private sealed record JobStatusMeta(string Icon, string Text, string Title);

    // Auto-refresh timer for queued webhook events
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshCts;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        StreamSubscriptionService.OnRunnerStatusChanged += OnStreamRunnerStatusChanged;
        StreamSubscriptionService.OnRunnerLogsReceived += OnRunnerLogsReceived;

        // Refresh every 10s for queued events progress
        _refreshCts = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = AutoRefreshLoop(_refreshCts.Token);
    }

    private async Task AutoRefreshLoop(CancellationToken ct)
    {
        try
        {
            while (await _refreshTimer!.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) { }
    }

    private void OnStreamRunnerStatusChanged(RunnerStatusChangedEvent evt)
    {
        InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
    }

    public void Dispose()
    {
        StreamSubscriptionService.OnRunnerStatusChanged -= OnStreamRunnerStatusChanged;
        StreamSubscriptionService.OnRunnerLogsReceived -= OnRunnerLogsReceived;
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        _refreshTimer?.Dispose();
    }

    private async Task Refresh()
    {
        var allInstances = (await Store.Query<RunnerInstance>().ToList()).ToList();
        var managedInstances = allInstances
            .Where(i => i.ManagedByRunnerRunner == true)
            .ToList();

        allHosts = (await Store.Query<Host>().ToList()).ToList();
        var profiles = (await Store.Query<RunnerProfile>().ToList()).ToList();
        var rules = (await Store.Query<ProvisioningRule>().ToList()).ToList();
        var credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();
        allWebhookEvents = (await Store.Query<WebhookEvent>().ToList()).ToList();

        hostNames = allHosts.ToDictionary(h => h.Id, h => h.Label);
        profileNames = profiles.ToDictionary(p => p.Id, p => p.Name);
        profilesById = profiles.ToDictionary(p => p.Id, p => p);
        ruleNames = rules.ToDictionary(r => r.Id, r => r.Name);
        rulesById = rules.ToDictionary(r => r.Id, r => r);
        credentialsById = credentials.ToDictionary(c => c.Id, c => c);
        capacitySnapshot = CapacityPlanningService.BuildSnapshot(allHosts, profiles, rules, managedInstances, allWebhookEvents);

        // Index webhook events by ID
        var webhookEventsById = allWebhookEvents.ToDictionary(e => e.Id);

        // Track which webhook events are already represented by a runner instance
        var linkedEventIds = managedInstances
            .Where(i => !string.IsNullOrEmpty(i.WebhookEventId))
            .Select(i => i.WebhookEventId!)
            .ToHashSet();

        // Build unified job views
        var jobViews = new List<JobView>();

        // 1) Runner instances → jobs (with linked webhook event if any)
        foreach (var inst in managedInstances)
        {
            WebhookEvent? whEvent = null;
            if (!string.IsNullOrEmpty(inst.WebhookEventId))
                webhookEventsById.TryGetValue(inst.WebhookEventId, out whEvent);

            jobViews.Add(BuildJobFromInstance(inst, whEvent));
        }

        // 2) Webhook events without a runner instance → queued/pending jobs
        var unlinkedEvents = allWebhookEvents
            .Where(e => e.Action == "queued" && !linkedEventIds.Contains(e.Id))
            .ToList();

        foreach (var evt in unlinkedEvents)
        {
            jobViews.Add(BuildJobFromWebhookEvent(evt));
        }

        jobs = jobViews;
    }

    private JobView BuildJobFromInstance(RunnerInstance inst, WebhookEvent? whEvent)
    {
        var ruleName = "—";
        if (!string.IsNullOrEmpty(inst.ProvisioningRuleId) && ruleNames.TryGetValue(inst.ProvisioningRuleId, out var rn))
            ruleName = rn;
        else if (whEvent != null && !string.IsNullOrEmpty(whEvent.BindingId) && ruleNames.TryGetValue(whEvent.BindingId, out var bn))
            ruleName = bn;

        profilesById.TryGetValue(inst.ProfileId, out var profile);
        var duration = GetDuration(inst.CreatedAt, inst.StoppedAt);
        return new JobView
        {
            Id = inst.Id,
            Instance = inst,
            WebhookEvent = whEvent,
            StatusLabel = inst.Status.ToString(),
            StatusBadge = GetInstanceStatusBadge(inst.Status),
            Error = inst.ErrorMessage,
            RunnerName = inst.RunnerName,
            JobId = inst.JobId ?? whEvent?.JobId,
            Repository = whEvent?.Repository,
            Mode = inst.ProvisioningMode,
            RuleName = ruleName,
            ProfileName = profileNames.GetValueOrDefault(inst.ProfileId, inst.ProfileId),
            ProfileId = inst.ProfileId,
            HostName = hostNames.GetValueOrDefault(inst.HostId, inst.HostId),
            HostId = inst.HostId,
            CreatedAt = inst.CreatedAt,
            Duration = duration,
            FormattedDuration = FormatDuration(duration),
            IsQueued = false,
            SortPriority = GetStatusSortPriority(inst.Status.ToString()),
            ExternalJobUrl = BuildExternalJobUrl(whEvent, profile),
            ProviderLabel = GetProviderLabel(whEvent, profile)
        };
    }

    private JobView BuildJobFromWebhookEvent(WebhookEvent evt)
    {
        var ruleName = "—";
        if (!string.IsNullOrEmpty(evt.BindingId) && ruleNames.TryGetValue(evt.BindingId, out var rn))
            ruleName = rn;

        var profileName = "—";
        var profileId = evt.MatchedProfileId ?? "";
        if (!string.IsNullOrEmpty(evt.MatchedProfileName))
            profileName = evt.MatchedProfileName;
        else if (!string.IsNullOrEmpty(profileId) && profileNames.TryGetValue(profileId, out var pn))
            profileName = pn;

        profilesById.TryGetValue(profileId, out var profile);
        var duration = GetDuration(evt.ReceivedAt, evt.ResolvedAt);
        var statusLabel = evt.IsTerminal ? evt.Status : $"Queued ({evt.Status})";

        return new JobView
        {
            Id = $"wh-{evt.Id}",
            Instance = null,
            WebhookEvent = evt,
            StatusLabel = statusLabel,
            StatusBadge = GetWebhookStatusBadge(evt.Status),
            Error = evt.Error,
            RunnerName = null,
            JobId = evt.JobId,
            Repository = evt.Repository,
            Mode = "dynamic",
            RuleName = ruleName,
            ProfileName = profileName,
            ProfileId = profileId,
            HostName = "—",
            HostId = "",
            CreatedAt = evt.ReceivedAt,
            Duration = duration,
            FormattedDuration = FormatDuration(duration),
            IsQueued = !evt.IsTerminal,
            SortPriority = GetStatusSortPriority(evt.Status),
            ExternalJobUrl = BuildExternalJobUrl(evt, profile),
            ProviderLabel = GetProviderLabel(evt, profile)
        };
    }

    private string? BuildExternalJobUrl(WebhookEvent? evt, RunnerProfile? profile)
    {
        if (evt == null)
            return null;

        return ProviderNavigationLinks.BuildJobUrl(evt, ResolveCredential(evt, profile));
    }

    private string GetProviderLabel(WebhookEvent? evt, RunnerProfile? profile)
        => ProviderNavigationLinks.GetProviderLabel(evt?.Provider ?? profile?.Provider.ToString());

    private ProviderCredential? ResolveCredential(WebhookEvent evt, RunnerProfile? profile)
    {
        if (!string.IsNullOrWhiteSpace(evt.BindingId)
            && rulesById.TryGetValue(evt.BindingId, out var rule)
            && !string.IsNullOrWhiteSpace(rule.ProviderCredentialId)
            && credentialsById.TryGetValue(rule.ProviderCredentialId, out var ruleCredential))
        {
            return ruleCredential;
        }

        if (!string.IsNullOrWhiteSpace(profile?.ProviderCredentialId)
            && credentialsById.TryGetValue(profile.ProviderCredentialId, out var profileCredential))
        {
            return profileCredential;
        }

        var provider = ProviderNavigationLinks.ParseProvider(evt.Provider);
        return provider.HasValue
            ? credentialsById.Values.FirstOrDefault(c => c.Provider == provider.Value)
            : null;
    }

    private bool HasActiveFilters() =>
        !string.IsNullOrWhiteSpace(searchText) ||
        (!string.IsNullOrWhiteSpace(filterStatus) && !string.Equals(filterStatus, "active", StringComparison.OrdinalIgnoreCase)) ||
        !string.IsNullOrWhiteSpace(filterMode) ||
        !string.IsNullOrWhiteSpace(filterProfileId) ||
        !string.IsNullOrWhiteSpace(filterHostId);

    private void ClearFilters()
    {
        searchText = "";
        filterStatus = "active";
        filterMode = "";
        filterProfileId = "";
        filterHostId = "";
    }

    private IEnumerable<JobView> GetFilteredJobs()
    {
        var q = jobs.AsEnumerable();

        if (string.Equals(filterStatus, "active", StringComparison.OrdinalIgnoreCase))
        {
            q = q.Where(j =>
                j.IsQueued
                || (j.Instance != null && j.Instance.Status is RunnerInstanceStatus.Pending
                    or RunnerInstanceStatus.Starting
                    or RunnerInstanceStatus.Running
                    or RunnerInstanceStatus.Stopping));
        }
        else if (string.Equals(filterStatus, "Queued", StringComparison.OrdinalIgnoreCase))
        {
            q = q.Where(j => j.IsQueued);
        }
        else if (!string.IsNullOrWhiteSpace(filterStatus) && Enum.TryParse<RunnerInstanceStatus>(filterStatus, out var status))
        {
            q = q.Where(j => j.Instance != null && j.Instance.Status == status);
        }

        if (!string.IsNullOrWhiteSpace(filterMode))
            q = q.Where(j => j.Mode == filterMode);

        if (!string.IsNullOrWhiteSpace(filterProfileId))
            q = q.Where(j => j.ProfileId == filterProfileId);

        if (!string.IsNullOrWhiteSpace(filterHostId))
            q = q.Where(j => j.HostId == filterHostId);

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim();
            q = q.Where(j =>
                (j.RunnerName ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                || (j.JobId ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                || (j.Repository ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                || j.HostName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || j.ProfileName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || j.RuleName.Contains(term, StringComparison.OrdinalIgnoreCase)
                || j.StatusLabel.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return q;
    }

    private IEnumerable<JobView> ApplySortJobs(IEnumerable<JobView> items)
    {
        return sortColumn switch
        {
            "Status" => sortAscending
                ? items.OrderBy(j => j.SortPriority).ThenBy(j => j.StatusLabel)
                : items.OrderByDescending(j => j.SortPriority).ThenByDescending(j => j.StatusLabel),
            "RunnerName" => sortAscending
                ? items.OrderBy(j => j.RunnerName ?? j.JobId ?? "")
                : items.OrderByDescending(j => j.RunnerName ?? j.JobId ?? ""),
            "Mode" => sortAscending ? items.OrderBy(j => j.Mode) : items.OrderByDescending(j => j.Mode),
            "Rule" => sortAscending ? items.OrderBy(j => j.RuleName) : items.OrderByDescending(j => j.RuleName),
            "Profile" => sortAscending ? items.OrderBy(j => j.ProfileName) : items.OrderByDescending(j => j.ProfileName),
            "Host" => sortAscending ? items.OrderBy(j => j.HostName) : items.OrderByDescending(j => j.HostName),
            "Created" => sortAscending ? items.OrderBy(j => j.CreatedAt) : items.OrderByDescending(j => j.CreatedAt),
            "Duration" => sortAscending ? items.OrderBy(j => j.Duration) : items.OrderByDescending(j => j.Duration),
            _ => items.OrderByDescending(j => j.CreatedAt)
        };
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private MarkupString SortIndicator(string column)
    {
        if (sortColumn != column) return (MarkupString)"";
        return (MarkupString)(sortAscending ? "▲" : "▼");
    }

    private void ToggleRow(string id)
    {
        if (!expandedRows.Remove(id))
            expandedRows.Add(id);
    }

    private static TimeSpan GetDuration(DateTime start, DateTime? end)
    {
        return (end ?? DateTime.UtcNow) - start;
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
            return $"{(int)duration.TotalDays}d {duration.Hours}h {duration.Minutes}m";
        if (duration.TotalHours >= 1)
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        if (duration.TotalMinutes >= 1)
            return $"{(int)duration.TotalMinutes}m {duration.Seconds}s";
        return $"{(int)duration.TotalSeconds}s";
    }

    private static int GetStatusSortPriority(string status) => status switch
    {
        // Active/queued first
        "Pending" or "pending" => 0,
        _ when status.StartsWith("pending") => 0,
        "Queued" => 0,
        "matching" or "preparing" or "dispatching" => 1,
        "Starting" => 2,
        "Running" or "provisioned" or "in_progress" => 3,
        "Stopping" => 4,
        "Failed" or "Crashed" or "timed_out" or "rejected" => 5,
        "Stopped" or "completed" or "ignored" or WebhookEvent.StatusIgnoredScope or WebhookEvent.StatusIgnoredTarget => 6,
        _ => 7
    };

    private static string? BuildImageReference(RunnerProfile profile, string? tagOverride)
    {
        switch (profile.ExecutionBackend)
        {
            case ExecutionBackend.Docker when profile.DockerConfig is { } d:
                return FormatImageRef(d.RegistryUrl, d.ImageName, tagOverride ?? d.Tag);
            case ExecutionBackend.Tart when profile.TartConfig is { } t:
                return FormatImageRef(t.RegistryUrl, t.ImageName, tagOverride ?? t.Tag);
            default:
                return null;
        }
    }

    private static string FormatImageRef(string? registry, string? image, string? tag)
    {
        var registryPart = string.IsNullOrWhiteSpace(registry) ? "" : registry.TrimEnd('/') + "/";
        var imagePart = (image ?? "").TrimStart('/');
        var tagPart = string.IsNullOrWhiteSpace(tag) ? "" : ":" + tag;
        return $"{registryPart}{imagePart}{tagPart}";
    }

