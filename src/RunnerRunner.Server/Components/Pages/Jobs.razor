    private static bool IsQueuedWait(WebhookEvent evt) =>
        evt.Action == "queued"
        && evt.Status is "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match";

    private string GetJobStatusLabel(JobView job)
    {
        if (job.Instance is not null)
            return job.Instance.Status.ToString();

        return job.WebhookEvent is null
            ? job.StatusLabel
            : GetWebhookStatusLabel(job.WebhookEvent.Status);
    }

    private EventCapacityView? GetJobEventInsight(JobView job) =>
        job.WebhookEvent is { } evt
        && IsQueuedWait(evt)
        && capacitySnapshot.Events.TryGetValue(evt.Id, out var insight)
            ? insight
            : null;

    private string? GetJobStatusSummary(JobView job)
    {
        if (!string.IsNullOrWhiteSpace(job.Error))
            return job.Error;

        if (job.Instance is { } instance)
        {
            if (!string.IsNullOrWhiteSpace(instance.ErrorMessage))
                return instance.ErrorMessage;
            if (!string.IsNullOrWhiteSpace(instance.StatusMessage))
                return instance.StatusMessage;

            return instance.Status switch
            {
                RunnerInstanceStatus.Pending => "Runner is waiting for provisioning.",
                RunnerInstanceStatus.Starting => $"Runner is starting on {job.HostName}.",
                RunnerInstanceStatus.Running => $"Runner is active on {job.HostName}.",
                RunnerInstanceStatus.Stopping => "Runner is shutting down.",
                RunnerInstanceStatus.Stopped => "Runner stopped.",
                RunnerInstanceStatus.Failed => "Runner failed.",
                RunnerInstanceStatus.Crashed => "Runner crashed.",
                _ => null
            };
        }

        if (job.WebhookEvent is not { } evt)
            return null;

        var insight = GetJobEventInsight(job);
        if (!string.IsNullOrWhiteSpace(insight?.Summary))
            return insight.Summary;

        return evt.Status switch
        {
            "provisioned" when !string.IsNullOrWhiteSpace(evt.InstanceId) => $"Runner {evt.InstanceId[..Math.Min(8, evt.InstanceId.Length)]} created.",
            "in_progress" => "Workflow job is running on a matched runner.",
            "completed" => "Workflow job completed.",
            "ignored" => "Event ignored by the provisioning pipeline.",
            WebhookEvent.StatusIgnoredScope => "Repository/org is outside all configured webhook rule scopes.",
            WebhookEvent.StatusIgnoredTarget => "No RunnerRunner target was requested, so this job is informational only.",
            _ => null
        };
    }

    private IEnumerable<JobStatusMeta> GetJobStatusMeta(JobView job)
    {
        if (job.WebhookEvent is { } evt)
        {
            if (IsQueuedWait(evt))
            {
                var queuePosition = GetQueuePosition(evt);
                if (queuePosition.HasValue)
                    yield return new("bi-list-ol", $"#{queuePosition.Value}", $"Queue position #{queuePosition.Value}");

                yield return new("bi-clock", evt.ReceivedAt.ToLocalTime().ToString("t"), $"Waiting since {evt.ReceivedAt.ToLocalTime():f}");
            }

            if (evt.RetryCount > 0)
                yield return new("bi-arrow-repeat", evt.RetryCount.ToString(), $"{evt.RetryCount} provisioning attempt(s)");

            if (evt.NextRetryAt.HasValue && evt.Status is "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match" or "provisioned")
                yield return new("bi-skip-forward", evt.NextRetryAt.Value.ToLocalTime().ToString("t"), $"Next check at {evt.NextRetryAt.Value.ToLocalTime():f}");

            yield break;
        }

        if (job.Instance is not { } instance)
            yield break;

        if (instance.StartedAt.HasValue)
            yield return new("bi-play-circle", instance.StartedAt.Value.ToLocalTime().ToString("t"), $"Started at {instance.StartedAt.Value.ToLocalTime():f}");
        else if (instance.DeployedAt.HasValue)
            yield return new("bi-box-arrow-in-down", instance.DeployedAt.Value.ToLocalTime().ToString("t"), $"Deployed at {instance.DeployedAt.Value.ToLocalTime():f}");
        else
            yield return new("bi-clock", instance.CreatedAt.ToLocalTime().ToString("t"), $"Created at {instance.CreatedAt.ToLocalTime():f}");

        if (instance.Status is RunnerInstanceStatus.Running or RunnerInstanceStatus.Starting or RunnerInstanceStatus.Stopping)
            yield return new("bi-stopwatch", job.FormattedDuration, $"Running for {job.FormattedDuration}");
    }

    private static string GetJobStatusToneClass(JobView job)
    {
        if (job.Instance is { } instance)
        {
            return instance.Status switch
            {
                RunnerInstanceStatus.Running or RunnerInstanceStatus.Stopped => "event-status-good",
                RunnerInstanceStatus.Starting or RunnerInstanceStatus.Pending or RunnerInstanceStatus.Stopping => "event-status-info",
                RunnerInstanceStatus.Failed or RunnerInstanceStatus.Crashed => "event-status-danger",
                _ => ""
            };
        }

        return job.WebhookEvent?.Status switch
        {
            "provisioned" or "completed" => "event-status-good",
            "matching" or "preparing" or "dispatching" or "in_progress" => "event-status-info",
            "pending" or "pending_fifo" or "pending_capacity" or "pending_host_match" or "pending_config" or "no_match" or "rate_limited" => "event-status-warn",
            "error" or "rejected" or "timed_out" => "event-status-danger",
            "ignored" => "event-status-muted",
            _ => ""
        };
    }

    private int? GetQueuePosition(WebhookEvent evt)
    {
        if (!IsQueuedWait(evt))
            return null;

        var orderedQueue = allWebhookEvents
            .Where(IsQueuedWait)
            .OrderBy(e => e.ReceivedAt)
            .ThenBy(e => e.Id)
            .Select((e, index) => new { e.Id, Position = index + 1 })
            .FirstOrDefault(e => e.Id == evt.Id);

        return orderedQueue?.Position;
    }

