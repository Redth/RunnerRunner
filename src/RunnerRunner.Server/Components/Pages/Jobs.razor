    // --- Log viewer ---

    private async Task ShowLogs(JobView job)
    {
        logModalJob = job;
        logModalTitle = job.RunnerName ?? job.JobId ?? job.Id;
        showLogModal = true;
        logContent = "";
        StateHasChanged();
        await FetchRunnerLogs(job);
    }

    private async Task RefreshLogs()
    {
        if (logModalJob != null)
            await FetchRunnerLogs(logModalJob);
    }

    private void CloseLogModal()
    {
        showLogModal = false;
        logModalJob = null;
        logContent = "";
    }

    private async Task FetchRunnerLogs(JobView job)
    {
        if (job.Instance == null) return;

        isLoadingLogs = true;
        StateHasChanged();

        try
        {
            var host = allHosts.FirstOrDefault(h => h.Id == job.Instance.HostId);
            if (host == null)
            {
                logContent = "Host not found for this runner instance.";
                return;
            }

            if (host.AgentStatus != AgentStatus.Online)
            {
                var cached = GetCachedRunnerLogs(host.Id, job.Instance);
                if (!string.IsNullOrWhiteSpace(cached))
                {
                    logContent = cached;
                    return;
                }

                logContent = BuildLiveTailUnavailableMessage(host, job.Instance, "this HostWorker is offline");
                return;
            }

            var handle = GetRunnerInstanceHandle(job.Instance);
            _runnerLogsTcs = new TaskCompletionSource<string>();
            var command = new GetRunnerLogsCommand
            {
                InstanceHandle = handle,
                RunnerInstanceId = job.Instance.Id,
                TailLines = logTailLines
            };

            try
            {
                await HostCommandDispatcher.DispatchGetRunnerLogsAsync(host.Id, command);
            }
            catch (InvalidOperationException ex)
            {
                var cached = GetCachedRunnerLogs(host.Id, job.Instance);
                logContent = !string.IsNullOrWhiteSpace(cached)
                    ? cached
                    : BuildLiveTailUnavailableMessage(host, job.Instance, ex.Message);
                return;
            }

            var completedTask = await Task.WhenAny(_runnerLogsTcs.Task, Task.Delay(TimeSpan.FromSeconds(10)));
            if (completedTask == _runnerLogsTcs.Task)
            {
                logContent = await _runnerLogsTcs.Task;
            }
            else
            {
                var cached = GetCachedRunnerLogs(host.Id, job.Instance);
                logContent = !string.IsNullOrWhiteSpace(cached)
                    ? cached
                    : "Timeout waiting for logs from HostWorker.";
            }
        }
        catch (Exception ex)
        {
            logContent = $"Error fetching logs: {ex.Message}";
        }
        finally
        {
            isLoadingLogs = false;
            StateHasChanged();
        }
    }

    private void OnRunnerLogsReceived(RunnerLogsEvent evt)
    {
        _runnerLogsTcs?.TrySetResult(evt.Logs ?? "(empty)");
        InvokeAsync(StateHasChanged);
    }

    private string GetCachedRunnerLogs(string hostId, RunnerInstance instance)
    {
        var streamId = $"runner.{GetRunnerInstanceHandle(instance)}";
        return HostWorkerLogCache.GetTextTail(hostId, streamId, logTailLines);
    }

    private static string BuildLiveTailUnavailableMessage(Host host, RunnerInstance instance, string reason)
    {
        var lines = new List<string>
        {
            $"=== Runner: {instance.RunnerName} ===",
            $"Host: {host.Label}",
            $"Status: {instance.Status}",
            ""
        };

        if (!string.IsNullOrWhiteSpace(instance.StatusMessage))
            lines.Add($"Status message: {instance.StatusMessage}");
        if (!string.IsNullOrWhiteSpace(instance.ErrorMessage))
            lines.Add($"Error: {instance.ErrorMessage}");

        lines.Add("");
        lines.Add($"Live log streaming is unavailable because {TrimTerminalPunctuation(reason)}.");

        if (host.Platform == HostPlatform.Linux)
        {
            lines.Add("");
            lines.Add("Manual log access:");
            var cid = instance.ContainerId ?? instance.RunnerName;
            lines.Add($"  ssh root@{host.Name} 'docker logs {cid} 2>&1 | tail -200'");
        }

        return string.Join("\n", lines);
    }

    private static string GetRunnerInstanceHandle(RunnerInstance instance) =>
        instance.ContainerId
        ?? instance.VmName
        ?? instance.ProcessId?.ToString()
        ?? instance.RunnerName;

    private static string TrimTerminalPunctuation(string value) =>
        value.Trim().TrimEnd('.', '!', '?');

}
