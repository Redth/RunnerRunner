@page "/webhooks"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@inject IDocumentStore Store
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Webhook Bindings - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-broadcast-pin"></i> Webhook Bindings</h1>
        <span class="page-desc">Configure webhook-triggered dynamic runner provisioning.</span>
    </div>
</SectionContent>

<div class="alert alert-info py-2 d-flex align-items-center gap-2 mb-3" style="font-size: 0.85rem;">
    <i class="bi bi-link-45deg"></i>
    <span><strong>Webhook URL:</strong> <code>@(Navigation.BaseUri.TrimEnd('/'))/api/webhooks/github</code></span>
</div>

<button class="btn btn-primary mb-3" @onclick="ShowCreateForm"><i class="bi bi-plus-lg me-1"></i> New Binding</button>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(isEditing ? "Edit" : "Create") Webhook Binding</h5>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="editBinding.Name" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Provider</label>
                    <select class="form-select" @bind="editBinding.Provider" @bind:after="OnProviderChanged">
                        @foreach (var p in Enum.GetValues<RunnerProvider>())
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Provider Credential</label>
                    <select class="form-select" @bind="editBinding.ProviderCredentialId">
                        <option value="">— Select credential —</option>
                        @foreach (var cred in credentials.Where(c => c.Provider == editBinding.Provider))
                        {
                            <option value="@cred.Id">@cred.Name</option>
                        }
                    </select>
                </div>
            </div>

            @* Allowed Orgs *@
            <div class="mb-3">
                <label class="form-label">Allowed Orgs</label>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var org in editAllowedOrgs)
                    {
                        <span class="badge bg-primary d-flex align-items-center gap-1" style="font-size: 0.85rem; padding: 0.4em 0.6em;">
                            @org
                            <i class="bi bi-x-lg" style="cursor:pointer; font-size:0.7rem;" @onclick="() => editAllowedOrgs.Remove(org)"></i>
                        </span>
                    }
                </div>
                <div class="input-group input-group-sm" style="max-width: 300px;">
                    <input class="form-control" placeholder="Add org..." @bind="newOrgInput" @onkeydown="OnOrgKeyDown" />
                    <button class="btn btn-outline-primary" type="button" @onclick="AddOrg"><i class="bi bi-plus-lg"></i></button>
                </div>
            </div>

            @* Allowed Repos *@
            <div class="mb-3">
                <label class="form-label">Allowed Repos</label>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var repo in editAllowedRepos)
                    {
                        <span class="badge bg-info d-flex align-items-center gap-1" style="font-size: 0.85rem; padding: 0.4em 0.6em;">
                            @repo
                            <i class="bi bi-x-lg" style="cursor:pointer; font-size:0.7rem;" @onclick="() => editAllowedRepos.Remove(repo)"></i>
                        </span>
                    }
                </div>
                <div class="input-group input-group-sm" style="max-width: 400px;">
                    <input class="form-control" placeholder="Add repo (org/repo)..." @bind="newRepoInput" @onkeydown="OnRepoKeyDown" />
                    <button class="btn btn-outline-primary" type="button" @onclick="AddRepo"><i class="bi bi-plus-lg"></i></button>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Webhook Secret</label>
                    <div class="input-group">
                        <input class="form-control" @bind="editBinding.WebhookSecret" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="GenerateSecret">Generate</button>
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Max Concurrent Jobs</label>
                    <input type="number" class="form-control" @bind="editBinding.MaxConcurrentJobs" min="1" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Cooldown Seconds</label>
                    <input type="number" class="form-control" @bind="editBinding.CooldownSeconds" min="0" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Default Profile</label>
                    <select class="form-select" @bind="editBinding.DefaultProfileId">
                        <option value="">— None —</option>
                        @foreach (var profile in profiles)
                        {
                            <option value="@profile.Id">@profile.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="editBinding.Enabled" id="enabledCheck" />
                        <label class="form-check-label" for="enabledCheck">Enabled</label>
                    </div>
                </div>
            </div>

            @* Label→Profile Mappings *@
            <h6 class="mt-3">Label → Profile Mappings</h6>
            <p class="text-muted small">Priority-ordered label-to-profile mappings. First match wins.</p>
            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th>Required Labels</th>
                        <th>Profile</th>
                        <th style="width:100px;">Priority</th>
                        <th style="width:80px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < editMappings.Count; i++)
                    {
                        var idx = i;
                        <tr>
                            <td>
                                <div class="d-flex flex-wrap gap-1 mb-1">
                                    @foreach (var label in editMappings[idx].RequiredLabels)
                                    {
                                        var lbl = label;
                                        <span class="badge bg-primary d-flex align-items-center gap-1" style="font-size: 0.8rem; padding: 0.3em 0.5em;">
                                            @lbl
                                            <i class="bi bi-x-lg" style="cursor:pointer; font-size:0.65rem;" @onclick="() => editMappings[idx].RequiredLabels.Remove(lbl)"></i>
                                        </span>
                                    }
                                </div>
                                <div class="input-group input-group-sm" style="max-width: 250px;">
                                    <input class="form-control" placeholder="Add label..." @bind="mappingLabelInputs[idx]"
                                           @onkeydown="(e) => OnMappingLabelKeyDown(e, idx)" />
                                    <button class="btn btn-outline-primary" type="button" @onclick="() => AddMappingLabel(idx)"><i class="bi bi-plus-lg"></i></button>
                                </div>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" @bind="editMappings[idx].ProfileId">
                                    <option value="">— Select —</option>
                                    @foreach (var profile in profiles)
                                    {
                                        <option value="@profile.Id">@profile.Name</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" @bind="editMappings[idx].Priority" />
                            </td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="() => RemoveMapping(idx)"><i class="bi bi-trash3"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <button class="btn btn-sm btn-outline-success mb-3" @onclick="AddMapping"><i class="bi bi-plus-lg me-1"></i> Add Mapping</button>

            <div>
                <button class="btn btn-success me-2" @onclick="SaveBinding">Save</button>
                <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
            </div>
        </div>
    </div>
}

<div class="table-responsive">
<table class="table table-striped resizable-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Provider</th>
            <th>Scope</th>
            <th>Mappings</th>
            <th>Max Concurrent</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var binding in bindings)
        {
            <tr>
                <td><strong>@binding.Name</strong></td>
                <td>
                    <span class="host-chip" style="background: @GetProviderColor(binding.Provider); color: white;">
                        <i class="bi @GetProviderIcon(binding.Provider) me-1"></i>@binding.Provider
                    </span>
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var org in binding.AllowedOrgs)
                        {
                            <span class="host-chip cap-chip">@org</span>
                        }
                        @foreach (var repo in binding.AllowedRepos)
                        {
                            <span class="host-chip cap-chip">@repo</span>
                        }
                        @if (!binding.AllowedOrgs.Any() && !binding.AllowedRepos.Any())
                        {
                            <span class="text-muted">—</span>
                        }
                    </div>
                </td>
                <td><span class="badge bg-secondary">@binding.Mappings.Count</span></td>
                <td>@binding.MaxConcurrentJobs</td>
                <td>
                    @if (binding.Enabled)
                    {
                        <span class="badge bg-success">Enabled</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Disabled</span>
                    }
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditBinding(binding)"><i class="bi bi-pencil-square"></i> Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmAndDeleteBinding(binding)"><i class="bi bi-trash3"></i> Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<WebhookBinding> bindings = [];
    private List<ProviderCredential> credentials = [];
    private List<RunnerProfile> profiles = [];
    private WebhookBinding editBinding = new() { Name = "" };
    private bool showForm;
    private bool isEditing;

    // Chip list state
    private List<string> editAllowedOrgs = [];
    private List<string> editAllowedRepos = [];
    private string newOrgInput = "";
    private string newRepoInput = "";

    // Mapping editing state
    private List<LabelProfileMapping> editMappings = [];
    private List<string> mappingLabelInputs = [];

    protected override async Task OnInitializedAsync()
    {
        bindings = (await Store.Query<WebhookBinding>().ToList()).ToList();
        credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();
        profiles = (await Store.Query<RunnerProfile>().ToList()).ToList();
    }

    private void ShowCreateForm()
    {
        editBinding = new WebhookBinding { Name = "" };
        editAllowedOrgs = [];
        editAllowedRepos = [];
        newOrgInput = "";
        newRepoInput = "";
        editMappings = [];
        mappingLabelInputs = [];
        isEditing = false;
        showForm = true;
    }

    private void EditBinding(WebhookBinding binding)
    {
        editBinding = binding;
        editAllowedOrgs = [.. binding.AllowedOrgs];
        editAllowedRepos = [.. binding.AllowedRepos];
        newOrgInput = "";
        newRepoInput = "";
        editMappings = binding.Mappings.Select(m => new LabelProfileMapping
        {
            RequiredLabels = [.. m.RequiredLabels],
            ProfileId = m.ProfileId,
            Priority = m.Priority
        }).ToList();
        mappingLabelInputs = editMappings.Select(_ => "").ToList();
        isEditing = true;
        showForm = true;
    }

    private async Task SaveBinding()
    {
        editBinding.AllowedOrgs = [.. editAllowedOrgs];
        editBinding.AllowedRepos = [.. editAllowedRepos];
        editBinding.Mappings = [.. editMappings];
        editBinding.UpdatedAt = DateTime.UtcNow;

        if (isEditing)
            await Store.Update(editBinding);
        else
            await Store.Insert(editBinding);

        bindings = (await Store.Query<WebhookBinding>().ToList()).ToList();
        showForm = false;
    }

    private async Task ConfirmAndDeleteBinding(WebhookBinding binding)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete webhook binding '{binding.Name}'?");
        if (confirmed) await DeleteBinding(binding.Id);
    }

    private async Task DeleteBinding(string id)
    {
        await Store.Remove<WebhookBinding>(id);
        bindings = (await Store.Query<WebhookBinding>().ToList()).ToList();
    }

    private void OnProviderChanged() => StateHasChanged();

    // --- Org chip helpers ---
    private void AddOrg()
    {
        var val = newOrgInput?.Trim() ?? "";
        if (!string.IsNullOrWhiteSpace(val) && !editAllowedOrgs.Contains(val))
        {
            editAllowedOrgs.Add(val);
            newOrgInput = "";
        }
    }

    private void OnOrgKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "," or "Tab")
            AddOrg();
    }

    // --- Repo chip helpers ---
    private void AddRepo()
    {
        var val = newRepoInput?.Trim() ?? "";
        if (!string.IsNullOrWhiteSpace(val) && !editAllowedRepos.Contains(val))
        {
            editAllowedRepos.Add(val);
            newRepoInput = "";
        }
    }

    private void OnRepoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "," or "Tab")
            AddRepo();
    }

    // --- Webhook secret ---
    private void GenerateSecret()
    {
        var bytes = new byte[16];
        System.Security.Cryptography.RandomNumberGenerator.Fill(bytes);
        editBinding.WebhookSecret = Convert.ToHexString(bytes).ToLowerInvariant();
    }

    // --- Mapping helpers ---
    private void AddMapping()
    {
        editMappings.Add(new LabelProfileMapping());
        mappingLabelInputs.Add("");
    }

    private void RemoveMapping(int index)
    {
        editMappings.RemoveAt(index);
        mappingLabelInputs.RemoveAt(index);
    }

    private void AddMappingLabel(int index)
    {
        var val = mappingLabelInputs[index]?.Trim() ?? "";
        if (!string.IsNullOrWhiteSpace(val) && !editMappings[index].RequiredLabels.Contains(val))
        {
            editMappings[index].RequiredLabels.Add(val);
            mappingLabelInputs[index] = "";
        }
    }

    private void OnMappingLabelKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key is "Enter" or "," or "Tab")
            AddMappingLabel(index);
    }

    // --- Provider display helpers ---
    private string GetProviderIcon(RunnerProvider provider) => provider switch
    {
        RunnerProvider.GitHubActions => "bi-github",
        RunnerProvider.GiteaActions => "bi-git",
        RunnerProvider.AzureDevOps => "bi-cloud-fill",
        _ => "bi-gear"
    };

    private string GetProviderColor(RunnerProvider provider) => provider switch
    {
        RunnerProvider.GitHubActions => "#24292f",
        RunnerProvider.GiteaActions => "#609926",
        RunnerProvider.AzureDevOps => "#0078d4",
        _ => "#6c757d"
    };
}
