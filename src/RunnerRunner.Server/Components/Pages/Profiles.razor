@page "/profiles"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Server.Services
@inject IDocumentStore Store
@inject IJSRuntime JS
@inject IGrainFactory GrainFactory
@inject CapacityPlanningService CapacityService

<PageTitle>Runner Profiles - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-clipboard2-check-fill"></i> Runner Profiles</h1>
        <span class="page-desc">Define runner configurations to deploy across hosts.</span>
    </div>
</SectionContent>

<button class="btn btn-primary mb-3" @onclick="ShowCreateForm"><i class="bi bi-plus-lg me-1"></i> New Profile</button>

<div class="row g-2 mb-3 align-items-end">
    <div class="col-md-4">
        <input class="form-control form-control-sm" placeholder="Search profiles..." @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" @bind="filterProvider">
            <option value="">All Providers</option>
            @foreach (var p in Enum.GetValues<RunnerProvider>())
            {
                <option value="@p">@p</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" @bind="filterPlatform">
            <option value="">All Platforms</option>
            @foreach (var p in Enum.GetValues<HostPlatform>())
            {
                <option value="@p">@p</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" @bind="filterBackend">
            <option value="">All Backends</option>
            @foreach (var b in Enum.GetValues<ExecutionBackend>())
            {
                <option value="@b">@b</option>
            }
        </select>
    </div>
</div>

<div class="alert alert-info py-2 d-flex align-items-center gap-2 mb-3" style="font-size: 0.9rem;">
    <i class="bi bi-info-circle"></i>
    <span><strong>Max Parallel Per Host</strong> is the profile-level cap. After a rule matches, each host still has to satisfy both this limit and its backend slot limit.</span>
</div>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(isEditing ? "Edit" : "Create") Profile</h5>

            @* Basic info *@
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="editProfile.Name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Description</label>
                    <input class="form-control" @bind="editProfile.Description" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Provider</label>
                    <select class="form-select" @bind="editProfile.Provider">
                        @foreach (var p in Enum.GetValues<RunnerProvider>())
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Host Platform</label>
                    <select class="form-select" @bind="editProfile.RequiredHostPlatform">
                        @foreach (var p in Enum.GetValues<HostPlatform>())
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Execution Backend</label>
                    <select class="form-select" @bind="editProfile.ExecutionBackend" @bind:after="OnBackendChanged">
                        @foreach (var b in Enum.GetValues<ExecutionBackend>())
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Max Parallel Per Host</label>
                    <input type="number" class="form-control" @bind="editProfile.MaxParallelPerHost" min="1" />
                </div>
            </div>

            @* Provider credential *@
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Provider Credential</label>
                    <select class="form-select" @bind="editProfile.ProviderCredentialId">
                        <option value="">— Select credential —</option>
                        @foreach (var cred in credentials.Where(c => c.Provider == editProfile.Provider))
                        {
                            <option value="@cred.Id">@cred.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Runner Group</label>
                    <input class="form-control" @bind="editProfile.RunnerGroup" />
                </div>
            </div>

            @* Labels as chips *@
            <div class="mb-3">
                <label class="form-label">Labels</label>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var label in editLabels)
                    {
                        <span class="badge bg-primary d-flex align-items-center gap-1" style="font-size: 0.85rem; padding: 0.4em 0.6em;">
                            @label
                            <i class="bi bi-x-lg" style="cursor:pointer; font-size:0.7rem;" @onclick="() => editLabels.Remove(label)"></i>
                        </span>
                    }
                </div>
                <div class="input-group input-group-sm" style="max-width: 300px;">
                    <input class="form-control" placeholder="Add label..." @bind="newLabelInput" @onkeydown="OnLabelKeyDown" />
                    <button class="btn btn-outline-primary" type="button" @onclick="AddLabel"><i class="bi bi-plus-lg"></i></button>
                </div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" @bind="editProfile.Ephemeral" id="ephemeralCheck" />
                <label class="form-check-label" for="ephemeralCheck">Ephemeral (single-use runners)</label>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" @bind="editProfile.EmitMetadataLabels" id="emitMetadataLabelsCheck" />
                <label class="form-check-label" for="emitMetadataLabelsCheck">
                    Emit <code>rr-*</code> metadata labels (backend, image, host, profile)
                </label>
                <div><small class="text-muted">Surfaces runner image/backend info in GitHub Actions' "Set up job" label list.</small></div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" @bind="editProfile.EmitJobStartedBanner" id="emitJobStartedBannerCheck" />
                <label class="form-check-label" for="emitJobStartedBannerCheck">
                    Install job-started banner hook
                </label>
                <div><small class="text-muted">Adds a collapsible "RunnerRunner environment" section to every job log via <code>ACTIONS_RUNNER_HOOK_JOB_STARTED</code>.</small></div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" @bind="editProfile.AllowWebhookImageTagOverride" id="allowWebhookImageTagOverrideCheck" />
                <label class="form-check-label" for="allowWebhookImageTagOverrideCheck">
                    Allow webhook to override image tag
                </label>
                <div><small class="text-muted">Honor an <code>rr-image-tag=&lt;tag&gt;</code> label on the job's <code>runs-on</code> to pull a specific tag of this profile's image. The registry and image name stay pinned; only the tag is overridden.</small></div>
            </div>

            @* Native Backend Config *@
            @if (editProfile.ExecutionBackend == ExecutionBackend.Native)
            {
                <h6 class="mt-3">Native Execution Settings</h6>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Runner Agent Version</label>
                        <input class="form-control" @bind="editProfile.RunnerAgentVersion" placeholder="latest (auto-download)" />
                        <small class="text-muted">e.g. 2.321.0 — leave empty for latest</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Runner Base Path</label>
                        <input class="form-control" @bind="nativeBasePath" placeholder="${HOME}/.runnerrunner" />
                        <small class="text-muted">Where agent binaries and instances are stored</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Work Directory</label>
                        <input class="form-control" @bind="nativeWorkDir" placeholder="${BASE_PATH}/work" />
                        <small class="text-muted">Each runner gets a subdirectory: <code>work/{runner-name}/</code></small>
                    </div>
                </div>
                <div class="alert alert-secondary py-2" style="font-size: 0.8rem;">
                    <i class="bi bi-info-circle me-1"></i> <strong>Path tokens:</strong>
                    Paths support <code>${TOKEN}</code> expansion. Available tokens:
                    <code>${BASE_PATH}</code>,
                    <code>${RUNNER_NAME}</code>,
                    <code>${INSTANCE_ID}</code>,
                    <code>${PROVIDER}</code>,
                    <code>${VERSION}</code>,
                    <code>${HOME}</code>
                </div>
            }

            @* Docker Image Config *@
            @if (editProfile.ExecutionBackend == ExecutionBackend.Docker)
            {
                <h6 class="mt-3">Docker Image Configuration</h6>
                @if (editProfile.RequiredHostPlatform == HostPlatform.Windows)
                {
                    <div class="alert alert-warning py-2" style="font-size: 0.85rem;">
                        <i class="bi bi-windows me-1"></i>
                        Use a <strong>Windows container image</strong> here. The target host must have Docker running in
                        <strong>windows</strong>-container mode; hosts report this as <code>docker_os=windows</code>.
                    </div>
                }
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Registry URL</label>
                        <input class="form-control" @bind="dockerRegistry" placeholder="ghcr.io" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Image Name</label>
                        <input class="form-control" @bind="dockerImage" placeholder="org/image" />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Tag</label>
                        <input class="form-control" @bind="dockerTag" placeholder="latest" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Pull Policy</label>
                        <select class="form-select" @bind="dockerPullPolicy">
                            @foreach (var p in Enum.GetValues<PullPolicy>())
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                </div>
            }

            @* Tart Image Config *@
            @if (editProfile.ExecutionBackend == ExecutionBackend.Tart)
            {
                <h6 class="mt-3">Tart VM Image Configuration</h6>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">OCI Registry URL</label>
                        <input class="form-control" @bind="tartRegistry" placeholder="ghcr.io" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Image Name</label>
                        <input class="form-control" @bind="tartImage" placeholder="cirruslabs/macos-sequoia-base" />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Tag</label>
                        <input class="form-control" @bind="tartTag" placeholder="latest" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2 mb-3">
                        <label class="form-label">CPU Count</label>
                        <input type="number" class="form-control" @bind="tartCpu" min="1" />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Memory (GB)</label>
                        <input type="number" class="form-control" @bind="tartMemory" min="1" />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Disk (GB)</label>
                        <input type="number" class="form-control" @bind="tartDisk" min="10" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Display</label>
                        <input class="form-control" @bind="tartDisplay" placeholder="1024x768" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">SSH User</label>
                        <input class="form-control" @bind="tartSshUser" placeholder="admin" />
                        <small class="text-muted">User to SSH into the VM (default: admin)</small>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">SSH Password</label>
                        <input type="password" class="form-control" @bind="tartSshPassword" placeholder="admin" />
                        <small class="text-muted">Password for SSH auth (Cirrus images use admin/admin)</small>
                    </div>
                </div>
            }

            @* Environment Variable Sets *@
            <h6 class="mt-3">Environment Variable Sets</h6>
            <p class="text-muted small">Select sets to compose (higher priority wins on key conflicts).</p>
            @foreach (var evs in allEnvVarSets)
            {
                var isSelected = selectedEnvVarSetIds.Contains(evs.Id);
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@isSelected"
                           @onchange="() => ToggleEnvVarSet(evs.Id)" id="evs-@evs.Id" />
                    <label class="form-check-label" for="evs-@evs.Id">
                        @evs.Name <span class="text-muted">(priority: @evs.Priority, @evs.Variables.Count vars)</span>
                    </label>
                </div>
            }

            @* Environment Overrides *@
            <h6 class="mt-3">Profile-Level Environment Overrides</h6>

            @* RR_ Reference Panel *@
            <div class="mb-2">
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => showProfileRrHelp = !showProfileRrHelp">
                    <i class="bi bi-info-circle me-1"></i> Available <code>$RR_</code> Variables
                    <i class="bi @(showProfileRrHelp ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i>
                </button>
                @if (showProfileRrHelp)
                {
                    <div class="card card-body mt-2" style="background: var(--bg-tertiary); font-size: 0.85rem;">
                        <p class="mb-2 text-muted">Auto-injected from credentials. Use as values: <code>$RR_GITHUB_TOKEN</code></p>
                        <div class="row">
                            <div class="col-md-4">
                                <strong>GitHub</strong>
                                @foreach (var v in new[] { "$RR_GITHUB_TOKEN", "$RR_GITHUB_ORG", "$RR_GITHUB_REPO" })
                                {
                                    <div><code style="cursor:pointer" @onclick="() => { newOverrideValue = v; }">@v</code></div>
                                }
                            </div>
                            <div class="col-md-4">
                                <strong>Gitea</strong>
                                @foreach (var v in new[] { "$RR_GITEA_RUNNER_TOKEN", "$RR_GITEA_INSTANCE_URL" })
                                {
                                    <div><code style="cursor:pointer" @onclick="() => { newOverrideValue = v; }">@v</code></div>
                                }
                            </div>
                            <div class="col-md-4">
                                <strong>AzDO</strong>
                                @foreach (var v in new[] { "$RR_AZDO_PAT", "$RR_AZDO_ORG_URL", "$RR_AZDO_PROJECT" })
                                {
                                    <div><code style="cursor:pointer" @onclick="() => { newOverrideValue = v; }">@v</code></div>
                                }
                            </div>
                        </div>
                        <p class="mt-2 mb-0 text-muted">Also injected: <code>$RR_INSTANCE_ID</code>, <code>$RR_RUNNER_NAME</code></p>
                    </div>
                }
            </div>

            <table class="table table-sm">
                <thead>
                    <tr><th>Key</th><th>Value</th><th style="width:150px">Resolves To</th><th style="width:60px" class="text-center"><i class="bi bi-shield-lock" title="Secret"></i></th><th style="width:40px"></th></tr>
                </thead>
                <tbody>
                    @foreach (var kvp in profileEnvOverrides)
                    {
                        var isSecret = profileOverrideSecretKeys.Contains(kvp.Key);
                        var resolved = ResolveProfilePreview(kvp.Value);
                        <tr>
                            <td><input class="form-control form-control-sm" value="@kvp.Key" @onchange="e => RenameOverrideKey(kvp.Key, e.Value?.ToString()!)" /></td>
                            <td><input type="@(isSecret ? "password" : "text")" class="form-control form-control-sm" value="@kvp.Value" @onchange="e => UpdateOverrideValue(kvp.Key, e.Value?.ToString()!)" /></td>
                            <td>
                                @if (resolved != null)
                                {
                                    @if (resolved.IsSecret)
                                    {
                                        <code class="text-muted" style="font-size:0.75rem">••••••••</code>
                                    }
                                    else if (resolved.IsUnknown)
                                    {
                                        <span class="text-warning" style="font-size:0.75rem"><i class="bi bi-exclamation-triangle"></i> unknown</span>
                                    }
                                    else
                                    {
                                        <code style="font-size:0.75rem; color: var(--success)">@resolved.Value</code>
                                    }
                                }
                            </td>
                            <td class="text-center"><input type="checkbox" class="form-check-input" checked="@isSecret" @onchange="() => ToggleOverrideSecret(kvp.Key)" title="Mark as secret" /></td>
                            <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveOverride(kvp.Key)"><i class="bi bi-x-lg"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row mb-3">
                <div class="col-md-3">
                    <input class="form-control form-control-sm" placeholder="KEY" @bind="newOverrideKey" />
                </div>
                <div class="col-md-4">
                    <input class="form-control form-control-sm" placeholder="Value or $RR_VARIABLE" @bind="newOverrideValue" />
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <input type="checkbox" class="form-check-input me-1" @bind="newOverrideIsSecret" id="newOverrideSecretCheck" />
                    <label class="form-check-label small" for="newOverrideSecretCheck">Secret</label>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-sm btn-outline-success" @onclick="AddOverride"><i class="bi bi-plus-lg"></i> Add</button>
                </div>
            </div>

            @* Init Steps *@
            <h6 class="mt-3">Init Steps</h6>
            <p class="text-muted small">
                Custom scripts executed as part of runner provisioning. PreRunner steps run
                before the runner starts; PostExit steps run after it exits, before cleanup.
                Useful for installing tools (e.g. <code>sentry-cli</code>, <code>gh</code>) without
                baking a new image.
            </p>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th style="width:30px"></th>
                        <th style="width:60px">Order</th>
                        <th>Name</th>
                        <th style="width:130px">Phase</th>
                        <th style="width:120px">Shell</th>
                        <th style="width:80px">Timeout</th>
                        <th style="width:70px" class="text-center" title="Continue on error">CoE</th>
                        <th style="width:80px"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < editInitSteps.Count; i++)
                    {
                        var idx = i;
                        var step = editInitSteps[idx];
                        <tr class="@(editingStepIndex == idx ? "table-active" : "")">
                            <td>
                                <input type="checkbox" class="form-check-input" checked="@step.Enabled"
                                       @onchange="e => { step.Enabled = (bool)(e.Value ?? false); }" title="Enabled" />
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => MoveInitStep(idx, -1)" disabled="@(idx == 0)"><i class="bi bi-arrow-up"></i></button>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => MoveInitStep(idx, 1)" disabled="@(idx == editInitSteps.Count - 1)"><i class="bi bi-arrow-down"></i></button>
                            </td>
                            <td><input class="form-control form-control-sm" @bind="step.Name" placeholder="Install sentry-cli" /></td>
                            <td>
                                <select class="form-select form-select-sm" @bind="step.Phase">
                                    <option value="@InitStepPhase.PreRunner">PreRunner</option>
                                    <option value="@InitStepPhase.PostExit">PostExit</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" @bind="step.Shell">
                                    @foreach (var s in Enum.GetValues<InitStepShell>())
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" class="form-control form-control-sm" min="1" @bind="step.TimeoutSeconds" /></td>
                            <td class="text-center"><input type="checkbox" class="form-check-input" checked="@step.ContinueOnError" @onchange="e => { step.ContinueOnError = (bool)(e.Value ?? false); }" /></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditInitStep(idx)" title="Edit script"><i class="bi bi-code-slash"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveInitStep(idx)" title="Delete"><i class="bi bi-x-lg"></i></button>
                            </td>
                        </tr>
                        @if (editingStepIndex == idx)
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small mb-1">Working directory (optional)</label>
                                            <input class="form-control form-control-sm" @bind="step.WorkingDirectory" placeholder="/home/runner" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small mb-1">Referenced Env Var Sets</label>
                                            <div style="max-height:100px; overflow-y:auto; border:1px solid var(--border-color); border-radius:4px; padding:4px;">
                                                @foreach (var evs in allEnvVarSets)
                                                {
                                                    var sel = step.EnvironmentVariableSetIds.Contains(evs.Id);
                                                    <div class="form-check form-check-sm">
                                                        <input class="form-check-input" type="checkbox" checked="@sel"
                                                               @onchange="() => ToggleStepEnvSet(step, evs.Id)" id="step-@idx-evs-@evs.Id" />
                                                        <label class="form-check-label small" for="step-@idx-evs-@evs.Id">@evs.Name <span class="text-muted">(@evs.Variables.Count vars)</span></label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small mb-1">Script</label>
                                            <textarea class="form-control form-control-sm" rows="8" style="font-family: var(--bs-font-monospace, monospace);" @bind="step.Script" placeholder="#!/usr/bin/env bash&#10;set -e&#10;curl -sL https://sentry.io/get-cli/ | bash"></textarea>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small mb-1">Step-level Environment Overrides</label>
                                            <table class="table table-sm mb-1">
                                                <thead><tr><th>Key</th><th>Value</th><th style="width:60px" class="text-center">Secret</th><th style="width:40px"></th></tr></thead>
                                                <tbody>
                                                    @foreach (var kvp in step.EnvironmentOverrides.ToList())
                                                    {
                                                        var k = kvp.Key;
                                                        var isSec = step.EnvironmentOverrideSecretKeys.Contains(k);
                                                        <tr>
                                                            <td><input class="form-control form-control-sm" value="@k" @onchange="e => RenameStepOverrideKey(step, k, e.Value?.ToString() ?? string.Empty)" /></td>
                                                            <td><input type="@(isSec ? "password" : "text")" class="form-control form-control-sm" value="@kvp.Value" @onchange="e => { step.EnvironmentOverrides[k] = e.Value?.ToString() ?? string.Empty; }" /></td>
                                                            <td class="text-center"><input type="checkbox" class="form-check-input" checked="@isSec" @onchange="() => ToggleStepOverrideSecret(step, k)" /></td>
                                                            <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveStepOverride(step, k)"><i class="bi bi-x-lg"></i></button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            <div class="row g-2">
                                                <div class="col-md-3"><input class="form-control form-control-sm" placeholder="KEY" @bind="newStepOverrideKey" /></div>
                                                <div class="col-md-4"><input class="form-control form-control-sm" placeholder="Value" @bind="newStepOverrideValue" /></div>
                                                <div class="col-md-2 d-flex align-items-center">
                                                    <input type="checkbox" class="form-check-input me-1" @bind="newStepOverrideIsSecret" id="newStepOverrideSecret-@idx" />
                                                    <label class="form-check-label small" for="newStepOverrideSecret-@idx">Secret</label>
                                                </div>
                                                <div class="col-md-2">
                                                    <button class="btn btn-sm btn-outline-success" @onclick="() => AddStepOverride(step)"><i class="bi bi-plus-lg"></i> Add</button>
                                                </div>
                                                <div class="col-md-1 text-end">
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => editingStepIndex = null" title="Collapse"><i class="bi bi-chevron-up"></i></button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <button class="btn btn-sm btn-outline-success mb-3" @onclick="AddInitStep"><i class="bi bi-plus-lg"></i> Add init step</button>

            <button class="btn btn-success me-2" @onclick="SaveProfile">Save</button>
            <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
        </div>
    </div>
}

<div class="table-responsive">
<table class="table table-striped resizable-table">
    <thead>
        <tr>
            <th role="button" @onclick='() => SetSort("Name")' style="cursor:pointer; user-select:none;">Name @SortIndicator("Name")</th>
            <th role="button" @onclick='() => SetSort("Provider")' style="cursor:pointer; user-select:none;">Provider / Platform @SortIndicator("Provider")</th>
            <th>Labels</th>
            <th>Env Sets</th>
            <th>Max Parallel</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var profile in FilteredProfiles)
        {
            <tr>
                <td>
                    <strong>@profile.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(profile.Description))
                    {
                        <br/><small class="text-muted">@profile.Description</small>
                    }
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="host-chip" style="background: @GetProviderColor(profile.Provider); color: white;">
                            <i class="bi @GetProviderIcon(profile.Provider) me-1"></i>@profile.Provider
                        </span>
                        <span class="host-chip platform-chip">
                            <i class="bi @GetPlatformIcon(profile.RequiredHostPlatform) me-1"></i>@profile.RequiredHostPlatform
                        </span>
                    </div>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        <span class="host-chip arch-chip">
                            <i class="bi @GetBackendIcon(profile.ExecutionBackend) me-1"></i>@profile.ExecutionBackend
                        </span>
                    </div>
                </td>
                <td>
                    @if (profile.Labels.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var label in profile.Labels)
                            {
                                <span class="host-chip cap-chip">@label</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>
                    @if (profile.EnvironmentVariableSetIds.Any())
                    {
                        <span class="badge bg-secondary">@profile.EnvironmentVariableSetIds.Count set(s)</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                    @if (profile.InitSteps.Any())
                    {
                        <span class="badge bg-info ms-1" title="Init steps">@profile.InitSteps.Count init step(s)</span>
                    }
                </td>
                <td>
                    <strong>@profile.MaxParallelPerHost / host</strong>
                    @if (capacitySnapshot.Profiles.TryGetValue(profile.Id, out var profileCapacity))
                    {
                        <div class="small text-muted mt-1">
                            Active: @profileCapacity.TotalActive
                            @if (profileCapacity.TotalActive > 0)
                            {
                                <span> · saturated on @profileCapacity.SaturatedHostCount host(s)</span>
                            }
                        </div>
                    }
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditProfile(profile)"><i class="bi bi-pencil-square"></i> Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmAndDeleteProfile(profile)"><i class="bi bi-trash3"></i> Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<RunnerProfile> profiles = [];
    private List<EnvironmentVariableSet> allEnvVarSets = [];
    private List<ProviderCredential> credentials = [];
    private CapacitySnapshot capacitySnapshot = CapacitySnapshot.Empty;
    private RunnerProfile editProfile = new() { Name = "" };
    private bool showForm;
    private bool isEditing;

    // Filter & sort state
    private string searchText = "";
    private string filterProvider = "";
    private string filterPlatform = "";
    private string filterBackend = "";
    private string sortColumn = "Name";
    private bool sortAscending = true;

    private IEnumerable<RunnerProfile> FilteredProfiles
    {
        get
        {
            var query = profiles.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term = searchText.Trim();
                query = query.Where(p =>
                    (p.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    p.Provider.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.RequiredHostPlatform.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.ExecutionBackend.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrEmpty(filterProvider) && Enum.TryParse<RunnerProvider>(filterProvider, out var prov))
                query = query.Where(p => p.Provider == prov);

            if (!string.IsNullOrEmpty(filterPlatform) && Enum.TryParse<HostPlatform>(filterPlatform, out var plat))
                query = query.Where(p => p.RequiredHostPlatform == plat);

            if (!string.IsNullOrEmpty(filterBackend) && Enum.TryParse<ExecutionBackend>(filterBackend, out var back))
                query = query.Where(p => p.ExecutionBackend == back);

            query = sortColumn switch
            {
                "Provider" => sortAscending ? query.OrderBy(p => p.Provider) : query.OrderByDescending(p => p.Provider),
                "Platform" => sortAscending ? query.OrderBy(p => p.RequiredHostPlatform) : query.OrderByDescending(p => p.RequiredHostPlatform),
                "Backend" => sortAscending ? query.OrderBy(p => p.ExecutionBackend) : query.OrderByDescending(p => p.ExecutionBackend),
                _ => sortAscending ? query.OrderBy(p => p.Name) : query.OrderByDescending(p => p.Name),
            };

            return query;
        }
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string SortIndicator(string column)
        => sortColumn == column ? (sortAscending ? "▲" : "▼") : "";

    // Labels as chip list
    private List<string> editLabels = [];
    private string newLabelInput = "";

    // Docker config fields
    private string dockerRegistry = "ghcr.io";
    private string dockerImage = "";
    private string dockerTag = "latest";
    private PullPolicy dockerPullPolicy = PullPolicy.IfNotPresent;

    // Tart config fields
    private string tartRegistry = "ghcr.io";
    private string tartImage = "";
    private string tartTag = "latest";
    private int? tartCpu;
    private int? tartMemory;
    private int? tartDisk;
    private string tartDisplay = "";
    private string tartSshUser = "admin";
    private string tartSshPassword = "";

    // Native config fields
    private string nativeBasePath = "";
    private string nativeWorkDir = "";

    // Env var composition
    private HashSet<string> selectedEnvVarSetIds = [];
    private Dictionary<string, string> profileEnvOverrides = new();
    private HashSet<string> profileOverrideSecretKeys = [];
    private string newOverrideKey = "";
    private string newOverrideValue = "";
    private bool newOverrideIsSecret;
    private bool showProfileRrHelp;

    // Init steps editor state
    private List<RunnerInitStep> editInitSteps = [];
    private int? editingStepIndex;
    private string newStepOverrideKey = "";
    private string newStepOverrideValue = "";
    private bool newStepOverrideIsSecret;

    // RR_ resolution
    private Dictionary<string, string> rrResolvableVars = new();
    private HashSet<string> rrSecretKeys = new(["RR_GITHUB_TOKEN", "RR_GITEA_RUNNER_TOKEN", "RR_AZDO_PAT"]);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        BuildRrResolvableVars();
    }

    private async Task LoadDataAsync()
    {
        profiles = (await Store.Query<RunnerProfile>().ToList()).ToList();
        allEnvVarSets = (await Store.Query<EnvironmentVariableSet>().ToList()).ToList();
        credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();
        capacitySnapshot = await CapacityService.GetSnapshotAsync();
    }

    private void ShowCreateForm()
    {
        editProfile = new RunnerProfile { Name = "" };
        editLabels = [];
        newLabelInput = "";
        nativeBasePath = "";
        nativeWorkDir = "";
        ResetImageFields();
        selectedEnvVarSetIds = [];
        profileEnvOverrides = new();
        profileOverrideSecretKeys = [];
        newOverrideIsSecret = false;
        showProfileRrHelp = false;
        editInitSteps = [];
        editingStepIndex = null;
        isEditing = false;
        showForm = true;
    }

    private void EditProfile(RunnerProfile profile)
    {
        editProfile = profile;
        editLabels = [.. profile.Labels];
        newLabelInput = "";
        selectedEnvVarSetIds = [.. profile.EnvironmentVariableSetIds];
        profileEnvOverrides = new Dictionary<string, string>(profile.EnvironmentOverrides);
        profileOverrideSecretKeys = [.. profile.EnvironmentOverrideSecretKeys];
        editInitSteps = profile.InitSteps.Select(CloneInitStep).ToList();
        editingStepIndex = null;
        nativeBasePath = profile.ProviderConfig.GetValueOrDefault("NativeBasePath", "");
        nativeWorkDir = profile.ProviderConfig.GetValueOrDefault("NativeWorkDir", "");

        if (profile.DockerConfig is not null)
        {
            dockerRegistry = profile.DockerConfig.RegistryUrl;
            dockerImage = profile.DockerConfig.ImageName;
            dockerTag = profile.DockerConfig.Tag;
            dockerPullPolicy = profile.DockerConfig.PullPolicy;
        }
        if (profile.TartConfig is not null)
        {
            tartRegistry = profile.TartConfig.RegistryUrl;
            tartImage = profile.TartConfig.ImageName;
            tartTag = profile.TartConfig.Tag;
            tartCpu = profile.TartConfig.CpuCount;
            tartMemory = profile.TartConfig.MemorySizeGb;
            tartDisk = profile.TartConfig.DiskSizeGb;
            tartDisplay = profile.TartConfig.Display ?? "";
            tartSshUser = profile.TartConfig.SshUser;
            tartSshPassword = profile.TartConfig.SshPassword ?? "";
        }

        isEditing = true;
        showForm = true;
    }

    private async Task SaveProfile()
    {
        editProfile.Labels = [.. editLabels];
        editProfile.EnvironmentVariableSetIds = [.. selectedEnvVarSetIds];
        editProfile.EnvironmentOverrides = new Dictionary<string, string>(profileEnvOverrides);
        editProfile.EnvironmentOverrideSecretKeys = [.. profileOverrideSecretKeys];
        editProfile.InitSteps = editInitSteps.Select(CloneInitStep).ToList();
        editProfile.UpdatedAt = DateTime.UtcNow;

        // Save native config into ProviderConfig
        if (editProfile.ExecutionBackend == ExecutionBackend.Native)
        {
            if (!string.IsNullOrWhiteSpace(nativeBasePath))
                editProfile.ProviderConfig["NativeBasePath"] = nativeBasePath;
            if (!string.IsNullOrWhiteSpace(nativeWorkDir))
                editProfile.ProviderConfig["NativeWorkDir"] = nativeWorkDir;
        }

        if (editProfile.ExecutionBackend == ExecutionBackend.Docker)
        {
            editProfile.DockerConfig = new DockerImageConfig
            {
                RegistryUrl = dockerRegistry,
                ImageName = dockerImage,
                Tag = dockerTag,
                PullPolicy = dockerPullPolicy
            };
            editProfile.TartConfig = null;
        }
        else if (editProfile.ExecutionBackend == ExecutionBackend.Tart)
        {
            editProfile.TartConfig = new TartImageConfig
            {
                RegistryUrl = tartRegistry,
                ImageName = tartImage,
                Tag = tartTag,
                CpuCount = tartCpu,
                MemorySizeGb = tartMemory,
                DiskSizeGb = tartDisk,
                Display = string.IsNullOrWhiteSpace(tartDisplay) ? null : tartDisplay,
                SshUser = string.IsNullOrWhiteSpace(tartSshUser) ? "admin" : tartSshUser,
                SshPassword = string.IsNullOrWhiteSpace(tartSshPassword) ? null : tartSshPassword
            };
            editProfile.DockerConfig = null;
        }
        else
        {
            editProfile.DockerConfig = null;
            editProfile.TartConfig = null;
        }

        if (isEditing)
            await Store.Update(editProfile);
        else
            await Store.Insert(editProfile);

        await LoadDataAsync();
        showForm = false;
    }

    private async Task ConfirmAndDeleteProfile(RunnerProfile profile)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete profile '{profile.Name}'?");
        if (confirmed) await DeleteProfile(profile.Id);
    }

    private async Task DeleteProfile(string id)
    {
        await Store.Remove<RunnerProfile>(id);
        await LoadDataAsync();
    }

    private void OnBackendChanged() => StateHasChanged();

    private void ToggleEnvVarSet(string id)
    {
        if (!selectedEnvVarSetIds.Remove(id))
            selectedEnvVarSetIds.Add(id);
    }

    private void AddOverride()
    {
        if (!string.IsNullOrWhiteSpace(newOverrideKey))
        {
            profileEnvOverrides[newOverrideKey] = newOverrideValue;
            if (newOverrideIsSecret) profileOverrideSecretKeys.Add(newOverrideKey);
            newOverrideKey = "";
            newOverrideValue = "";
            newOverrideIsSecret = false;
        }
    }

    private void RemoveOverride(string key)
    {
        profileEnvOverrides.Remove(key);
        profileOverrideSecretKeys.Remove(key);
    }

    private void RenameOverrideKey(string oldKey, string newKey)
    {
        if (profileEnvOverrides.TryGetValue(oldKey, out var val))
        {
            profileEnvOverrides.Remove(oldKey);
            profileEnvOverrides[newKey] = val;
            if (profileOverrideSecretKeys.Remove(oldKey))
                profileOverrideSecretKeys.Add(newKey);
        }
    }

    private void ToggleOverrideSecret(string key)
    {
        if (!profileOverrideSecretKeys.Remove(key))
            profileOverrideSecretKeys.Add(key);
    }

    private void UpdateOverrideValue(string key, string value) => profileEnvOverrides[key] = value;

    // --- Init steps helpers ---

    private static RunnerInitStep CloneInitStep(RunnerInitStep s) => new()
    {
        Id = s.Id,
        Name = s.Name,
        Phase = s.Phase,
        Shell = s.Shell,
        Script = s.Script,
        ContinueOnError = s.ContinueOnError,
        TimeoutSeconds = s.TimeoutSeconds,
        WorkingDirectory = s.WorkingDirectory,
        EnvironmentVariableSetIds = [.. s.EnvironmentVariableSetIds],
        EnvironmentOverrides = new Dictionary<string, string>(s.EnvironmentOverrides),
        EnvironmentOverrideSecretKeys = [.. s.EnvironmentOverrideSecretKeys],
        Enabled = s.Enabled,
    };

    private void AddInitStep()
    {
        editInitSteps.Add(new RunnerInitStep { Name = "New step" });
        editingStepIndex = editInitSteps.Count - 1;
    }

    private void RemoveInitStep(int idx)
    {
        if (idx < 0 || idx >= editInitSteps.Count) return;
        editInitSteps.RemoveAt(idx);
        if (editingStepIndex == idx) editingStepIndex = null;
        else if (editingStepIndex > idx) editingStepIndex--;
    }

    private void EditInitStep(int idx)
    {
        editingStepIndex = editingStepIndex == idx ? null : idx;
    }

    private void MoveInitStep(int idx, int delta)
    {
        var target = idx + delta;
        if (target < 0 || target >= editInitSteps.Count) return;
        (editInitSteps[idx], editInitSteps[target]) = (editInitSteps[target], editInitSteps[idx]);
        if (editingStepIndex == idx) editingStepIndex = target;
        else if (editingStepIndex == target) editingStepIndex = idx;
    }

    private void ToggleStepEnvSet(RunnerInitStep step, string setId)
    {
        if (!step.EnvironmentVariableSetIds.Remove(setId))
            step.EnvironmentVariableSetIds.Add(setId);
    }

    private void AddStepOverride(RunnerInitStep step)
    {
        if (string.IsNullOrWhiteSpace(newStepOverrideKey)) return;
        step.EnvironmentOverrides[newStepOverrideKey] = newStepOverrideValue;
        if (newStepOverrideIsSecret) step.EnvironmentOverrideSecretKeys.Add(newStepOverrideKey);
        newStepOverrideKey = "";
        newStepOverrideValue = "";
        newStepOverrideIsSecret = false;
    }

    private void RemoveStepOverride(RunnerInitStep step, string key)
    {
        step.EnvironmentOverrides.Remove(key);
        step.EnvironmentOverrideSecretKeys.Remove(key);
    }

    private void RenameStepOverrideKey(RunnerInitStep step, string oldKey, string newKey)
    {
        if (string.IsNullOrWhiteSpace(newKey) || newKey == oldKey) return;
        if (!step.EnvironmentOverrides.TryGetValue(oldKey, out var val)) return;
        step.EnvironmentOverrides.Remove(oldKey);
        step.EnvironmentOverrides[newKey] = val;
        if (step.EnvironmentOverrideSecretKeys.Remove(oldKey))
            step.EnvironmentOverrideSecretKeys.Add(newKey);
    }

    private void ToggleStepOverrideSecret(RunnerInitStep step, string key)
    {
        if (!step.EnvironmentOverrideSecretKeys.Remove(key))
            step.EnvironmentOverrideSecretKeys.Add(key);
    }

    private void ResetImageFields()
    {
        dockerRegistry = "ghcr.io"; dockerImage = ""; dockerTag = "latest";
        dockerPullPolicy = PullPolicy.IfNotPresent;
        tartRegistry = "ghcr.io"; tartImage = ""; tartTag = "latest";
        tartCpu = null; tartMemory = null; tartDisk = null; tartDisplay = ""; tartSshUser = "admin"; tartSshPassword = "";
    }

    // --- Label chip helpers ---

    private void AddLabel()
    {
        if (!string.IsNullOrWhiteSpace(newLabelInput) && !editLabels.Contains(newLabelInput.Trim()))
        {
            editLabels.Add(newLabelInput.Trim());
            newLabelInput = "";
        }
    }

    private void OnLabelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "," or "Tab")
            AddLabel();
    }

    // --- RR_ Resolution Preview ---

    private void BuildRrResolvableVars()
    {
        rrResolvableVars.Clear();
        foreach (var cred in credentials)
        {
            switch (cred.Provider)
            {
                case RunnerProvider.GitHubActions:
                    if (!string.IsNullOrEmpty(cred.GitHubToken)) rrResolvableVars["RR_GITHUB_TOKEN"] = cred.GitHubToken;
                    if (!string.IsNullOrEmpty(cred.GitHubOrg)) rrResolvableVars["RR_GITHUB_ORG"] = cred.GitHubOrg;
                    if (!string.IsNullOrEmpty(cred.GitHubRepo)) rrResolvableVars["RR_GITHUB_REPO"] = cred.GitHubRepo;
                    break;
                case RunnerProvider.GiteaActions:
                    if (!string.IsNullOrEmpty(cred.GiteaRunnerToken)) rrResolvableVars["RR_GITEA_RUNNER_TOKEN"] = cred.GiteaRunnerToken;
                    if (!string.IsNullOrEmpty(cred.GiteaInstanceUrl)) rrResolvableVars["RR_GITEA_INSTANCE_URL"] = cred.GiteaInstanceUrl;
                    break;
                case RunnerProvider.AzureDevOps:
                    if (!string.IsNullOrEmpty(cred.AzDoPat)) rrResolvableVars["RR_AZDO_PAT"] = cred.AzDoPat;
                    if (!string.IsNullOrEmpty(cred.AzDoOrgUrl)) rrResolvableVars["RR_AZDO_ORG_URL"] = cred.AzDoOrgUrl;
                    break;
            }
        }
    }

    private ResolvedVal? ResolveProfilePreview(string value)
    {
        if (string.IsNullOrEmpty(value) || !value.Contains('$')) return null;

        var resolved = value;
        var hasSecret = false;
        var hasUnknown = false;

        foreach (var rrKey in rrResolvableVars.Keys)
        {
            if (resolved.Contains($"${{{rrKey}}}") || resolved.Contains($"${rrKey}"))
            {
                if (rrSecretKeys.Contains(rrKey)) hasSecret = true;
                resolved = resolved.Replace($"${{{rrKey}}}", rrResolvableVars[rrKey]).Replace($"${rrKey}", rrResolvableVars[rrKey]);
            }
        }

        if (resolved.Contains('$')) hasUnknown = true;
        if (hasSecret) return new ResolvedVal { IsSecret = true };
        if (hasUnknown) return new ResolvedVal { IsUnknown = true };
        return resolved != value ? new ResolvedVal { Value = resolved } : null;
    }

    private class ResolvedVal
    {
        public string? Value { get; set; }
        public bool IsSecret { get; set; }
        public bool IsUnknown { get; set; }
    }

    private string GetPlatformIcon(HostPlatform platform) => platform switch
    {
        HostPlatform.Linux => "bi-ubuntu",
        HostPlatform.MacOS => "bi-apple",
        HostPlatform.Windows => "bi-windows",
        _ => "bi-pc-display"
    };

    private string GetProviderIcon(RunnerProvider provider) => provider switch
    {
        RunnerProvider.GitHubActions => "bi-github",
        RunnerProvider.GiteaActions => "bi-git",
        RunnerProvider.AzureDevOps => "bi-cloud-fill",
        _ => "bi-gear"
    };

    private string GetProviderColor(RunnerProvider provider) => provider switch
    {
        RunnerProvider.GitHubActions => "#24292f",
        RunnerProvider.GiteaActions => "#609926",
        RunnerProvider.AzureDevOps => "#0078d4",
        _ => "#6c757d"
    };

    private string GetBackendIcon(ExecutionBackend backend) => backend switch
    {
        ExecutionBackend.Docker => "bi-box-fill",
        ExecutionBackend.Tart => "bi-display",
        ExecutionBackend.Native => "bi-terminal",
        _ => "bi-gear"
    };
}
