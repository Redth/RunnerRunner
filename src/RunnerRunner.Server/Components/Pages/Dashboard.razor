@page "/"
@using RunnerRunner.Server.Grains.Events
@using RunnerRunner.Server.Services
@using Shiny.DocumentDb
@inject IGrainFactory GrainFactory
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Dashboard - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-grid-1x2-fill"></i> Dashboard</h1>
    </div>
</SectionContent>

<div class="row mt-3">
    <div class="col-md-3">
        <div class="card text-bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-hdd-rack me-1"></i> Connected Hosts</h5>
                <p class="card-text display-4">@connectedHostCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-lightning-charge me-1"></i> Running Instances</h5>
                <p class="card-text display-4">@runningInstanceCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-clipboard2-check me-1"></i> Profiles</h5>
                <p class="card-text display-4">@profileCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-braces me-1"></i> Env Var Sets</h5>
                <p class="card-text display-4">@envVarSetCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-lightning me-1"></i> Dynamic Runners</h5>
                <p class="card-text display-4">@dynamicRunnerCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-broadcast-pin me-1"></i> Webhook Events (1h)</h5>
                <p class="card-text display-4">@recentWebhookEventCount</p>
            </div>
        </div>
    </div>
</div>

<h3 class="mt-4"><i class="bi bi-diagram-3-fill me-2"></i>Cluster Status</h3>
<div class="row mb-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h6>Orleans Silo</h6>
                <p class="mb-1"><span class="badge bg-success">Active</span> Silo running on this server</p>
                <small class="text-muted">
                    <a href="/orleans" target="_blank"><i class="bi bi-box-arrow-up-right me-1"></i>Open Orleans Dashboard</a>
                </small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h6>Database</h6>
                <p class="mb-1"><span class="badge bg-success">PostgreSQL</span> Connected</p>
                <small class="text-muted">Grain persistence + DocumentDB</small>
            </div>
        </div>
    </div>
</div>

<h3 class="mt-4"><i class="bi bi-hdd-rack me-2"></i>Hosts</h3>
@if (!hosts.Any())
{
    <div class="alert alert-secondary">No hosts registered. Deploy a HostSilo on your machines to get started.</div>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped resizable-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Platform</th>
                <th>Last Heartbeat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var host in hosts)
            {
                <tr>
                    <td>
                        <span>@host.Label</span>
                        @if (!string.IsNullOrWhiteSpace(host.DisplayName))
                        {
                            <br/><small class="text-muted">@host.Name</small>
                        }
                    </td>
                    <td><span class="badge @GetStatusBadge(host.AgentStatus)">@host.AgentStatus</span></td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            <span class="host-chip platform-chip"><i class="bi @GetPlatformIcon(host.Platform) me-1"></i>@host.Platform</span>
                            @if (!string.IsNullOrEmpty(host.Architecture))
                            {
                                <span class="host-chip arch-chip"><i class="bi bi-cpu me-1"></i>@host.Architecture</span>
                            }
                        </div>
                    </td>
                    <td>@(host.LastHeartbeat?.ToString("HH:mm:ss") ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private int connectedHostCount;
    private int runningInstanceCount;
    private int profileCount;
    private int envVarSetCount;
    private int dynamicRunnerCount;
    private int recentWebhookEventCount;
    private List<RunnerRunner.Core.Models.Host> hosts = [];
    private List<RunnerRunner.Core.Models.RunnerAssignment> assignments = [];
    private Dictionary<string, string> profileNames = new();

    [Inject] IDocumentStore Store { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        StreamSubscriptionService.OnRunnerStatusChanged += OnStreamRunnerStatusChanged;
        StreamSubscriptionService.OnHostStatusChanged += OnStreamHostStatusChanged;
    }

    private void OnStreamRunnerStatusChanged(RunnerStatusChangedEvent evt)
    {
        InvokeAsync(async () => { await LoadData(); StateHasChanged(); });
    }

    private void OnStreamHostStatusChanged(HostStatusChangedEvent evt)
    {
        InvokeAsync(async () => { await LoadData(); StateHasChanged(); });
    }

    public void Dispose()
    {
        StreamSubscriptionService.OnRunnerStatusChanged -= OnStreamRunnerStatusChanged;
        StreamSubscriptionService.OnHostStatusChanged -= OnStreamHostStatusChanged;
    }

    private async Task LoadData()
    {
        hosts = (await Store.Query<RunnerRunner.Core.Models.Host>().ToList()).ToList();
        connectedHostCount = hosts.Count(h => h.AgentStatus == RunnerRunner.Core.Models.AgentStatus.Online);

        var profiles = (await Store.Query<RunnerRunner.Core.Models.RunnerProfile>().ToList()).ToList();
        profileCount = profiles.Count;
        profileNames = profiles.ToDictionary(p => p.Id, p => p.Name);
        envVarSetCount = (await Store.Query<RunnerRunner.Core.Models.EnvironmentVariableSet>().ToList()).Count;
        assignments = (await Store.Query<RunnerRunner.Core.Models.RunnerAssignment>().ToList()).ToList();

        var allInstances = (await Store.Query<RunnerRunner.Core.Models.RunnerInstance>().ToList()).ToList();

        runningInstanceCount = allInstances.Count(i =>
            i.Status == RunnerRunner.Core.Models.RunnerInstanceStatus.Running
            || i.Status == RunnerRunner.Core.Models.RunnerInstanceStatus.Starting);

        dynamicRunnerCount = allInstances.Count(i =>
            i.ProvisioningMode == "dynamic"
            && (i.Status == RunnerRunner.Core.Models.RunnerInstanceStatus.Running
                || i.Status == RunnerRunner.Core.Models.RunnerInstanceStatus.Starting));

        var oneHourAgo = DateTime.UtcNow.AddHours(-1);
        recentWebhookEventCount = (await Store.Query<RunnerRunner.Core.Models.WebhookEvent>().ToList())
            .Count(e => e.ReceivedAt > oneHourAgo);
    }

    private string GetPlatformIcon(RunnerRunner.Core.Models.HostPlatform platform) => platform switch
    {
        RunnerRunner.Core.Models.HostPlatform.Linux => "bi-ubuntu",
        RunnerRunner.Core.Models.HostPlatform.MacOS => "bi-apple",
        RunnerRunner.Core.Models.HostPlatform.Windows => "bi-windows",
        _ => "bi-pc-display"
    };

    private string GetStatusBadge(RunnerRunner.Core.Models.AgentStatus status) => status switch
    {
        RunnerRunner.Core.Models.AgentStatus.Online => "bg-success",
        RunnerRunner.Core.Models.AgentStatus.Connecting => "bg-warning",
        _ => "bg-secondary"
    };
}
