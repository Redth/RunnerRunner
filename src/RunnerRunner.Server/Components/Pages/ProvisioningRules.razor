    private static void RenameRunnerEnvOverride(RunnerDefinition runner, string oldKey, string? newKeyValue)
    {
        var newKey = (newKeyValue ?? "").Trim();
        if (string.IsNullOrWhiteSpace(newKey)
            || string.Equals(oldKey, newKey, StringComparison.OrdinalIgnoreCase)
            || !runner.EnvironmentOverrides.TryGetValue(oldKey, out var value))
        {
            return;
        }

        var wasSecret = runner.EnvironmentOverrideSecretKeys.Remove(oldKey);
        runner.EnvironmentOverrides.Remove(oldKey);
        runner.EnvironmentOverrides[newKey] = value;
        if (wasSecret)
            runner.EnvironmentOverrideSecretKeys.Add(newKey);
    }

