            ProfileId = m.ProfileId,
            Priority = m.Priority
        })],
        DefaultProfileId = rule.DefaultProfileId,
        MaxConcurrent = rule.MaxConcurrent,
        CooldownSeconds = rule.CooldownSeconds,
