    private List<RunnerDefinition> GetDisplayRunnerDefinitions(ProvisioningRule rule)
    {
        if (rule.RunnerDefinitions.Count > 0)
            return rule.RunnerDefinitions.Where(r => r.Enabled).ToList();

        if (rule.Type == ProvisioningType.Webhook)
        {
            return rule.LabelMappings
                .Select(mapping => profiles.FirstOrDefault(profile => string.Equals(profile.Id, mapping.ProfileId, StringComparison.OrdinalIgnoreCase)))
                .Where(profile => profile != null)
                .DistinctBy(profile => profile!.Id)
                .Select(profile => RunnerDefinition.FromProfile(profile!))
                .ToList();
        }

        var sourceProfile = profiles.FirstOrDefault(profile => string.Equals(profile.Id, rule.ProfileId, StringComparison.OrdinalIgnoreCase));
        return sourceProfile == null ? [] : [RunnerDefinition.FromProfile(sourceProfile)];
    }

    private string GetTargetDisplay(ProvisioningRule rule)
    {
        var targetParts = new List<string>();
        if (!string.IsNullOrWhiteSpace(rule.TargetHostId))
        {
            var host = hosts.FirstOrDefault(h => h.Id == rule.TargetHostId);
            targetParts.Add(host?.Label ?? rule.TargetHostId);
        }

        if (!string.IsNullOrWhiteSpace(rule.TargetGroupId))
            targetParts.Add(rule.TargetGroupId);

        if (rule.RequiredHostLabels.Count > 0)
            targetParts.Add($"{rule.RequiredHostLabels.Count} host label(s)");

        return targetParts.Count > 0 ? string.Join(" · ", targetParts) : "Any eligible host";
    }

