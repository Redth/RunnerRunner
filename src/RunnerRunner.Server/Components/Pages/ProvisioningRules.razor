    private static string FormatScopeList(List<string> values, string empty)
    {
        if (values.Count == 0)
            return empty;
        if (values.Count <= 2)
            return string.Join(", ", values);
        return $"{values.Count} configured";
    }

    private bool TryGetWebhookEndpoint(RunnerProvider provider, out string endpoint)
    {
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        endpoint = provider switch
        {
            RunnerProvider.GitHubActions => $"{baseUri}/api/webhooks/github",
            RunnerProvider.GiteaActions => $"{baseUri}/api/webhooks/gitea",
            _ => ""
        };

        return !string.IsNullOrWhiteSpace(endpoint);
    }

