                                }
                            </div>

                            <div class="rule-preview-card">
                                <div class="preview-title">Capacity model</div>
                                <ol class="capacity-order">
                                    <li>FIFO fairness</li>
                                    <li>Rule concurrency</li>
                                    <li>Host backend slots</li>
                                    <li>HostWorker availability</li>
                                </ol>
                            </div>
                        </aside>
