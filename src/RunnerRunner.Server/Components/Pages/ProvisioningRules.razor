@page "/provisioning-rules"
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@inject IDocumentStore Store
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Provisioning Rules - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-diagram-3-fill"></i> Provisioning Rules</h1>
        <span class="page-desc">Define how runner profiles are provisioned across hosts.</span>
    </div>
</SectionContent>

<button class="btn btn-primary mb-3" @onclick="ShowCreateForm"><i class="bi bi-plus-lg me-1"></i> New Rule</button>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(isEditing ? "Edit" : "Create") Provisioning Rule</h5>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="editRule.Name" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Description</label>
                    <input class="form-control" @bind="editRule.Description" />
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="editRule.Type" @bind:after="OnTypeChanged">
                        @foreach (var t in Enum.GetValues<ProvisioningType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label class="form-label">Profile</label>
                    <select class="form-select" @bind="editRule.ProfileId">
                        <option value="">— Select —</option>
                        @foreach (var p in profiles)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
            </div>

            @* --- Static fields --- *@
            @if (editRule.Type == ProvisioningType.Static)
            {
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Desired Count</label>
                        <input type="number" class="form-control" @bind="editRule.DesiredCount" min="1" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Target Host</label>
                        <select class="form-select" @bind="editRule.TargetHostId">
                            <option value="">Auto (by labels)</option>
                            @foreach (var h in hosts)
                            {
                                <option value="@h.Id">@h.Label</option>
                            }
                        </select>
                    </div>
                </div>
            }

            @* --- ScaleSet fields --- *@
            @if (editRule.Type == ProvisioningType.ScaleSet)
            {
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Min Ready</label>
                        <input type="number" class="form-control" @bind="editRule.MinReady" min="0" />
                        <div class="form-text">Warm pool: runners kept idle and ready</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Max Instances</label>
                        <input type="number" class="form-control" @bind="editRule.MaxInstances" min="1" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Scale Down Delay (seconds)</label>
                        <input type="number" class="form-control" @bind="editRule.ScaleDownDelaySeconds" min="0" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Target Host</label>
                        <select class="form-select" @bind="editRule.TargetHostId">
                            <option value="">Auto (by labels)</option>
                            @foreach (var h in hosts)
                            {
                                <option value="@h.Id">@h.Label</option>
                            }
                        </select>
                    </div>
                </div>
            }

            @* --- Webhook fields --- *@
            @if (editRule.Type == ProvisioningType.Webhook)
            {
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Provider</label>
                        <select class="form-select" @bind="editRule.Provider" @bind:after="OnProviderChanged">
                            @foreach (var p in Enum.GetValues<RunnerProvider>())
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Provider Credential</label>
                        <select class="form-select" @bind="editRule.ProviderCredentialId">
                            <option value="">— Select credential —</option>
                            @foreach (var cred in credentials.Where(c => c.Provider == editRule.Provider))
                            {
                                <option value="@cred.Id">@cred.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Webhook Secret</label>
                        <div class="input-group">
                            <input class="form-control" @bind="editRule.WebhookSecret" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="GenerateSecret">Generate</button>
                        </div>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Max Concurrent</label>
                        <input type="number" class="form-control" @bind="editRule.MaxConcurrent" min="1" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Min Ready / Warm Pool</label>
                        <input type="number" class="form-control" @bind="editRule.MinReady" min="0" />
                        <div class="form-text">Keep N runners pre-provisioned</div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Cooldown Seconds</label>
                        <input type="number" class="form-control" @bind="editRule.CooldownSeconds" min="0" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Default Profile</label>
                        <select class="form-select" @bind="editRule.DefaultProfileId">
                            <option value="">— None —</option>
                            @foreach (var p in profiles)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                </div>

                @* Allowed Orgs *@
                <div class="mb-3">
                    <label class="form-label">Allowed Orgs</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var org in editAllowedOrgs)
                        {
                            <span class="badge bg-primary d-flex align-items-center gap-1" style="font-size: 0.85rem; padding: 0.4em 0.6em;">
                                @org
                                <i class="bi bi-x-lg" style="cursor:pointer; font-size:0.7rem;" @onclick="() => editAllowedOrgs.Remove(org)"></i>
                            </span>
                        }
                    </div>
                    <div class="input-group input-group-sm" style="max-width: 300px;">
                        <input class="form-control" placeholder="Add org..." @bind="newOrgInput" @onkeydown="OnOrgKeyDown" />
                        <button class="btn btn-outline-primary" type="button" @onclick="AddOrg"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>

                @* Allowed Repos *@
                <div class="mb-3">
                    <label class="form-label">Allowed Repos</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var repo in editAllowedRepos)
                        {
                            <span class="badge bg-info d-flex align-items-center gap-1" style="font-size: 0.85rem; padding: 0.4em 0.6em;">
                                @repo
                                <i class="bi bi-x-lg" style="cursor:pointer; font-size:0.7rem;" @onclick="() => editAllowedRepos.Remove(repo)"></i>
                            </span>
                        }
                    </div>
                    <div class="input-group input-group-sm" style="max-width: 400px;">
                        <input class="form-control" placeholder="Add repo (org/repo)..." @bind="newRepoInput" @onkeydown="OnRepoKeyDown" />
                        <button class="btn btn-outline-primary" type="button" @onclick="AddRepo"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>

                @* Label → Profile Mappings *@
                <h6 class="mt-3">Label → Profile Mappings</h6>
                <p class="text-muted small">Priority-ordered label-to-profile mappings. First match wins.</p>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Required Labels</th>
                            <th>Profile</th>
                            <th style="width:100px;">Priority</th>
                            <th style="width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < editMappings.Count; i++)
                        {
                            var idx = i;
                            <tr>
                                <td>
                                    <div class="d-flex flex-wrap gap-1 mb-1">
                                        @foreach (var label in editMappings[idx].RequiredLabels)
                                        {
                                            var lbl = label;
                                            <span class="badge bg-primary d-flex align-items-center gap-1" style="font-size: 0.8rem; padding: 0.3em 0.5em;">
                                                @lbl
                                                <i class="bi bi-x-lg" style="cursor:pointer; font-size:0.65rem;" @onclick="() => editMappings[idx].RequiredLabels.Remove(lbl)"></i>
                                            </span>
                                        }
                                    </div>
                                    <div class="input-group input-group-sm" style="max-width: 250px;">
                                        <input class="form-control" placeholder="Add label..." @bind="mappingLabelInputs[idx]"
                                               @onkeydown="(e) => OnMappingLabelKeyDown(e, idx)" />
                                        <button class="btn btn-outline-primary" type="button" @onclick="() => AddMappingLabel(idx)"><i class="bi bi-plus-lg"></i></button>
                                    </div>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" @bind="editMappings[idx].ProfileId">
                                        <option value="">— Select —</option>
                                        @foreach (var p in profiles)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" class="form-control form-control-sm" @bind="editMappings[idx].Priority" />
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-danger" @onclick="() => RemoveMapping(idx)"><i class="bi bi-trash3"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button class="btn btn-sm btn-outline-success mb-3" @onclick="AddMapping"><i class="bi bi-plus-lg me-1"></i> Add Mapping</button>

                <div class="alert alert-info py-2 d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                    <i class="bi bi-link-45deg"></i>
                    <span><strong>Webhook URL:</strong> <code>@(Navigation.BaseUri.TrimEnd('/'))api/webhooks/@(editRule.Provider.ToString().ToLowerInvariant())</code></span>
                </div>
            }

            @* --- Scheduled fields --- *@
            @if (editRule.Type == ProvisioningType.Scheduled)
            {
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Cron Expression</label>
                        <input class="form-control" @bind="editRule.CronExpression" placeholder="0 */5 * * *" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Desired Count</label>
                        <input type="number" class="form-control" @bind="editRule.DesiredCount" min="1" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Target Host</label>
                        <select class="form-select" @bind="editRule.TargetHostId">
                            <option value="">Auto (by labels)</option>
                            @foreach (var h in hosts)
                            {
                                <option value="@h.Id">@h.Label</option>
                            }
                        </select>
                    </div>
                </div>
            }

            @* --- Common fields (all types) --- *@
            <h6 class="mt-3">Host Targeting</h6>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Required Host Labels</label>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var kvp in editHostLabels)
                        {
                            var key = kvp.Key;
                            <span class="badge bg-secondary d-flex align-items-center gap-1" style="font-size: 0.85rem; padding: 0.4em 0.6em;">
                                @key=@kvp.Value
                                <i class="bi bi-x-lg" style="cursor:pointer; font-size:0.7rem;" @onclick="() => editHostLabels.Remove(key)"></i>
                            </span>
                        }
                    </div>
                    <div class="input-group input-group-sm" style="max-width: 350px;">
                        <input class="form-control" placeholder="key=value" @bind="newHostLabelInput" @onkeydown="OnHostLabelKeyDown" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="AddHostLabel"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Target Group</label>
                    <select class="form-select" @bind="editRule.TargetGroupId">
                        <option value="">— Any —</option>
                        @foreach (var g in hostGroups)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="editRule.Enabled" id="ruleEnabledCheck" />
                        <label class="form-check-label" for="ruleEnabledCheck">Enabled</label>
                    </div>
                </div>
            </div>

            <div>
                <button class="btn btn-success me-2" @onclick="SaveRule">Save</button>
                <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
            </div>
        </div>
    </div>
}

<div class="table-responsive">
<table class="table table-striped resizable-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Profile</th>
            <th>Scale</th>
            <th>Target</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rule in rules)
        {
            <tr>
                <td>
                    <strong>@rule.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(rule.Description))
                    {
                        <br /><small class="text-muted">@rule.Description</small>
                    }
                </td>
                <td>
                    <span class="badge @GetTypeBadgeClass(rule.Type)">@rule.Type</span>
                </td>
                <td>@GetProfileName(rule.ProfileId)</td>
                <td>@GetScaleDisplay(rule)</td>
                <td>@GetTargetDisplay(rule)</td>
                <td>
                    @if (rule.Enabled)
                    {
                        <span class="badge bg-success">Enabled</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Disabled</span>
                    }
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditRule(rule)"><i class="bi bi-pencil-square"></i> Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => ConfirmAndDeleteRule(rule)"><i class="bi bi-trash3"></i> Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<ProvisioningRule> rules = [];
    private List<RunnerProfile> profiles = [];
    private List<Host> hosts = [];
    private List<ProviderCredential> credentials = [];
    private List<string> hostGroups = [];

    private ProvisioningRule editRule = new() { Name = "" };
    private bool showForm;
    private bool isEditing;

    // Chip list state
    private List<string> editAllowedOrgs = [];
    private List<string> editAllowedRepos = [];
    private string newOrgInput = "";
    private string newRepoInput = "";
    private Dictionary<string, string> editHostLabels = new();
    private string newHostLabelInput = "";

    // Mapping editing state
    private List<LabelProfileMapping> editMappings = [];
    private List<string> mappingLabelInputs = [];

    protected override async Task OnInitializedAsync()
    {
        rules = (await Store.Query<ProvisioningRule>().ToList()).ToList();
        profiles = (await Store.Query<RunnerProfile>().ToList()).ToList();
        hosts = (await Store.Query<Host>().ToList()).ToList();
        credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();

        hostGroups = hosts
            .Where(h => !string.IsNullOrWhiteSpace(h.GroupId))
            .Select(h => h.GroupId!)
            .Distinct()
            .OrderBy(g => g)
            .ToList();
    }

    private void ShowCreateForm()
    {
        editRule = new ProvisioningRule { Name = "" };
        ResetFormState();
        isEditing = false;
        showForm = true;
    }

    private void EditRule(ProvisioningRule rule)
    {
        editRule = rule;
        editAllowedOrgs = [.. rule.AllowedOrgs];
        editAllowedRepos = [.. rule.AllowedRepos];
        editHostLabels = new Dictionary<string, string>(rule.RequiredHostLabels);
        editMappings = rule.LabelMappings.Select(m => new LabelProfileMapping
        {
            RequiredLabels = [.. m.RequiredLabels],
            ProfileId = m.ProfileId,
            Priority = m.Priority
        }).ToList();
        mappingLabelInputs = editMappings.Select(_ => "").ToList();
        newOrgInput = "";
        newRepoInput = "";
        newHostLabelInput = "";
        isEditing = true;
        showForm = true;
    }

    private void ResetFormState()
    {
        editAllowedOrgs = [];
        editAllowedRepos = [];
        editHostLabels = new();
        editMappings = [];
        mappingLabelInputs = [];
        newOrgInput = "";
        newRepoInput = "";
        newHostLabelInput = "";
    }

    private async Task SaveRule()
    {
        editRule.AllowedOrgs = [.. editAllowedOrgs];
        editRule.AllowedRepos = [.. editAllowedRepos];
        editRule.RequiredHostLabels = new Dictionary<string, string>(editHostLabels);
        editRule.LabelMappings = [.. editMappings];
        editRule.UpdatedAt = DateTime.UtcNow;

        if (isEditing)
            await Store.Update(editRule);
        else
            await Store.Insert(editRule);

        rules = (await Store.Query<ProvisioningRule>().ToList()).ToList();
        showForm = false;
    }

    private async Task ConfirmAndDeleteRule(ProvisioningRule rule)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete provisioning rule '{rule.Name}'?");
        if (confirmed)
        {
            await Store.Remove<ProvisioningRule>(rule.Id);
            rules = (await Store.Query<ProvisioningRule>().ToList()).ToList();
        }
    }

    private void OnTypeChanged() => StateHasChanged();
    private void OnProviderChanged() => StateHasChanged();

    // --- Org chip helpers ---
    private void AddOrg()
    {
        var val = newOrgInput?.Trim() ?? "";
        if (!string.IsNullOrWhiteSpace(val) && !editAllowedOrgs.Contains(val))
        {
            editAllowedOrgs.Add(val);
            newOrgInput = "";
        }
    }

    private void OnOrgKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "," or "Tab") AddOrg();
    }

    // --- Repo chip helpers ---
    private void AddRepo()
    {
        var val = newRepoInput?.Trim() ?? "";
        if (!string.IsNullOrWhiteSpace(val) && !editAllowedRepos.Contains(val))
        {
            editAllowedRepos.Add(val);
            newRepoInput = "";
        }
    }

    private void OnRepoKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "," or "Tab") AddRepo();
    }

    // --- Host label chip helpers ---
    private void AddHostLabel()
    {
        var val = newHostLabelInput?.Trim() ?? "";
        if (val.Contains('='))
        {
            var parts = val.Split('=', 2);
            var key = parts[0].Trim();
            var value = parts[1].Trim();
            if (!string.IsNullOrWhiteSpace(key))
            {
                editHostLabels[key] = value;
                newHostLabelInput = "";
            }
        }
    }

    private void OnHostLabelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter") AddHostLabel();
    }

    // --- Webhook secret ---
    private void GenerateSecret()
    {
        var bytes = new byte[16];
        System.Security.Cryptography.RandomNumberGenerator.Fill(bytes);
        editRule.WebhookSecret = Convert.ToHexString(bytes).ToLowerInvariant();
    }

    // --- Mapping helpers ---
    private void AddMapping()
    {
        editMappings.Add(new LabelProfileMapping());
        mappingLabelInputs.Add("");
    }

    private void RemoveMapping(int index)
    {
        editMappings.RemoveAt(index);
        mappingLabelInputs.RemoveAt(index);
    }

    private void AddMappingLabel(int index)
    {
        var val = mappingLabelInputs[index]?.Trim() ?? "";
        if (!string.IsNullOrWhiteSpace(val) && !editMappings[index].RequiredLabels.Contains(val))
        {
            editMappings[index].RequiredLabels.Add(val);
            mappingLabelInputs[index] = "";
        }
    }

    private void OnMappingLabelKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key is "Enter" or "," or "Tab") AddMappingLabel(index);
    }

    // --- Display helpers ---
    private string GetTypeBadgeClass(ProvisioningType type) => type switch
    {
        ProvisioningType.Static => "bg-secondary",
        ProvisioningType.ScaleSet => "bg-primary",
        ProvisioningType.Webhook => "bg-warning text-dark",
        ProvisioningType.Scheduled => "bg-info",
        _ => "bg-secondary"
    };

    private string GetProfileName(string? profileId) =>
        profiles.FirstOrDefault(p => p.Id == profileId)?.Name ?? "—";

    private string GetScaleDisplay(ProvisioningRule rule) => rule.Type switch
    {
        ProvisioningType.Static => $"×{rule.DesiredCount}",
        ProvisioningType.ScaleSet => $"Min {rule.MinReady} / Max {rule.MaxInstances}",
        ProvisioningType.Webhook => rule.MinReady > 0
            ? $"Max {rule.MaxConcurrent} (warm: {rule.MinReady})"
            : $"Max {rule.MaxConcurrent}",
        ProvisioningType.Scheduled => $"×{rule.DesiredCount}",
        _ => "—"
    };

    private string GetTargetDisplay(ProvisioningRule rule)
    {
        if (!string.IsNullOrWhiteSpace(rule.TargetHostId))
        {
            var host = hosts.FirstOrDefault(h => h.Id == rule.TargetHostId);
            return host?.Label ?? rule.TargetHostId;
        }
        if (!string.IsNullOrWhiteSpace(rule.TargetGroupId))
            return $"Group: {rule.TargetGroupId}";
        return "Auto";
    }
}
