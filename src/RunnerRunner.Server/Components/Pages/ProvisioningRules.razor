    private IEnumerable<ImageAutocompleteSource> GetImageConfigs(RegistryType registryType)
    {
        foreach (var profile in profiles)
        {
            if (registryType == RegistryType.Docker && profile.DockerConfig is { } docker)
                yield return new ImageAutocompleteSource(docker.RegistryUrl, docker.ImageName, docker.Tag, null, null);
            else if (registryType == RegistryType.Tart && profile.TartConfig is { } tart)
                yield return new ImageAutocompleteSource(tart.RegistryUrl, tart.ImageName, tart.Tag, tart.Display, tart.SshUser);
        }

        foreach (var runner in SavedRunnerDefinitions().Concat(editRule.RunnerDefinitions))
        {
            if (registryType == RegistryType.Docker && runner.DockerConfig is { } docker)
                yield return new ImageAutocompleteSource(docker.RegistryUrl, docker.ImageName, docker.Tag, null, null);
            else if (registryType == RegistryType.Tart && runner.TartConfig is { } tart)
                yield return new ImageAutocompleteSource(tart.RegistryUrl, tart.ImageName, tart.Tag, tart.Display, tart.SshUser);
        }
    }

    private static IReadOnlyList<string> OrderedDistinct(IEnumerable<string?> values) =>
        values
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private RegistryCredential? ResolveDockerRegistryCredential(DockerImageConfig docker)
    {
        if (!string.IsNullOrWhiteSpace(docker.CredentialId))
        {
            var explicitCredential = registryCredentials.FirstOrDefault(credential =>
                string.Equals(credential.Id, docker.CredentialId, StringComparison.OrdinalIgnoreCase)
                && credential.RegistryType == RegistryType.Docker);

            if (explicitCredential is not null)
                return explicitCredential;
        }

        return ResolveRegistryCredential(RegistryType.Docker, docker.RegistryUrl, docker.ImageName);
    }

    private RegistryCredential? ResolveRegistryCredential(RegistryType registryType, string? registryUrl, string? imageName)
    {
        var normalizedRegistry = NormalizeRegistryUrl(registryUrl);
        if (string.IsNullOrWhiteSpace(normalizedRegistry))
            return null;

        var registryMatches = registryCredentials
            .Where(credential =>
                credential.RegistryType == registryType
                && string.Equals(NormalizeRegistryUrl(credential.RegistryUrl), normalizedRegistry, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var normalizedImage = NormalizeImageName(imageName);
        var imageOrganization = GetImageOrganization(normalizedImage);
        if (!string.IsNullOrWhiteSpace(imageOrganization))
        {
            var organizationMatch = registryMatches.FirstOrDefault(credential =>
                !string.IsNullOrWhiteSpace(credential.DefaultNamespace)
                && string.Equals(credential.DefaultNamespace, imageOrganization, StringComparison.OrdinalIgnoreCase));

            if (organizationMatch is not null)
                return organizationMatch;
        }

        var imageOwner = GetImageOwner(normalizedImage);
        if (!string.IsNullOrWhiteSpace(imageOwner))
        {
            var ownerMatch = registryMatches.FirstOrDefault(credential =>
                !string.IsNullOrWhiteSpace(credential.DefaultNamespace)
                && string.Equals(credential.DefaultNamespace, imageOwner, StringComparison.OrdinalIgnoreCase));

            if (ownerMatch is not null)
                return ownerMatch;
        }

        var configuredCredential = registryMatches.FirstOrDefault(credential => credential.IsDefault)
            ?? registryMatches.FirstOrDefault(credential => !string.IsNullOrWhiteSpace(credential.Username) || !string.IsNullOrWhiteSpace(credential.Password))
            ?? registryMatches.FirstOrDefault();

        if (configuredCredential is not null)
            return configuredCredential;

        return new RegistryCredential
        {
            Id = $"inline-{registryType}-{normalizedRegistry.ToLowerInvariant()}",
            Name = normalizedRegistry,
            RegistryUrl = normalizedRegistry,
            RegistryType = registryType
        };
    }

    private static string BuildImageTagSuggestionKey(RegistryType registryType, string? registryUrl, string? imageName) =>
        $"{registryType}:{NormalizeRegistryUrl(registryUrl).ToLowerInvariant()}:{NormalizeImageName(imageName).ToLowerInvariant()}";

    private static string NormalizeRegistryUrl(string? registryUrl)
    {
        if (string.IsNullOrWhiteSpace(registryUrl))
            return string.Empty;

        var trimmed = registryUrl.Trim().TrimEnd('/');
        if (Uri.TryCreate(trimmed, UriKind.Absolute, out var absolute) && !string.IsNullOrWhiteSpace(absolute.Authority))
            return absolute.Authority;

        return trimmed
            .Replace("https://", "", StringComparison.OrdinalIgnoreCase)
            .Replace("http://", "", StringComparison.OrdinalIgnoreCase)
            .TrimEnd('/');
    }

    private static string NormalizeImageName(string? imageName) =>
        (imageName ?? "").Trim().Trim('/').Replace("\\", "/");

    private static string? GetImageOrganization(string imageName)
    {
        var lastSlash = imageName.LastIndexOf('/');
        return lastSlash > 0 ? imageName[..lastSlash] : null;
    }

    private static string? GetImageOwner(string imageName)
    {
        var firstSlash = imageName.IndexOf('/');
        return firstSlash > 0 ? imageName[..firstSlash] : null;
    }

