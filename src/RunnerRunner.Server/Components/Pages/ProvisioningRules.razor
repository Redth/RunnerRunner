@page "/provisioning-rules"
@attribute [Authorize(Policy = RunnerRunnerPolicies.ManageProfiles)]
@rendermode InteractiveServer
@using Shiny.DocumentDb
@using RunnerRunner.Core.Models
@using RunnerRunner.Server.Services
@inject IDocumentStore Store
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CapacityPlanningService CapacityService
@inject ProvisioningRuleGrainSyncService RuleGrainSync
@inject IRegistryCatalogService RegistryCatalog

<PageTitle>Provisioning Rules - RunnerRunner</PageTitle>
<SectionContent SectionName="page-header">
    <div class="page-header">
        <h1><i class="bi bi-diagram-3-fill"></i> Provisioning Rules</h1>
        <span class="page-desc">Define what workflows request and where RunnerRunner may place them.</span>
    </div>
</SectionContent>

<div class="provisioning-hero mb-3">
    <div>
        <div class="provisioning-eyebrow">Provisioning control</div>
        <h2>Turn CI demand into ready runners.</h2>
        <p>Choose the provider credential, webhook scope, runner targets, provider visibility, host routing, custom steps, and capacity limits for static pools, scale sets, and webhook-triggered jobs.</p>
    </div>
    <div class="provisioning-hero-actions">
        <button class="btn btn-primary" @onclick="ShowCreateForm"><i class="bi bi-plus-lg me-1"></i>New rule</button>
        <a class="btn btn-outline-secondary" href="/webhook-events"><i class="bi bi-clock-history me-1"></i>Event audit</a>
        <a class="btn btn-outline-secondary" href="/custom-steps"><i class="bi bi-code-slash me-1"></i>Custom steps</a>
    </div>
</div>

<div class="provisioning-metric-grid mb-3" aria-label="Provisioning rule summary">
    <div class="provisioning-metric-card">
        <span>Enabled rules</span>
        <strong>@rules.Count(r => r.Enabled)</strong>
        <small>@rules.Count total</small>
    </div>
    <div class="provisioning-metric-card">
        <span>Runner targets</span>
        <strong>@rules.Sum(rule => GetDisplayRunnerDefinitions(rule).Count)</strong>
        <small>owned by rules</small>
    </div>
    <div class="provisioning-metric-card">
        <span>Matching hosts</span>
        <strong>@hosts.Count(h => h.AgentStatus == AgentStatus.Online)</strong>
        <small>@hosts.Count registered</small>
    </div>
    <div class="provisioning-metric-card">
        <span>Webhook rules</span>
        <strong>@rules.Count(r => r.Type == ProvisioningType.Webhook)</strong>
        <small>event driven</small>
    </div>
</div>

@if (showForm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block rr-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="provisioning-rule-title">
        <div class="modal-dialog modal-xxl modal-dialog-scrollable" role="document" @onclick:stopPropagation="true">
            <div class="modal-content provisioning-builder-modal">
                <div class="modal-header">
                    <div>
                        <h5 id="provisioning-rule-title" class="modal-title">
                            <i class="bi bi-diagram-3-fill me-2"></i>@(isEditing ? "Edit" : "Create") provisioning rule
                        </h5>
                        <div class="modal-kicker">Define the CI connection, rule capacity, global host routing, and the runner targets workflow authors can request.</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CancelEdit" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger py-2" role="alert">@formError</div>
                    }

                    <div class="rule-builder-grid">
                        <div class="rule-builder-main">
                            <section class="rr-form-section">
                                <div class="rr-form-section-title"><i class="bi bi-sliders"></i>Rule basics</div>
                                <div class="row g-3">
                                    <div class="col-lg-5">
                                        <label class="form-label" for="ruleName">Name</label>
                                        <input id="ruleName" class="form-control" @bind="editRule.Name" />
                                    </div>
                                    <div class="col-lg-4">
                                        <label class="form-label" for="ruleDescription">Description</label>
                                        <input id="ruleDescription" class="form-control" @bind="editRule.Description" />
                                    </div>
                                    <div class="col-lg-3">
                                        <label class="form-label" for="ruleType">Provisioning type</label>
                                        <select id="ruleType" class="form-select" @bind="editRule.Type" @bind:after="OnTypeChanged">
                                            @foreach (var type in SupportedProvisioningTypes)
                                            {
                                                <option value="@type">@GetTypeLabel(type)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-4">
                                        <label class="form-label" for="ruleProvider">Provider</label>
                                        <select id="ruleProvider" class="form-select" @bind="editRule.Provider" @bind:after="OnProviderChanged">
                                            @foreach (var provider in Enum.GetValues<RunnerProvider>())
                                            {
                                                <option value="@provider">@GetProviderLabel(provider)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-5">
                                        <label class="form-label" for="ruleCredential">Provider credential</label>
                                        <select id="ruleCredential" class="form-select" @bind="editRule.ProviderCredentialId" @bind:after="OnProviderCredentialChanged">
                                            <option value="">No credential selected</option>
                                            @foreach (var credential in credentials.Where(c => c.Provider == editRule.Provider).OrderBy(c => c.Name))
                                            {
                                                <option value="@credential.Id">@credential.Name</option>
                                            }
                                        </select>
                                        <div class="form-text">The rule credential is used for runner registration, JIT config, cleanup, and provider API calls.</div>
                                    </div>
                                    <div class="col-lg-3 d-flex align-items-end">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="ruleEnabledCheck" @bind="editRule.Enabled" />
                                            <label class="form-check-label" for="ruleEnabledCheck">Rule enabled</label>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            @if (editRule.Type == ProvisioningType.Webhook)
                            {
                                <section class="rr-form-section">
                                    <div class="rr-form-section-title"><i class="bi bi-broadcast-pin"></i>Webhook scope</div>
                                    @if (UsesGitHubAppCredential())
                                    {
                                        <div class="alert alert-info py-2">
                                            <i class="bi bi-github me-1"></i>
                                            Using the selected GitHub App credential's webhook secret and endpoint setup. Runner API calls use the installation ID from each webhook event.
                                        </div>

                                        <details class="advanced-compatibility webhook-app-advanced">
                                            <summary><i class="bi bi-sliders2"></i>Webhook secret override and endpoint</summary>
                                            <p class="form-text mb-3">Only expand this if you need to override the GitHub App credential secret or inspect the endpoint URL.</p>
                                            <div class="row g-3">
                                                <div class="col-lg-7">
                                                    <label class="form-label" for="webhookSecret">Webhook secret override</label>
                                                    <div class="input-group">
                                                        <input id="webhookSecret" class="form-control" @bind="editRule.WebhookSecret" autocomplete="off" />
                                                        <button class="btn btn-outline-secondary" type="button" @onclick="GenerateSecret">Generate</button>
                                                    </div>
                                                    <div class="form-text">Leave blank to use the selected GitHub App credential's webhook secret.</div>
                                                </div>
                                                <div class="col-lg-5">
                                                    <label class="form-label">Webhook endpoint</label>
                                                    <div class="webhook-url-card">
                                                        @if (TryGetWebhookEndpoint(editRule.Provider, out var endpoint))
                                                        {
                                                            <i class="bi bi-link-45deg"></i>
                                                            <code>@endpoint</code>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-exclamation-triangle"></i>
                                                            <span>No webhook ingress for @editRule.Provider.</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </details>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            <div class="col-lg-7">
                                                <label class="form-label" for="webhookSecret">Webhook secret</label>
                                                <div class="input-group">
                                                    <input id="webhookSecret" class="form-control" @bind="editRule.WebhookSecret" autocomplete="off" />
                                                    <button class="btn btn-outline-secondary" type="button" @onclick="GenerateSecret">Generate</button>
                                                </div>
                                            </div>
                                            <div class="col-lg-5">
                                                <label class="form-label">Webhook endpoint</label>
                                                <div class="webhook-url-card">
                                                    @if (TryGetWebhookEndpoint(editRule.Provider, out var endpoint))
                                                    {
                                                        <i class="bi bi-link-45deg"></i>
                                                        <code>@endpoint</code>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-exclamation-triangle"></i>
                                                        <span>No webhook ingress for @editRule.Provider.</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="row g-3 mt-1">
                                        <div class="col-lg-6">
                                             <label class="form-label">Allowed owners / orgs</label>
                                             <div class="runner-chip-list">
                                                @if (editAllowedOrgs.Count == 0)
                                                {
                                                    <span class="runner-chip runner-chip-placeholder" title="No owner or org filter">
                                                        <i class="bi bi-buildings"></i>Any
                                                    </span>
                                                }
                                                else
                                                {
                                                    @foreach (var org in editAllowedOrgs.ToList())
                                                    {
                                                        <span class="runner-chip">
                                                            <i class="bi bi-buildings"></i>@org
                                                            <button type="button" @onclick="() => editAllowedOrgs.Remove(org)" aria-label="Remove owner @org"><i class="bi bi-x"></i></button>
                                                        </span>
                                                    }
                                                }
                                            </div>
                                            <div class="input-group input-group-sm mt-2">
                                                <SmartAutocomplete Value="@newOrgInput"
                                                                   ValueChanged="value => newOrgInput = value ?? string.Empty"
                                                                   Suggestions="@GetAllowedOrgSuggestions()"
                                                                   Placeholder="Add owner or org..."
                                                                   AriaLabel="Allowed owner or org" />
                                                <button class="btn btn-outline-primary" type="button" @onclick="AddOrg"><i class="bi bi-plus-lg"></i></button>
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                             <label class="form-label">Allowed repos</label>
                                             <div class="runner-chip-list">
                                                @if (editAllowedRepos.Count == 0)
                                                {
                                                    <span class="runner-chip runner-chip-placeholder" title="No repository filter">
                                                        <i class="bi bi-git"></i>Any
                                                    </span>
                                                }
                                                else
                                                {
                                                    @foreach (var repo in editAllowedRepos.ToList())
                                                    {
                                                        <span class="runner-chip">
                                                            <i class="bi bi-git"></i>@repo
                                                            <button type="button" @onclick="() => editAllowedRepos.Remove(repo)" aria-label="Remove repo @repo"><i class="bi bi-x"></i></button>
                                                        </span>
                                                    }
                                                }
                                            </div>
                                            <div class="input-group input-group-sm mt-2">
                                                <SmartAutocomplete Value="@newRepoInput"
                                                                   ValueChanged="value => newRepoInput = value ?? string.Empty"
                                                                   Suggestions="@GetAllowedRepoSuggestions()"
                                                                   Placeholder="Add org/repo..."
                                                                   AriaLabel="Allowed repository" />
                                                <button class="btn btn-outline-primary" type="button" @onclick="AddRepo"><i class="bi bi-plus-lg"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-text mt-2">Leave both lists empty to allow any repository accepted by the webhook credential.</div>
                                </section>
                            }

                            <section class="rr-form-section">
                                <details class="global-host-routing-panel">
                                    <summary>
                                        <span><i class="bi bi-hdd-network"></i>Global host routing</span>
                                        <small>@GetEditTargetDisplay()</small>
                                    </summary>
                                    <p class="section-help mb-3">Optional rule-wide placement filters. They are applied before each runner target's own host routing, so put target-specific capabilities like <code>windows-ui</code> on the target below.</p>
                                    <div class="row g-3">
                                        <div class="col-lg-5">
                                            <label class="form-label" for="targetGroup">Host routing group</label>
                                            <SmartAutocomplete Value="@editRule.TargetGroupId"
                                                               ValueChanged="value => editRule.TargetGroupId = string.IsNullOrWhiteSpace(value) ? null : value"
                                                               Suggestions="@GetHostGroupSuggestions()"
                                                               Placeholder="Any host routing group"
                                                               AriaLabel="Host routing group" />
                                        </div>
                                        <div class="col-lg-7">
                                            <label class="form-label">Global host labels</label>
                                            <div class="runner-chip-list mb-2">
                                                @foreach (var requirement in editHostLabels.OrderBy(kvp => kvp.Key))
                                                {
                                                    var key = requirement.Key;
                                                    <span class="runner-chip">
                                                        <i class="bi bi-tag"></i>@key=@requirement.Value
                                                        <button type="button" @onclick="() => editHostLabels.Remove(key)" aria-label="Remove host label @key"><i class="bi bi-x"></i></button>
                                                    </span>
                                                }
                                            </div>
                                            <div class="input-group input-group-sm">
                                                <SmartAutocomplete Value="@newHostLabelInput"
                                                                   ValueChanged="value => newHostLabelInput = value ?? string.Empty"
                                                                   Suggestions="@GetHostCapabilityLabelSuggestions()"
                                                                   Placeholder="pool=mac-builders"
                                                                   AriaLabel="Global required host label" />
                                                <button class="btn btn-outline-secondary" type="button" @onclick="AddHostLabel"><i class="bi bi-plus-lg me-1"></i>Add</button>
                                            </div>
                                        </div>
                                    </div>
                                </details>
                            </section>

                            @if (editRule.Type == ProvisioningType.Webhook)
                            {
                                <section class="rr-form-section">
                                    <details class="global-host-routing-panel global-capacity-panel">
                                        <summary>
                                            <span><i class="bi bi-speedometer2"></i>Global capacity</span>
                                            <small>@GetGlobalCapacityDisplay()</small>
                                        </summary>
                                        <p class="section-help mb-3">Optional rule-wide concurrency across all runner targets. Leave it at 0 for unlimited jobs, constrained only by target and host capacity.</p>
                                        <div class="capacity-control-grid">
                                            <div>
                                                <label class="form-label" for="maxConcurrent">Max concurrent jobs</label>
                                                <input id="maxConcurrent" type="number" class="form-control" @bind="editRule.MaxConcurrent" min="0" />
                                                <div class="form-text">0 means unlimited across every target in this rule.</div>
                                            </div>
                                        </div>
                                    </details>
                                </section>
                            }

                            <section class="rr-form-section runner-definition-section">
                                <div class="section-title-row">
                                    <div>
                                        <div class="rr-form-section-title mb-1"><i class="bi bi-cpu"></i>Runner targets</div>
                                        <p class="section-help">Each target has one workflow selector key plus the platform/backend, labels, environment, image, lifecycle, and custom steps this rule can provision.</p>
                                    </div>
                                    @if (editRule.Type == ProvisioningType.Webhook)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddRunnerDefinition"><i class="bi bi-plus-lg me-1"></i>Add target</button>
                                    }
                                </div>

                                <div class="runner-definition-stack">
                                    @for (var runnerIndex = 0; runnerIndex < editRule.RunnerDefinitions.Count; runnerIndex++)
                                    {
                                         var idx = runnerIndex;
                                         var runner = editRule.RunnerDefinitions[idx];
                                         EnsureRunnerEditorState(runner);
                                         var isCollapsed = IsRunnerDefinitionCollapsed(runner);
                                         <article class="runner-definition-card" @key="runner.Id">
                                             <div class="runner-definition-header">
                                                 <div>
                                                    <div class="runner-card-kicker">@GetRunnerCardKicker(runner)</div>
                                                    <h3>@(string.IsNullOrWhiteSpace(runner.Name) ? "Unnamed runner" : runner.Name)</h3>
                                                 </div>
                                                 <div class="runner-definition-actions">
                                                     <span class="badge @(runner.Enabled ? "bg-success" : "bg-secondary")">@(runner.Enabled ? "Enabled" : "Disabled")</span>
                                                     <button class="btn btn-sm btn-outline-secondary runner-collapse-toggle"
                                                             type="button"
                                                             @onclick="() => ToggleRunnerDefinitionCollapsed(runner)"
                                                             aria-expanded="@(!isCollapsed)"
                                                             aria-controls="runner-body-@runner.Id">
                                                         <i class="bi @(isCollapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
                                                         @(isCollapsed ? "Expand" : "Collapse")
                                                     </button>
                                                     @if (editRule.Type == ProvisioningType.Webhook && editRule.RunnerDefinitions.Count > 1)
                                                     {
                                                         <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveRunnerDefinition(idx)" aria-label="Remove runner @runner.Name"><i class="bi bi-trash3"></i></button>
                                                     }
                                                 </div>
                                             </div>

                                             @if (!isCollapsed)
                                             {
                                                 <div id="runner-body-@runner.Id" class="runner-definition-body">
                                             <div class="row g-3">
                                                 <div class="col-lg-3">
                                                     <label class="form-label" for="runnerName-@runner.Id">Target name</label>
                                                    <input id="runnerName-@runner.Id" class="form-control" @bind="runner.Name" />
                                                </div>
                                                <div class="col-lg-3">
                                                    <label class="form-label" for="runnerTargetKey-@runner.Id">Workflow target key</label>
                                                    <SmartAutocomplete Value="@runner.TargetKey"
                                                                       ValueChanged="value => runner.TargetKey = value ?? string.Empty"
                                                                       Suggestions="@GetTargetKeySuggestions(runner)"
                                                                       Placeholder="rr-linux-docker"
                                                                       AriaLabel="Workflow target key"
                                                                       CssClass="rr-autocomplete rr-autocomplete-mono" />
                                                </div>
                                                <div class="col-lg-4">
                                                    <label class="form-label" for="runnerDescription-@runner.Id">Description</label>
                                                    <input id="runnerDescription-@runner.Id" class="form-control" @bind="runner.Description" />
                                                </div>
                                                <div class="col-lg-2 d-flex align-items-end">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" role="switch" id="runnerEnabled-@runner.Id" @bind="runner.Enabled" />
                                                        <label class="form-check-label" for="runnerEnabled-@runner.Id">Enabled</label>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (editRule.Type == ProvisioningType.Webhook)
                                            {
                                                <div class="target-selector-callout">
                                                    <span>Workflow selector</span>
                                                    <code>@runner.TargetKey</code>
                                                    <small>@GetInlineWorkflowHint(runner)</small>
                                                </div>

                                                <details class="advanced-compatibility">
                                                    <summary><i class="bi bi-sliders2"></i>Advanced compatibility label matchers</summary>
                                                    <p class="form-text mb-3">Only use these to keep older workflows working while they migrate to the target key above.</p>
                                                    <div class="runner-subsection-heading">
                                                        <span><i class="bi bi-funnel"></i>Legacy label matchers</span>
                                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => AddMatcher(runner)"><i class="bi bi-plus-lg me-1"></i>Add matcher</button>
                                                    </div>
                                                    <div class="matcher-grid">
                                                        @for (var matcherIndex = 0; matcherIndex < runner.Matchers.Count; matcherIndex++)
                                                        {
                                                            var matcherIdx = matcherIndex;
                                                            var matcher = runner.Matchers[matcherIdx];
                                                            EnsureMatcherEditorState(matcher);
                                                            <div class="matcher-card" @key="matcher.Id">
                                                                <div class="matcher-card-header">
                                                                    <strong>Priority @matcher.Priority</strong>
                                                                    <div class="matcher-actions">
                                                                        <div class="form-check form-switch">
                                                                            <input class="form-check-input" type="checkbox" role="switch" id="matcherEnabled-@matcher.Id" @bind="matcher.Enabled" />
                                                                            <label class="form-check-label" for="matcherEnabled-@matcher.Id">Enabled</label>
                                                                        </div>
                                                                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveMatcher(runner, matcherIdx)" aria-label="Remove matcher"><i class="bi bi-x-lg"></i></button>
                                                                    </div>
                                                                </div>
                                                                <label class="form-label" for="matcherPriority-@matcher.Id">Priority</label>
                                                                <input id="matcherPriority-@matcher.Id" type="number" class="form-control form-control-sm matcher-priority" @bind="matcher.Priority" />
                                                                <div class="runner-chip-list mt-2">
                                                                    @foreach (var label in matcher.RequiredLabels.ToList())
                                                                    {
                                                                        var labelValue = label;
                                                                        <span class="runner-chip">
                                                                            <i class="bi bi-tag-fill"></i>@labelValue
                                                                            <button type="button" @onclick="() => matcher.RequiredLabels.Remove(labelValue)" aria-label="Remove matcher label @labelValue"><i class="bi bi-x"></i></button>
                                                                        </span>
                                                                    }
                                                                </div>
                                                                <div class="input-group input-group-sm mt-2">
                                                                    <SmartAutocomplete Value="@matcherLabelInputs[matcher.Id]"
                                                                                       ValueChanged="value => matcherLabelInputs[matcher.Id] = value ?? string.Empty"
                                                                                       Suggestions="@GetMatcherLabelSuggestions(runner)"
                                                                                       Placeholder="self-hosted, mac*, *"
                                                                                       AriaLabel="Legacy matcher label" />
                                                                    <button class="btn btn-outline-primary" type="button" @onclick="() => AddMatcherLabel(matcher)"><i class="bi bi-plus-lg"></i></button>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </details>
                                             }

                                             <div class="runner-subsection">
                                                 <div class="runner-subsection-heading"><span><i class="bi bi-speedometer2"></i>Capacity and lifecycle</span></div>
                                                 <div class="capacity-control-grid">
                                                     @if (editRule.Type == ProvisioningType.Static)
                                                     {
                                                         <div>
                                                             <label class="form-label" for="desiredCount-@runner.Id">Desired runners</label>
                                                             <input id="desiredCount-@runner.Id" type="number" class="form-control" @bind="runner.DesiredCount" min="0" />
                                                             <div class="form-text">Keep this many runners alive for this target.</div>
                                                         </div>
                                                     }
                                                     else if (editRule.Type == ProvisioningType.ScaleSet)
                                                     {
                                                         <div>
                                                             <label class="form-label" for="minReady-@runner.Id">Warm runners</label>
                                                             <input id="minReady-@runner.Id" type="number" class="form-control" @bind="runner.MinReady" min="0" />
                                                         </div>
                                                         <div>
                                                             <label class="form-label" for="maxInstances-@runner.Id">Max instances</label>
                                                             <input id="maxInstances-@runner.Id" type="number" class="form-control" @bind="runner.MaxInstances" min="1" />
                                                         </div>
                                                         <div>
                                                             <label class="form-label" for="scaleDownDelay-@runner.Id">Scale-down delay</label>
                                                             <input id="scaleDownDelay-@runner.Id" type="number" class="form-control" @bind="runner.ScaleDownDelaySeconds" min="0" />
                                                             <div class="form-text">Seconds to wait before retiring idle target capacity.</div>
                                                         </div>
                                                     }
                                                     else
                                                     {
                                                         <div>
                                                             <label class="form-label" for="webhookWarm-@runner.Id">Warm runners</label>
                                                             <input id="webhookWarm-@runner.Id" type="number" class="form-control" @bind="runner.MinReady" min="0" />
                                                             <div class="form-text">Optional idle runners to pre-provision for this target.</div>
                                                         </div>
                                                         <div>
                                                             <label class="form-label" for="cooldownSeconds-@runner.Id">Cooldown seconds</label>
                                                             <input id="cooldownSeconds-@runner.Id" type="number" class="form-control" @bind="runner.CooldownSeconds" min="0" />
                                                             <div class="form-text">Delay before this target retires idle capacity.</div>
                                                         </div>
                                                     }
                                                 </div>

                                                 <div class="lifecycle-choice-grid mt-3" role="radiogroup" aria-label="Runner lifecycle">
                                                     <label class="lifecycle-choice @(runner.Ephemeral ? "selected" : "")" for="oneJob-@runner.Id">
                                                         <input id="oneJob-@runner.Id" type="radio" name="lifecycle-@runner.Id" checked="@runner.Ephemeral" @onchange="() => runner.Ephemeral = true" />
                                                         <span>
                                                             <strong>One-job runner</strong>
                                                             <small>Recommended. Fresh registration/resource per job, then deregister and dispose.</small>
                                                         </span>
                                                     </label>
                                                     <label class="lifecycle-choice @(!runner.Ephemeral ? "selected" : "")" for="reusable-@runner.Id">
                                                         <input id="reusable-@runner.Id" type="radio" name="lifecycle-@runner.Id" checked="@(!runner.Ephemeral)" @onchange="() => runner.Ephemeral = false" />
                                                         <span>
                                                             <strong>Reusable runner</strong>
                                                             <small>Explicit warm/static mode. Local state can persist between jobs.</small>
                                                         </span>
                                                     </label>
                                                 </div>
                                             </div>

                                             <div class="runner-subsection">
                                                 <div class="runner-subsection-heading"><span><i class="bi bi-hdd-stack"></i>Execution shape</span></div>
                                                 <div class="row g-3">
                                                    <div class="col-lg-3">
                                                        <label class="form-label" for="platform-@runner.Id">Target platform</label>
                                                        <select id="platform-@runner.Id" class="form-select" @bind="runner.RequiredHostPlatform">
                                                            @foreach (var platform in Enum.GetValues<HostPlatform>())
                                                            {
                                                                <option value="@platform">@platform</option>
                                                            }
                                                        </select>
                                                        <div class="form-text">Runner environment OS. Docker targets match compatible Docker engine OS.</div>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        <label class="form-label" for="backend-@runner.Id">Backend</label>
                                                        <select id="backend-@runner.Id" class="form-select" value="@runner.ExecutionBackend" @onchange="e => SetRunnerBackend(runner, e.Value?.ToString())">
                                                            @foreach (var backend in Enum.GetValues<ExecutionBackend>())
                                                            {
                                                                <option value="@backend">@backend</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-lg-3">
                                                    <label class="form-label" for="runnerGroup-@runner.Id">@GetProviderGroupFieldLabel()</label>
                                                    <SmartAutocomplete Value="@runner.RunnerGroup"
                                                                       ValueChanged="value => runner.RunnerGroup = value ?? string.Empty"
                                                                       Suggestions="@GetProviderGroupSuggestions()"
                                                                       Placeholder="Default"
                                                                       AriaLabel="@GetProviderGroupFieldLabel()" />
                                                    <div class="form-text">@GetProviderGroupFieldHelp()</div>
                                                    </div>
                                                    <div class="col-lg-3">
                                                        <label class="form-label" for="runnerAgentVersion-@runner.Id">Agent version</label>
                                                        <input id="runnerAgentVersion-@runner.Id" class="form-control" @bind="runner.RunnerAgentVersion" placeholder="latest" />
                                                    </div>
                                                </div>
                                             </div>

                                            <div class="runner-subsection">
                                                <div class="runner-subsection-heading"><span><i class="bi bi-hdd-network"></i>Host routing for this target</span></div>
                                                <div class="form-text mb-2">Target-specific placement filters are combined with the rule's global host routing.</div>
                                                <div class="row g-3">
                                                    <div class="col-lg-4">
                                                        <label class="form-label" for="runnerTargetGroup-@runner.Id">Host routing group</label>
                                                        <SmartAutocomplete Value="@runner.TargetGroupId"
                                                                           ValueChanged="value => runner.TargetGroupId = string.IsNullOrWhiteSpace(value) ? null : value"
                                                                           Suggestions="@GetHostGroupSuggestions()"
                                                                           Placeholder="Any host routing group"
                                                                           AriaLabel="Target host routing group" />
                                                    </div>
                                                    <div class="col-lg-8">
                                                        <label class="form-label">Required HostWorker capabilities</label>
                                                        <div class="runner-chip-list mb-2">
                                                            @if (runner.RequiredHostCapabilities.Count == 0)
                                                            {
                                                                <span class="runner-chip runner-chip-placeholder" title="No required HostWorker capability filter">
                                                                    <i class="bi bi-stars"></i>any
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var capability in runner.RequiredHostCapabilities.ToList())
                                                                {
                                                                    var capabilityValue = capability;
                                                                    <span class="runner-chip">
                                                                        <i class="bi bi-stars"></i>@capabilityValue
                                                                        <button type="button" @onclick="() => runner.RequiredHostCapabilities.Remove(capabilityValue)" aria-label="Remove required host capability @capabilityValue"><i class="bi bi-x"></i></button>
                                                                    </span>
                                                                }
                                                            }
                                                        </div>
                                                        <div class="input-group input-group-sm runner-label-input">
                                                            <SmartAutocomplete Value="@runnerHostCapabilityInputs[runner.Id]"
                                                                               ValueChanged="value => runnerHostCapabilityInputs[runner.Id] = value ?? string.Empty"
                                                                               Suggestions="@GetRunnerHostCapabilitySuggestions(runner)"
                                                                               Placeholder="windows-ui, gpu, xcode16"
                                                                               AriaLabel="Required HostWorker capability" />
                                                            <button class="btn btn-outline-primary" type="button" @onclick="() => AddRunnerHostCapability(runner)"><i class="bi bi-plus-lg me-1"></i>Add capability</button>
                                                        </div>
                                                    </div>
                                                </div>
                                                @{
                                                    var hostPreview = GetHostMatchPreviewForRunner(runner);
                                                }
                                                <div class="host-match-preview host-match-preview-inline">
                                                    <div class="host-match-preview-header">
                                                        <span><i class="bi bi-radar"></i>Calculated host set</span>
                                                        <small>Global routing + platform/backend compatibility + target routing.</small>
                                                    </div>
                                                    <article class="host-match-card @(hostPreview.Hosts.Count == 0 ? "empty" : "")">
                                                        <div class="host-match-card-title">
                                                            <strong>@runner.Name</strong>
                                                            <span>@hostPreview.Hosts.Count host(s)</span>
                                                        </div>
                                                        <small>@runner.RequiredHostPlatform · @runner.ExecutionBackend · @GetRunnerHostRoutingDisplay(runner)</small>
                                                        @if (hostPreview.Hosts.Count == 0)
                                                        {
                                                            <p><strong>No possible hosts.</strong> @hostPreview.EmptyReason</p>
                                                        }
                                                        else
                                                        {
                                                            <div class="host-match-list">
                                                                @foreach (var host in hostPreview.Hosts.Take(6))
                                                                {
                                                                    <span class="host-match-pill @(host.AgentStatus == AgentStatus.Online ? "online" : "")">
                                                                        <i class="bi @GetPlatformIcon(host.Platform)"></i>@host.Label
                                                                    </span>
                                                                }
                                                                @if (hostPreview.Hosts.Count > 6)
                                                                {
                                                                    <span class="host-match-pill muted">+@(hostPreview.Hosts.Count - 6) more</span>
                                                                }
                                                            </div>
                                                        }
                                                    </article>
                                                </div>
                                            </div>

                                            <div class="runner-subsection">
                                                <div class="runner-subsection-heading"><span><i class="bi bi-tags"></i>Advertised labels / capabilities</span></div>
                                                <div class="form-text mb-2">Extra provider metadata attached to created runners after the workflow target has selected this runner.</div>
                                                <div class="runner-chip-list mb-2">
                                                    @foreach (var label in runner.Labels.ToList())
                                                    {
                                                        var labelValue = label;
                                                        <span class="runner-chip">
                                                            <i class="bi bi-tag"></i>@labelValue
                                                            <button type="button" @onclick="() => runner.Labels.Remove(labelValue)" aria-label="Remove runner label @labelValue"><i class="bi bi-x"></i></button>
                                                        </span>
                                                    }
                                                </div>
                                                <div class="input-group input-group-sm runner-label-input">
                                                    <SmartAutocomplete Value="@runnerLabelInputs[runner.Id]"
                                                                       ValueChanged="value => runnerLabelInputs[runner.Id] = value ?? string.Empty"
                                                                       Suggestions="@GetRunnerLabelSuggestions(runner)"
                                                                       Placeholder="linux, docker, x64"
                                                                       AriaLabel="Advertised runner label" />
                                                    <button class="btn btn-outline-primary" type="button" @onclick="() => AddRunnerLabel(runner)"><i class="bi bi-plus-lg me-1"></i>Add label</button>
                                                </div>
                                            </div>

                                            @if (runner.ExecutionBackend == ExecutionBackend.Docker)
                                            {
                                                var docker = EnsureDockerConfig(runner);
                                                <div class="runner-subsection">
                                                    <div class="runner-subsection-heading">
                                                        <span><i class="bi bi-box-seam"></i>Docker image</span>
                                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenImagePicker(runner, RegistryType.Docker)">
                                                            <i class="bi bi-search me-1"></i>Find image
                                                        </button>
                                                    </div>
                                                    @if (runner.RequiredHostPlatform == HostPlatform.Windows)
                                                    {
                                                        <div class="alert alert-warning py-2">
                                                            <i class="bi bi-windows me-1"></i>Use a Windows container image and target hosts reporting <code>docker_os=windows</code>.
                                                        </div>
                                                    }
                                                    <div class="row g-3">
                                                        <div class="col-lg-4">
                                                            <label class="form-label" for="dockerRegistry-@runner.Id">Registry</label>
                                                            <SmartAutocomplete Value="@docker.RegistryUrl"
                                                                               ValueChanged="@(value => OnDockerRegistryChangedAsync(docker, value))"
                                                                               Suggestions="@GetRegistrySuggestions(RegistryType.Docker)"
                                                                               Placeholder="ghcr.io"
                                                                               AriaLabel="Docker registry" />
                                                        </div>
                                                        <div class="col-lg-8">
                                                            <label class="form-label" for="dockerImage-@runner.Id">Image</label>
                                                            <SmartAutocomplete Value="@docker.ImageName"
                                                                               ValueChanged="@(value => OnDockerImageNameChangedAsync(docker, value))"
                                                                               Suggestions="@GetImageNameSuggestions(RegistryType.Docker)"
                                                                               Placeholder="org/runner-image"
                                                                               AriaLabel="Docker image" />
                                                        </div>
                                                        <div class="col-lg-8">
                                                            <label class="form-label" for="dockerTag-@runner.Id">Tag</label>
                                                            <SmartAutocomplete Value="@docker.Tag"
                                                                               ValueChanged="value => docker.Tag = value ?? string.Empty"
                                                                               Suggestions="@GetImageTagSuggestions(RegistryType.Docker, docker.RegistryUrl, docker.ImageName, docker.Tag)"
                                                                               Placeholder="latest"
                                                                               AriaLabel="Docker image tag" />
                                                        </div>
                                                        <div class="col-lg-4">
                                                            <label class="form-label" for="pullPolicy-@runner.Id">Pull policy</label>
                                                            <select id="pullPolicy-@runner.Id" class="form-select" @bind="docker.PullPolicy">
                                                                @foreach (var policy in Enum.GetValues<PullPolicy>())
                                                                {
                                                                    <option value="@policy">@policy</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else if (runner.ExecutionBackend == ExecutionBackend.Tart)
                                            {
                                                var tart = EnsureTartConfig(runner);
                                                <div class="runner-subsection">
                                                    <div class="runner-subsection-heading">
                                                        <span><i class="bi bi-apple"></i>Tart VM image</span>
                                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenImagePicker(runner, RegistryType.Tart)">
                                                            <i class="bi bi-search me-1"></i>Find image
                                                        </button>
                                                    </div>
                                                    <div class="row g-3">
                                                        <div class="col-lg-3">
                                                            <label class="form-label" for="tartRegistry-@runner.Id">OCI registry</label>
                                                            <SmartAutocomplete Value="@tart.RegistryUrl"
                                                                               ValueChanged="@(value => OnTartRegistryChangedAsync(tart, value))"
                                                                               Suggestions="@GetRegistrySuggestions(RegistryType.Tart)"
                                                                               Placeholder="ghcr.io"
                                                                               AriaLabel="Tart OCI registry" />
                                                        </div>
                                                        <div class="col-lg-4">
                                                            <label class="form-label" for="tartImage-@runner.Id">Image</label>
                                                            <SmartAutocomplete Value="@tart.ImageName"
                                                                               ValueChanged="@(value => OnTartImageNameChangedAsync(tart, value))"
                                                                               Suggestions="@GetImageNameSuggestions(RegistryType.Tart)"
                                                                               Placeholder="cirruslabs/macos-sequoia-base"
                                                                               AriaLabel="Tart image" />
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label class="form-label" for="tartTag-@runner.Id">Tag</label>
                                                            <SmartAutocomplete Value="@tart.Tag"
                                                                               ValueChanged="value => tart.Tag = value ?? string.Empty"
                                                                               Suggestions="@GetImageTagSuggestions(RegistryType.Tart, tart.RegistryUrl, tart.ImageName, tart.Tag)"
                                                                               Placeholder="latest"
                                                                               AriaLabel="Tart image tag" />
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <label class="form-label" for="tartDisplay-@runner.Id">Display</label>
                                                            <SmartAutocomplete Value="@tart.Display"
                                                                               ValueChanged="value => tart.Display = value"
                                                                               Suggestions="@GetTartDisplaySuggestions()"
                                                                               Placeholder="1024x768"
                                                                               AriaLabel="Tart display" />
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label class="form-label" for="tartCpu-@runner.Id">CPU</label>
                                                            <input id="tartCpu-@runner.Id" type="number" class="form-control" min="1" @bind="tart.CpuCount" />
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label class="form-label" for="tartMemory-@runner.Id">Memory GB</label>
                                                            <input id="tartMemory-@runner.Id" type="number" class="form-control" min="1" @bind="tart.MemorySizeGb" />
                                                        </div>
                                                        <div class="col-lg-2">
                                                            <label class="form-label" for="tartDisk-@runner.Id">Disk GB</label>
                                                            <input id="tartDisk-@runner.Id" type="number" class="form-control" min="10" @bind="tart.DiskSizeGb" />
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <label class="form-label" for="tartSshUser-@runner.Id">SSH user</label>
                                                            <SmartAutocomplete Value="@tart.SshUser"
                                                                               ValueChanged="value => tart.SshUser = value"
                                                                               Suggestions="@GetSshUserSuggestions()"
                                                                               Placeholder="admin"
                                                                               AriaLabel="Tart SSH user" />
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <label class="form-label" for="tartSshPassword-@runner.Id">SSH password</label>
                                                            <input id="tartSshPassword-@runner.Id" type="password" class="form-control" @bind="tart.SshPassword" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="runner-subsection">
                                                    <div class="runner-subsection-heading"><span><i class="bi bi-terminal"></i>Native execution</span></div>
                                                    <div class="row g-3">
                                                        <div class="col-lg-6">
                                                            <label class="form-label" for="nativeBasePath-@runner.Id">Runner base path</label>
                                                            <SmartAutocomplete Value='@GetProviderConfig(runner, "NativeBasePath")'
                                                                               ValueChanged='value => SetProviderConfig(runner, "NativeBasePath", value)'
                                                                               Suggestions='@GetNativePathSuggestions("NativeBasePath")'
                                                                               Placeholder="${HOME}/.runnerrunner"
                                                                               AriaLabel="Native runner base path" />
                                                        </div>
                                                        <div class="col-lg-6">
                                                            <label class="form-label" for="nativeWorkDir-@runner.Id">Work directory</label>
                                                            <SmartAutocomplete Value='@GetProviderConfig(runner, "NativeWorkDir")'
                                                                               ValueChanged='value => SetProviderConfig(runner, "NativeWorkDir", value)'
                                                                               Suggestions='@GetNativePathSuggestions("NativeWorkDir")'
                                                                               Placeholder="${BASE_PATH}/work"
                                                                               AriaLabel="Native work directory" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            <div class="runner-subsection">
                                                <div class="runner-subsection-heading"><span><i class="bi bi-braces"></i>Environment</span></div>
                                                @if (allEnvVarSets.Count == 0)
                                                {
                                                    <div class="subtle-empty">No environment variable sets configured.</div>
                                                }
                                                else
                                                {
                                                    <div class="env-set-grid">
                                                        @foreach (var envSet in allEnvVarSets.OrderBy(e => e.Priority).ThenBy(e => e.Name))
                                                        {
                                                            var selected = runner.EnvironmentVariableSetIds.Contains(envSet.Id);
                                                            <label class="env-set-card @(selected ? "selected" : "")" for="envSet-@runner.Id-@envSet.Id">
                                                                <input id="envSet-@runner.Id-@envSet.Id" type="checkbox" checked="@selected" @onchange="() => ToggleRunnerEnvSet(runner, envSet.Id)" />
                                                                <span>
                                                                    <strong>@envSet.Name</strong>
                                                                    <small>@envSet.Variables.Count var(s) · priority @envSet.Priority</small>
                                                                </span>
                                                            </label>
                                                        }
                                                    </div>
                                                }

                                                <div class="env-override-table mt-3">
                                                    @foreach (var kvp in runner.EnvironmentOverrides.ToList())
                                                    {
                                                        var key = kvp.Key;
                                                        var isSecret = runner.EnvironmentOverrideSecretKeys.Contains(key);
                                                        <div class="env-override-row">
                                                            <input class="form-control form-control-sm" value="@key" @onchange="e => RenameRunnerEnvOverride(runner, key, e.Value?.ToString())" aria-label="Environment variable key" />
                                                            <input class="form-control form-control-sm" type="@(isSecret ? "password" : "text")" value="@kvp.Value" @onchange="e => SetRunnerEnvOverrideValue(runner, key, e.Value?.ToString())" aria-label="Environment variable value" />
                                                            <label class="form-check small">
                                                                <input class="form-check-input" type="checkbox" checked="@isSecret" @onchange="() => ToggleRunnerEnvSecret(runner, key)" />
                                                                Secret
                                                            </label>
                                                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveRunnerEnvOverride(runner, key)" aria-label="Remove environment override @key"><i class="bi bi-x-lg"></i></button>
                                                        </div>
                                                    }
                                                    <div class="env-override-row add-row">
                                                        <SmartAutocomplete Value="@envOverrideKeyInputs[runner.Id]"
                                                                           ValueChanged="value => envOverrideKeyInputs[runner.Id] = value ?? string.Empty"
                                                                           Suggestions="@GetEnvironmentKeySuggestions(runner)"
                                                                           Placeholder="KEY"
                                                                           AriaLabel="Environment variable key" />
                                                        <input class="form-control form-control-sm" placeholder="Value or $RR_VARIABLE" @bind="envOverrideValueInputs[runner.Id]" />
                                                        <label class="form-check small">
                                                            <input class="form-check-input" type="checkbox" @bind="envOverrideSecretInputs[runner.Id]" />
                                                            Secret
                                                        </label>
                                                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => AddRunnerEnvOverride(runner)"><i class="bi bi-plus-lg"></i></button>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="runner-subsection">
                                                <div class="runner-subsection-heading">
                                                    <span><i class="bi bi-code-slash"></i>Custom steps</span>
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => AddInitStepReference(runner)" disabled="@(initSteps.Count == 0)">
                                                        <i class="bi bi-plus-lg me-1"></i>Reference step
                                                    </button>
                                                </div>
                                                @if (initSteps.Count == 0)
                                                {
                                                    <div class="subtle-empty">Create reusable custom steps from the Custom Steps page, then reference them here.</div>
                                                }
                                                else if (runner.InitStepRefs.Count == 0)
                                                {
                                                    <div class="subtle-empty">No custom steps selected for this runner.</div>
                                                }
                                                else
                                                {
                                                    <div class="init-ref-list">
                                                        @for (var refIndex = 0; refIndex < runner.InitStepRefs.Count; refIndex++)
                                                        {
                                                            var index = refIndex;
                                                            var reference = runner.InitStepRefs[index];
                                                            <div class="init-ref-row">
                                                                <input type="number" class="form-control form-control-sm" @bind="reference.Order" aria-label="Custom step order" />
                                                                <select class="form-select form-select-sm" @bind="reference.InitStepId" aria-label="Custom step">
                                                                    @foreach (var step in initSteps.OrderBy(s => s.Name))
                                                                    {
                                                                        <option value="@step.Id">@step.Name (@step.Phase)</option>
                                                                    }
                                                                </select>
                                                                <select class="form-select form-select-sm" value="@GetEnabledOverrideValue(reference)" @onchange="e => SetEnabledOverride(reference, e.Value?.ToString())" aria-label="Enabled override">
                                                                    <option value="">Default enabled</option>
                                                                    <option value="true">Force enabled</option>
                                                                    <option value="false">Force disabled</option>
                                                                </select>
                                                                <input type="number" class="form-control form-control-sm" @bind="reference.TimeoutSecondsOverride" placeholder="timeout" aria-label="Timeout override seconds" />
                                                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveInitStepReference(runner, index)" aria-label="Remove custom step"><i class="bi bi-x-lg"></i></button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <div class="runner-subsection">
                                                <div class="runner-subsection-heading"><span><i class="bi bi-ui-checks"></i>Runner metadata</span></div>
                                                <div class="metadata-toggle-grid">
                                                    <label class="metadata-toggle">
                                                        <input type="checkbox" @bind="runner.EmitMetadataLabels" />
                                                        <span><strong>Emit <code>rr-*</code> labels</strong><small>Show backend/image/host details in provider setup logs.</small></span>
                                                    </label>
                                                    <label class="metadata-toggle">
                                                        <input type="checkbox" @bind="runner.EmitJobStartedBanner" />
                                                        <span><strong>Job-started banner</strong><small>Add a collapsible RunnerRunner environment section to every job log.</small></span>
                                                    </label>
                                                    <label class="metadata-toggle">
                                                        <input type="checkbox" @bind="runner.AllowWebhookImageTagOverride" />
                                                        <span><strong>Allow image tag override</strong><small>Honor <code>rr-image-tag=&lt;tag&gt;</code> labels for this runner's image tag only.</small></span>
                                                    </label>
                                                 </div>
                                             </div>
                                                 </div>
                                             }
                                         </article>
                                    }
                                </div>
                            </section>
                        </div>

                        <aside class="rule-builder-sidebar">
                            <div class="rule-preview-card">
                                <div class="preview-title">Rule preview</div>
                                <h3>@(string.IsNullOrWhiteSpace(editRule.Name) ? "New provisioning rule" : editRule.Name)</h3>
                                <div class="preview-chip-row">
                                    <span class="badge @GetTypeBadgeClass(editRule.Type)">@GetTypeLabel(editRule.Type)</span>
                                    <span class="badge @(editRule.Enabled ? "bg-success" : "bg-secondary")">@(editRule.Enabled ? "Enabled" : "Disabled")</span>
                                </div>
                                <div class="preview-list">
                                    <div><span>Provider</span><strong>@GetProviderLabel(editRule.Provider)</strong></div>
                                    <div><span>Capacity</span><strong>@GetEditCapacityDisplay()</strong></div>
                                    <div><span>Targets</span><strong>@editRule.RunnerDefinitions.Count(r => r.Enabled)</strong></div>
                                    <div><span>Global host route</span><strong>@GetEditTargetDisplay()</strong></div>
                                </div>
                            </div>

                            @{
                                var workflowPreviewTarget = GetWorkflowPreviewTarget();
                            }
                            <div class="rule-preview-card workflow-instructions-card">
                                <div class="preview-title">Workflow instructions</div>
                                @if (workflowPreviewTarget == null)
                                {
                                    <p>Create a target, copy its workflow snippet, then commit it to your workflow.</p>
                                }
                                else
                                {
                                    @if (editRule.RunnerDefinitions.Count(r => r.Enabled) > 1)
                                    {
                                        <label class="form-label" for="workflowPreviewTarget">Preview target</label>
                                        <select id="workflowPreviewTarget" class="form-select form-select-sm mb-3" value="@workflowPreviewTarget.Id" @onchange="SetWorkflowPreviewTarget">
                                            @foreach (var target in editRule.RunnerDefinitions.Where(r => r.Enabled).OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                                            {
                                                <option value="@target.Id">@target.Name (@target.TargetKey)</option>
                                            }
                                        </select>
                                    }
                                    <p>Use this in your workflow to request <strong>@workflowPreviewTarget.Name</strong>.</p>
                                    <div class="workflow-snippet-panel" aria-label="Workflow YAML snippet">
                                        <div class="workflow-snippet-header">
                                            <span><i class="bi bi-code-square"></i> Workflow snippet</span>
                                            <span>@GetWorkflowSnippetKind()</span>
                                        </div>
                                        <div class="workflow-snippet-code">
                                            @GetHighlightedWorkflowSnippet(workflowPreviewTarget)
                                        </div>
                                    </div>
                                    <div class="preview-list">
                                        <div><span>Target key</span><strong>@workflowPreviewTarget.TargetKey</strong></div>
                                        <div><span>Runner shape</span><strong>@workflowPreviewTarget.RequiredHostPlatform · @workflowPreviewTarget.ExecutionBackend</strong></div>
                                        <div><span>Target host route</span><strong>@GetRunnerHostRoutingDisplay(workflowPreviewTarget)</strong></div>
