            ProvisioningType.ScaleSet => $"{firstRunner?.MinReady ?? editRule.MinReady} warm / {firstRunner?.MaxInstances ?? editRule.MaxInstances} max",
            ProvisioningType.Webhook => $"{FormatMaxConcurrent(editRule.MaxConcurrent)} · {editRule.RunnerDefinitions.Where(runner => runner.Enabled).Sum(runner => runner.MinReady)} warm",
            ProvisioningType.Scheduled => $"{firstRunner?.DesiredCount ?? editRule.DesiredCount} desired",
