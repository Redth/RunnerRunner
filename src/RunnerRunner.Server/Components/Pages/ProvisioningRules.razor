    private void GenerateSecret()
    {
        var bytes = new byte[16];
        System.Security.Cryptography.RandomNumberGenerator.Fill(bytes);
        editRule.WebhookSecret = Convert.ToHexString(bytes).ToLowerInvariant();
    }

    private async Task ConfirmAndDeleteRule(ProvisioningRule rule)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete provisioning rule '{rule.Name}'?");
        if (!confirmed)
            return;

        await RuleGrainSync.DisableRuleAsync(rule.Id);
        await Store.Remove<ProvisioningRule>(rule.Id);
        await LoadDataAsync();
    }

