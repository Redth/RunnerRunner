                @if (rule.Type == ProvisioningType.Webhook)
                {
                    <div class="webhook-scope-row">
                        <span><i class="bi bi-buildings"></i>@FormatScopeList(rule.AllowedOrgs, "Any owner")</span>
                        <span><i class="bi bi-git"></i>@FormatScopeList(rule.AllowedRepos, "Any repo")</span>
