            return;

        runner.ExecutionBackend = backend;
        if (backend == ExecutionBackend.Docker)
        {
            EnsureDockerConfig(runner);
            runner.TartConfig = null;
        }
        else if (backend == ExecutionBackend.Tart)
        {
            EnsureTartConfig(runner);
            runner.DockerConfig = null;
        }
        else
        {
            runner.DockerConfig = null;
            runner.TartConfig = null;
        }
    }

