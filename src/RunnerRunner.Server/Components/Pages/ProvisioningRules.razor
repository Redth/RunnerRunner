    private async Task LoadImageTagSuggestionsForRuleAsync()
    {
        foreach (var runner in editRule.RunnerDefinitions)
        {
            if (runner.ExecutionBackend == ExecutionBackend.Docker && runner.DockerConfig is { } docker)
                await LoadDockerTagSuggestionsAsync(docker);
            else if (runner.ExecutionBackend == ExecutionBackend.Tart && runner.TartConfig is { } tart)
                await LoadTartTagSuggestionsAsync(tart);
        }
    }

    private Task LoadDockerTagSuggestionsAsync(DockerImageConfig docker) =>
        LoadImageTagSuggestionsAsync(
            RegistryType.Docker,
            docker.RegistryUrl,
            docker.ImageName,
            ResolveDockerRegistryCredential(docker));

    private Task LoadTartTagSuggestionsAsync(TartImageConfig tart) =>
        LoadImageTagSuggestionsAsync(
            RegistryType.Tart,
            tart.RegistryUrl,
            tart.ImageName,
            ResolveRegistryCredential(RegistryType.Tart, tart.RegistryUrl, tart.ImageName));

    private async Task LoadImageTagSuggestionsAsync(
        RegistryType registryType,
        string? registryUrl,
        string? imageName,
        RegistryCredential? registry)
    {
        var normalizedRegistry = NormalizeRegistryUrl(registryUrl);
        var normalizedImage = NormalizeImageName(imageName);
        if (string.IsNullOrWhiteSpace(normalizedRegistry) || string.IsNullOrWhiteSpace(normalizedImage))
            return;

        var key = BuildImageTagSuggestionKey(registryType, normalizedRegistry, normalizedImage);
        if (imageTagSuggestions.ContainsKey(key) || !imageTagSuggestionLookups.Add(key))
            return;

        try
        {
            registry ??= ResolveRegistryCredential(registryType, registryUrl, imageName);
            if (registry is null)
                return;

            var tags = await RegistryCatalog.GetTagsAsync(registry, normalizedImage);
            imageTagSuggestions[key] = OrderedDistinct(tags.Tags.Select(tag => tag.Name));
        }
        finally
        {
            imageTagSuggestionLookups.Remove(key);
        }

        StateHasChanged();
    }

