    private static string GetRunnerAvailabilityClass(RuleRunnerCapacityView mapped)
    {
        if (mapped.EffectivePoolLimit <= 0)
            return "availability-empty";
        if (mapped.AvailableNow <= 0)
            return "availability-full";
        if (mapped.SaturatedHosts > 0 || mapped.AvailableNow <= Math.Max(1, mapped.EffectivePoolLimit / 4))
            return "availability-warn";
        return "availability-good";
    }

    private static string GetRunnerAvailabilityTitle(RuleRunnerCapacityView mapped) =>
        $"{mapped.RunnerName}: {mapped.ActiveNow} active, {mapped.AvailableNow} of {mapped.EffectivePoolLimit} host backend slot(s) available across {mapped.MatchingHosts} matching host(s).";

    private static string GetRunnerAvailabilityStyle(RuleRunnerCapacityView mapped)
    {
        var pct = mapped.EffectivePoolLimit <= 0
            ? 0
            : Math.Clamp(mapped.AvailableNow / (double)mapped.EffectivePoolLimit * 100, 0, 100);
        return $"width: {pct:0.#}%";
    }

