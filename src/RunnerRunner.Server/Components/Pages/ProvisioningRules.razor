    private void AddRunnerEnvOverride(RunnerDefinition runner)
    {
        var key = envOverrideKeyInputs.GetValueOrDefault(runner.Id, "").Trim();
        if (string.IsNullOrWhiteSpace(key))
            return;

        runner.EnvironmentOverrides[key] = envOverrideValueInputs.GetValueOrDefault(runner.Id, "");
        if (envOverrideSecretInputs.GetValueOrDefault(runner.Id))
            runner.EnvironmentOverrideSecretKeys.Add(key);
        else
            runner.EnvironmentOverrideSecretKeys.Remove(key);

        envOverrideKeyInputs[runner.Id] = "";
        envOverrideValueInputs[runner.Id] = "";
        envOverrideSecretInputs[runner.Id] = false;
    }

    private static void RemoveRunnerEnvOverride(RunnerDefinition runner, string key)
    {
        runner.EnvironmentOverrides.Remove(key);
        runner.EnvironmentOverrideSecretKeys.Remove(key);
    }

    private static void SetRunnerEnvOverrideValue(RunnerDefinition runner, string key, string? value)
