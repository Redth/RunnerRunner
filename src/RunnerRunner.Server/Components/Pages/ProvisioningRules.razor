}

@code {
    private static readonly ProvisioningType[] SupportedProvisioningTypes =
    [
        ProvisioningType.Static,
        ProvisioningType.ScaleSet,
        ProvisioningType.Webhook
    ];

    private List<ProvisioningRule> rules = [];
    private List<RunnerProfile> profiles = [];
    private List<Host> hosts = [];
    private List<ProviderCredential> credentials = [];
    private List<RegistryCredential> registryCredentials = [];
    private List<EnvironmentVariableSet> allEnvVarSets = [];
    private List<RunnerInitStepDefinition> initSteps = [];
    private List<string> hostGroups = [];
    private CapacitySnapshot capacitySnapshot = CapacitySnapshot.Empty;

    private ProvisioningRule editRule = new() { Name = "" };
    private bool showForm;
    private bool isEditing;
    private string? formError;

    private List<string> editAllowedOrgs = [];
    private List<string> editAllowedRepos = [];
    private string newOrgInput = "";
    private string newRepoInput = "";
    private Dictionary<string, string> editHostLabels = new();
    private string newHostLabelInput = "";
    private string? selectedWorkflowTargetId;
    private readonly Dictionary<string, string> runnerLabelInputs = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> runnerHostCapabilityInputs = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> matcherLabelInputs = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> envOverrideKeyInputs = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> envOverrideValueInputs = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool> envOverrideSecretInputs = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<string>> imageTagSuggestions = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> imageTagSuggestionLookups = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> collapsedRunnerDefinitionIds = new(StringComparer.OrdinalIgnoreCase);
    private bool showImagePicker;
    private RunnerDefinition? imagePickerRunner;
    private RegistryType imagePickerType = RegistryType.Docker;

    private sealed record HostMatchPreview(IReadOnlyList<Host> Hosts, string EmptyReason);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        rules = (await Store.Query<ProvisioningRule>().ToList()).ToList();
        profiles = (await Store.Query<RunnerProfile>().ToList()).ToList();
        hosts = (await Store.Query<Host>().ToList()).ToList();
        credentials = (await Store.Query<ProviderCredential>().ToList()).ToList();
        registryCredentials = (await Store.Query<RegistryCredential>().ToList()).ToList();
        allEnvVarSets = (await Store.Query<EnvironmentVariableSet>().ToList()).ToList();
        initSteps = (await Store.Query<RunnerInitStepDefinition>().ToList()).ToList();
        capacitySnapshot = await CapacityService.GetSnapshotAsync();

        hostGroups = hosts
            .Where(h => !string.IsNullOrWhiteSpace(h.GroupId))
            .Select(h => h.GroupId!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task ShowCreateForm()
    {
        editRule = new ProvisioningRule
        {
            Name = "",
            Type = ProvisioningType.Webhook,
            Provider = RunnerProvider.GitHubActions,
            MaxConcurrent = 0,
            CooldownSeconds = 5,
            RunnerDefinitions = [CreateDefaultRunnerDefinition("Linux Docker", includeCatchAllMatcher: false)]
        };

        ResetFormState();
        PrepareEditorState();
        isEditing = false;
        showForm = true;
        await LoadImageTagSuggestionsForRuleAsync();
    }

    private async Task EditRule(ProvisioningRule rule)
    {
        editRule = CloneRule(rule);
        HydrateLegacyRunnerDefinitions(editRule);
        EnsureRunnersForType();
        BackfillSingleTargetCapacityFromRule(editRule);

        editAllowedOrgs = [.. editRule.AllowedOrgs];
        editAllowedRepos = [.. editRule.AllowedRepos];
        editHostLabels = new Dictionary<string, string>(editRule.RequiredHostLabels);
        newOrgInput = "";
        newRepoInput = "";
        newHostLabelInput = "";
        formError = null;
        PrepareEditorState();
        isEditing = true;
        showForm = true;
        await LoadImageTagSuggestionsForRuleAsync();
    }

    private void ResetFormState()
    {
        formError = null;
        editAllowedOrgs = [];
        editAllowedRepos = [];
        editHostLabels = new();
        newOrgInput = "";
        newRepoInput = "";
        newHostLabelInput = "";
        runnerLabelInputs.Clear();
        runnerHostCapabilityInputs.Clear();
        matcherLabelInputs.Clear();
        envOverrideKeyInputs.Clear();
        envOverrideValueInputs.Clear();
        envOverrideSecretInputs.Clear();
        collapsedRunnerDefinitionIds.Clear();
        selectedWorkflowTargetId = null;
    }

    private async Task SaveRule()
    {
        formError = null;
        editRule.Name = (editRule.Name ?? "").Trim();
        editRule.Description = string.IsNullOrWhiteSpace(editRule.Description) ? null : editRule.Description.Trim();

        if (string.IsNullOrWhiteSpace(editRule.Name))
        {
            formError = "Rule name is required.";
            return;
        }

        editRule.AllowedOrgs = editRule.Type == ProvisioningType.Webhook ? [.. editAllowedOrgs] : [];
        editRule.AllowedRepos = editRule.Type == ProvisioningType.Webhook ? [.. editAllowedRepos] : [];
        editRule.RequiredHostLabels = new Dictionary<string, string>(editHostLabels);
        editRule.TargetHostId = null;
        EnsureRunnersForType();

        NormalizeRunnerDefinitions();
        ApplyTargetCapacityToRule();
        if (!ValidateRunnerDefinitions())
            return;

        if (editRule.Type == ProvisioningType.Webhook)
        {
            editRule.ProfileId = "";
            editRule.DefaultProfileId = null;
            editRule.LabelMappings = BuildLegacyLabelMappings(editRule.RunnerDefinitions);

            if (UsesGitHubAppCredential()
                && string.IsNullOrWhiteSpace(editRule.WebhookSecret)
                && string.IsNullOrWhiteSpace(SelectedCredential()?.GitHubAppWebhookSecret))
            {
                formError = "GitHub App webhook rules require either a rule webhook secret override or a webhook secret on the selected credential.";
                return;
            }
        }
        else
        {
            var runner = editRule.RunnerDefinitions.First();
            editRule.ProfileId = runner.Id;
            editRule.DefaultProfileId = null;
            editRule.LabelMappings = [];
        }

        editRule.UpdatedAt = DateTime.UtcNow;

        if (isEditing)
            await Store.Update(editRule);
        else
            await Store.Insert(editRule);

        await RuleGrainSync.ConfigureRuleAsync(editRule);
        await LoadDataAsync();
        showForm = false;
    }

    private bool ValidateRunnerDefinitions()
    {
        var enabledRunners = editRule.RunnerDefinitions.Where(r => r.Enabled).ToList();
        if (enabledRunners.Count == 0)
        {
            formError = "At least one runner definition must be enabled.";
            return false;
        }

        var targetKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var runner in enabledRunners)
        {
            if (string.IsNullOrWhiteSpace(runner.Name))
            {
                formError = "Every enabled runner target needs a name.";
                return false;
            }

            if (string.IsNullOrWhiteSpace(runner.TargetKey))
            {
                formError = $"Runner target '{runner.Name}' needs a workflow target key.";
                return false;
            }

            if (RunnerDefinition.IsReservedTargetKey(runner.TargetKey))
            {
                formError = $"Runner target key '{runner.TargetKey}' is reserved for RunnerRunner magic labels.";
                return false;
            }

            if (!targetKeys.Add(runner.TargetKey))
            {
                formError = $"Runner target key '{runner.TargetKey}' is already used in this rule.";
                return false;
            }

            if (runner.ExecutionBackend == ExecutionBackend.Docker)
            {
                var docker = EnsureDockerConfig(runner);
                if (string.IsNullOrWhiteSpace(docker.RegistryUrl) || string.IsNullOrWhiteSpace(docker.ImageName))
                {
                    formError = $"Docker runner '{runner.Name}' needs a registry and image name.";
                    return false;
                }
            }

            if (runner.ExecutionBackend == ExecutionBackend.Tart)
            {
                var tart = EnsureTartConfig(runner);
                if (string.IsNullOrWhiteSpace(tart.RegistryUrl) || string.IsNullOrWhiteSpace(tart.ImageName))
                {
                    formError = $"Tart runner '{runner.Name}' needs an OCI registry and image name.";
                    return false;
                }
            }
        }

        return true;
    }

    private void NormalizeRunnerDefinitions()
    {
        foreach (var runner in editRule.RunnerDefinitions)
        {
            runner.Name = (runner.Name ?? "").Trim();
            runner.Description = string.IsNullOrWhiteSpace(runner.Description) ? null : runner.Description.Trim();
            runner.TargetKey = string.IsNullOrWhiteSpace(runner.TargetKey)
                ? RunnerDefinition.GenerateTargetKey(runner.Name)
                : RunnerDefinition.NormalizeTargetKey(runner.TargetKey);
            runner.RunnerGroup = string.IsNullOrWhiteSpace(runner.RunnerGroup) ? "Default" : runner.RunnerGroup.Trim();
            runner.Labels = [.. runner.Labels.Where(label => !string.IsNullOrWhiteSpace(label)).Select(label => label.Trim()).Distinct(StringComparer.OrdinalIgnoreCase)];
            runner.TargetGroupId = string.IsNullOrWhiteSpace(runner.TargetGroupId) ? null : runner.TargetGroupId.Trim();
            runner.RequiredHostCapabilities = [.. runner.RequiredHostCapabilities
                .Where(capability => !string.IsNullOrWhiteSpace(capability))
                .Select(capability => capability.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)];
            runner.DesiredCount = Math.Max(0, runner.DesiredCount);
            runner.MinReady = Math.Max(0, runner.MinReady);
            runner.MaxInstances = Math.Max(1, runner.MaxInstances);
            runner.ScaleDownDelaySeconds = Math.Max(0, runner.ScaleDownDelaySeconds);
            runner.CooldownSeconds = Math.Max(0, runner.CooldownSeconds);
            runner.EnvironmentOverrides = runner.EnvironmentOverrides
                .Where(kvp => !string.IsNullOrWhiteSpace(kvp.Key))
                .ToDictionary(kvp => kvp.Key.Trim(), kvp => kvp.Value, StringComparer.OrdinalIgnoreCase);
            runner.EnvironmentOverrideSecretKeys = [.. runner.EnvironmentOverrideSecretKeys.Where(runner.EnvironmentOverrides.ContainsKey)];
            runner.InitStepRefs = [.. runner.InitStepRefs
                .Where(reference => !string.IsNullOrWhiteSpace(reference.InitStepId))
                .OrderBy(reference => reference.Order)];

            if (runner.ExecutionBackend != ExecutionBackend.Docker)
                runner.DockerConfig = null;
            if (runner.ExecutionBackend != ExecutionBackend.Tart)
                runner.TartConfig = null;

            foreach (var matcher in runner.Matchers)
                matcher.RequiredLabels = [.. matcher.RequiredLabels.Where(label => !string.IsNullOrWhiteSpace(label)).Select(label => label.Trim()).Distinct(StringComparer.OrdinalIgnoreCase)];

            runner.Matchers = [.. runner.Matchers
                .Where(matcher => matcher.RequiredLabels.Count > 0)
                .OrderByDescending(matcher => matcher.Priority)];
        }

        editRule.RunnerDefinitions = [.. editRule.RunnerDefinitions.Where(runner => !string.IsNullOrWhiteSpace(runner.Name))];
    }

    private void ApplyTargetCapacityToRule()
    {
        editRule.MaxConcurrent = Math.Max(0, editRule.MaxConcurrent);
        if (editRule.RunnerDefinitions.Count == 0)
            return;

        var firstRunner = editRule.RunnerDefinitions[0];
        if (editRule.Type == ProvisioningType.Static)
        {
            editRule.DesiredCount = firstRunner.DesiredCount;
            return;
        }

        if (editRule.Type == ProvisioningType.ScaleSet)
        {
            editRule.MinReady = firstRunner.MinReady;
            editRule.MaxInstances = firstRunner.MaxInstances;
            editRule.ScaleDownDelaySeconds = firstRunner.ScaleDownDelaySeconds;
            return;
        }

        editRule.MinReady = editRule.RunnerDefinitions.Where(runner => runner.Enabled).Sum(runner => runner.MinReady);
        editRule.CooldownSeconds = editRule.RunnerDefinitions
            .Where(runner => runner.Enabled)
            .Select(runner => runner.CooldownSeconds)
            .DefaultIfEmpty(firstRunner.CooldownSeconds)
            .Max();
    }

    private List<LabelProfileMapping> BuildLegacyLabelMappings(IEnumerable<RunnerDefinition> runners)
    {
        return runners
            .Where(runner => runner.Enabled)
            .SelectMany(runner => runner.Matchers
                .Where(matcher => matcher.Enabled && matcher.RequiredLabels.Count > 0)
                .Select(matcher => new LabelProfileMapping
                {
                    ProfileId = runner.Id,
                    Priority = matcher.Priority,
                    RequiredLabels = [.. matcher.RequiredLabels]
                }))
            .OrderByDescending(mapping => mapping.Priority)
            .ToList();
    }

    private void EnsureRunnersForType()
    {
        if (editRule.Type == ProvisioningType.Webhook)
        {
            if (editRule.RunnerDefinitions.Count == 0)
                editRule.RunnerDefinitions.Add(CreateDefaultRunnerDefinition("Linux Docker", includeCatchAllMatcher: false));

            return;
        }

        if (editRule.RunnerDefinitions.Count == 0)
            editRule.RunnerDefinitions.Add(CreateDefaultRunnerDefinition(editRule.Name, includeCatchAllMatcher: false));
        else if (editRule.RunnerDefinitions.Count > 1)
            editRule.RunnerDefinitions = [editRule.RunnerDefinitions[0]];

        editRule.RunnerDefinitions[0].Matchers = [];
    }

    private RunnerDefinition CreateDefaultRunnerDefinition(string? name, bool includeCatchAllMatcher)
    {
        var runnerName = string.IsNullOrWhiteSpace(name) ? "Linux Docker" : name;
        var runner = new RunnerDefinition
        {
            Name = runnerName,
            TargetKey = RunnerDefinition.GenerateTargetKey(runnerName),
            RequiredHostPlatform = HostPlatform.Linux,
            ExecutionBackend = ExecutionBackend.Docker,
            DockerConfig = new DockerImageConfig
            {
                RegistryUrl = "ghcr.io",
                ImageName = "",
                Tag = "latest"
            },
            Labels = ["self-hosted", "linux", "docker"],
            RunnerGroup = "Default",
            Ephemeral = true
        };

        if (includeCatchAllMatcher)
            runner.Matchers.Add(new RunnerLabelMatcher { RequiredLabels = ["*"], Priority = 0 });

        return runner;
    }

    private static void BackfillSingleTargetCapacityFromRule(ProvisioningRule rule)
    {
        if (rule.RunnerDefinitions.Count != 1)
            return;

        var runner = rule.RunnerDefinitions[0];
        var shouldBackfill = rule.Type switch
        {
            ProvisioningType.Static => runner.DesiredCount == 1 && rule.DesiredCount != 1,
            ProvisioningType.ScaleSet => runner.MinReady == 0
                && runner.MaxInstances == 5
                && runner.ScaleDownDelaySeconds == 300
                && (rule.MinReady != 0 || rule.MaxInstances != 5 || rule.ScaleDownDelaySeconds != 300),
            ProvisioningType.Webhook => runner.MinReady == 0
                && runner.CooldownSeconds == 5
                && (rule.MinReady != 0 || rule.CooldownSeconds != 5),
            _ => false
        };

        if (!shouldBackfill)
            return;

        runner.DesiredCount = Math.Max(0, rule.DesiredCount);
        runner.MinReady = Math.Max(0, rule.MinReady);
        runner.MaxInstances = Math.Max(1, rule.MaxInstances);
        runner.ScaleDownDelaySeconds = Math.Max(0, rule.ScaleDownDelaySeconds);
        runner.CooldownSeconds = Math.Max(0, rule.CooldownSeconds);
    }

    private void HydrateLegacyRunnerDefinitions(ProvisioningRule rule)
    {
        if (rule.RunnerDefinitions.Count > 0)
            return;

        if (rule.Type == ProvisioningType.Webhook)
        {
            foreach (var mappingGroup in rule.LabelMappings
                .Where(mapping => !string.IsNullOrWhiteSpace(mapping.ProfileId))
                .GroupBy(mapping => mapping.ProfileId, StringComparer.OrdinalIgnoreCase))
            {
                var profile = profiles.FirstOrDefault(p => string.Equals(p.Id, mappingGroup.Key, StringComparison.OrdinalIgnoreCase));
                if (profile == null)
                    continue;

                var runner = RunnerDefinition.FromProfile(profile, $"{rule.Id}-{profile.Id}");
                runner.Ephemeral = true;
                runner.Matchers = [.. mappingGroup.Select(mapping => new RunnerLabelMatcher
                {
                    RequiredLabels = [.. mapping.RequiredLabels],
                    Priority = mapping.Priority
                })];
                rule.RunnerDefinitions.Add(runner);
            }
        }
        else if (!string.IsNullOrWhiteSpace(rule.ProfileId))
        {
            var profile = profiles.FirstOrDefault(p => string.Equals(p.Id, rule.ProfileId, StringComparison.OrdinalIgnoreCase));
            if (profile != null)
            {
                var runner = RunnerDefinition.FromProfile(profile, $"{rule.Id}-{profile.Id}");
                runner.Name = string.IsNullOrWhiteSpace(rule.Name) ? runner.Name : rule.Name;
                rule.RunnerDefinitions.Add(runner);
            }
        }
    }

    private void PrepareEditorState()
    {
        foreach (var runner in editRule.RunnerDefinitions)
        {
            EnsureRunnerEditorState(runner);
            foreach (var matcher in runner.Matchers)
                EnsureMatcherEditorState(matcher);
        }

        EnsureWorkflowPreviewTarget();
    }

    private void EnsureRunnerEditorState(RunnerDefinition runner)
    {
        runnerLabelInputs.TryAdd(runner.Id, "");
        runnerHostCapabilityInputs.TryAdd(runner.Id, "");
        envOverrideKeyInputs.TryAdd(runner.Id, "");
        envOverrideValueInputs.TryAdd(runner.Id, "");
        envOverrideSecretInputs.TryAdd(runner.Id, false);
    }

    private void EnsureMatcherEditorState(RunnerLabelMatcher matcher)
    {
        matcherLabelInputs.TryAdd(matcher.Id, "");
    }

    private void EnsureWorkflowPreviewTarget()
    {
        var enabledTargets = editRule.RunnerDefinitions.Where(r => r.Enabled).ToList();
        if (enabledTargets.Count == 0)
        {
            selectedWorkflowTargetId = null;
            return;
        }

        if (enabledTargets.Any(r => string.Equals(r.Id, selectedWorkflowTargetId, StringComparison.OrdinalIgnoreCase)))
            return;

        selectedWorkflowTargetId = enabledTargets
            .OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
            .First()
            .Id;
    }

    private RunnerDefinition? GetWorkflowPreviewTarget()
    {
        EnsureWorkflowPreviewTarget();
        return editRule.RunnerDefinitions.FirstOrDefault(r =>
                r.Enabled && string.Equals(r.Id, selectedWorkflowTargetId, StringComparison.OrdinalIgnoreCase))
            ?? editRule.RunnerDefinitions.FirstOrDefault(r => r.Enabled);
    }

    private void SetWorkflowPreviewTarget(ChangeEventArgs e)
    {
        selectedWorkflowTargetId = e.Value?.ToString();
    }

    private string GetInlineWorkflowHint(RunnerDefinition runner) =>
        editRule.Provider switch
        {
            RunnerProvider.GitHubActions or RunnerProvider.GiteaActions => $"Use runs-on: [self-hosted, {runner.TargetKey}]",
            RunnerProvider.AzureDevOps => $"Use Azure pool '{GetProviderPoolName(runner)}' with demand rr.target = {runner.TargetKey}",
            _ => $"Request {runner.TargetKey} from your workflow provider."
        };

    private string GetWorkflowSnippet(RunnerDefinition runner)
    {
        var targetKey = runner.TargetKey;
        return editRule.Provider switch
        {
            RunnerProvider.GitHubActions or RunnerProvider.GiteaActions =>
                $"runs-on: [self-hosted, {targetKey}]",
            RunnerProvider.AzureDevOps =>
                $"pool:{Environment.NewLine}  name: {GetProviderPoolName(runner)}{Environment.NewLine}  demands:{Environment.NewLine}    - rr.target -equals {targetKey}",
            _ => targetKey
        };
    }

    private string GetWorkflowSnippetKind() =>
        editRule.Provider switch
        {
            RunnerProvider.GitHubActions => "GitHub Actions",
            RunnerProvider.GiteaActions => "Gitea Actions",
            RunnerProvider.AzureDevOps => "Azure Pipelines",
            _ => "Workflow"
        };

    private MarkupString GetHighlightedWorkflowSnippet(RunnerDefinition runner)
    {
        var lines = GetWorkflowSnippet(runner).Split(Environment.NewLine);
        var html = string.Join("", lines.Select((line, index) =>
            $"<div class=\"workflow-snippet-line\"><span class=\"workflow-snippet-line-code\">{HighlightWorkflowLine(line, runner)}</span></div>"));

        return new MarkupString(html);
    }

    private string HighlightWorkflowLine(string line, RunnerDefinition runner)
    {
        var indentLength = line.Length - line.TrimStart().Length;
        var indent = line[..indentLength];
        var trimmed = line[indentLength..];

        if (trimmed.StartsWith("- ", StringComparison.Ordinal))
        {
            return Encode(indent)
                + "<span class=\"yaml-punctuation\">-</span> "
                + HighlightWorkflowValue(trimmed[2..], runner);
        }

        var separatorIndex = trimmed.IndexOf(':');
        if (separatorIndex >= 0)
        {
            var key = trimmed[..separatorIndex];
            var value = trimmed[(separatorIndex + 1)..];
            return Encode(indent)
                + $"<span class=\"yaml-key\">{Encode(key)}</span><span class=\"yaml-punctuation\">:</span>"
                + HighlightWorkflowValue(value, runner);
        }

        return HighlightWorkflowValue(line, runner);
    }

    private string HighlightWorkflowValue(string value, RunnerDefinition runner)
    {
        var highlighted = Encode(value)
            .Replace("[", "<span class=\"yaml-punctuation\">[</span>", StringComparison.Ordinal)
            .Replace("]", "<span class=\"yaml-punctuation\">]</span>", StringComparison.Ordinal)
            .Replace(",", "<span class=\"yaml-punctuation\">,</span>", StringComparison.Ordinal);

        highlighted = HighlightToken(highlighted, runner.TargetKey, "yaml-target");
        highlighted = HighlightToken(highlighted, "self-hosted", "yaml-string");
        highlighted = HighlightToken(highlighted, "rr.target", "yaml-string");
        highlighted = HighlightToken(highlighted, "-equals", "yaml-operator");

        if (editRule.Provider == RunnerProvider.AzureDevOps)
            highlighted = HighlightToken(highlighted, GetProviderPoolName(runner), "yaml-string");

        return highlighted;
    }

    private static string HighlightToken(string html, string? token, string cssClass)
    {
        if (string.IsNullOrWhiteSpace(token))
            return html;

        var encodedToken = Encode(token);
        return html.Replace(encodedToken, $"<span class=\"{cssClass}\">{encodedToken}</span>", StringComparison.Ordinal);
    }

    private static string Encode(string value) =>
        System.Net.WebUtility.HtmlEncode(value);

