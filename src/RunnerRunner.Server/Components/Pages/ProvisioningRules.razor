    private HostMatchPreview GetHostMatchPreviewForRunner(RunnerDefinition runner)
    {
        if (hosts.Count == 0)
            return new HostMatchPreview(Array.Empty<Host>(), "No HostWorkers are registered yet.");

        var globalMatches = hosts
            .Where(HostMatchesRulePreview)
            .ToList();
        if (globalMatches.Count == 0)
            return new HostMatchPreview(Array.Empty<Host>(), $"Global host routing excludes every registered host ({GetEditTargetDisplay()}).");

        var platformMatches = globalMatches
            .Where(host => HostCanProvideRunnerPlatform(host, runner))
            .ToList();
        if (platformMatches.Count == 0)
            return new HostMatchPreview(Array.Empty<Host>(), $"No hosts can provide target platform {runner.RequiredHostPlatform} for {runner.ExecutionBackend} after global host routing.");

        var backendMatches = platformMatches
            .Where(host =>
                CapacityPlanningService.HasBackendCapability(host, runner.ExecutionBackend)
                && CapacityPlanningService.GetBackendLimit(host, runner.ExecutionBackend) > 0)
            .ToList();
        if (backendMatches.Count == 0)
            return new HostMatchPreview(Array.Empty<Host>(), $"No compatible hosts advertise {runner.ExecutionBackend.ToString().ToLowerInvariant()} support with capacity enabled.");

        var matches = backendMatches
            .Where(host => HostMatchesRunnerRouting(host, runner))
            .OrderByDescending(host => host.AgentStatus == AgentStatus.Online)
            .ThenBy(host => host.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (matches.Count == 0)
            return new HostMatchPreview(Array.Empty<Host>(), $"Target host routing excludes every otherwise compatible host ({GetRunnerHostRoutingDisplay(runner)}).");

        return new HostMatchPreview(matches, "");
    }

    private bool HostMatchesRulePreview(Host host)
    {
        if (!string.IsNullOrWhiteSpace(editRule.TargetHostId)
            && !string.Equals(host.Id, editRule.TargetHostId, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(editRule.TargetGroupId)
            && !string.Equals(host.GroupId, editRule.TargetGroupId, StringComparison.OrdinalIgnoreCase))
            return false;

        foreach (var required in editHostLabels)
        {
            if (!host.Labels.TryGetValue(required.Key, out var actualValue)
                || !string.Equals(actualValue, required.Value, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        return true;
    }

    private static bool HostCanProvideRunnerPlatform(Host host, RunnerDefinition runner)
    {
        if (runner.ExecutionBackend != ExecutionBackend.Docker)
            return host.Platform == runner.RequiredHostPlatform;

        var expectedDockerOs = GetExpectedDockerOs(runner);
        if (expectedDockerOs == null)
            return host.Platform == runner.RequiredHostPlatform;

        if (host.Labels.TryGetValue("docker_os", out var dockerOs) && !string.IsNullOrWhiteSpace(dockerOs))
            return string.Equals(dockerOs, expectedDockerOs, StringComparison.OrdinalIgnoreCase);

        if (expectedDockerOs == "linux")
            return host.Platform is HostPlatform.Linux or HostPlatform.MacOS;

        return host.Platform == runner.RequiredHostPlatform;
    }

    private static bool HostMatchesRunnerRouting(Host host, RunnerDefinition runner)
    {
        if (!string.IsNullOrWhiteSpace(runner.TargetGroupId)
            && !string.Equals(host.GroupId, runner.TargetGroupId, StringComparison.OrdinalIgnoreCase))
            return false;

        if (runner.RequiredHostCapabilities.Count == 0)
            return true;

        var hostCapabilities = GetEffectiveHostCapabilities(host);
        return runner.RequiredHostCapabilities
            .Where(capability => !string.IsNullOrWhiteSpace(capability))
            .Select(capability => capability.Trim())
            .All(hostCapabilities.Contains);
    }

    private static HashSet<string> GetEffectiveHostCapabilities(Host host)
    {
        var capabilities = host.Capabilities
            .Where(capability => !string.IsNullOrWhiteSpace(capability))
            .Select(capability => capability.Trim())
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        capabilities.Add("native");
        capabilities.Add(host.Platform.ToString().ToLowerInvariant());
        if (!string.IsNullOrWhiteSpace(host.Architecture))
            capabilities.Add(host.Architecture.Trim().ToLowerInvariant());
        return capabilities;
    }

    private static string? GetExpectedDockerOs(RunnerDefinition runner) =>
        runner.ExecutionBackend != ExecutionBackend.Docker
            ? null
            : runner.RequiredHostPlatform switch
            {
                HostPlatform.Windows => "windows",
                HostPlatform.Linux => "linux",
                _ => null
            };

