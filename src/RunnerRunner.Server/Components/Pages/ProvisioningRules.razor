    </div>
}
else
{
    <div class="provisioning-rule-grid">
        @foreach (var rule in rules.OrderByDescending(r => r.Enabled).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
        {
            var displayRunners = GetDisplayRunnerDefinitions(rule);
            <article class="provisioning-rule-card">
                <div class="provisioning-rule-card-header">
                    <div>
                        <div class="rule-card-kicker">
                            <span class="badge @GetTypeBadgeClass(rule.Type)">@GetTypeLabel(rule.Type)</span>
                            <span class="badge @(rule.Enabled ? "bg-success" : "bg-secondary")">@(rule.Enabled ? "Enabled" : "Disabled")</span>
                        </div>
                        <h2>@rule.Name</h2>
                        @if (!string.IsNullOrWhiteSpace(rule.Description))
                        {
                            <p>@rule.Description</p>
                        }
                    </div>
                    <div class="rule-card-actions">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditRule(rule)"><i class="bi bi-pencil-square me-1"></i>Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmAndDeleteRule(rule)"><i class="bi bi-trash3"></i></button>
                    </div>
                </div>

                <div class="rule-card-meta-grid">
                    <div>
                        <span>Provider</span>
                        <strong>@GetProviderLabel(rule.Provider)</strong>
                    </div>
                    <div>
                        <span>Capacity</span>
                        <strong>@GetScaleDisplay(rule)</strong>
                    </div>
                    <div>
                        <span>Global host route</span>
                        <strong>@GetTargetDisplay(rule)</strong>
                    </div>
                </div>

                <div class="rule-runner-summary">
                    @if (capacitySnapshot.Rules.TryGetValue(rule.Id, out var ruleCapacity) && ruleCapacity.MappedRunners.Any())
                    {
                        @foreach (var mapped in ruleCapacity.MappedRunners.Take(4))
                        {
                            <div class="rule-profile-card @GetRunnerAvailabilityClass(mapped)" title="@GetRunnerAvailabilityTitle(mapped)">
                                <div class="rule-profile-main">
                                    <span class="rule-profile-name">@mapped.RunnerName</span>
                                    <span class="rule-profile-count">@mapped.AvailableNow/@mapped.EffectivePoolLimit</span>
                                </div>
                                <span class="rule-profile-meter" aria-hidden="true">
                                    <span style="@GetRunnerAvailabilityStyle(mapped)"></span>
                                </span>
                                <div class="rule-profile-meta">
                                    <span><i class="bi bi-activity"></i>@mapped.ActiveNow active</span>
                                    <span><i class="bi bi-hdd-network"></i>@mapped.MatchingHosts host(s)</span>
                                    @if (mapped.SaturatedHosts > 0)
                                    {
                                        <span class="text-warning"><i class="bi bi-exclamation-triangle-fill"></i>@mapped.SaturatedHosts full</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (displayRunners.Any())
                                 {
                                     @foreach (var runner in displayRunners.Take(4))
                                     {
                                         <div class="runner-mini-card">
                                             <strong>@runner.Name</strong>
                                             <span>@runner.TargetKey · @runner.RequiredHostPlatform · @runner.ExecutionBackend · @GetRunnerHostRoutingDisplay(runner) · @(runner.Ephemeral ? "one-job" : "reusable")</span>
