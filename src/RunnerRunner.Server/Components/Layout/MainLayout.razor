@inherits LayoutComponentBase

<div class="page" id="page-root">
    <aside class="sidebar" onclick="if(event.target.closest('a'))closeMobileSidebar()">
        <NavMenu />
        <button class="sidebar-toggle" onclick="toggleSidebar()" title="Toggle sidebar">
            <i class="bi bi-chevron-bar-left collapse-icon-expanded"></i>
            <i class="bi bi-chevron-bar-right collapse-icon-collapsed"></i>
        </button>
    </aside>
    <div class="sidebar-backdrop" onclick="closeMobileSidebar()"></div>

    <main>
        <header class="top-bar">
            <div class="top-bar-left">
                <button class="mobile-hamburger" onclick="toggleMobileSidebar()" title="Open menu">
                    <i class="bi bi-list"></i>
                </button>
                <SectionOutlet SectionName="page-header" />
            </div>
            <div class="top-bar-right">
                <LongRunningTasksMenu />
                <button class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
                    <span class="theme-icon-light"><i class="bi bi-sun-fill"></i></span>
                    <span class="theme-icon-dark"><i class="bi bi-moon-stars-fill"></i></span>
                </button>
            </div>
        </header>

        <article class="content-area">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
