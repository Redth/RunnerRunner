@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="page" id="page-root">
    <aside class="sidebar" onclick="if(event.target.closest('a'))closeMobileSidebar()">
        <NavMenu />
    </aside>
    <div class="sidebar-backdrop" onclick="closeMobileSidebar()"></div>

    <main id="main-content" tabindex="-1">
        <header class="top-bar">
            <div class="top-bar-left">
                <button class="mobile-hamburger" onclick="toggleMobileSidebar()" title="Open menu">
                    <i class="bi bi-list"></i>
                </button>
                <button type="button" class="sidebar-toggle" onclick="toggleSidebar()" title="Toggle sidebar" aria-label="Toggle sidebar">
                    <i class="bi bi-chevron-bar-left collapse-icon-expanded"></i>
                    <i class="bi bi-chevron-bar-right collapse-icon-collapsed"></i>
                </button>
                <SectionOutlet SectionName="page-header" />
            </div>
            <div class="top-bar-right">
                <LongRunningTasksMenu />
                <AuthorizeView>
                    <Authorized>
                        <div class="user-chip">
                            <i class="bi bi-person-circle"></i>
                            <span>@context.User.Identity?.Name</span>
                        </div>
                        <form method="post" action="/auth/logout" class="m-0">
                            <AntiforgeryToken />
                            <button type="submit" class="theme-toggle" title="Sign out">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </Authorized>
                </AuthorizeView>
                <button type="button" class="theme-toggle" onclick="toggleTheme()" title="Theme: Auto" aria-label="Theme: Auto" data-theme-toggle>
                    <span class="theme-icon theme-icon-auto"><i class="bi bi-circle-half"></i></span>
                    <span class="theme-icon theme-icon-light"><i class="bi bi-sun-fill"></i></span>
                    <span class="theme-icon theme-icon-dark"><i class="bi bi-moon-stars-fill"></i></span>
                </button>
            </div>
        </header>

        <article class="content-area">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
